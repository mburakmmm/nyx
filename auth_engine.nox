# nyx.auth_engine - Devise-core on SQLite (application.db).
# PostgreSQL: nyx.auth_engine_pg + nyx.app.pg(application).
#
# Reset tokens: DB stores SHA-256 hex; raw token returned once to caller.
# Emails are trim+lowercase normalized.

import nox.time
import nox.uuid
import nox.strings
import nox.crypto
from nox.sqlite import Connection, SqliteError, Statement
import nyx.password
import nyx.model
import nyx.runtime
from nyx.model import Attributes, ModelError, Record

class AuthEngineError(Exception):
    def __init__(self: AuthEngineError, message: str) -> None:
        self.message = message

def max_failed_attempts() -> int:
    return 5

def lock_duration_ms() -> int:
    return 15 * 60 * 1000

def normalize_email(email: str) -> str:
    return nox.strings.lower(nox.strings.trim(email))

def hash_reset_token(raw: str) -> str:
    return nox.crypto.sha256(raw)

class _TimingDigest:
    value: str

    def __init__(self: _TimingDigest) -> None:
        self.value = ""

    def get(self: _TimingDigest) -> str:
        if len(self.value) == 0:
            self.value = nyx.password.hash("__nyx_auth_timing_dummy_v1__")
        return self.value

_timing: _TimingDigest = _TimingDigest()

def timing_dummy_digest() -> str:
    # Cached argon2 digest so missing-user / locked paths spend similar verify time.
    return _timing.get()

def ensure_schema(db: Connection) -> None:
    db.execute(
        "CREATE TABLE IF NOT EXISTS users (" +
        "id INTEGER PRIMARY KEY AUTOINCREMENT, " +
        "email TEXT NOT NULL UNIQUE, " +
        "password_digest TEXT NOT NULL, " +
        "failed_attempts INTEGER NOT NULL DEFAULT 0, " +
        "locked_at_ms INTEGER NOT NULL DEFAULT 0, " +
        "reset_token TEXT NOT NULL DEFAULT '', " +
        "reset_sent_at_ms INTEGER NOT NULL DEFAULT 0" +
        ")"
    )
    db.execute("CREATE INDEX IF NOT EXISTS idx_users_reset_token ON users (reset_token)")

def find_by_email(db: Connection, email: str) -> Record | None:
    rows: list[Record] = nyx.model.where(db, "users", "email", normalize_email(email))
    if len(rows) == 0:
        return None
    return rows[0]

def is_locked_at(locked_at: int) -> bool:
    if locked_at <= 0:
        return False
    return nox.time.now_ms() - locked_at < lock_duration_ms()

def register(db: Connection, email: str, password: str) -> int:
    em: str = normalize_email(email)
    if len(em) == 0 or not nox.strings.contains(em, "@"):
        raise AuthEngineError("invalid email")
    if len(password) < 8:
        raise AuthEngineError("password too short (min 8)")
    attrs: Attributes = nyx.model.attributes()
    nyx.model.set_str(attrs, "email", em)
    nyx.model.set_str(attrs, "password_digest", nyx.password.hash(password))
    nyx.model.set_int(attrs, "failed_attempts", 0)
    nyx.model.set_int(attrs, "locked_at_ms", 0)
    nyx.model.set_str(attrs, "reset_token", "")
    nyx.model.set_int(attrs, "reset_sent_at_ms", 0)
    try:
        return nyx.model.create_attrs(db, "users", attrs)
    except ModelError:
        raise AuthEngineError("could not register")
    except SqliteError:
        raise AuthEngineError("could not register")

def _bump_failure(db: Connection, rec: Record) -> None:
    # Atomic increment avoids read-modify-write races on concurrent failures.
    now: int = nox.time.now_ms()
    max_a: int = max_failed_attempts()
    stmt: Statement = db.prepare(
        "UPDATE users SET failed_attempts = failed_attempts + 1, " +
        "locked_at_ms = CASE WHEN failed_attempts + 1 >= ? THEN ? ELSE locked_at_ms END " +
        "WHERE id = ?"
    )
    stmt.bind_int(0, max_a)
    stmt.bind_int(1, now)
    stmt.bind_int(2, rec.get_int("id"))
    stmt.execute()

def _clear_failure(db: Connection, rec: Record) -> None:
    attrs: Attributes = nyx.model.attributes()
    nyx.model.set_int(attrs, "failed_attempts", 0)
    nyx.model.set_int(attrs, "locked_at_ms", 0)
    nyx.model.update_attrs(db, "users", rec.get_int("id"), attrs)

def authenticate(db: Connection, email: str, password: str) -> int:
    rec: Record | None = find_by_email(db, email)
    if rec == None:
        nyx.password.verify(timing_dummy_digest(), password)
        raise AuthEngineError("invalid credentials")
    else:
        if is_locked_at(rec.get_int_or("locked_at_ms", 0)):
            nyx.password.verify(timing_dummy_digest(), password)
            raise AuthEngineError("invalid credentials")
        digest: str = rec.get("password_digest")
        if not nyx.password.verify(digest, password):
            _bump_failure(db, rec)
            raise AuthEngineError("invalid credentials")
        _clear_failure(db, rec)
        return rec.get_int("id")

def request_password_reset(db: Connection, email: str) -> str:
    rec: Record | None = find_by_email(db, email)
    if rec == None:
        return ""
    else:
        raw: str = nox.uuid.uuid4()
        attrs: Attributes = nyx.model.attributes()
        nyx.model.set_str(attrs, "reset_token", hash_reset_token(raw))
        nyx.model.set_int(attrs, "reset_sent_at_ms", nox.time.now_ms())
        nyx.model.update_attrs(db, "users", rec.get_int("id"), attrs)
        return raw

def reset_password(db: Connection, token: str, new_password: str) -> int:
    if len(token) == 0:
        raise AuthEngineError("invalid reset token")
    if len(new_password) < 8:
        raise AuthEngineError("password too short (min 8)")
    hashed: str = hash_reset_token(token)
    rows: list[Record] = nyx.model.where(db, "users", "reset_token", hashed)
    if len(rows) == 0:
        raise AuthEngineError("invalid reset token")
    rec: Record = rows[0]
    sent: int = rec.get_int_or("reset_sent_at_ms", 0)
    if sent <= 0 or nox.time.now_ms() - sent > 3600000:
        raise AuthEngineError("reset token expired")
    attrs: Attributes = nyx.model.attributes()
    nyx.model.set_str(attrs, "password_digest", nyx.password.hash(new_password))
    nyx.model.set_str(attrs, "reset_token", "")
    nyx.model.set_int(attrs, "reset_sent_at_ms", 0)
    nyx.model.set_int(attrs, "failed_attempts", 0)
    nyx.model.set_int(attrs, "locked_at_ms", 0)
    nyx.model.update_attrs(db, "users", rec.get_int("id"), attrs)
    return rec.get_int("id")

def session_data_for_user(user_id: int) -> str:
    return "{\"user_id\":" + str(user_id) + "}"

def login_session(user_id: int) -> None:
    nyx.runtime.set_session(session_data_for_user(user_id))
    nyx.runtime.cycle_session()
    nyx.runtime.set_user(str(user_id), session_data_for_user(user_id))

def logout_session() -> None:
    nyx.runtime.logout()
