# cli.nox — kurulan `nyx` ikilisi. Argv Rune'da, dosya uretimi Nox'ta.
# Unix: ./bin/nyx   Windows: bin\nyx.cmd   Her ikisi de bu dosyayi calistirir.

import nox.os
import nyx.cli_app

def cli_main() -> None:
    args: list[str] = []
    total: int = nox.os.arg_count()
    i: int = 1
    while i < total:
        args.append(nox.os.arg(i))
        i = i + 1
    nox.os.exit(nyx.cli_app.execute(args))

cli_main()
