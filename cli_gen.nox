    nox.fs.write_string(path, "# Job handler: " + name + "\n# Register in jobs/worker.nox:\n# def " + sn + "_perform(payload_json: str) -> None:\n#     return None\n# registry.register(\"" + name + "\", " + sn + "_perform)\n")
    print("created: " + path)

def generate_channel(root: str, name: str) -> None:
    if len(name) == 0:
        raise CliGenError("usage: nyx generate channel <Name>")
    sn: str = snake(name)
    nox.fs.create_dir_all(_join(root, "app/channels"))
    path: str = _join(root, "app/channels/" + sn + ".nox")
    nox.fs.write_string(path, "# Cable channel: " + name + "\n# ch = nyx.cable.channel_memory(hub, \"" + sn + "\")\n# nyx.cable.channel_broadcast(ch, \"ping\", \"{}\")\n# WS: nyx.cable.ws_auth_broadcast_loop(ch, conn, application.db, secret, \"\")\n# PG:  nyx.cable.ws_auth_broadcast_loop_pg(ch, conn, nyx.app.pg(application), secret, \"\")\n# Ticket: nyx.cable.issue_ws_ticket(secret, sid, ch.name, 60)\n")
    print("created: " + path)

def _copy_tree(src: str, dst: str, app_name: str) -> None:
    nox.fs.create_dir_all(dst)
    names: list[str] = nox.fs.read_dir(src)
    i: int = 0
    while i < len(names):
        name: str = names[i]
        if name != "." and name != "..":
            sp: str = src + "/" + name
            dp: str = dst + "/" + name
            if nox.fs.is_dir(sp):
                _copy_tree(sp, dp, app_name)
            else:
                text_file: bool = nox.strings.ends_with(name, ".nox") or nox.strings.ends_with(name, ".json") or nox.strings.ends_with(name, ".html") or nox.strings.ends_with(name, ".md") or nox.strings.ends_with(name, ".sql")
                if text_file:
                    text: str = nox.fs.read_to_string(sp)
                    text = nox.strings.replace(text, "{{APP_NAME}}", app_name)
                    nox.fs.write_string(dp, text)
                else:
                    nox.fs.copy(sp, dp)
        i = i + 1

def generate_new(dest_parent: str, name: str, templates_root: str) -> None:
    if len(name) == 0:
        raise CliGenError("usage: nyx new <name>")
    src: str = templates_root + "/templates/app"
    if not nox.fs.is_dir(src):
        raise CliGenError("missing templates: " + src)
    dest: str = _join(dest_parent, name)
    if nox.fs.exists(dest):
        raise CliGenError("exists: " + dest)
    label: str = name
    parts: list[str] = nox.strings.split(name, "/")
    if len(parts) > 0:
        label = parts[len(parts) - 1]
    _copy_tree(src, dest, label)
    print("created: " + dest + "/")
    print("  cd " + dest + " && noxc fetch && NYX_ENV=development noxc run main.nox")
