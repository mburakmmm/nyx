    return "# Paste into setup(application). Imports stay at module scope.\n# import nyx.auth_engine\n# import nyx.auth_engine_pg\n# import nyx.auth_engine_mysql\n# import nyx.params\n# import nox.json\n# from nyx.auth_engine import AuthEngineError\n#\n# if application.dialect == \"postgres\":\n#     nyx.auth_engine_pg.ensure_schema(nyx.app.pg(application))\n# elif application.dialect == \"mysql\":\n#     nyx.auth_engine_mysql.ensure_schema(nyx.app.mysql(application))\n# else:\n#     nyx.auth_engine.ensure_schema(application.db)\n#\n# def auth_register(ctx: Context) -> HttpResponse:\n#     p: dict[str, str] = nyx.params.from_request(ctx.request)\n#     email: str = nyx.params.get(p, \"email\", \"\")\n#     password: str = nyx.params.get(p, \"password\", \"\")\n#     if len(email) == 0 or len(password) == 0:\n#         return nyx.ctrl.json(422, \"{\\\"error\\\":\\\"missing_fields\\\"}\")\n#     try:\n#         uid: int = 0\n#         if application.dialect == \"postgres\":\n#             uid = nyx.auth_engine_pg.register(nyx.app.pg(application), email, password)\n#         elif application.dialect == \"mysql\":\n#             uid = nyx.auth_engine_mysql.register(nyx.app.mysql(application), email, password)\n#         else:\n#             uid = nyx.auth_engine.register(application.db, email, password)\n#         nyx.auth_engine.login_session(uid)\n#         return nyx.ctrl.redirect(\"/\")\n#     except AuthEngineError as e:\n#         return nyx.ctrl.json(422, \"{\\\"error\\\":\" + nox.json.dump_string(e.message) + \"}\")\n#\n# def auth_login(ctx: Context) -> HttpResponse:\n#     p: dict[str, str] = nyx.params.from_request(ctx.request)\n#     email: str = nyx.params.get(p, \"email\", \"\")\n#     password: str = nyx.params.get(p, \"password\", \"\")\n#     if len(email) == 0 or len(password) == 0:\n#         return nyx.ctrl.json(422, \"{\\\"error\\\":\\\"missing_fields\\\"}\")\n#     try:\n#         uid: int = 0\n#         if application.dialect == \"postgres\":\n#             uid = nyx.auth_engine_pg.authenticate(nyx.app.pg(application), email, password)\n#         elif application.dialect == \"mysql\":\n#             uid = nyx.auth_engine_mysql.authenticate(nyx.app.mysql(application), email, password)\n#         else:\n#             uid = nyx.auth_engine.authenticate(application.db, email, password)\n#         nyx.auth_engine.login_session(uid)\n#         return nyx.ctrl.redirect(\"/\")\n#     except AuthEngineError as e:\n#         return nyx.ctrl.json(401, \"{\\\"error\\\":\" + nox.json.dump_string(e.message) + \"}\")\n#\n# def auth_logout(ctx: Context) -> HttpResponse:\n#     nyx.auth_engine.logout_session()\n#     return nyx.ctrl.redirect(\"/\")\n#\n# application.router.post(\"/register\", auth_register)\n# application.router.post(\"/login\", auth_login)\n# application.router.post(\"/logout\", auth_logout)\n"

def generate_auth(root: str) -> None:
    dirp: str = _join(root, "db/migrate")
    nox.fs.create_dir_all(dirp)
    nox.fs.create_dir_all(_join(root, "app/views/auth"))
    nox.fs.create_dir_all(_join(root, "config"))
    ts: str = stamp()
    base: str = dirp + "/" + ts + "_create_users"
    up: str = "CREATE TABLE IF NOT EXISTS users (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  email TEXT NOT NULL UNIQUE,\n  password_digest TEXT NOT NULL,\n  failed_attempts INTEGER NOT NULL DEFAULT 0,\n  locked_at_ms INTEGER NOT NULL DEFAULT 0,\n  reset_token TEXT NOT NULL DEFAULT '',\n  reset_sent_at_ms INTEGER NOT NULL DEFAULT 0\n);\nCREATE INDEX IF NOT EXISTS idx_users_reset_token ON users (reset_token);\n"
    down: str = "DROP TABLE IF EXISTS users;\n"
    pg: str = "CREATE TABLE IF NOT EXISTS users (\n  id BIGSERIAL PRIMARY KEY,\n  email TEXT NOT NULL UNIQUE,\n  password_digest TEXT NOT NULL,\n  failed_attempts INTEGER NOT NULL DEFAULT 0,\n  locked_at_ms BIGINT NOT NULL DEFAULT 0,\n  reset_token TEXT NOT NULL DEFAULT '',\n  reset_sent_at_ms BIGINT NOT NULL DEFAULT 0\n);\nCREATE INDEX IF NOT EXISTS idx_users_reset_token ON users (reset_token);\n"
    my: str = "CREATE TABLE IF NOT EXISTS users (\n  id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY,\n  email VARCHAR(255) NOT NULL,\n  password_digest TEXT NOT NULL,\n  failed_attempts INTEGER NOT NULL DEFAULT 0,\n  locked_at_ms BIGINT NOT NULL DEFAULT 0,\n  reset_token VARCHAR(255) NOT NULL DEFAULT '',\n  reset_sent_at_ms BIGINT NOT NULL DEFAULT 0,\n  UNIQUE KEY uniq_users_email (email)\n);\n"
    nox.fs.write_string(base + ".sql", up)
    nox.fs.write_string(base + ".down.sql", down)
    nox.fs.write_string(base + ".pg.sql", pg)
    nox.fs.write_string(base + ".pg.down.sql", down)
    nox.fs.write_string(base + ".mysql.sql", my)
    nox.fs.write_string(base + ".mysql.down.sql", down)
    snippet: str = _auth_snippet()
    nox.fs.write_string(_join(root, "config/auth_routes.nox.snippet"), snippet)
    print("created: " + base + ".sql")
    print("created: " + base + ".down.sql")
    print("created: " + base + ".pg.sql")
    print("created: " + base + ".pg.down.sql")
    print("created: " + base + ".mysql.sql")
    print("created: " + base + ".mysql.down.sql")
    print("created: config/auth_routes.nox.snippet")

def generate_mailer(root: str, name: str) -> None:
    if len(name) == 0:
        raise CliGenError("usage: nyx generate mailer <Name>")
    sn: str = snake(name)
    nox.fs.create_dir_all(_join(root, "app/mailers"))
    nox.fs.create_dir_all(_join(root, "app/views/mailers"))
    path: str = _join(root, "app/mailers/" + sn + ".nox")
    nox.fs.write_string(path, "# Mailer: " + name + "\n# import nyx.mailer\n# mail = nyx.mailer.mail_from_template(to, from_addr, subject, \"app/views/mailers/" + sn + ".txt\", ctx)\n# nyx.mailer.deliver(cfg, mail)\n")
    nox.fs.write_string(_join(root, "app/views/mailers/" + sn + ".txt"), "Hello {{name}},\n\nThis is the " + name + " mailer body.\n")
    print("created: " + path)

def generate_job(root: str, name: str) -> None:
    if len(name) == 0:
        raise CliGenError("usage: nyx generate job <Name>")
