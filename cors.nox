# nyx.cors - Router before/after CORS ara katmanları.
#
# import nyx.cors

from nox.http import HttpResponse
from nox.router import Context
import nyx.response

class CorsError(Exception):
    def __init__(self: CorsError, message: str) -> None:
        self.message = message

class CorsConfig:
    # Fetch/CORS spesifikasyonu 'Access-Control-Allow-Origin: *' ile
    # 'Access-Control-Allow-Credentials: true'nin BIRLIKTE kullanimini
    # ZATEN tarayici tarafinda REDDEDER (kimlik-bilgili istekler "*" origin'i
    # KABUL ETMEZ) - ama bu SESSIZ bir tarayici-tarafi basarisizliktir
    # (gelistirici curl/Postman ile test EDERKEN "calisiyor" SANIR, gercek
    # tarayicida CORS hatasi ALIR). Bu yuzden burada YAPILANDIRMA ANINDA
    # ACIKCA CorsError firlatilir.
    def __init__(self: CorsConfig, origin: str, methods: str, headers: str, credentials: bool) -> None:
        if credentials and origin == "*":
            raise CorsError("credentials=true ile origin='*' birlikte kullanilamaz (CORS guvenlik ihlali)")
        self.origin = origin
        self.methods = methods
        self.headers = headers
        self.credentials = credentials

def default_config() -> CorsConfig:
    return CorsConfig("*", "GET,POST,PUT,DELETE,OPTIONS", "Authorization,Content-Type", False)

def _apply_cors_headers(cfg: CorsConfig, resp: HttpResponse) -> HttpResponse:
    r1: HttpResponse = nyx.response.with_header(resp, "Access-Control-Allow-Origin", cfg.origin)
    r2: HttpResponse = nyx.response.with_header(r1, "Access-Control-Allow-Methods", cfg.methods)
    r3: HttpResponse = nyx.response.with_header(r2, "Access-Control-Allow-Headers", cfg.headers)
    r4: HttpResponse = nyx.response.with_header(r3, "Vary", "Origin")
    if cfg.credentials:
        return nyx.response.with_header(r4, "Access-Control-Allow-Credentials", "true")
    return r4

def before_handler(cfg: CorsConfig) -> (Context) -> HttpResponse | None:
    def handler(ctx: Context) -> HttpResponse | None:
        if ctx.request.method == "OPTIONS":
            headers: dict[str, str] = {}
            headers["Access-Control-Allow-Origin"] = cfg.origin
            headers["Access-Control-Allow-Methods"] = cfg.methods
            headers["Access-Control-Allow-Headers"] = cfg.headers
            headers["Access-Control-Max-Age"] = "86400"
            headers["Vary"] = "Origin"
            if cfg.credentials:
                headers["Access-Control-Allow-Credentials"] = "true"
            return HttpResponse(204, "", headers)
        return None
    return handler

def after_handler(cfg: CorsConfig) -> (Context, HttpResponse) -> HttpResponse:
    def handler(ctx: Context, resp: HttpResponse) -> HttpResponse:
        return _apply_cors_headers(cfg, resp)
    return handler
