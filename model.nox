# nyx.model - SQLite satır yardımcıları (basit, Rails-tarzı his).
#
# import nyx.model
# from nox.sqlite import Connection
#
# # Tercih edilen (typed) API:
# attrs: Attributes = nyx.model.attributes()
# nyx.model.set_str(attrs, "email", "a@b.c")
# nyx.model.set_str(attrs, "name", "A")
# id: int = nyx.model.create_attrs(db, "users", attrs)
#
# # Eski JSON string API (uyumluluk icin duruyor):
# id: int = nyx.model.create(db, "users", "{\"email\":\"a@b.c\",\"name\":\"A\"}")
#
# u: Record | None = nyx.model.find(db, "users", 1)
# bio: str | None = u.get_opt("bio")   # SQL NULL -> None
# name: str = u.get_or("name", "")

import nox.sqlite
import nox.json
import nox.strings
from nox.sqlite import Connection, Statement, SqliteError
from nox.json import JsonError
from nox.db import Row

class ModelError:
    def __init__(self: ModelError, message: str) -> None:
        self.message = message

class Record:
    def __init__(self: Record, row: Row) -> None:
        self.row = row

    def _col_index(self: Record, name: str) -> int:
        i: int = 0
        n: int = self.row.column_count()
        while i < n:
            if self.row.column_name(i) == name:
                return i
            i = i + 1
        raise ModelError("sutun yok: " + name)

    # Uyumluluk: SQL NULL -> "" (eski davranis). Yeni kod icin get_opt/get_or.
    def get(self: Record, name: str) -> str:
        i: int = self._col_index(name)
        if self.row.is_null(i):
            return ""
        return self.row.get_str(i)

    def is_null(self: Record, name: str) -> bool:
        return self.row.is_null(self._col_index(name))

    # Sutun yoksa ModelError. SQL NULL ise None.
    def get_opt(self: Record, name: str) -> str | None:
        i: int = self._col_index(name)
        if self.row.is_null(i):
            return None
        return self.row.get_str(i)

    def get_or(self: Record, name: str, fallback: str) -> str:
        i: int = self._col_index(name)
        if self.row.is_null(i):
            return fallback
        out: str = self.row.get_str(i)
        return out

    def get_int(self: Record, name: str) -> int:
        i: int = self._col_index(name)
        if self.row.is_null(i):
            raise ModelError("sutun NULL, get_int_opt kullanin: " + name)
        out: int = self.row.get_int(i)
        return out

    def get_int_opt(self: Record, name: str) -> int | None:
        i: int = self._col_index(name)
        if self.row.is_null(i):
            return None
        return self.row.get_int(i)

    def get_int_or(self: Record, name: str, fallback: int) -> int:
        i: int = self._col_index(name)
        if self.row.is_null(i):
            return fallback
        out: int = self.row.get_int(i)
        return out

    def has(self: Record, name: str) -> bool:
        i: int = 0
        n: int = self.row.column_count()
        while i < n:
            if self.row.column_name(i) == name:
                return True
            i = i + 1
        return False

# Uyumluluk sarmalayicilari - tercih edilen API: record.get_opt / get_int_opt.
def get_opt(record: Record, name: str) -> str | None:
    return record.get_opt(name)

def get_int_opt(record: Record, name: str) -> int | None:
    return record.get_int_opt(name)

def _check_ident(name: str) -> None:
    if len(name) == 0:
        raise ModelError("bos kimlik")
    i: int = 0
    while i < len(name):
        b: int = nox.strings.byte_at(name, i)
        ok: bool = False
        if b >= 48 and b <= 57:
            ok = i > 0
        if b >= 65 and b <= 90:
            ok = True
        if b >= 97 and b <= 122:
            ok = True
        if b == 95:
            ok = True
        if not ok:
            raise ModelError("gecersiz kimlik: " + name)
        i = i + 1

def _quote_ident(name: str) -> str:
    _check_ident(name)
    return "\"" + name + "\""

def _rows_to_records(rows: list[Row]) -> list[Record]:
    out: list[Record] = []
    i: int = 0
    while i < len(rows):
        out.append(Record(rows[i]))
        i = i + 1
    return out

def find(db: Connection, table: str, id: int) -> Record | None:
    _check_ident(table)
    sql: str = "SELECT * FROM " + _quote_ident(table) + " WHERE \"id\" = ?"
    stmt: Statement = db.prepare(sql)
    stmt.bind_int(0, id)
    rows: list[Row] = stmt.query()
    if len(rows) == 0:
        return None
    return Record(rows[0])

def all(db: Connection, table: str) -> list[Record]:
    _check_ident(table)
    sql: str = "SELECT * FROM " + _quote_ident(table)
    rows: list[Row] = db.query(sql)
    return _rows_to_records(rows)

# Tek eşitlik filtresi: WHERE col = ?
def where(db: Connection, table: str, col: str, value: str) -> list[Record]:
    _check_ident(table)
    _check_ident(col)
    sql: str = "SELECT * FROM " + _quote_ident(table) + " WHERE " + _quote_ident(col) + " = ?"
    stmt: Statement = db.prepare(sql)
    stmt.bind_str(0, value)
    return _rows_to_records(stmt.query())

def where_int(db: Connection, table: str, col: str, value: int) -> list[Record]:
    _check_ident(table)
    _check_ident(col)
    sql: str = "SELECT * FROM " + _quote_ident(table) + " WHERE " + _quote_ident(col) + " = ?"
    stmt: Statement = db.prepare(sql)
    stmt.bind_int(0, value)
    return _rows_to_records(stmt.query())

def destroy(db: Connection, table: str, id: int) -> None:
    _check_ident(table)
    sql: str = "DELETE FROM " + _quote_ident(table) + " WHERE \"id\" = ?"
    stmt: Statement = db.prepare(sql)
    stmt.bind_int(0, id)
    stmt.execute()

class Attrs:
    def __init__(self: Attrs, keys: list[str], vals: list[str], nulls: list[bool]) -> None:
        self.keys = keys
        self.vals = vals
        self.nulls = nulls

# Typed attribute builder - JSON string birlestirme yerine tercih edilen API.
# kinds[i]: "str" | "int" | "bool" | "null"
class Attributes:
    keys: list[str]
    kinds: list[str]
    str_vals: list[str]
    int_vals: list[int]
    bool_vals: list[bool]

    def __init__(self: Attributes) -> None:
        self.keys = []
        self.kinds = []
        self.str_vals = []
        self.int_vals = []
        self.bool_vals = []

def attributes() -> Attributes:
    return Attributes()

def _validate_attrs_shape(attrs: Attributes) -> None:
    n: int = len(attrs.keys)
    if len(attrs.kinds) != n:
        raise ModelError("corrupt Attributes: kinds length mismatch")
    if len(attrs.str_vals) != n:
        raise ModelError("corrupt Attributes: str_vals length mismatch")
    if len(attrs.int_vals) != n:
        raise ModelError("corrupt Attributes: int_vals length mismatch")
    if len(attrs.bool_vals) != n:
        raise ModelError("corrupt Attributes: bool_vals length mismatch")

def _attrs_find(attrs: Attributes, key: str) -> int:
    i: int = 0
    while i < len(attrs.keys):
        if attrs.keys[i] == key:
            return i
        i = i + 1
    return -1

def _attrs_set(
    attrs: Attributes,
    key: str,
    kind: str,
    str_val: str,
    int_val: int,
    bool_val: bool
) -> None:
    _check_ident(key)
    idx: int = _attrs_find(attrs, key)
    if idx >= 0:
        kinds: list[str] = attrs.kinds
        strs: list[str] = attrs.str_vals
        ints: list[int] = attrs.int_vals
        bools: list[bool] = attrs.bool_vals
        kinds[idx] = kind
        strs[idx] = str_val
        ints[idx] = int_val
        bools[idx] = bool_val
        attrs.kinds = kinds
        attrs.str_vals = strs
        attrs.int_vals = ints
        attrs.bool_vals = bools
        return
    keys: list[str] = attrs.keys
    kinds2: list[str] = attrs.kinds
    strs2: list[str] = attrs.str_vals
    ints2: list[int] = attrs.int_vals
    bools2: list[bool] = attrs.bool_vals
    keys.append(key)
    kinds2.append(kind)
    strs2.append(str_val)
    ints2.append(int_val)
    bools2.append(bool_val)
    attrs.keys = keys
    attrs.kinds = kinds2
    attrs.str_vals = strs2
    attrs.int_vals = ints2
    attrs.bool_vals = bools2

def set_str(attrs: Attributes, key: str, value: str) -> None:
    _attrs_set(attrs, key, "str", value, 0, False)

def set_int(attrs: Attributes, key: str, value: int) -> None:
    _attrs_set(attrs, key, "int", "", value, False)

def set_bool(attrs: Attributes, key: str, value: bool) -> None:
    _attrs_set(attrs, key, "bool", "", 0, value)

def set_null(attrs: Attributes, key: str) -> None:
    _attrs_set(attrs, key, "null", "", 0, False)

def _bind_typed(stmt: Statement, attrs: Attributes) -> None:
    _validate_attrs_shape(attrs)
    j: int = 0
    while j < len(attrs.keys):
        kind: str = attrs.kinds[j]
        if kind == "null":
            stmt.bind_null(j)
        elif kind == "int":
            stmt.bind_int(j, attrs.int_vals[j])
        elif kind == "bool":
            if attrs.bool_vals[j]:
                stmt.bind_int(j, 1)
            else:
                stmt.bind_int(j, 0)
        elif kind == "str":
            stmt.bind_str(j, attrs.str_vals[j])
        else:
            raise ModelError("bilinmeyen attribute tipi: " + kind)
        j = j + 1

def create_attrs(db: Connection, table: str, attrs: Attributes) -> int:
    _check_ident(table)
    _validate_attrs_shape(attrs)
    if len(attrs.keys) == 0:
        raise ModelError("bos attrs")
    cols: str = ""
    placeholders: str = ""
    i: int = 0
    while i < len(attrs.keys):
        if i > 0:
            cols = cols + ", "
            placeholders = placeholders + ", "
        cols = cols + _quote_ident(attrs.keys[i])
        placeholders = placeholders + "?"
        i = i + 1
    sql: str = "INSERT INTO " + _quote_ident(table) + " (" + cols + ") VALUES (" + placeholders + ")"
    stmt: Statement = db.prepare(sql)
    _bind_typed(stmt, attrs)
    stmt.execute()
    return db.last_insert_rowid()

def update_attrs(db: Connection, table: str, id: int, attrs: Attributes) -> None:
    _check_ident(table)
    _validate_attrs_shape(attrs)
    if len(attrs.keys) == 0:
        raise ModelError("bos attrs")
    sets: str = ""
    i: int = 0
    while i < len(attrs.keys):
        if i > 0:
            sets = sets + ", "
        sets = sets + _quote_ident(attrs.keys[i]) + " = ?"
        i = i + 1
    sql: str = "UPDATE " + _quote_ident(table) + " SET " + sets + " WHERE \"id\" = ?"
    stmt: Statement = db.prepare(sql)
    _bind_typed(stmt, attrs)
    stmt.bind_int(len(attrs.keys), id)
    stmt.execute()

# Yalnizca string alanlar icin kisa yol (JSON birlestirme yok).
def create_fields(db: Connection, table: str, keys: list[str], vals: list[str]) -> int:
    if len(keys) != len(vals):
        raise ModelError("keys ve vals ayni uzunlukta olmali")
    attrs: Attributes = attributes()
    i: int = 0
    while i < len(keys):
        set_str(attrs, keys[i], vals[i])
        i = i + 1
    return create_attrs(db, table, attrs)

def validate_attrs_required(attrs: Attributes, fields: list[str]) -> list[str]:
    errors: list[str] = []
    fi: int = 0
    while fi < len(fields):
        name: str = fields[fi]
        found: bool = False
        empty: bool = False
        ai: int = 0
        while ai < len(attrs.keys):
            if attrs.keys[ai] == name:
                found = True
                kind: str = attrs.kinds[ai]
                if kind == "null":
                    empty = True
                if kind == "str" and len(attrs.str_vals[ai]) == 0:
                    empty = True
            ai = ai + 1
        if not found:
            errors.append("eksik zorunlu alan: " + name)
        else:
            if empty:
                errors.append("alan bos olamaz: " + name)
        fi = fi + 1
    return errors

def validate_attrs_max_length(attrs: Attributes, field: str, max_len: int) -> list[str]:
    errors: list[str] = []
    i: int = 0
    while i < len(attrs.keys):
        if attrs.keys[i] == field:
            if attrs.kinds[i] == "str" and len(attrs.str_vals[i]) > max_len:
                errors.append(field + " too long (max " + str(max_len) + ")")
            return errors
        i = i + 1
    return errors

def create_attrs_valid(db: Connection, table: str, attrs: Attributes, required_fields: list[str]) -> int:
    errors: list[str] = validate_attrs_required(attrs, required_fields)
    if len(errors) > 0:
        raise ModelError("dogrulama basarisiz: " + nox.strings.join(errors, "; "))
    return create_attrs(db, table, attrs)

# 'keys[i]'in degerini tasir: 'nulls[i]' True ise deger JSON 'null'dur
# (baglanirken 'vals[i]' ("") YOK SAYILIP 'Statement.bind_null' kullanilir),
# aksi halde 'vals[i]' (her zaman metin - sayilar da metin olarak) baglanir.
def _json_keys_vals(attrs_json: str) -> Attrs:
    v: JsonValue = nox.json.decode(attrs_json)
    if not nox.json.is_object(v):
        raise ModelError("attrs bir JSON nesnesi olmali")
    keys: list[str] = []
    vals: list[str] = []
    nulls: list[bool] = []
    i: int = 0
    n: int = nox.json.object_len(v)
    while i < n:
        key: str = nox.json.object_key(v, i)
        _check_ident(key)
        val: JsonValue = nox.json.object_value(v, i)
        keys.append(key)
        if nox.json.is_null(val):
            vals.append("")
            nulls.append(True)
        elif nox.json.is_string(val):
            vals.append(nox.json.as_string(val))
            nulls.append(False)
        elif nox.json.is_number(val):
            vals.append(nox.json.encode(val))
            nulls.append(False)
        elif nox.json.is_bool(val):
            if nox.json.as_bool(val):
                vals.append("1")
            else:
                vals.append("0")
            nulls.append(False)
        else:
            raise ModelError("desteklenmeyen attrs tipi: " + key)
        i = i + 1
    return Attrs(keys, vals, nulls)

def create(db: Connection, table: str, attrs_json: str) -> int:
    _check_ident(table)
    attrs: Attrs = _json_keys_vals(attrs_json)
    if len(attrs.keys) == 0:
        raise ModelError("bos attrs")
    cols: str = ""
    placeholders: str = ""
    i: int = 0
    while i < len(attrs.keys):
        if i > 0:
            cols = cols + ", "
            placeholders = placeholders + ", "
        cols = cols + _quote_ident(attrs.keys[i])
        placeholders = placeholders + "?"
        i = i + 1
    sql: str = "INSERT INTO " + _quote_ident(table) + " (" + cols + ") VALUES (" + placeholders + ")"
    stmt: Statement = db.prepare(sql)
    j: int = 0
    while j < len(attrs.keys):
        if attrs.nulls[j]:
            stmt.bind_null(j)
        else:
            stmt.bind_str(j, attrs.vals[j])
        j = j + 1
    stmt.execute()
    return db.last_insert_rowid()

def update(db: Connection, table: str, id: int, attrs_json: str) -> None:
    _check_ident(table)
    attrs: Attrs = _json_keys_vals(attrs_json)
    if len(attrs.keys) == 0:
        raise ModelError("bos attrs")
    sets: str = ""
    i: int = 0
    while i < len(attrs.keys):
        if i > 0:
            sets = sets + ", "
        sets = sets + _quote_ident(attrs.keys[i]) + " = ?"
        i = i + 1
    sql: str = "UPDATE " + _quote_ident(table) + " SET " + sets + " WHERE \"id\" = ?"
    stmt: Statement = db.prepare(sql)
    j: int = 0
    while j < len(attrs.keys):
        if attrs.nulls[j]:
            stmt.bind_null(j)
        else:
            stmt.bind_str(j, attrs.vals[j])
        j = j + 1
    stmt.bind_int(len(attrs.keys), id)
    stmt.execute()

# 'fn'i tek bir SQLite islemi (transaction) icinde calistirir: basariliysa
# COMMIT, hata olursa ROLLBACK. Nox >= 1.9: bilinen turler yeniden firlatilir;
# digerleri 'ModelError("transaction failed")' olarak sarilir.
def transaction(db: Connection, fn: (Connection) -> None) -> None:
    db.execute("BEGIN")
    try:
        fn(db)
        db.execute("COMMIT")
    except ModelError as e:
        db.execute("ROLLBACK")
        raise ModelError(e.message)
    except SqliteError as e:
        db.execute("ROLLBACK")
        raise SqliteError(e.message)
    except JsonError as e:
        db.execute("ROLLBACK")
        raise JsonError(e.message)
    except ValueError as e:
        db.execute("ROLLBACK")
        raise ValueError(e.message)
    except KeyError as e:
        db.execute("ROLLBACK")
        raise KeyError(e.message)
    except IndexError as e:
        db.execute("ROLLBACK")
        raise IndexError(e.message)
    except:
        db.execute("ROLLBACK")
        raise ModelError("transaction failed")

def _count_char(s: str, target: str) -> int:
    count: int = 0
    i: int = 0
    while i < len(s):
        if s[i] == target:
            count = count + 1
        i = i + 1
    return count

# 'where_clause' icinde YALNIZCA harf/rakam/alt cizgi/bosluk/nokta/virgul/
# parantez/'?'/karsilastirma operatorleri ('= < > !') kabul edilir - tirnak
# isareti, noktali virgul, yorum satiri gibi SQL enjeksiyonuna acik
# karakterler REDDEDILIR. Degerler HER ZAMAN '?' ile baglanir (asla dogrudan
# string birlestirme ile SQL'e gomulmez).
def _check_where_clause(clause: str) -> None:
    if len(clause) == 0:
        raise ModelError("where_clause bos olamaz")
    i: int = 0
    n: int = len(clause)
    while i < n:
        b: int = nox.strings.byte_at(clause, i)
        ok: bool = False
        if b >= 48 and b <= 57:
            ok = True
        if b >= 65 and b <= 90:
            ok = True
        if b >= 97 and b <= 122:
            ok = True
        if b == 95:
            ok = True
        if b == 32:
            ok = True
        if b == 40 or b == 41:
            ok = True
        if b == 63:
            ok = True
        if b == 46:
            ok = True
        if b == 44:
            ok = True
        if b == 61 or b == 60 or b == 62 or b == 33:
            ok = True
        if not ok:
            raise ModelError("where_clause icinde izin verilmeyen karakter: " + clause)
        i = i + 1

# 'where_clause' icindeki HER '?' yerine 'binds'teki degeri sirayla baglar
# (SQL enjeksiyonuna karsi guvenli - degerler asla metne gomulmez). Ornek:
# 'where_sql(db, "posts", "user_id = ? AND published = ?", ["1", "1"])'.
def where_sql(db: Connection, table: str, where_clause: str, binds: list[str]) -> list[Record]:
    _check_ident(table)
    _check_where_clause(where_clause)
    placeholder_count: int = _count_char(where_clause, "?")
    if placeholder_count != len(binds):
        raise ModelError("bind sayisi '?' sayisiyla eslesmiyor")
    sql: str = "SELECT * FROM " + _quote_ident(table) + " WHERE " + where_clause
    stmt: Statement = db.prepare(sql)
    i: int = 0
    while i < len(binds):
        stmt.bind_str(i, binds[i])
        i = i + 1
    return _rows_to_records(stmt.query())

# 'order_col'a gore siralanmis, en fazla 'limit' satir doner.
def order_limit(db: Connection, table: str, order_col: str, desc: bool, limit: int) -> list[Record]:
    _check_ident(table)
    _check_ident(order_col)
    if limit < 0:
        raise ModelError("limit negatif olamaz")
    direction: str = "ASC"
    if desc:
        direction = "DESC"
    sql: str = (
        "SELECT * FROM " + _quote_ident(table) + " ORDER BY " + _quote_ident(order_col) +
        " " + direction + " LIMIT " + str(limit)
    )
    rows: list[Row] = db.query(sql)
    return _rows_to_records(rows)

def _find_field(v: JsonValue, name: str) -> JsonValue | None:
    i: int = 0
    n: int = nox.json.object_len(v)
    while i < n:
        if nox.json.object_key(v, i) == name:
            return nox.json.object_value(v, i)
        i = i + 1
    return None

# 'fields'teki her alanin 'attrs_json'da MEVCUT, null OLMAYAN ve (metinse)
# BOS OLMAYAN bir degeri olup olmadigini dogrular. Hata mesajlari listesini
# doner (bossa gecerli).
def validate_required(attrs_json: str, fields: list[str]) -> list[str]:
    errors: list[str] = []
    v: JsonValue = nox.json.decode(attrs_json)
    if not nox.json.is_object(v):
        errors.append("attrs bir JSON nesnesi olmali")
        return errors
    i: int = 0
    while i < len(fields):
        name: str = fields[i]
        found: JsonValue | None = _find_field(v, name)
        if found == None:
            errors.append("eksik zorunlu alan: " + name)
        else:
            if nox.json.is_null(found):
                errors.append("alan bos olamaz: " + name)
            else:
                if nox.json.is_string(found) and len(nox.json.as_string(found)) == 0:
                    errors.append("alan bos olamaz: " + name)
        i = i + 1
    return errors

# 'create'in dogrulamali hali (Rails'in 'create!'ine benzer): 'required_fields'
# eksik/boşsa ModelError firlatir, aksi halde normal 'create'e devreder.
def create_valid(db: Connection, table: str, attrs_json: str, required_fields: list[str]) -> int:
    errors: list[str] = validate_required(attrs_json, required_fields)
    if len(errors) > 0:
        raise ModelError("dogrulama basarisiz: " + nox.strings.join(errors, "; "))
    return create(db, table, attrs_json)

def validate_attrs_unique(db: Connection, table: str, col: str, value: str, exclude_id: int) -> list[str]:
    _check_ident(table)
    _check_ident(col)
    errors: list[str] = []
    sql: str = "SELECT \"id\" FROM " + _quote_ident(table) + " WHERE " + _quote_ident(col) + " = ?"
    stmt: Statement = db.prepare(sql)
    stmt.bind_str(0, value)
    rows: list[Row] = stmt.query()
    i: int = 0
    while i < len(rows):
        id: int = rows[i].get_int(0)
        if exclude_id < 0 or id != exclude_id:
            errors.append(col + " already taken")
            return errors
        i = i + 1
    return errors
