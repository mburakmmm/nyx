# nyx.security - güvenlik yanıt başlıkları + TLS notu (terminate reverse proxy).
#
# Sunucu tarafı TLS Nox stdlib'de yok; production'da nginx/caddy/traefik
# arkasına alın. Bu modül uygulama katmanı güvenlik başlıklarını ekler.

from nox.http import HttpResponse
from nox.router import Context
import nyx.response
import nyx.runtime
from nyx.config import Config

# Varsayilan (sabit) production CSP'si - 'cfg.csp' BOSSA ve 'cfg.
# is_production()' True'ysa kullanilir (bkz. 'nyx.config.Config.csp'
# belge notu).
def _default_production_csp() -> str:
    return "default-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

# Temel guvenlik basliklari HER ORTAMDA (development/test/production)
# KOSULSUZ eklenir - bunlar tarayici-tarafi savunmalardir ve production'a
# OZGU DEGILDIR. Tek dict + with_headers: O(n) kopya (onceki 4-5x with_header degil).
def headers_after(cfg: Config) -> (Context, HttpResponse) -> HttpResponse:
    def handler(ctx: Context, resp: HttpResponse) -> HttpResponse:
        extras: dict[str, str] = {}
        extras["X-Content-Type-Options"] = "nosniff"
        extras["X-Frame-Options"] = "SAMEORIGIN"
        extras["Referrer-Policy"] = "strict-origin-when-cross-origin"
        extras["X-XSS-Protection"] = "0"
        if cfg.request_id:
            req_id: str = nyx.runtime.request_id()
            if len(req_id) > 0:
                extras["X-Request-Id"] = req_id
        csp: str = cfg.csp
        if len(csp) == 0 and cfg.is_production():
            csp = _default_production_csp()
        if len(csp) > 0:
            extras["Content-Security-Policy"] = csp
        if cfg.is_production():
            extras["Strict-Transport-Security"] = "max-age=31536000; includeSubDomains"
        return nyx.response.with_headers(resp, extras)
    return handler
