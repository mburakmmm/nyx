# nyx.runtime — istek-kapsamli (ambient/thread-local benzeri) durum.
#
# ONEMLI DIL KISITI: Nox'ta modul-duzeyi (top-level) degiskenler HICBIR
# fonksiyon/metod govdesinden GORULEMEZ (yalnizca ust-duzey script
# ifadelerinden erisilebilirler) — bu yuzden GERCEK bir surec-capinda
# "su anki istek" durumu burada nox.os.set_var/nox.os.getenv (PROSES ORTAM
# DEGISKENLERI, gercek bir global depo) UZERINDEN saklanir. `nox.router`in
# `Context`i de calisma zamaninda yeni alan KAZANAMADIGINDAN (bkz. nyx
# dil kisitlari), session/current_user'i tasimanin BASKA pratik bir yolu
# yoktur. Bu tasarim, nyx.app.dispatch'in TEK bir istegi UCTAN UCA senkron
# isledigi (thread/fiber arasi PAYLASIM olmadigi) varsayimina dayanir.
#
# `current()` artik BIR SNAPSHOT (o anki degerlerin KOPYASI) doner —
# donen `RequestBag` nesnesinin alanlarini DOGRUDAN degistirmek ARTIK
# KALICI DEGILDIR (env degiskenlerine geri YAZILMAZ). Durumu degistirmek
# icin bu modulun `set_*`/`load_*`/`touch_*` fonksiyonlarini kullanin.

import nox.os
from nox.os import OsError
import nox.strings
import nyx.flash

# NOT: Kurucu (__init__) PARAMETRE adlari, bu modulun ASAGIDAKI
# `session_json()`/`has_session()`/`locale()`/`request_id()`/`started_ms()`
# GETTER FONKSIYONLARIYLA KASITLI OLARAK AYNI DEGIL (bkz. `sj`/`hs`/`loc`/
# `rid`/`sms`) — bir parametrenin modul-duzeyinde AYNI ada sahip bir
# fonksiyonla CAKISMASI, o fonksiyon/metod GERCEKTEN COGENDIR (codegen)
# EDILDIGINDE derleyicinin "nested function/class definition" DESTEKLENMEYEN
# bir yapi URETMESINE yol acan GERCEK bir derleyici hatasidir (yalnizca
# `noxc check`te DEGIL, yalnizca `noxc build`/`test` COGENDIR asamasinda
# ORTAYA CIKAR — bkz. proje notlari).
class RequestBag:
    def __init__(
        self: RequestBag,
        sj: str,
        session_dirty: bool,
        hs: bool,
        user_id: str,
        user_payload: str,
        has_user: bool,
        loc: str,
        rid: str,
        sms: int
    ) -> None:
        self.session_json = sj
        self.session_dirty = session_dirty
        self.has_session = hs
        self.user_id = user_id
        self.user_payload = user_payload
        self.has_user = has_user
        self.locale = loc
        self.request_id = rid
        self.started_ms = sms

class RuntimeError:
    def __init__(self: RuntimeError, message: str) -> None:
        self.message = message

def _key(name: str) -> str:
    return "NYX_RT_" + name

def _get(name: str, default: str) -> str:
    try:
        return nox.os.getenv(_key(name))
    except OsError:
        return default

def _put(name: str, value: str) -> None:
    nox.os.set_var(_key(name), value)

def _get_bool(name: str, default: bool) -> bool:
    raw: str = _get(name, "")
    if len(raw) == 0:
        return default
    return raw == "1"

def _put_bool(name: str, value: bool) -> None:
    if value:
        _put(name, "1")
    else:
        _put(name, "0")

def _get_int(name: str, default: int) -> int:
    raw: str = _get(name, "")
    if len(raw) == 0:
        return default
    return int(raw)

def is_active() -> bool:
    return _get_bool("ACTIVE", False)

# TUM istek durumunu varsayilanlara doner (aktif DEGIL).
def reset() -> None:
    _put_bool("ACTIVE", False)
    _put("SESSION_JSON", "{}")
    _put_bool("SESSION_DIRTY", False)
    _put_bool("HAS_SESSION", False)
    _put("USER_ID", "")
    _put("USER_PAYLOAD", "")
    _put_bool("HAS_USER", False)
    _put("LOCALE", "")
    _put("REQUEST_ID", "")
    _put("STARTED_MS", "0")
    _put("REQUEST_TARGET", "")
    _put("HDR_KEYS", "")

# Yeni bir istek icin durumu baslatir (nyx.app.dispatch tarafindan HER
# istegin basinda cagrilir).
#
# NOT: Parametre adlari KASITLI OLARAK asagidaki `locale()`/`request_id()`/
# `started_ms()` getter FONKSIYONLARIYLA AYNI ADI TASIMAZ (`req_id`/
# `start_ms`/`loc`) — Nox derleyicisinde modul-duzeyi bir fonksiyonla AYNI
# ada sahip bir parametrenin, o modul BASKA bir dosyadan BAGIMLILIK olarak
# IMPORT EDILDIGINDE (yalnizca `noxc check`in kendi dosyasi olarak
# calistirilmasinda DEGIL) parametrenin turunu fonksiyonun turuyle
# KARISTIRDIGI GERCEK bir derleyici hatasi GOZLEMLENDI (bkz. proje notlari).
def begin(req_id: str, start_ms: int, loc: str) -> RequestBag:
    _put_bool("ACTIVE", True)
    _put("SESSION_JSON", "{}")
    _put_bool("SESSION_DIRTY", False)
    _put_bool("HAS_SESSION", False)
    _put("USER_ID", "")
    _put("USER_PAYLOAD", "")
    _put_bool("HAS_USER", False)
    _put("LOCALE", loc)
    _put("REQUEST_ID", req_id)
    _put("STARTED_MS", str(start_ms))
    _put("REQUEST_TARGET", "")
    _put("HDR_KEYS", "")
    return current()

def end() -> None:
    reset()

def set_request_target(target: str) -> None:
    _put("REQUEST_TARGET", target)

def request_target() -> str:
    return _get("REQUEST_TARGET", "")

# Tracks response header names for with_header (dict key iteration yok).
def track_header_key(key: str) -> None:
    raw: str = _get("HDR_KEYS", "")
    if len(raw) == 0:
        _put("HDR_KEYS", key)
        return
    parts: list[str] = nox.strings.split(raw, "\n")
    i: int = 0
    while i < len(parts):
        if parts[i] == key:
            return
        i = i + 1
    _put("HDR_KEYS", raw + "\n" + key)

def tracked_header_keys() -> list[str]:
    raw: str = _get("HDR_KEYS", "")
    if len(raw) == 0:
        return []
    return nox.strings.split(raw, "\n")

def clear_tracked_headers() -> None:
    _put("HDR_KEYS", "")

# `begin()` HIC CAGRILMAMISSA (ör. bir middleware'i `nyx.app.dispatch`
# DISINDA, dogrudan bir birim testinde cagirirken) BILE cokmemek icin
# durumu SESSIZCE baslatir — eski davranis (RuntimeError firlatmak)
# gereksiz KIRILGANDI.
def current() -> RequestBag:
    if not is_active():
        _put_bool("ACTIVE", True)
    return RequestBag(
        _get("SESSION_JSON", "{}"),
        _get_bool("SESSION_DIRTY", False),
        _get_bool("HAS_SESSION", False),
        _get("USER_ID", ""),
        _get("USER_PAYLOAD", ""),
        _get_bool("HAS_USER", False),
        _get("LOCALE", ""),
        _get("REQUEST_ID", ""),
        _get_int("STARTED_MS", 0)
    )

# `nyx.app`in cookie'den YUKLEDIGI oturum verisini isaretler — kullanicinin
# KENDI degisikligi OLMADIGINDAN `session_dirty` DOKUNULMAZ (Set-Cookie
# gereksiz yere yeniden yazilmasin).
def load_session(data_json: str) -> None:
    _put("SESSION_JSON", data_json)
    _put_bool("HAS_SESSION", True)

def set_session(data_json: str) -> None:
    _put("SESSION_JSON", data_json)
    _put_bool("HAS_SESSION", True)
    _put_bool("SESSION_DIRTY", True)

def session_json() -> str:
    return _get("SESSION_JSON", "{}")

def has_session() -> bool:
    return _get_bool("HAS_SESSION", False)

def is_session_dirty() -> bool:
    return _get_bool("SESSION_DIRTY", False)

def touch_session() -> None:
    _put_bool("SESSION_DIRTY", True)

# Oturum sabitleme (session fixation) korumasi: giris/yetki DEGISIMINDE
# cagirilir — veriyi DEGISTIRMEZ, sadece `session_dirty`yi isaretler, boylece
# `nyx.app`in `_session_after`i `nyx.session.create`i (HER cagrildiginda
# YENI bir `exp` + imza uretir) YENIDEN calistirip Set-Cookie'yi YENI bir
# degerle yeniden yazar (bkz. `nyx.session.regenerate`/`rotate`).
def cycle_session() -> None:
    touch_session()

def set_user(user_id: str, payload_json: str) -> None:
    _put("USER_ID", user_id)
    _put("USER_PAYLOAD", payload_json)
    _put_bool("HAS_USER", True)

def clear_user() -> None:
    _put("USER_ID", "")
    _put("USER_PAYLOAD", "")
    _put_bool("HAS_USER", False)

def current_user_id() -> str:
    return _get("USER_ID", "")

def current_user_payload() -> str:
    return _get("USER_PAYLOAD", "")

def signed_in() -> bool:
    return _get_bool("HAS_USER", False)

def request_id() -> str:
    return _get("REQUEST_ID", "")

def started_ms() -> int:
    return _get_int("STARTED_MS", 0)

def locale() -> str:
    return _get("LOCALE", "")

def flash_set(key: str, message: str) -> None:
    updated: str = nyx.flash.set(session_json(), key, message)
    _put("SESSION_JSON", updated)
    _put_bool("HAS_SESSION", True)
    _put_bool("SESSION_DIRTY", True)

# Rails'in flash'iyla AYNI TEK-KULLANIMLIK davranis: mesaj OKUNDUGUNDA
# (mevcutsa) oturumdan OTOMATIK silinir — cagiran ARTIK ayrica `flash_clear`
# CAGIRMAK ZORUNDA DEGILDIR (bir sonraki istekte AYNI mesaj TEKRAR
# GORUNMEZ). Mesaj YOKSA (None) oturum DEGISTIRILMEZ.
def flash_get(key: str) -> str | None:
    val: str | None = nyx.flash.get(session_json(), key)
    if val != None:
        flash_clear(key)
    return val

def flash_clear(key: str) -> None:
    updated: str = nyx.flash.clear(session_json(), key)
    _put("SESSION_JSON", updated)
    _put_bool("SESSION_DIRTY", True)
