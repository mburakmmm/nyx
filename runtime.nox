# nyx.runtime - istek-kapsamli durum (Nox >= 1.24 TaskLocal[T]).
#
# TaskLocal: ayni worker'da eszamanli fiber'lar birbirinin session/user
# state'ini GORMEZ. Modul-seviyesi TaskLocal ornegi paylasilir; deger
# fiber-local haritada saklanir.
#
# 'current()' BIR SNAPSHOT doner - alanlarini dogrudan degistirmek kalici
# degildir; 'set_*' / 'load_*' / 'touch_*' / 'cycle_session' / 'logout' kullanin.
#
# NOT: RequestBag kurucu parametre adlari getter fonksiyon adlariyla
# cakismasin (eski codegen kisiti; guvenli tutuyoruz).

import nox.strings
import nyx.flash

class RequestBag:
    def __init__(
        self: RequestBag,
        sj: str,
        session_dirty: bool,
        hs: bool,
        user_id: str,
        user_payload: str,
        has_user: bool,
        loc: str,
        rid: str,
        sms: int
    ) -> None:
        self.session_json = sj
        self.session_dirty = session_dirty
        self.has_session = hs
        self.user_id = user_id
        self.user_payload = user_payload
        self.has_user = has_user
        self.locale = loc
        self.request_id = rid
        self.started_ms = sms

class RuntimeError(Exception):
    pass

# Mutable per-request bag; TaskLocal[T] T=sinif gerektirir (int/bool yok).
class RuntimeState:
    def __init__(self: RuntimeState) -> None:
        self.active = False
        self.session_json = "{}"
        self.session_dirty = False
        self.has_session = False
        self.user_id = ""
        self.user_payload = ""
        self.has_user = False
        self.locale = ""
        self.request_id = ""
        self.started_ms = 0
        self.request_target = ""
        self.hdr_keys = ""
        self.session_sid = ""
        self.session_rotate = False
        self.expire_session_cookie = False

_tl: TaskLocal[RuntimeState] = TaskLocal[RuntimeState]()

def _state() -> RuntimeState:
    got: RuntimeState | None = _tl.get()
    if got == None:
        created: RuntimeState = RuntimeState()
        _tl.set(created)
        return created
    else:
        return got

def is_active() -> bool:
    return _state().active

def reset() -> None:
    st: RuntimeState = _state()
    st.active = False
    st.session_json = "{}"
    st.session_dirty = False
    st.has_session = False
    st.user_id = ""
    st.user_payload = ""
    st.has_user = False
    st.locale = ""
    st.request_id = ""
    st.started_ms = 0
    st.request_target = ""
    st.hdr_keys = ""
    st.session_sid = ""
    st.session_rotate = False
    st.expire_session_cookie = False

def begin(req_id: str, start_ms: int, loc: str) -> RequestBag:
    st: RuntimeState = RuntimeState()
    st.active = True
    st.session_json = "{}"
    st.session_dirty = False
    st.has_session = False
    st.user_id = ""
    st.user_payload = ""
    st.has_user = False
    st.locale = loc + ""
    st.request_id = req_id + ""
    st.started_ms = start_ms
    st.request_target = ""
    st.hdr_keys = ""
    st.session_sid = ""
    st.session_rotate = False
    st.expire_session_cookie = False
    _tl.set(st)
    return current()

def end() -> None:
    reset()
    _tl.clear()

def set_request_target(target: str) -> None:
    _state().request_target = target + ""

def request_target() -> str:
    return _state().request_target + ""

def track_header_key(key: str) -> None:
    st: RuntimeState = _state()
    raw: str = st.hdr_keys
    if len(raw) == 0:
        st.hdr_keys = key
        return
    parts: list[str] = nox.strings.split(raw, "\n")
    i: int = 0
    while i < len(parts):
        if parts[i] == key:
            return
        i = i + 1
    st.hdr_keys = raw + "\n" + key

def tracked_header_keys() -> list[str]:
    raw: str = _state().hdr_keys
    if len(raw) == 0:
        out: list[str] = []
        return out
    return nox.strings.split(raw, "\n")

def clear_tracked_headers() -> None:
    _state().hdr_keys = ""

def current() -> RequestBag:
    st: RuntimeState = _state()
    if not st.active:
        st.active = True
    return RequestBag(
        st.session_json + "",
        st.session_dirty,
        st.has_session,
        st.user_id + "",
        st.user_payload + "",
        st.has_user,
        st.locale + "",
        st.request_id + "",
        st.started_ms
    )

def load_session(data_json: str) -> None:
    st: RuntimeState = _state()
    st.session_json = data_json + ""
    st.has_session = True

def set_session(data_json: str) -> None:
    st: RuntimeState = _state()
    st.session_json = data_json + ""
    st.has_session = True
    st.session_dirty = True

def session_json() -> str:
    return _state().session_json + ""

def has_session() -> bool:
    return _state().has_session

def is_session_dirty() -> bool:
    return _state().session_dirty

def touch_session() -> None:
    _state().session_dirty = True

def cycle_session() -> None:
    st: RuntimeState = _state()
    st.session_dirty = True
    st.session_rotate = True

def is_session_rotate() -> bool:
    return _state().session_rotate

def clear_session_rotate() -> None:
    _state().session_rotate = False

def expire_session_cookie() -> None:
    st: RuntimeState = _state()
    st.expire_session_cookie = True
    st.session_dirty = True

def should_expire_session_cookie() -> bool:
    return _state().expire_session_cookie

def clear_expire_session_cookie() -> None:
    _state().expire_session_cookie = False

def logout() -> None:
    st: RuntimeState = _state()
    st.session_json = "{}"
    st.has_session = True
    st.session_dirty = True
    st.session_rotate = False
    st.expire_session_cookie = True
    clear_user()

def set_user(user_id: str, payload_json: str) -> None:
    st: RuntimeState = _state()
    st.user_id = user_id
    st.user_payload = payload_json
    st.has_user = True

def clear_user() -> None:
    st: RuntimeState = _state()
    st.user_id = ""
    st.user_payload = ""
    st.has_user = False

def current_user_id() -> str:
    return _state().user_id + ""

def current_user_payload() -> str:
    return _state().user_payload + ""

def signed_in() -> bool:
    return _state().has_user

def request_id() -> str:
    return _state().request_id + ""

def started_ms() -> int:
    return _state().started_ms

def locale() -> str:
    return _state().locale + ""

def session_sid() -> str:
    return _state().session_sid + ""

def set_session_sid(sid: str) -> None:
    _state().session_sid = sid + ""

def flash_set(key: str, message: str) -> None:
    st: RuntimeState = _state()
    updated: str = nyx.flash.set(st.session_json, key, message)
    st.session_json = updated
    st.has_session = True
    st.session_dirty = True

def flash_get(key: str) -> str | None:
    val: str | None = nyx.flash.get(session_json(), key)
    if val != None:
        flash_clear(key)
    return val

def flash_clear(key: str) -> None:
    st: RuntimeState = _state()
    updated: str = nyx.flash.clear(st.session_json, key)
    st.session_json = updated
    st.session_dirty = True
