# nyx.runtime - istek-kapsamli (worker/thread-local) durum.
#
# Nox >= 1.18.1: paket-modül globals + nested closure / Router codegen-safe
# (P1c düzeltmesi). NYX_RT_* ortam değişkenleri ARTIK KULLANILMAZ.
#
# Her OS thread'inin KENDI global blogu vardir ('serve_multicore' worker
# basina). Varsayim: worker basina senkron, tek istek (nyx.app.dispatch).
#
# 'current()' BIR SNAPSHOT doner - alanlarini dogrudan degistirmek kalici
# degildir; 'set_*' / 'load_*' / 'touch_*' kullanin.
#
# NOT: RequestBag kurucu parametre adlari getter fonksiyon adlariyla
# cakismasin (eski codegen kisiti; guvenli tutuyoruz).

import nox.strings
import nyx.flash

class RequestBag:
    def __init__(
        self: RequestBag,
        sj: str,
        session_dirty: bool,
        hs: bool,
        user_id: str,
        user_payload: str,
        has_user: bool,
        loc: str,
        rid: str,
        sms: int
    ) -> None:
        self.session_json = sj
        self.session_dirty = session_dirty
        self.has_session = hs
        self.user_id = user_id
        self.user_payload = user_payload
        self.has_user = has_user
        self.locale = loc
        self.request_id = rid
        self.started_ms = sms

class RuntimeError:
    def __init__(self: RuntimeError, message: str) -> None:
        self.message = message

_rt_active: bool = False
_rt_session_json: str = "{}"
_rt_session_dirty: bool = False
_rt_has_session: bool = False
_rt_user_id: str = ""
_rt_user_payload: str = ""
_rt_has_user: bool = False
_rt_locale: str = ""
_rt_request_id: str = ""
_rt_started_ms: int = 0
_rt_request_target: str = ""
_rt_hdr_keys: str = ""
_rt_session_sid: str = ""

def is_active() -> bool:
    return _rt_active

def reset() -> None:
    _rt_active = False
    _rt_session_json = "{}"
    _rt_session_dirty = False
    _rt_has_session = False
    _rt_user_id = ""
    _rt_user_payload = ""
    _rt_has_user = False
    _rt_locale = ""
    _rt_request_id = ""
    _rt_started_ms = 0
    _rt_request_target = ""
    _rt_hdr_keys = ""
    _rt_session_sid = ""

def begin(req_id: str, start_ms: int, loc: str) -> RequestBag:
    _rt_active = True
    _rt_session_json = "{}"
    _rt_session_dirty = False
    _rt_has_session = False
    _rt_user_id = ""
    _rt_user_payload = ""
    _rt_has_user = False
    _rt_locale = loc + ""
    _rt_request_id = req_id + ""
    _rt_started_ms = start_ms
    _rt_request_target = ""
    _rt_hdr_keys = ""
    _rt_session_sid = ""
    return current()

def end() -> None:
    reset()

def set_request_target(target: str) -> None:
    _rt_request_target = target + ""

def request_target() -> str:
    return _rt_request_target + ""

def track_header_key(key: str) -> None:
    raw: str = _rt_hdr_keys
    if len(raw) == 0:
        _rt_hdr_keys = key
        return
    parts: list[str] = nox.strings.split(raw, "\n")
    i: int = 0
    while i < len(parts):
        if parts[i] == key:
            return
        i = i + 1
    _rt_hdr_keys = raw + "\n" + key

def tracked_header_keys() -> list[str]:
    raw: str = _rt_hdr_keys
    if len(raw) == 0:
        out: list[str] = []
        return out
    return nox.strings.split(raw, "\n")

def clear_tracked_headers() -> None:
    _rt_hdr_keys = ""

def current() -> RequestBag:
    if not _rt_active:
        _rt_active = True
    return RequestBag(
        _rt_session_json + "",
        _rt_session_dirty,
        _rt_has_session,
        _rt_user_id + "",
        _rt_user_payload + "",
        _rt_has_user,
        _rt_locale + "",
        _rt_request_id + "",
        _rt_started_ms
    )

def load_session(data_json: str) -> None:
    _rt_session_json = data_json + ""
    _rt_has_session = True

def set_session(data_json: str) -> None:
    _rt_session_json = data_json + ""
    _rt_has_session = True
    _rt_session_dirty = True

def session_json() -> str:
    # Kopya don: HttpResponse body / session.create ayni ref'i paylasmasin.
    return _rt_session_json + ""

def has_session() -> bool:
    return _rt_has_session

def is_session_dirty() -> bool:
    return _rt_session_dirty

def touch_session() -> None:
    _rt_session_dirty = True

def cycle_session() -> None:
    touch_session()

def set_user(user_id: str, payload_json: str) -> None:
    _rt_user_id = user_id
    _rt_user_payload = payload_json
    _rt_has_user = True

def clear_user() -> None:
    _rt_user_id = ""
    _rt_user_payload = ""
    _rt_has_user = False

def current_user_id() -> str:
    return _rt_user_id + ""

def current_user_payload() -> str:
    return _rt_user_payload + ""

def signed_in() -> bool:
    return _rt_has_user

def request_id() -> str:
    return _rt_request_id + ""

def started_ms() -> int:
    return _rt_started_ms

def locale() -> str:
    return _rt_locale + ""

def session_sid() -> str:
    return _rt_session_sid + ""

def set_session_sid(sid: str) -> None:
    _rt_session_sid = sid + ""

def flash_set(key: str, message: str) -> None:
    updated: str = nyx.flash.set(session_json(), key, message)
    _rt_session_json = updated
    _rt_has_session = True
    _rt_session_dirty = True

def flash_get(key: str) -> str | None:
    val: str | None = nyx.flash.get(session_json(), key)
    if val != None:
        flash_clear(key)
    return val

def flash_clear(key: str) -> None:
    updated: str = nyx.flash.clear(session_json(), key)
    _rt_session_json = updated
    _rt_session_dirty = True
