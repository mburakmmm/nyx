# nyx.storage - ActiveStorage-benzeri yerel disk depolama.
#
# import nyx.storage
#
# key: str = nyx.storage.store("storage", "avatar.png", content)
# content2: str = nyx.storage.read("storage", key)
# url: str = nyx.storage.url_path(key)
# nyx.storage.delete("storage", key)

import nox.fs
import nox.path
import nox.uuid
import nox.crypto
import nox.time
import nox.json
import nox.strings
import nox.http
import nox.transfer
import nyx.config
from nox.http import HttpResponse, HttpError, HttpTimeoutError
from nox.path import PathError
from nox.fs import FsError

class StorageError(Exception):
    pass

def _ensure_dir(path: str) -> None:
    if len(path) == 0 or path == ".":
        return
    if nox.fs.exists(path):
        return
    parent: str = nox.path.dirname(path)
    if parent != path and len(parent) > 0:
        _ensure_dir(parent)
    if not nox.fs.exists(path):
        nox.fs.create_dir(path)

# Yol gezinme (path traversal) korumasi: cagiran 'filename' icinde '../'
# geciriyor olsa bile yalnizca son bilesen (basename) kullanilir.
def _sanitize_filename(filename: str) -> str:
    return nox.path.basename(filename)

def _meta_path(content_path: str) -> str:
    return content_path + ".meta.json"

# 'key' (cagiran tarafindan verilen, GUVENILMEYEN olabilecek opak depolama
# anahtari) icinde yol gezinme ('..'), mutlak yol veya backslash icerip
# icermedigini denetler - hicbiri 'store()'un URETTIGI (uuid4 + "/" +
# basename) anahtarlarda BULUNMAZ, bu yuzden burada YAKALANMASI HER ZAMAN
# kotu niyetli/bozuk bir 'key' anlamina gelir.
def _validate_key(key: str) -> None:
    if len(key) == 0:
        raise StorageError("depolama anahtari bos olamaz")
    if nox.strings.contains(key, ".."):
        raise StorageError("gecersiz depolama anahtari (yol gezinme denemesi): " + key)
    if nox.strings.contains(key, "\\"):
        raise StorageError("gecersiz depolama anahtari (backslash icermemeli): " + key)
    if nox.path.is_absolute(key):
        raise StorageError("gecersiz depolama anahtari (mutlak yol olamaz): " + key)

def _write_meta(key: str, safe_name: str, content_str: str, content_type: str, full: str) -> None:
    checksum: str = nox.crypto.sha256(content_str)
    meta: str = (
        "{\"key\":" + nox.json.dump_string(key) +
        ",\"filename\":" + nox.json.dump_string(safe_name) +
        ",\"checksum\":" + nox.json.dump_string(checksum) +
        ",\"size\":" + str(len(content_str)) +
        ",\"content_type\":" + nox.json.dump_string(content_type) +
        ",\"created_at_ms\":" + str(nox.time.now_ms()) + "}"
    )
    nox.fs.write_string_atomic(_meta_path(full), meta)

# 'content_str'i 'root' altinda RASTGELE (uuid4) bir alt dizine yazar ve
# opak bir 'key' ("<uuid>/<dosya_adi>") doner. Yaninda sha256 checksum +
# boyut + olusturulma zamanini iceren bir '.meta.json' sidecar dosyasi
# tutulur (ActiveStorage'daki 'blobs' tablosunun disk-tabanli esdegeri).
def store(root: str, filename: str, content_str: str) -> str:
    return store_limited(root, filename, content_str, 0, "")

# max_bytes <= 0 disables size check. content_type stored in meta when non-empty.
def store_limited(root: str, filename: str, content_str: str, max_bytes: int, content_type: str) -> str:
    if len(filename) == 0:
        raise StorageError("dosya adi bos olamaz")
    if max_bytes > 0 and len(content_str) > max_bytes:
        raise StorageError("file too large")
    safe_name: str = _sanitize_filename(filename)
    if len(safe_name) == 0:
        raise StorageError("gecersiz dosya adi: " + filename)
    key: str = nox.uuid.uuid4() + "/" + safe_name
    full: str = _prepare_new(root, key)
    nox.fs.write_string_atomic(full, content_str)
    _write_meta(key, safe_name, content_str, content_type, full)
    return key

# POST, PUT, or PATCH. Timeout is NYX_HTTP_TIMEOUT_MS (default 10000, 0 disables).
# Nox >= 2.0.31: nox.http.request. Body is sent only for these three methods.
def store_http(method: str, url: str, content_str: str, content_type: str) -> None:
    verb: str = nox.strings.upper(method)
    if verb != "POST" and verb != "PUT" and verb != "PATCH":
        raise StorageError("desteklenmeyen HTTP metodu: " + method)
    headers: dict[str, str] = {}
    if len(content_type) > 0:
        headers["Content-Type"] = content_type
    timeout_ms: int = nyx.config.read_http_timeout_ms()
    try:
        resp: HttpResponse = nox.http.request(verb, url, content_str, headers, timeout_ms)
        if resp.status < 200 or resp.status >= 300:
            raise StorageError("HTTP upload failed: HTTP " + str(resp.status))
    except HttpTimeoutError:
        raise StorageError("HTTP upload timed out: " + verb + " " + url)
    except HttpError as e:
        raise StorageError("HTTP upload failed: " + e.message)

def store_http_post(url: str, content_str: str, content_type: str) -> None:
    store_http("POST", url, content_str, content_type)

# Large body: file is streamed with Content-Length. POST and PATCH are not retried.
# PUT may be retried by the stdlib client only on the buffered request() path;
# upload_file uses stream_upload and does not retry a partial upload.
def store_http_file(method: str, url: str, path: str, content_type: str) -> int:
    verb: str = nox.strings.upper(method)
    if verb != "POST" and verb != "PUT" and verb != "PATCH":
        raise StorageError("desteklenmeyen HTTP metodu: " + method)
    if not nox.fs.exists(path):
        raise StorageError("yuklenecek dosya yok: " + path)
    headers: dict[str, str] = {}
    if len(content_type) > 0:
        headers["Content-Type"] = content_type
    timeout_ms: int = nyx.config.read_http_timeout_ms()
    try:
        resp: HttpResponse = nox.transfer.upload_file(verb, url, path, headers, timeout_ms)
        if resp.status < 200 or resp.status >= 300:
            raise StorageError("HTTP upload failed: HTTP " + str(resp.status))
        return resp.status
    except HttpTimeoutError:
        raise StorageError("HTTP upload timed out: " + verb + " " + url)
    except HttpError as e:
        raise StorageError("HTTP upload failed: " + e.message)
    except FsError as e:
        raise StorageError("HTTP upload failed: " + e.message)

# GET the URL onto disk under root. Non-2xx does not leave a blob.
# Checksum is a second read of the saved file.
def fetch(root: str, filename: str, url: str) -> str:
    if len(url) == 0:
        raise StorageError("indirme adresi bos olamaz")
    if len(filename) == 0:
        raise StorageError("dosya adi bos olamaz")
    safe_name: str = _sanitize_filename(filename)
    if len(safe_name) == 0:
        raise StorageError("gecersiz dosya adi: " + filename)
    key: str = nox.uuid.uuid4() + "/" + safe_name
    full: str = _prepare_new(root, key)
    headers: dict[str, str] = {}
    timeout_ms: int = nyx.config.read_http_timeout_ms()
    status: int = 0
    try:
        status = nox.transfer.download_to_file(url, full, headers, timeout_ms)
    except HttpTimeoutError:
        raise StorageError("HTTP download timed out: " + url)
    except HttpError as e:
        raise StorageError("HTTP download failed: " + e.message)
    except FsError as e:
        raise StorageError("HTTP download failed: " + e.message)
    if status < 200 or status >= 300:
        raise StorageError("HTTP download failed: HTTP " + str(status))
    body: str = nox.fs.read_to_string(full)
    _write_meta(key, safe_name, body, "", full)
    return key

def _prepare_new(root: str, key: str) -> str:
    _ensure_dir(root)
    parent: str = nox.path.dirname(key)
    if len(parent) > 0 and parent != ".":
        _ensure_dir(nox.path.join(root, parent))
    return path_for(root, key)

def path_for(root: str, key: str) -> str:
    _validate_key(key)
    if not nox.fs.exists(root):
        raise StorageError("depolama koku yok: " + root)
    try:
        return nox.path.safe_join(root, key)
    except PathError as e:
        if nox.strings.contains(e.message, "path escapes root"):
            raise StorageError("depolama anahtari kok dizinin disina cikiyor: " + key)
        raise StorageError("depolama anahtari yok: " + key)

def read(root: str, key: str) -> str:
    full: str = path_for(root, key)
    if not nox.fs.exists(full):
        raise StorageError("depolama anahtari yok: " + key)
    return nox.fs.read_to_string(full)

def metadata_json(root: str, key: str) -> str:
    meta_path: str = _meta_path(path_for(root, key))
    if not nox.fs.exists(meta_path):
        raise StorageError("meta veri yok: " + key)
    return nox.fs.read_to_string(meta_path)

# Diskteki mevcut icerigin sha256'sini yeniden hesaplayip 'store' sirasinda
# kaydedilen checksum ile karsilastirir - bozulma (corruption) tespiti icin.
def verify_checksum(root: str, key: str) -> bool:
    content: str = read(root, key)
    actual: str = nox.crypto.sha256(content)
    meta: str = metadata_json(root, key)
    v: JsonValue = nox.json.parse(meta)
    i: int = 0
    n: int = nox.json.object_len(v)
    while i < n:
        if nox.json.object_key(v, i) == "checksum":
            expected: str = nox.json.as_string(nox.json.object_value(v, i))
            return expected == actual
        i = i + 1
    return False

def exists(root: str, key: str) -> bool:
    return nox.fs.exists(path_for(root, key))

def delete(root: str, key: str) -> None:
    full: str = path_for(root, key)
    if nox.fs.exists(full):
        nox.fs.remove_file(full)
    meta_path: str = _meta_path(full)
    if nox.fs.exists(meta_path):
        nox.fs.remove_file(meta_path)

def url_path(key: str) -> str:
    return "/storage/" + key
