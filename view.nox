# nyx.view — şablon render, layout, partial.
#
# nyx.view.render("app/views/home.html", ctx)
# nyx.view.render_with_layout("app/views/layouts/application.html", "app/views/home.html", ctx)
# nyx.view.partial("app/views/posts/_item.html", ctx)
# nyx.view.render_records("app/views/posts/_item.html", rows, ["title", "body"])

import nox.fs
import nox.template
import nox.strings
from nyx.model import Record

class ViewError:
    def __init__(self: ViewError, message: str) -> None:
        self.message = message

def render(path: str, context: dict[str, str]) -> str:
    if not nox.fs.exists(path):
        raise ViewError("sablon yok: " + path)
    tmpl: str = nox.fs.read_to_string(path)
    return nox.template.render(tmpl, context)

def render_unescaped(path: str, context: dict[str, str]) -> str:
    if not nox.fs.exists(path):
        raise ViewError("sablon yok: " + path)
    tmpl: str = nox.fs.read_to_string(path)
    return nox.template.render_unescaped(tmpl, context)

def partial(path: str, context: dict[str, str]) -> str:
    return render(path, context)

def partial_unescaped(path: str, context: dict[str, str]) -> str:
    return render_unescaped(path, context)

# Nox template'te `{% for %}` yok. Her Record icin `field_keys` alanlarini
# context'e yazip partial render eder.
def render_records(partial_path: str, rows: list[Record], field_keys: list[str]) -> str:
    out: str = ""
    i: int = 0
    while i < len(rows):
        context: dict[str, str] = {}
        j: int = 0
        while j < len(field_keys):
            key: str = field_keys[j]
            context[key] = rows[i].get_or(key, "")
            j = j + 1
        out = out + partial(partial_path, context)
        i = i + 1
    return out

def render_records_unescaped(partial_path: str, rows: list[Record], field_keys: list[str]) -> str:
    out: str = ""
    i: int = 0
    while i < len(rows):
        context: dict[str, str] = {}
        j: int = 0
        while j < len(field_keys):
            key: str = field_keys[j]
            context[key] = rows[i].get_or(key, "")
            j = j + 1
        out = out + partial_unescaped(partial_path, context)
        i = i + 1
    return out

# Nox >= 1.8.2: `list[dict[str,str]]` desteklenir. Her context bir partial.
def render_each(partial_path: str, contexts: list[dict[str, str]]) -> str:
    out: str = ""
    i: int = 0
    while i < len(contexts):
        out = out + partial(partial_path, contexts[i])
        i = i + 1
    return out

def render_each_unescaped(partial_path: str, contexts: list[dict[str, str]]) -> str:
    out: str = ""
    i: int = 0
    while i < len(contexts):
        out = out + partial_unescaped(partial_path, contexts[i])
        i = i + 1
    return out

# Layout: once layout render edilir ({{ yield }} icin benzersiz slot),
# sonra body slot'a string replace ile konur — body icindeki `{{...}}`
# ikinci kez template olarak yorumlanmaz (second-pass injection onlemi).
def _yield_slot() -> str:
    return "__NYX_YIELD_SLOT_7f3a9c__"

def render_with_layout(layout_path: str, view_path: str, context: dict[str, str]) -> str:
    body: str = render(view_path, context)
    if not nox.fs.exists(layout_path):
        raise ViewError("layout yok: " + layout_path)
    layout_tmpl: str = nox.fs.read_to_string(layout_path)
    slot: str = _yield_slot()
    prepared: str = nox.strings.replace(layout_tmpl, "{{ yield }}", slot)
    prepared = nox.strings.replace(prepared, "{{yield}}", slot)
    rendered_layout: str = nox.template.render(prepared, context)
    return nox.strings.replace(rendered_layout, slot, body)

def render_with_layout_unescaped(layout_path: str, view_path: str, context: dict[str, str]) -> str:
    body: str = render_unescaped(view_path, context)
    if not nox.fs.exists(layout_path):
        raise ViewError("layout yok: " + layout_path)
    layout_tmpl: str = nox.fs.read_to_string(layout_path)
    slot: str = _yield_slot()
    prepared: str = nox.strings.replace(layout_tmpl, "{{ yield }}", slot)
    prepared = nox.strings.replace(prepared, "{{yield}}", slot)
    rendered_layout: str = nox.template.render_unescaped(prepared, context)
    return nox.strings.replace(rendered_layout, slot, body)
