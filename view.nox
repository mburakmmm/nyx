# nyx.view - şablon render, layout, partial.
#
# nyx.view.render("app/views/home.html", ctx)
# nyx.view.render_with_layout("app/views/layouts/application.html", "app/views/home.html", ctx)
# nyx.view.partial("app/views/posts/_item.html", ctx)
# nyx.view.render_records("app/views/posts/_item.html", rows, ["title", "body"])

import nox.fs
import nox.template
import nox.strings
from nox.fs import FileMetadata
from nyx.model import Record

class ViewError(Exception):
    pass

class _CachedTemplate:
    path: str
    modified_ms: int
    size: int
    body: str
    used: int

    def __init__(self: _CachedTemplate, path: str, modified_ms: int, size: int, body: str, used: int) -> None:
        self.path = path
        self.modified_ms = modified_ms
        self.size = size
        self.body = body
        self.used = used

# nox.template yalnizca kaynak metni render eder; derlenmis sablon tutaci yok.
# exists ve metadata her render'da kalir, degisen dosya eski govdeyi sunmasin.
# Kapasite asilinca en eski kayit duser.
_TEMPLATE_CAP: int = 64
_templates: list[_CachedTemplate] = []
_disk_reads: int = 0
_template_tick: int = 0

def template_disk_reads() -> int:
    return _disk_reads

def template_cache_size() -> int:
    return len(_templates)

def template_cache_cap() -> int:
    return _TEMPLATE_CAP

def clear_template_cache() -> None:
    _templates = []
    _disk_reads = 0
    _template_tick = 0

def _touch_template(item: _CachedTemplate) -> None:
    _template_tick = _template_tick + 1
    item.used = _template_tick

def _evict_templates() -> None:
    while len(_templates) > _TEMPLATE_CAP:
        oldest: int = 0
        k: int = 1
        while k < len(_templates):
            if _templates[k].used < _templates[oldest].used:
                oldest = k
            k = k + 1
        kept: list[_CachedTemplate] = []
        n: int = 0
        while n < len(_templates):
            if n != oldest:
                kept.append(_templates[n])
            n = n + 1
        _templates = kept

# mtime ve boyut ayniysa dosya yeniden okunmaz. Boyut degisirse ayni saniyedeki
# yazma da onbellegi dusurur.
def _cached_source(path: str) -> str:
    if not nox.fs.exists(path):
        raise ViewError("sablon yok: " + path)
    meta: FileMetadata = nox.fs.metadata(path)
    i: int = 0
    while i < len(_templates):
        item: _CachedTemplate = _templates[i]
        if item.path == path and item.modified_ms == meta.modified_ms and item.size == meta.size:
            _touch_template(item)
            return item.body
        i = i + 1
    body: str = nox.fs.read_to_string(path)
    _disk_reads = _disk_reads + 1
    _template_tick = _template_tick + 1
    fresh: _CachedTemplate = _CachedTemplate(path, meta.modified_ms, meta.size, body, _template_tick)
    kept_new: list[_CachedTemplate] = []
    j: int = 0
    replaced: bool = False
    while j < len(_templates):
        old: _CachedTemplate = _templates[j]
        if old.path == path:
            kept_new.append(fresh)
            replaced = True
        else:
            kept_new.append(old)
        j = j + 1
    if not replaced:
        kept_new.append(fresh)
    _templates = kept_new
    _evict_templates()
    return body

def render(path: str, context: dict[str, str]) -> str:
    tmpl: str = _cached_source(path)
    return nox.template.render(tmpl, context)

def render_unescaped(path: str, context: dict[str, str]) -> str:
    tmpl: str = _cached_source(path)
    return nox.template.render_unescaped(tmpl, context)

# Nox >= 2.1.7: {% for %} / {% if %} / {% else %}. `render` bu etiketleri yorumlamaz.
# scalars {{ ad }} ve if icin, lists `{% for x in ad %}` icin (oge alanlari {{ x.alan }}).
def render_blocks(
    path: str,
    scalars: dict[str, str],
    lists: dict[str, list[dict[str, str]]]
) -> str:
    tmpl: str = _cached_source(path)
    return nox.template.render_blocks(tmpl, scalars, lists)

def render_blocks_unescaped(
    path: str,
    scalars: dict[str, str],
    lists: dict[str, list[dict[str, str]]]
) -> str:
    tmpl: str = _cached_source(path)
    return nox.template.render_blocks_unescaped(tmpl, scalars, lists)

def partial(path: str, context: dict[str, str]) -> str:
    return render(path, context)

def partial_unescaped(path: str, context: dict[str, str]) -> str:
    return render_unescaped(path, context)

# Eski partial dongusu. Yeni sablonlar render_blocks kullanir.
# Her Record icin 'field_keys' alanlarini
# context'e yazip partial render eder.
def render_records(partial_path: str, rows: list[Record], field_keys: list[str]) -> str:
    out: str = ""
    i: int = 0
    while i < len(rows):
        context: dict[str, str] = {}
        j: int = 0
        while j < len(field_keys):
            key: str = field_keys[j]
            context[key] = rows[i].get_or(key, "")
            j = j + 1
        out = out + partial(partial_path, context)
        i = i + 1
    return out

def render_records_unescaped(partial_path: str, rows: list[Record], field_keys: list[str]) -> str:
    out: str = ""
    i: int = 0
    while i < len(rows):
        context: dict[str, str] = {}
        j: int = 0
        while j < len(field_keys):
            key: str = field_keys[j]
            context[key] = rows[i].get_or(key, "")
            j = j + 1
        out = out + partial_unescaped(partial_path, context)
        i = i + 1
    return out

# Nox >= 1.8.2: 'list[dict[str,str]]' desteklenir. Her context bir partial.
def render_each(partial_path: str, contexts: list[dict[str, str]]) -> str:
    out: str = ""
    i: int = 0
    while i < len(contexts):
        out = out + partial(partial_path, contexts[i])
        i = i + 1
    return out

def render_each_unescaped(partial_path: str, contexts: list[dict[str, str]]) -> str:
    out: str = ""
    i: int = 0
    while i < len(contexts):
        out = out + partial_unescaped(partial_path, contexts[i])
        i = i + 1
    return out

# Nox >= 1.18.1: paket modülünde function-type + inline dict sonucu güvenli (C2).
def render_each_map(
    partial_path: str,
    rows: list[Record],
    to_context: (Record) -> dict[str, str]
) -> str:
    out: str = ""
    i: int = 0
    while i < len(rows):
        out = out + partial(partial_path, to_context(rows[i]))
        i = i + 1
    return out

def render_each_map_unescaped(
    partial_path: str,
    rows: list[Record],
    to_context: (Record) -> dict[str, str]
) -> str:
    out: str = ""
    i: int = 0
    while i < len(rows):
        out = out + partial_unescaped(partial_path, to_context(rows[i]))
        i = i + 1
    return out

# Layout: once layout render edilir ({{ yield }} icin benzersiz slot),
# sonra body slot'a string replace ile konur - body icindeki '{{...}}'
# ikinci kez template olarak yorumlanmaz (second-pass injection onlemi).
def _yield_slot() -> str:
    return "__NYX_YIELD_SLOT_7f3a9c__"

def render_with_layout(layout_path: str, view_path: str, context: dict[str, str]) -> str:
    body: str = render(view_path, context)
    if not nox.fs.exists(layout_path):
        raise ViewError("layout yok: " + layout_path)
    layout_tmpl: str = _cached_source(layout_path)
    slot: str = _yield_slot()
    prepared: str = nox.strings.replace(layout_tmpl, "{{ yield }}", slot)
    prepared = nox.strings.replace(prepared, "{{yield}}", slot)
    rendered_layout: str = nox.template.render(prepared, context)
    return nox.strings.replace(rendered_layout, slot, body)

def render_with_layout_unescaped(layout_path: str, view_path: str, context: dict[str, str]) -> str:
    body: str = render_unescaped(view_path, context)
    if not nox.fs.exists(layout_path):
        raise ViewError("layout yok: " + layout_path)
    layout_tmpl: str = _cached_source(layout_path)
    slot: str = _yield_slot()
    prepared: str = nox.strings.replace(layout_tmpl, "{{ yield }}", slot)
    prepared = nox.strings.replace(prepared, "{{yield}}", slot)
    rendered_layout: str = nox.template.render_unescaped(prepared, context)
    return nox.strings.replace(rendered_layout, slot, body)
