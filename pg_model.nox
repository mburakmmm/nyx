# nyx.pg_model - PostgreSQL ORM helpers (prepare/bind + RETURNING).
#
# Dialect-aware boot (Nox >= 1.21.3 + nyx 0.10):
#   application = nyx.app.boot(cfg, setup)  # DATABASE_URL=postgres://...
#   id = nyx.pg_model.create_attrs(nyx.app.pg(application), "posts", attrs)
#   row = nyx.pg_model.find(nyx.app.pg(application), "posts", id)
#
# SQLite ORM icin nyx.model + application.db kullanin.
# Tipler ayri kalir (PgConnection vs sqlite.Connection) - ortak query
# protokolu Nox'ta henuz yok (Row kovaryansi).

import nox.strings
from nox.postgres import Connection, PostgresError
from nox.db import Statement
from nox.db import Row
import nyx.model
from nyx.model import ModelError, Attributes

class Record:
    def __init__(self: Record, row: Row) -> None:
        self.row = row
        indices: dict[str, int] = {}
        i: int = 0
        n: int = row.column_count()
        while i < n:
            indices[row.column_name(i)] = i
            i = i + 1
        self._indices = indices

    def _col_index(self: Record, name: str) -> int:
        try:
            return self._indices[name]
        except KeyError:
            raise ModelError("sutun yok: " + name)

    def get(self: Record, name: str) -> str:
        i: int = self._col_index(name)
        if self.row.is_null(i):
            return ""
        return self.row.get_str(i)

    def get_or(self: Record, name: str, fallback: str) -> str:
        i: int = self._col_index(name)
        if self.row.is_null(i):
            return fallback
        return self.row.get_str(i)

    def get_int(self: Record, name: str) -> int:
        i: int = self._col_index(name)
        if self.row.is_null(i):
            raise ModelError("sutun NULL: " + name)
        return self.row.get_int(i)

    def get_int_or(self: Record, name: str, fallback: int) -> int:
        i: int = self._col_index(name)
        if self.row.is_null(i):
            return fallback
        return self.row.get_int(i)

    def has(self: Record, name: str) -> bool:
        try:
            skip: int = self._indices[name]
            return True
        except KeyError:
            return False

def _check_ident(name: str) -> None:
    if len(name) == 0:
        raise ModelError("bos kimlik")
    i: int = 0
    while i < len(name):
        b: int = nox.strings.byte_at(name, i)
        ok: bool = False
        if b >= 48 and b <= 57:
            ok = i > 0
        if b >= 65 and b <= 90:
            ok = True
        if b >= 97 and b <= 122:
            ok = True
        if b == 95:
            ok = True
        if not ok:
            raise ModelError("gecersiz kimlik: " + name)
        i = i + 1

def _quote_ident(name: str) -> str:
    _check_ident(name)
    return "\"" + name + "\""

def _pg_placeholder(i: int) -> str:
    return "$" + str(i + 1)

def _rows_to_records(rows: list[Row]) -> list[Record]:
    out: list[Record] = []
    i: int = 0
    while i < len(rows):
        out.append(Record(rows[i]))
        i = i + 1
    return out

def find(db: Connection, table: str, id: int) -> Record | None:
    _check_ident(table)
    sql: str = "SELECT * FROM " + _quote_ident(table) + " WHERE \"id\" = $1"
    stmt: Statement = db.prepare(sql)
    stmt.bind_int(0, id)
    rows: list[Row] = stmt.query()
    if len(rows) == 0:
        return None
    return Record(rows[0])

def all(db: Connection, table: str) -> list[Record]:
    _check_ident(table)
    sql: str = "SELECT * FROM " + _quote_ident(table)
    rows: list[Row] = db.query(sql)
    return _rows_to_records(rows)

def where(db: Connection, table: str, col: str, value: str) -> list[Record]:
    _check_ident(table)
    _check_ident(col)
    sql: str = "SELECT * FROM " + _quote_ident(table) + " WHERE " + _quote_ident(col) + " = $1"
    stmt: Statement = db.prepare(sql)
    stmt.bind_str(0, value)
    return _rows_to_records(stmt.query())

def where_int(db: Connection, table: str, col: str, value: int) -> list[Record]:
    _check_ident(table)
    _check_ident(col)
    sql: str = "SELECT * FROM " + _quote_ident(table) + " WHERE " + _quote_ident(col) + " = $1"
    stmt: Statement = db.prepare(sql)
    stmt.bind_int(0, value)
    return _rows_to_records(stmt.query())

def destroy(db: Connection, table: str, id: int) -> None:
    _check_ident(table)
    sql: str = "DELETE FROM " + _quote_ident(table) + " WHERE \"id\" = $1"
    stmt: Statement = db.prepare(sql)
    stmt.bind_int(0, id)
    stmt.execute()

def _bind_typed(stmt: Statement, attrs: Attributes) -> None:
    n: int = len(attrs.keys)
    if len(attrs.kinds) != n or len(attrs.str_vals) != n or len(attrs.int_vals) != n or len(attrs.bool_vals) != n:
        raise ModelError("corrupt Attributes: length mismatch")
    j: int = 0
    while j < len(attrs.keys):
        kind: str = attrs.kinds[j]
        if kind == "null":
            stmt.bind_null(j)
        elif kind == "int":
            stmt.bind_int(j, attrs.int_vals[j])
        elif kind == "bool":
            if attrs.bool_vals[j]:
                stmt.bind_int(j, 1)
            else:
                stmt.bind_int(j, 0)
        elif kind == "str":
            stmt.bind_str(j, attrs.str_vals[j])
        else:
            raise ModelError("bilinmeyen attribute tipi: " + kind)
        j = j + 1

def create_attrs(db: Connection, table: str, attrs: Attributes) -> int:
    _check_ident(table)
    n: int = len(attrs.keys)
    if len(attrs.kinds) != n or len(attrs.str_vals) != n or len(attrs.int_vals) != n or len(attrs.bool_vals) != n:
        raise ModelError("corrupt Attributes: length mismatch")
    if len(attrs.keys) == 0:
        raise ModelError("bos attrs")
    cols: str = ""
    placeholders: str = ""
    i: int = 0
    while i < len(attrs.keys):
        if i > 0:
            cols = cols + ", "
            placeholders = placeholders + ", "
        cols = cols + _quote_ident(attrs.keys[i])
        placeholders = placeholders + _pg_placeholder(i)
        i = i + 1
    sql: str = (
        "INSERT INTO " + _quote_ident(table) + " (" + cols + ") VALUES (" + placeholders + ") RETURNING id"
    )
    stmt: Statement = db.prepare(sql)
    _bind_typed(stmt, attrs)
    try:
        rows: list[Row] = stmt.query()
    except PostgresError as e:
        raise ModelError("postgres create failed: " + e.message)
    if len(rows) == 0:
        raise ModelError("postgres INSERT RETURNING returned no rows")
    return rows[0].get_int(0)

def update_attrs(db: Connection, table: str, id: int, attrs: Attributes) -> None:
    _check_ident(table)
    n: int = len(attrs.keys)
    if len(attrs.kinds) != n or len(attrs.str_vals) != n or len(attrs.int_vals) != n or len(attrs.bool_vals) != n:
        raise ModelError("corrupt Attributes: length mismatch")
    if len(attrs.keys) == 0:
        raise ModelError("bos attrs")
    sets: str = ""
    i: int = 0
    while i < len(attrs.keys):
        if i > 0:
            sets = sets + ", "
        sets = sets + _quote_ident(attrs.keys[i]) + " = " + _pg_placeholder(i)
        i = i + 1
    sql: str = (
        "UPDATE " + _quote_ident(table) + " SET " + sets +
        " WHERE \"id\" = " + _pg_placeholder(len(attrs.keys))
    )
    stmt: Statement = db.prepare(sql)
    _bind_typed(stmt, attrs)
    stmt.bind_int(len(attrs.keys), id)
    try:
        stmt.execute()
    except PostgresError as e:
        raise ModelError("postgres update failed: " + e.message)

def create_attrs_valid(db: Connection, table: str, attrs: Attributes, required_fields: list[str]) -> int:
    errors: list[str] = nyx.model.validate_attrs_required(attrs, required_fields)
    if len(errors) > 0:
        raise ModelError("dogrulama basarisiz: " + nox.strings.join(errors, "; "))
    return create_attrs(db, table, attrs)

def transaction(db: Connection, fn: (Connection) -> None) -> None:
    db.execute("BEGIN")
    try:
        fn(db)
        db.execute("COMMIT")
    except ModelError as e:
        db.execute("ROLLBACK")
        raise ModelError(e.message)
    except PostgresError as e:
        db.execute("ROLLBACK")
        raise ModelError(e.message)
    except:
        db.execute("ROLLBACK")
        raise ModelError("transaction failed")
