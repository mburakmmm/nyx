# nyx.session_store_mysql - server-side sessions on MySQL.
#
# application.dialect == "mysql" and NYX_SESSION_STORE=db.
# Cookie signing stays on nyx.session_store.

import nox.time
import nox.uuid
import nox.json
from nox.mysql import Connection as MysqlConnection, MysqlError
from nox.db import Statement
from nox.db import Row
from nyx.session_store import SessionStoreError

def ensure_schema(db: MysqlConnection) -> None:
    db.execute(
        "CREATE TABLE IF NOT EXISTS nyx_sessions (" +
        "id VARCHAR(64) PRIMARY KEY NOT NULL, " +
        "data TEXT NOT NULL, " +
        "user_id BIGINT NOT NULL DEFAULT 0, " +
        "expires_at_ms BIGINT NOT NULL, " +
        "created_at_ms BIGINT NOT NULL, " +
        "updated_at_ms BIGINT NOT NULL, " +
        "KEY idx_nyx_sessions_user (user_id), " +
        "KEY idx_nyx_sessions_exp (expires_at_ms)" +
        ")"
    )

def _now_ms() -> int:
    return nox.time.now_ms()

def create_sid(db: MysqlConnection, data_json: str, max_age_sec: int, user_id: int) -> str:
    if max_age_sec <= 0:
        raise SessionStoreError("max_age_sec must be positive")
    nox.json.decode(data_json)
    sid: str = nox.uuid.uuid4()
    now: int = _now_ms()
    exp: int = now + (max_age_sec * 1000)
    stmt: Statement = db.prepare(
        "INSERT INTO nyx_sessions (id, data, user_id, expires_at_ms, created_at_ms, updated_at_ms) " +
        "VALUES (?, ?, ?, ?, ?, ?)"
    )
    stmt.bind_str(0, sid)
    stmt.bind_str(1, data_json)
    stmt.bind_int(2, user_id)
    stmt.bind_int(3, exp)
    stmt.bind_int(4, now)
    stmt.bind_int(5, now)
    try:
        stmt.execute()
    except MysqlError as e:
        raise SessionStoreError("mysql create_sid failed: " + e.message)
    return sid

def load_sid(db: MysqlConnection, sid: str) -> str | None:
    if len(sid) == 0:
        return None
    stmt: Statement = db.prepare(
        "SELECT data, expires_at_ms FROM nyx_sessions WHERE id = ?"
    )
    stmt.bind_str(0, sid)
    rows: list[Row] = stmt.query()
    if len(rows) == 0:
        return None
    exp: int = rows[0].get_int(1)
    if exp < _now_ms():
        destroy_sid(db, sid)
        return None
    return rows[0].get_str(0)

def save_sid(db: MysqlConnection, sid: str, data_json: str, max_age_sec: int, user_id: int) -> None:
    nox.json.decode(data_json)
    now: int = _now_ms()
    exp: int = now + (max_age_sec * 1000)
    stmt: Statement = db.prepare(
        "UPDATE nyx_sessions SET data = ?, user_id = ?, expires_at_ms = ?, updated_at_ms = ? WHERE id = ?"
    )
    stmt.bind_str(0, data_json)
    stmt.bind_int(1, user_id)
    stmt.bind_int(2, exp)
    stmt.bind_int(3, now)
    stmt.bind_str(4, sid)
    try:
        stmt.execute()
    except MysqlError as e:
        raise SessionStoreError("mysql save_sid failed: " + e.message)

def destroy_sid(db: MysqlConnection, sid: str) -> None:
    if len(sid) == 0:
        return
    stmt: Statement = db.prepare("DELETE FROM nyx_sessions WHERE id = ?")
    stmt.bind_str(0, sid)
    stmt.execute()

def destroy_all_for_user(db: MysqlConnection, user_id: int) -> int:
    stmt: Statement = db.prepare("DELETE FROM nyx_sessions WHERE user_id = ?")
    stmt.bind_int(0, user_id)
    return stmt.execute()

def purge_expired(db: MysqlConnection) -> int:
    stmt: Statement = db.prepare("DELETE FROM nyx_sessions WHERE expires_at_ms < ?")
    stmt.bind_int(0, _now_ms())
    return stmt.execute()
