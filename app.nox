# nyx.app - Application boot + request lifecycle.
#
# # Boot once (Nox >= 1.10 module globals), then serve:
# cfg: Config = nyx.config.load()
# application: Application = nyx.app.boot(cfg, setup)
#
# def handle(req: HttpRequest) -> HttpResponse:
#     return nyx.app.dispatch(application, req)
#
# nox.http.serve(8080, handle)
# # TLS / WS (Nox >= 1.22): serve_tls / serve_ws / serve_ws_tls — see nyx.server
#
# `nox.http.serve*` needs a top-level bare function name; the Application
# and Router live in module globals (per-worker / thread-local in multicore).

import nox.http
import nox.log
import nox.time
import nox.uuid
import nox.strings
import nox.fs
import nox.json
from nox.http import HttpRequest, HttpResponse
from nox.router import Router, Context
from nox.sqlite import Connection
from nox.postgres import Connection as PgConnection
import nyx.config
import nyx.db
import nyx.runtime
import nyx.session
import nyx.cookie
import nyx.csrf
import nyx.response
import nyx.security
import nyx.ctrl
import nyx.params
from nyx.config import Config
from nyx.runtime import RequestBag
from nyx.cookie import CookieError
from nyx.db import DbError
from nyx.model import ModelError

class AppError:
    def __init__(self: AppError, message: str) -> None:
        self.message = message

class Application:
    def __init__(
        self: Application,
        cfg: Config,
        conn: Connection,
        router: Router,
        dialect: str,
        jobs: Connection,
        pg_list: list[PgConnection],
        hooks: list[() -> None]
    ) -> None:
        self.config = cfg
        self.db = conn
        self.router = router
        self.dialect = dialect
        self.jobs_db = jobs
        self._pg = pg_list
        self._shutdown_hooks = hooks
        self._closed = False

def db(application: Application) -> Connection:
    return application.db

def jobs_db(application: Application) -> Connection:
    return application.jobs_db

def config(application: Application) -> Config:
    return application.config

def has_pg(application: Application) -> bool:
    return len(application._pg) > 0

def pg(application: Application) -> PgConnection:
    if len(application._pg) == 0:
        raise AppError("Application.pg is empty (dialect is not postgres)")
    return application._pg[0]

def _is_placeholder_secret(secret: str) -> bool:
    if nox.strings.contains(secret, "change-me"):
        return True
    if nox.strings.contains(secret, "nyx-dev-secret"):
        return True
    if nox.strings.contains(secret, "nyx-test-secret"):
        return True
    return False

def on_shutdown(application: Application, run: () -> None) -> None:
    hooks: list[() -> None] = application._shutdown_hooks
    hooks.append(run)
    application._shutdown_hooks = hooks

def shutdown(application: Application) -> None:
    if application._closed:
        return
    application._closed = True
    i: int = len(application._shutdown_hooks) - 1
    while i >= 0:
        try:
            application._shutdown_hooks[i]()
        except:
            a: int = 0
        i = i - 1
    if len(application._pg) > 0:
        try:
            application._pg[0].close()
        except:
            b: int = 0
    try:
        application.jobs_db.close()
    except:
        c: int = 0
    try:
        application.db.close()
    except:
        d: int = 0

def mount_health(application: Application) -> None:
    def health(ctx: Context) -> HttpResponse:
        return nyx.ctrl.json(200, "{\"status\":\"ok\"}")

    def ready(ctx: Context) -> HttpResponse:
        try:
            if application.dialect == "postgres":
                application._pg[0].query("SELECT 1")
            else:
                application.db.query("SELECT 1")
            return nyx.ctrl.json(200, "{\"status\":\"ready\"}")
        except DbError:
            return nyx.ctrl.json(503, "{\"status\":\"not_ready\"}")
        except:
            return nyx.ctrl.json(503, "{\"status\":\"not_ready\"}")

    application.router.get("/health", health)
    application.router.get("/healthz", health)
    application.router.get("/ready", ready)

def boot(cfg: Config, setup: (Application) -> None) -> Application:
    if len(cfg.secret_key) < 16:
        raise AppError("secret_key must be at least 16 characters")
    if cfg.is_production() and len(cfg.secret_key) < 32:
        raise AppError("production secret_key must be at least 32 characters")
    if cfg.is_production() and _is_placeholder_secret(cfg.secret_key):
        raise AppError("production secret_key looks like a placeholder; set NYX_SECRET_KEY")
    dialect: str = nyx.db.dialect_of_url(cfg.db_path)
    if dialect == "":
        dialect = "sqlite"
    if dialect == "mysql":
        raise AppError(
            "Application boot does not wire mysql yet; use nyx.db.open_mysql " +
            "and keep Application.db on sqlite (or use postgres dialect)"
        )
    pg_list: list[PgConnection] = []
    conn: Connection = nyx.db.open(":memory:")
    if dialect == "postgres":
        pg_list.append(nyx.db.open_postgres(cfg.db_path))
        if cfg.auto_migrate:
            if nox.fs.exists(cfg.migrate_path) and nox.fs.is_dir(cfg.migrate_path):
                try:
                    nyx.db.migrate_postgres(pg_list[0], cfg.migrate_path)
                except DbError:
                    raise AppError("postgres migration failed: " + cfg.migrate_path)
            else:
                if cfg.is_production():
                    raise AppError("migration directory missing: " + cfg.migrate_path)
    elif dialect == "sqlite":
        conn = nyx.db.open(cfg.db_path)
        if cfg.auto_migrate:
            if nox.fs.exists(cfg.migrate_path) and nox.fs.is_dir(cfg.migrate_path):
                try:
                    nyx.db.migrate(conn, cfg.migrate_path)
                except DbError:
                    raise AppError("migration failed: " + cfg.migrate_path)
            else:
                if cfg.is_production():
                    raise AppError("migration directory missing: " + cfg.migrate_path)
    else:
        raise AppError("unsupported db dialect: " + dialect)
    jobs: Connection = nyx.db.open(cfg.jobs_db_path)
    hooks: list[() -> None] = []
    application: Application = Application(cfg, conn, Router(), dialect, jobs, pg_list, hooks)
    _install_framework_middleware(application)
    mount_health(application)
    setup(application)
    return application

def _install_framework_middleware(application: Application) -> None:
    cfg: Config = application.config
    router: Router = application.router
    router.use_before(_session_before(cfg))
    if cfg.csrf_enabled:
        if cfg.csrf_api_exempt:
            router.use_before(nyx.csrf.protect_api_exempt(cfg.secret_key))
        else:
            router.use_before(nyx.csrf.protect(cfg.secret_key))
    router.use_after(_session_after(cfg))
    router.use_after(nyx.security.headers_after(cfg))
    if cfg.log_requests:
        router.use_after(_log_after())

def _header_get(headers: dict[str, str], name: str) -> str | None:
    try:
        return headers[name]
    except KeyError:
        a: int = 0
    lower: str = nox.strings.lower(name)
    try:
        return headers[lower]
    except KeyError:
        b: int = 0
    if lower == "cookie":
        try:
            return headers["Cookie"]
        except KeyError:
            c: int = 0
        try:
            return headers["cookie"]
        except KeyError:
            d: int = 0
    return None

def _ensure_session_seed() -> None:
    sess: str = nyx.runtime.session_json()
    if len(sess) == 0 or sess == "{}":
        seed: str = nox.uuid.uuid4()
        nyx.runtime.set_session("{\"_nyx\":" + nox.json.encode_string(seed) + "}")

def _load_session_from_cookie(cfg: Config, raw: str) -> None:
    try:
        cookies: dict[str, str] = nyx.cookie.parse(raw)
        val: str = cookies[cfg.session_cookie]
        data: str | None = nyx.session.load(cfg.secret_key, val)
        if data != None:
            nyx.runtime.load_session(data)
        else:
            nyx.runtime.load_session("{}")
            _ensure_session_seed()
    except KeyError:
        nyx.runtime.load_session("{}")
        _ensure_session_seed()
    except CookieError:
        nyx.runtime.load_session("{}")
        _ensure_session_seed()

def _session_before(cfg: Config) -> (Context) -> HttpResponse | None:
    def handler(ctx: Context) -> HttpResponse | None:
        raw: str | None = _header_get(ctx.request.headers, "Cookie")
        if raw != None:
            _load_session_from_cookie(cfg, raw)
        else:
            nyx.runtime.load_session("{}")
            _ensure_session_seed()
        return None
    return handler

def _session_after(cfg: Config) -> (Context, HttpResponse) -> HttpResponse:
    def handler(ctx: Context, resp: HttpResponse) -> HttpResponse:
        if not nyx.runtime.is_session_dirty():
            return resp
        token: str = nyx.session.create(cfg.secret_key, nyx.runtime.session_json(), cfg.session_max_age)
        set_cookie: str = nyx.cookie.serialize(
            cfg.session_cookie,
            token,
            "/",
            cfg.session_max_age,
            True,
            "Lax",
            cfg.secure_cookies
        )
        return nyx.response.with_header(resp, "Set-Cookie", set_cookie)
    return handler

def _log_after() -> (Context, HttpResponse) -> HttpResponse:
    def handler(ctx: Context, resp: HttpResponse) -> HttpResponse:
        elapsed: int = nox.time.now_ms() - nyx.runtime.started_ms()
        nox.log.info(
            ctx.request.method + " " + ctx.request.target + " -> " + str(resp.status) + " " + str(elapsed) + "ms id=" + nyx.runtime.request_id()
        )
        return resp
    return handler

def _error_response(ctx: Context, cfg: Config, kind: str, message: str) -> HttpResponse:
    return nyx.ctrl.server_error_detail_for(ctx, cfg, kind, message)

def dispatch(application: Application, req: HttpRequest) -> HttpResponse:
    cfg: Config = application.config
    rid: str = nox.uuid.uuid4()
    nyx.runtime.begin(rid, nox.time.now_ms(), cfg.locale)
    nyx.runtime.set_request_target(req.target)
    path: str = nyx.params.path_only(req.target)
    routed: HttpRequest = HttpRequest(req.method, path, req.body, req.headers)
    empty_params: dict[str, str] = {}
    err_ctx: Context = Context(routed, empty_params)
    resp: HttpResponse = HttpResponse(500, "", {})
    try:
        try:
            resp = application.router.dispatch(routed)
        except ModelError as e:
            resp = _error_response(err_ctx, cfg, "ModelError", e.message)
        except AppError as e:
            resp = _error_response(err_ctx, cfg, "AppError", e.message)
        except DbError as e:
            resp = _error_response(err_ctx, cfg, "DbError", e.message)
        except:
            resp = _error_response(err_ctx, cfg, "Error", "unhandled exception")
    finally:
        nyx.runtime.end()
    return resp
