# nyx.app - Application boot + request lifecycle.
#
# # Boot once (Nox >= 1.10 module globals), then serve:
# cfg: Config = nyx.config.load()
# application: Application = nyx.app.boot(cfg, setup)
#
# def handle(req: HttpRequest) -> HttpResponse:
#     return nyx.app.dispatch(application, req)
#
# nox.http.serve(8080, handle)
# # TLS / WS (Nox >= 1.22): serve_tls / serve_ws / serve_ws_tls - see nyx.server
#
# nox.http.serve* needs a top-level bare function name; the Application
# and Router live in module globals (per-worker / thread-local in multicore).

import nox.http
import nox.log
import nox.time
import nox.uuid
import nox.strings
import nox.fs
import nox.json
from nox.http import HttpRequest, HttpResponse
from nox.router import Router, Context
from nox.sqlite import Connection
from nox.postgres import Connection as PgConnection
from nox.mysql import Connection as MysqlConnection
import nyx.config
import nyx.db
import nyx.runtime
import nyx.session
import nyx.session_store
import nyx.session_store_pg
import nyx.session_store_mysql
import nyx.cookie
import nyx.csrf
import nyx.response
import nyx.security
import nyx.ctrl
import nyx.params
import nyx.rate_limit
import nyx.metrics
import nyx.job
from nyx.config import Config
from nyx.runtime import RequestBag
from nyx.cookie import CookieError
from nyx.db import DbError
from nyx.model import ModelError
from nyx.rate_limit import MemoryStore

class AppError(Exception):
    pass

_rate_store: MemoryStore = nyx.rate_limit.open_memory()

class Application:
    def __init__(
        self: Application,
        cfg: Config,
        conn: Connection,
        router: Router,
        dialect: str,
        jobs: Connection,
        pg_list: list[PgConnection],
        my_list: list[MysqlConnection],
        hooks: list[() -> None]
    ) -> None:
        self.config = cfg
        self.db = conn
        self.router = router
        self.dialect = dialect
        self.jobs_db = jobs
        self._pg = pg_list
        self._my = my_list
        self._shutdown_hooks = hooks
        self._closed = False

def db(application: Application) -> Connection:
    return application.db

def jobs_db(application: Application) -> Connection:
    return application.jobs_db

def config(application: Application) -> Config:
    return application.config

def has_pg(application: Application) -> bool:
    return len(application._pg) > 0

def pg(application: Application) -> PgConnection:
    if len(application._pg) == 0:
        raise AppError("Application.pg is empty (dialect is not postgres)")
    return application._pg[0]

def has_mysql(application: Application) -> bool:
    return len(application._my) > 0

def mysql(application: Application) -> MysqlConnection:
    if len(application._my) == 0:
        raise AppError("Application.mysql is empty (dialect is not mysql)")
    return application._my[0]

def _is_placeholder_secret(secret: str) -> bool:
    if nox.strings.contains(secret, "change-me"):
        return True
    if nox.strings.contains(secret, "nyx-dev-secret"):
        return True
    if nox.strings.contains(secret, "nyx-test-secret"):
        return True
    return False

def on_shutdown(application: Application, run: () -> None) -> None:
    hooks: list[() -> None] = application._shutdown_hooks
    hooks.append(run)
    application._shutdown_hooks = hooks

def shutdown(application: Application) -> None:
    if application._closed:
        return
    application._closed = True
    i: int = len(application._shutdown_hooks) - 1
    while i >= 0:
        try:
            application._shutdown_hooks[i]()
        except:
            nox.log.error("nyx.app.shutdown: hook failed")
        i = i - 1
    if len(application._pg) > 0:
        try:
            application._pg[0].close()
        except:
            nox.log.error("nyx.app.shutdown: postgres close failed")
    if len(application._my) > 0:
        try:
            application._my[0].close()
        except:
            nox.log.error("nyx.app.shutdown: mysql close failed")
    try:
        application.jobs_db.close()
    except:
        nox.log.error("nyx.app.shutdown: jobs_db close failed")
    try:
        application.db.close()
    except:
        nox.log.error("nyx.app.shutdown: db close failed")

def mount_health(application: Application) -> None:
    def health(ctx: Context) -> HttpResponse:
        return nyx.ctrl.json(200, "{\"status\":\"ok\"}")

    def ready(ctx: Context) -> HttpResponse:
        try:
            if application.dialect == "postgres":
                application._pg[0].query("SELECT 1")
            elif application.dialect == "mysql":
                application._my[0].query("SELECT 1")
            else:
                application.db.query("SELECT 1")
            application.jobs_db.query("SELECT 1")
            return nyx.ctrl.json(200, "{\"status\":\"ready\"}")
        except DbError:
            return nyx.ctrl.json(503, "{\"status\":\"not_ready\"}")
        except:
            return nyx.ctrl.json(503, "{\"status\":\"not_ready\"}")

    def metrics_handler(ctx: Context) -> HttpResponse:
        if not application.config.metrics_enabled:
            return nyx.ctrl.not_found()
        headers: dict[str, str] = {}
        headers["Content-Type"] = "text/plain; version=0.0.4; charset=utf-8"
        return HttpResponse(200, nyx.metrics.prometheus_text(), headers)

    application.router.get("/health", health)
    application.router.get("/healthz", health)
    application.router.get("/ready", ready)
    if application.config.metrics_enabled:
        application.router.get("/metrics", metrics_handler)

def boot(cfg: Config, setup: (Application) -> None) -> Application:
    if len(cfg.secret_key) < 16:
        raise AppError("secret_key must be at least 16 characters")
    if cfg.is_production() and len(cfg.secret_key) < 32:
        raise AppError("production secret_key must be at least 32 characters")
    if cfg.is_production() and _is_placeholder_secret(cfg.secret_key):
        raise AppError("production secret_key looks like a placeholder; set NYX_SECRET_KEY")
    dialect: str = nyx.db.dialect_of_url(cfg.db_path)
    if dialect == "":
        dialect = "sqlite"
    pg_list: list[PgConnection] = []
    my_list: list[MysqlConnection] = []
    conn: Connection = nyx.db.open(":memory:")
    if dialect == "postgres":
        pg_list.append(nyx.db.open_postgres(cfg.db_path))
        if cfg.auto_migrate:
            if nox.fs.exists(cfg.migrate_path) and nox.fs.is_dir(cfg.migrate_path):
                try:
                    nyx.db.migrate_postgres(pg_list[0], cfg.migrate_path)
                except DbError:
                    raise AppError("postgres migration failed: " + cfg.migrate_path)
            else:
                if cfg.is_production():
                    raise AppError("migration directory missing: " + cfg.migrate_path)
    elif dialect == "mysql":
        try:
            my_list.append(nyx.db.open_mysql(cfg.db_path))
        except DbError as e:
            raise AppError("mysql open failed: " + e.message)
        if cfg.auto_migrate:
            if nox.fs.exists(cfg.migrate_path) and nox.fs.is_dir(cfg.migrate_path):
                try:
                    nyx.db.migrate_mysql(my_list[0], cfg.migrate_path)
                except DbError as e_my:
                    raise AppError("mysql migration failed: " + e_my.message)
            else:
                if cfg.is_production():
                    raise AppError("migration directory missing: " + cfg.migrate_path)
    elif dialect == "sqlite":
        conn = nyx.db.open(cfg.db_path)
        if cfg.auto_migrate:
            if nox.fs.exists(cfg.migrate_path) and nox.fs.is_dir(cfg.migrate_path):
                try:
                    nyx.db.migrate(conn, cfg.migrate_path)
                except DbError:
                    raise AppError("migration failed: " + cfg.migrate_path)
            else:
                if cfg.is_production():
                    raise AppError("migration directory missing: " + cfg.migrate_path)
    else:
        raise AppError("unsupported db dialect: " + dialect)
    jobs: Connection = nyx.db.open(cfg.jobs_db_path)
    hooks: list[() -> None] = []
    application: Application = Application(cfg, conn, Router(), dialect, jobs, pg_list, my_list, hooks)
    if cfg.session_store == "db":
        if dialect == "postgres":
            nyx.session_store_pg.ensure_schema(pg_list[0])
        elif dialect == "mysql":
            nyx.session_store_mysql.ensure_schema(my_list[0])
        else:
            nyx.session_store.ensure_schema(application.db)
    nyx.job.ensure_schema(application.jobs_db)
    if cfg.rate_limit_enabled and cfg.rate_limit_store == "db":
        nyx.rate_limit.ensure_schema(application.jobs_db)
    _install_framework_middleware(application)
    mount_health(application)
    setup(application)
    return application

def _install_framework_middleware(application: Application) -> None:
    cfg: Config = application.config
    router: Router = application.router
    if cfg.rate_limit_enabled:
        router.use_before(_rate_limit_before(application))
    if cfg.session_enabled:
        if cfg.session_store == "db":
            if application.dialect == "postgres":
                router.use_before(_session_pg_before(application))
                router.use_after(_session_pg_after(application))
            elif application.dialect == "mysql":
                router.use_before(_session_my_before(application))
                router.use_after(_session_my_after(application))
            else:
                router.use_before(_session_db_before(application))
                router.use_after(_session_db_after(application))
        else:
            router.use_before(_session_before(cfg))
            router.use_after(_session_after(cfg))
    if cfg.csrf_enabled:
        if cfg.csrf_api_exempt:
            router.use_before(nyx.csrf.protect_api_exempt(cfg.secret_key))
        else:
            router.use_before(nyx.csrf.protect(cfg.secret_key))
    if cfg.security_headers:
        router.use_after(nyx.security.headers_after(cfg))
    if cfg.metrics_enabled:
        router.use_after(_metrics_after())
    if cfg.log_requests:
        router.use_after(_log_after(cfg))

def _header_get(headers: dict[str, str], name: str) -> str | None:
    try:
        return headers[name]
    except KeyError:
        a: int = 0
    lower: str = nox.strings.lower(name)
    try:
        return headers[lower]
    except KeyError:
        b: int = 0
    if lower == "cookie":
        try:
            return headers["Cookie"]
        except KeyError:
            c: int = 0
        try:
            return headers["cookie"]
        except KeyError:
            d: int = 0
    return None

def _first_xff_ip(raw: str) -> str:
    parts: list[str] = nox.strings.split(raw, ",")
    if len(parts) == 0:
        return ""
    return nox.strings.trim(parts[0])

def _peer_ip(peer_addr: str) -> str:
    if len(peer_addr) == 0:
        return ""
    # Nox 1.142.10: IPv4 "a.b.c.d:port", IPv6 "[addr]:port".
    if peer_addr[0] == "[":
        end: int = nox.strings.index_of(peer_addr, "]")
        if end > 1:
            ip: str = ""
            i: int = 1
            while i < end:
                ip = ip + peer_addr[i]
                i = i + 1
            return ip
    parts: list[str] = nox.strings.split(peer_addr, ":")
    if len(parts) == 0:
        return ""
    return parts[0]

def _proxy_allows(cfg: Config, peer_ip: str) -> bool:
    if len(peer_ip) == 0:
        return False
    parts: list[str] = nox.strings.split(cfg.trusted_proxies, ",")
    i: int = 0
    while i < len(parts):
        if nox.strings.trim(parts[i]) == peer_ip:
            return True
        i = i + 1
    return False

def _client_key(cfg: Config, ctx: Context) -> str:
    # peer_addr is "ip:port" (Nox >= 1.127). Empty peer (constructed tests,
    # dispatch_from_parts) keeps the shared "direct" bucket.
    # trust off: real peers are keyed by their own IP; X-Forwarded-For is ignored.
    # trust on + empty trusted_proxies: operator asserts the edge; first XFF hop.
    # trust on + trusted_proxies: XFF only when the connecting IP is in that list.
    peer: str = _peer_ip(ctx.request.peer_addr)
    if not cfg.trust_x_forwarded_for:
        if len(peer) == 0:
            return "direct"
        return peer
    use_xff: bool = True
    if len(cfg.trusted_proxies) > 0:
        use_xff = _proxy_allows(cfg, peer)
    if not use_xff:
        if len(peer) == 0:
            return "direct"
        return peer
    xf: str | None = _header_get(ctx.request.headers, "X-Forwarded-For")
    if xf == None:
        if len(peer) == 0:
            return "direct"
        return peer
    else:
        ip: str = _first_xff_ip(xf)
        if len(ip) == 0:
            if len(peer) == 0:
                return "direct"
            return peer
        return ip

def _is_auth_path(path: str) -> bool:
    if path == "/login" or path == "/register" or path == "/logout":
        return True
    if path == "/password/reset" or path == "/password/forgot":
        return True
    if nox.strings.contains(path, "/auth/"):
        return True
    return False

def _rate_limit_before(application: Application) -> (Context) -> HttpResponse | None:
    def handler(ctx: Context) -> HttpResponse | None:
        cfg: Config = application.config
        path: str = nyx.params.path_only(ctx.request.target)
        key: str = path + ":" + _client_key(cfg, ctx)
        limit: int = cfg.rate_limit_max
        if _is_auth_path(path):
            limit = cfg.rate_limit_auth_max
        allowed: bool = False
        if cfg.rate_limit_store == "db":
            allowed = nyx.rate_limit.allow_db(
                application.jobs_db, key, limit, cfg.rate_limit_window_ms
            )
        else:
            allowed = nyx.rate_limit.allow(_rate_store, key, limit, cfg.rate_limit_window_ms)
        if not allowed:
            nyx.metrics.inc_rate_limited()
            return nyx.ctrl.json(429, "{\"error\":\"rate_limited\"}")
        return None
    return handler

def _ensure_session_seed(cfg: Config) -> None:
    # CSRF form tokens need a stable cookie across GET→POST. Only dirty+HMAC
    # when CSRF is on. Stateless/API paths stay clean (no Set-Cookie on empty).
    if not cfg.csrf_enabled:
        return
    sess: str = nyx.runtime.session_json()
    if len(sess) == 0 or sess == "{}":
        seed: str = nox.uuid.uuid4()
        nyx.runtime.set_session("{\"_nyx\":" + nox.json.dump_string(seed) + "}")

def _load_session_from_cookie(cfg: Config, raw: str) -> None:
    try:
        cookies: dict[str, str] = nyx.cookie.parse(raw)
        val: str = cookies[cfg.session_cookie]
        data: str | None = nyx.session.load(cfg.secret_key, val)
        if data == None and len(cfg.secret_key_previous) > 0:
            data = nyx.session.load(cfg.secret_key_previous, val)
        if data != None:
            nyx.runtime.load_session(data)
        else:
            nyx.runtime.load_session("{}")
            _ensure_session_seed(cfg)
    except KeyError:
        nyx.runtime.load_session("{}")
        _ensure_session_seed(cfg)
    except CookieError:
        nyx.runtime.load_session("{}")
        _ensure_session_seed(cfg)

def _session_before(cfg: Config) -> (Context) -> HttpResponse | None:
    def handler(ctx: Context) -> HttpResponse | None:
        raw: str | None = _header_get(ctx.request.headers, "Cookie")
        if raw != None:
            _load_session_from_cookie(cfg, raw)
        else:
            nyx.runtime.load_session("{}")
            _ensure_session_seed(cfg)
        return None
    return handler

def _session_after(cfg: Config) -> (Context, HttpResponse) -> HttpResponse:
    def handler(ctx: Context, resp: HttpResponse) -> HttpResponse:
        if not nyx.runtime.is_session_dirty():
            return resp
        if nyx.runtime.should_expire_session_cookie():
            nyx.runtime.clear_expire_session_cookie()
            expired: str = nyx.cookie.serialize(
                cfg.session_cookie,
                "deleted",
                "/",
                0,
                True,
                "Lax",
                cfg.secure_cookies
            )
            return nyx.response.with_header(resp, "Set-Cookie", expired)
        token: str = nyx.session.create(cfg.secret_key, nyx.runtime.session_json(), cfg.session_max_age)
        set_cookie: str = nyx.cookie.serialize(
            cfg.session_cookie,
            token,
            "/",
            cfg.session_max_age,
            True,
            "Lax",
            cfg.secure_cookies
        )
        return nyx.response.with_header(resp, "Set-Cookie", set_cookie)
    return handler

def _session_db_before(application: Application) -> (Context) -> HttpResponse | None:
    cfg: Config = application.config
    def handler(ctx: Context) -> HttpResponse | None:
        nyx.runtime.set_session_sid("")
        raw: str | None = _header_get(ctx.request.headers, "Cookie")
        if raw == None:
            nyx.runtime.load_session("{}")
            _ensure_session_seed(cfg)
            return None
        else:
            raw_s: str = raw
            try:
                cookies: dict[str, str] = nyx.cookie.parse(raw_s)
                val: str = cookies[cfg.session_cookie]
                sid: str | None = nyx.session_store.sid_from_cookie_value_rotated(
                    cfg.secret_key, cfg.secret_key_previous, val
                )
                if sid == None:
                    nyx.runtime.load_session("{}")
                    _ensure_session_seed(cfg)
                    return None
                else:
                    sid_s: str = sid
                    data: str | None = nyx.session_store.load_sid(application.db, sid_s)
                    if data == None:
                        nyx.runtime.load_session("{}")
                        _ensure_session_seed(cfg)
                        return None
                    else:
                        nyx.runtime.set_session_sid(sid_s)
                        nyx.runtime.load_session(data)
            except KeyError:
                nyx.runtime.load_session("{}")
                _ensure_session_seed(cfg)
            except CookieError:
                nyx.runtime.load_session("{}")
                _ensure_session_seed(cfg)
            return None
    return handler

def _session_db_after(application: Application) -> (Context, HttpResponse) -> HttpResponse:
    cfg: Config = application.config
    def handler(ctx: Context, resp: HttpResponse) -> HttpResponse:
        if not nyx.runtime.is_session_dirty():
            return resp
        if nyx.runtime.should_expire_session_cookie():
            old: str = nyx.runtime.session_sid()
            if len(old) > 0:
                nyx.session_store.destroy_sid(application.db, old)
            nyx.runtime.set_session_sid("")
            nyx.runtime.clear_expire_session_cookie()
            nyx.runtime.clear_session_rotate()
            expired: str = nyx.cookie.serialize(
                cfg.session_cookie,
                "deleted",
                "/",
                0,
                True,
                "Lax",
                cfg.secure_cookies
            )
            return nyx.response.with_header(resp, "Set-Cookie", expired)
        data: str = nyx.runtime.session_json()
        uid: int = nyx.session_store.user_id_from_session_json(data)
        sid: str = nyx.runtime.session_sid()
        if nyx.runtime.is_session_rotate() and len(sid) > 0:
            nyx.session_store.destroy_sid(application.db, sid)
            sid = ""
            nyx.runtime.set_session_sid("")
            nyx.runtime.clear_session_rotate()
        if len(sid) == 0:
            sid = nyx.session_store.create_sid(application.db, data, cfg.session_max_age, uid)
            nyx.runtime.set_session_sid(sid)
        else:
            nyx.session_store.save_sid(application.db, sid, data, cfg.session_max_age, uid)
        token: str = nyx.session_store.cookie_value_for_sid(cfg.secret_key, sid, cfg.session_max_age)
        set_cookie: str = nyx.cookie.serialize(
            cfg.session_cookie,
            token,
            "/",
            cfg.session_max_age,
            True,
            "Lax",
            cfg.secure_cookies
        )
        return nyx.response.with_header(resp, "Set-Cookie", set_cookie)
    return handler

def _session_pg_before(application: Application) -> (Context) -> HttpResponse | None:
    cfg: Config = application.config
    def handler(ctx: Context) -> HttpResponse | None:
        nyx.runtime.set_session_sid("")
        raw: str | None = _header_get(ctx.request.headers, "Cookie")
        if raw == None:
            nyx.runtime.load_session("{}")
            _ensure_session_seed(cfg)
            return None
        else:
            raw_s: str = raw
            try:
                cookies: dict[str, str] = nyx.cookie.parse(raw_s)
                val: str = cookies[cfg.session_cookie]
                sid: str | None = nyx.session_store.sid_from_cookie_value_rotated(
                    cfg.secret_key, cfg.secret_key_previous, val
                )
                if sid == None:
                    nyx.runtime.load_session("{}")
                    _ensure_session_seed(cfg)
                    return None
                else:
                    sid_s: str = sid
                    data: str | None = nyx.session_store_pg.load_sid(pg(application), sid_s)
                    if data == None:
                        nyx.runtime.load_session("{}")
                        _ensure_session_seed(cfg)
                        return None
                    else:
                        nyx.runtime.set_session_sid(sid_s)
                        nyx.runtime.load_session(data)
            except KeyError:
                nyx.runtime.load_session("{}")
                _ensure_session_seed(cfg)
            except CookieError:
                nyx.runtime.load_session("{}")
                _ensure_session_seed(cfg)
            return None
    return handler

def _session_pg_after(application: Application) -> (Context, HttpResponse) -> HttpResponse:
    cfg: Config = application.config
    def handler(ctx: Context, resp: HttpResponse) -> HttpResponse:
        if not nyx.runtime.is_session_dirty():
            return resp
        pdb: PgConnection = pg(application)
        if nyx.runtime.should_expire_session_cookie():
            old: str = nyx.runtime.session_sid()
            if len(old) > 0:
                nyx.session_store_pg.destroy_sid(pdb, old)
            nyx.runtime.set_session_sid("")
            nyx.runtime.clear_expire_session_cookie()
            nyx.runtime.clear_session_rotate()
            expired: str = nyx.cookie.serialize(
                cfg.session_cookie,
                "deleted",
                "/",
                0,
                True,
                "Lax",
                cfg.secure_cookies
            )
            return nyx.response.with_header(resp, "Set-Cookie", expired)
        data: str = nyx.runtime.session_json()
        uid: int = nyx.session_store.user_id_from_session_json(data)
        sid: str = nyx.runtime.session_sid()
        if nyx.runtime.is_session_rotate() and len(sid) > 0:
            nyx.session_store_pg.destroy_sid(pdb, sid)
            sid = ""
            nyx.runtime.set_session_sid("")
            nyx.runtime.clear_session_rotate()
        if len(sid) == 0:
            sid = nyx.session_store_pg.create_sid(pdb, data, cfg.session_max_age, uid)
            nyx.runtime.set_session_sid(sid)
        else:
            nyx.session_store_pg.save_sid(pdb, sid, data, cfg.session_max_age, uid)
        token: str = nyx.session_store.cookie_value_for_sid(cfg.secret_key, sid, cfg.session_max_age)
        set_cookie: str = nyx.cookie.serialize(
            cfg.session_cookie,
            token,
            "/",
            cfg.session_max_age,
            True,
            "Lax",
            cfg.secure_cookies
        )
        return nyx.response.with_header(resp, "Set-Cookie", set_cookie)
    return handler

def _session_my_before(application: Application) -> (Context) -> HttpResponse | None:
    cfg: Config = application.config
    def handler(ctx: Context) -> HttpResponse | None:
        nyx.runtime.set_session_sid("")
        raw: str | None = _header_get(ctx.request.headers, "Cookie")
        if raw == None:
            nyx.runtime.load_session("{}")
            _ensure_session_seed(cfg)
            return None
        else:
            raw_s: str = raw
            try:
                cookies: dict[str, str] = nyx.cookie.parse(raw_s)
                val: str = cookies[cfg.session_cookie]
                sid: str | None = nyx.session_store.sid_from_cookie_value_rotated(
                    cfg.secret_key, cfg.secret_key_previous, val
                )
                if sid == None:
                    nyx.runtime.load_session("{}")
                    _ensure_session_seed(cfg)
                    return None
                else:
                    sid_s: str = sid
                    data: str | None = nyx.session_store_mysql.load_sid(mysql(application), sid_s)
                    if data == None:
                        nyx.runtime.load_session("{}")
                        _ensure_session_seed(cfg)
                        return None
                    else:
                        nyx.runtime.set_session_sid(sid_s)
                        nyx.runtime.load_session(data)
            except KeyError:
                nyx.runtime.load_session("{}")
                _ensure_session_seed(cfg)
            except CookieError:
                nyx.runtime.load_session("{}")
                _ensure_session_seed(cfg)
            return None
    return handler

def _session_my_after(application: Application) -> (Context, HttpResponse) -> HttpResponse:
    cfg: Config = application.config
    def handler(ctx: Context, resp: HttpResponse) -> HttpResponse:
        if not nyx.runtime.is_session_dirty():
            return resp
        mdb: MysqlConnection = mysql(application)
        if nyx.runtime.should_expire_session_cookie():
            old: str = nyx.runtime.session_sid()
            if len(old) > 0:
                nyx.session_store_mysql.destroy_sid(mdb, old)
            nyx.runtime.set_session_sid("")
            nyx.runtime.clear_expire_session_cookie()
            nyx.runtime.clear_session_rotate()
            expired: str = nyx.cookie.serialize(
                cfg.session_cookie,
                "deleted",
                "/",
                0,
                True,
                "Lax",
                cfg.secure_cookies
            )
            return nyx.response.with_header(resp, "Set-Cookie", expired)
        data: str = nyx.runtime.session_json()
        uid: int = nyx.session_store.user_id_from_session_json(data)
        sid: str = nyx.runtime.session_sid()
        if nyx.runtime.is_session_rotate() and len(sid) > 0:
            nyx.session_store_mysql.destroy_sid(mdb, sid)
            sid = ""
            nyx.runtime.set_session_sid("")
            nyx.runtime.clear_session_rotate()
        if len(sid) == 0:
            sid = nyx.session_store_mysql.create_sid(mdb, data, cfg.session_max_age, uid)
            nyx.runtime.set_session_sid(sid)
        else:
            nyx.session_store_mysql.save_sid(mdb, sid, data, cfg.session_max_age, uid)
        token: str = nyx.session_store.cookie_value_for_sid(cfg.secret_key, sid, cfg.session_max_age)
        set_cookie: str = nyx.cookie.serialize(
            cfg.session_cookie,
            token,
            "/",
            cfg.session_max_age,
            True,
            "Lax",
            cfg.secure_cookies
        )
        return nyx.response.with_header(resp, "Set-Cookie", set_cookie)
    return handler

def _metrics_after() -> (Context, HttpResponse) -> HttpResponse:
    def handler(ctx: Context, resp: HttpResponse) -> HttpResponse:
        nyx.metrics.inc_requests()
        if resp.status >= 500:
            nyx.metrics.inc_5xx()
        return resp
    return handler

def _log_after(cfg: Config) -> (Context, HttpResponse) -> HttpResponse:
    def handler(ctx: Context, resp: HttpResponse) -> HttpResponse:
        elapsed: int = nox.time.now_ms() - nyx.runtime.started_ms()
        if cfg.log_json:
            line: str = "{"
            line = line + "\"request_id\":" + nox.json.dump_string(nyx.runtime.request_id()) + ","
            line = line + "\"method\":" + nox.json.dump_string(ctx.request.method) + ","
            line = line + "\"path\":" + nox.json.dump_string(ctx.request.target) + ","
            line = line + "\"status\":" + str(resp.status) + ","
            line = line + "\"ms\":" + str(elapsed) + ","
            line = line + "\"user_id\":" + nox.json.dump_string(nyx.runtime.current_user_id())
            line = line + "}"
            nox.log.info(line)
        else:
            nox.log.info(
                ctx.request.method + " " + ctx.request.target + " -> " + str(resp.status) + " " + str(elapsed) + "ms id=" + nyx.runtime.request_id()
            )
        return resp
    return handler

def _error_response(ctx: Context, cfg: Config, kind: str, message: str, line: int) -> HttpResponse:
    return nyx.ctrl.server_error_detail_for(ctx, cfg, kind, message, line)

EMPTY_HEADERS: dict[str, str] = {}

def dispatch(application: Application, req: HttpRequest) -> HttpResponse:
    cfg: Config = application.config
    rid: str = ""
    if cfg.request_id:
        rid = nox.uuid.uuid4()
    started: int = 0
    if cfg.request_id or cfg.log_requests:
        started = nox.time.now_ms()
    want_tl: bool = cfg.request_id or cfg.log_requests or cfg.session_enabled or cfg.csrf_enabled
    if want_tl:
        nyx.runtime.begin(rid, started, cfg.locale)
        nyx.runtime.set_request_target(req.target)
    path: str = nyx.params.path_only(req.target)
    routed: HttpRequest = HttpRequest(req.method, path, req.body, req.headers, req.peer_addr)
    empty_params: dict[str, str] = {}
    err_ctx: Context = Context(routed, empty_params)
    resp: HttpResponse = HttpResponse(500, "", {})
    counted: bool = False
    try:
        try:
            resp = application.router.dispatch(routed)
            counted = True
        except ModelError as e:
            resp = _error_response(err_ctx, cfg, "ModelError", e.message, e.line)
        except AppError as e:
            resp = _error_response(err_ctx, cfg, "AppError", e.message, e.line)
        except DbError as e:
            resp = _error_response(err_ctx, cfg, "DbError", e.message, e.line)
        except Exception as e:
            resp = _error_response(err_ctx, cfg, "Exception", e.message, e.line)
        # Router after-middleware may not run on exceptions caught here.
        if not counted and cfg.metrics_enabled:
            nyx.metrics.inc_requests()
            if resp.status >= 500:
                nyx.metrics.inc_5xx()
    finally:
        if want_tl:
            nyx.runtime.end()
    return resp

# Nox 1.29.2+: do not pass req into dispatch — reading req.headers marks
# iterateHeaders required. Parts + EMPTY_HEADERS enables handle_bare.
def dispatch_from_parts(
    application: Application,
    method: str,
    target: str,
    body: str,
    headers: dict[str, str]
) -> HttpResponse:
    req: HttpRequest = HttpRequest(method, target, body, headers, "")
    return dispatch(application, req)
