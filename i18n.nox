# nyx.i18n - config/locales/{locale}.json (duz anahtar -> metin).
#
# import nyx.i18n
#
# nyx.i18n.load("config/locales", "tr")
# nyx.i18n.load("config/locales", "en")
# nyx.i18n.set_locale("tr")
# msg: str = nyx.i18n.t("greeting")
# ctx: dict[str, str] = {}
# ctx["name"] = "Ada"
# msg2: str = nyx.i18n.t_with("welcome", ctx)
#
# Katalog, aktif locale ve varsayilan locale bu worker'in modul kutusundadir.
# Her worker boot'ta load() cagirir. Ortam degiskeni kullanilmaz.

import nox.fs
import nox.path
import nox.json
import nox.template
from nox.json import JsonValue

class I18nError(Exception):
    pass

class _Catalog:
    bundles: dict[str, str]
    current: str
    fallback: str

    def __init__(self: _Catalog) -> None:
        self.bundles = {}
        self.current = "en"
        self.fallback = "en"

_catalog: _Catalog = _Catalog()

def _bundle_raw(locale: str) -> str:
    if locale in _catalog.bundles:
        return _catalog.bundles[locale]
    return ""

# 'dir_path/{locale}.json' dosyasini okuyup duz (ic ice olmayan, tum
# degerleri metin) bir nesne oldugunu dogrular. Ayni locale tekrar
# yuklenirse onceki icerik degisir.
def load(dir_path: str, locale: str) -> None:
    file_path: str = nox.path.join(dir_path, locale + ".json")
    if not nox.fs.exists(file_path):
        raise I18nError("locale dosyasi yok: " + file_path)
    raw: str = nox.fs.read_to_string(file_path)
    v: JsonValue = nox.json.parse(raw)
    if not nox.json.is_object(v):
        raise I18nError("locale JSON bir nesne olmali: " + file_path)
    i: int = 0
    n: int = nox.json.object_len(v)
    while i < n:
        val_v: JsonValue = nox.json.object_value(v, i)
        if not nox.json.is_string(val_v):
            raise I18nError("locale degeri metin olmali: " + nox.json.object_key(v, i))
        i = i + 1
    _catalog.bundles[locale] = raw

def is_loaded(locale: str) -> bool:
    return len(_bundle_raw(locale)) > 0

def set_locale(locale: str) -> None:
    _catalog.current = locale

def current_locale() -> str:
    return _catalog.current

def set_default_locale(locale: str) -> None:
    _catalog.fallback = locale

def default_locale() -> str:
    return _catalog.fallback

def _lookup(locale: str, key: str) -> str | None:
    raw: str = _bundle_raw(locale)
    if len(raw) == 0:
        return None
    v: JsonValue = nox.json.parse(raw)
    i: int = 0
    n: int = nox.json.object_len(v)
    while i < n:
        if nox.json.object_key(v, i) == key:
            return nox.json.as_string(nox.json.object_value(v, i))
        i = i + 1
    return None

# Aktif locale'de 'key' bulunamazsa varsayilan locale'e duser; o da yoksa
# "translation missing: ..." yer tutucusu doner.
def t(key: str) -> str:
    val: str | None = _lookup(current_locale(), key)
    if val == None:
        val = _lookup(default_locale(), key)
    if val != None:
        return val
    return "translation missing: " + current_locale() + "." + key

# '{{ degisken }}' yer tutucularini context ile doldurur (HTML kacisli).
def t_with(key: str, context: dict[str, str]) -> str:
    return nox.template.render(t(key), context)

def t_with_unescaped(key: str, context: dict[str, str]) -> str:
    return nox.template.render_unescaped(t(key), context)
