import nox.test
import nox.fs
import nox.strings
import nyx.view
import nyx.ctrl
import nyx.db
import nyx.model
from nox.http import HttpResponse, HttpRequest
from nox.router import Context
from nyx.model import Record, Attributes
from nox.sqlite import Connection

path: str = "/tmp/nyx_view_test.html"
nox.fs.write_string(path, "<h1>{{ title }}</h1>")
ctx: dict[str, str] = {}
ctx["title"] = "Merhaba"
html: str = nyx.view.render(path, ctx)
nox.test.assert_eq_str(html, "<h1>Merhaba</h1>", "render")

resp: HttpResponse = nyx.ctrl.redirect("/x")
nox.test.assert_eq_int(resp.status, 302, "redirect status")
nox.test.assert_eq_str(resp.headers["Location"], "/x", "redirect loc")

r2: HttpResponse = nyx.ctrl.render(200, path, ctx)
nox.test.assert_eq_int(r2.status, 200, "ctrl render")
nox.test.assert_eq_str(r2.body, "<h1>Merhaba</h1>", "ctrl body")

layout_path: str = "/tmp/nyx_layout_test.html"
nox.fs.write_string(layout_path, "<html><body>{{ yield }}</body></html>")
r3: HttpResponse = nyx.ctrl.render_layout(200, layout_path, path, ctx)
nox.test.assert_eq_int(r3.status, 200, "render_layout status")
nox.test.assert_true(nox.strings.contains(r3.body, "<html><body>"), "render_layout govdesi layout icermeli")
nox.test.assert_true(nox.strings.contains(r3.body, "<h1>Merhaba</h1>"), "render_layout govdesi view icermeli")

no_headers: dict[str, str] = {}
req_no_referer: HttpRequest = HttpRequest("GET", "/posts", "", no_headers)
params_empty: dict[str, str] = {}
ctx_no_referer: Context = Context(req_no_referer, params_empty)
r4: HttpResponse = nyx.ctrl.redirect_back(ctx_no_referer, "/anasayfa")
nox.test.assert_eq_int(r4.status, 302, "redirect_back status")
nox.test.assert_eq_str(r4.headers["Location"], "/anasayfa", "referer yoksa fallback kullanilmali")

with_referer: dict[str, str] = {}
with_referer["Referer"] = "/onceki-sayfa"
req_with_referer: HttpRequest = HttpRequest("GET", "/posts", "", with_referer)
ctx_with_referer: Context = Context(req_with_referer, params_empty)
r5: HttpResponse = nyx.ctrl.redirect_back(ctx_with_referer, "/anasayfa")
nox.test.assert_eq_str(r5.headers["Location"], "/onceki-sayfa", "referer varsa ona yonlendirmeli")

r6: HttpResponse = nyx.ctrl.redirect_back_to("", "/fallback")
nox.test.assert_eq_str(r6.headers["Location"], "/fallback", "redirect_back_to bos referer icin fallback kullanmali")

r7: HttpResponse = nyx.ctrl.redirect_back_to("/direkt", "/fallback")
nox.test.assert_eq_str(r7.headers["Location"], "/direkt", "redirect_back_to dolu referer kullanmali")

# --- acik yonlendirme (open redirect) korumasi ---

r_abs: HttpResponse = nyx.ctrl.redirect_back_to("http://evil.example.com/phish", "/fallback")
nox.test.assert_eq_str(r_abs.headers["Location"], "/fallback", "mutlak URL referer reddedilip fallback kullanilmali")

r_proto_relative: HttpResponse = nyx.ctrl.redirect_back_to("//evil.example.com/phish", "/fallback")
nox.test.assert_eq_str(r_proto_relative.headers["Location"], "/fallback", "protokol-goreli (//) referer reddedilip fallback kullanilmali")

r_scheme_embedded: HttpResponse = nyx.ctrl.redirect_back_to("/redirect?to=http://evil.example.com", "/fallback")
nox.test.assert_eq_str(r_scheme_embedded.headers["Location"], "/fallback", "'://' iceren referer reddedilip fallback kullanilmali")

with_evil_referer: dict[str, str] = {}
with_evil_referer["Referer"] = "http://evil.example.com/phish"
req_evil_referer: HttpRequest = HttpRequest("GET", "/posts", "", with_evil_referer)
ctx_evil_referer: Context = Context(req_evil_referer, params_empty)
r_evil: HttpResponse = nyx.ctrl.redirect_back(ctx_evil_referer, "/anasayfa")
nox.test.assert_eq_str(r_evil.headers["Location"], "/anasayfa", "redirect_back mutlak Referer'i reddedip fallback kullanmali")

r8: HttpResponse = nyx.ctrl.unprocessable()
nox.test.assert_eq_int(r8.status, 422, "unprocessable 422 donmeli")

errors: list[str] = []
errors.append("email bos olamaz")
errors.append("isim bos olamaz")
r9: HttpResponse = nyx.ctrl.unprocessable_json(errors)
nox.test.assert_eq_int(r9.status, 422, "unprocessable_json 422 donmeli")
nox.test.assert_true(nox.strings.contains(r9.body, "email bos olamaz"), "unprocessable_json hatalari icermeli")

# render_each: partial per Record (Nox template has no {% for %})
item_path: str = "/tmp/nyx_item_partial.html"
nox.fs.write_string(item_path, "<li>{{ title }}</li>")
vdb: Connection = nyx.db.open(":memory:")
vdb.execute("CREATE TABLE posts (id INTEGER PRIMARY KEY, title TEXT)")
a1: Attributes = nyx.model.attributes()
nyx.model.set_str(a1, "title", "One")
nyx.model.create_attrs(vdb, "posts", a1)
a2: Attributes = nyx.model.attributes()
nyx.model.set_str(a2, "title", "Two")
nyx.model.create_attrs(vdb, "posts", a2)
posts: list[Record] = nyx.model.all(vdb, "posts")
fields: list[str] = []
fields.append("title")
each_html: str = nyx.view.render_records(item_path, posts, fields)
nox.test.assert_true(nox.strings.contains(each_html, "<li>One</li>"), "render_records one")
nox.test.assert_true(nox.strings.contains(each_html, "<li>Two</li>"), "render_records two")
vdb.close()

# --- layout second-pass: body icindeki {{...}} yeniden parse edilmemeli ---
inj_view: str = "/tmp/nyx_layout_inject_view.html"
inj_layout: str = "/tmp/nyx_layout_inject_layout.html"
nox.fs.write_string(inj_view, "<p>{{ title }}</p>")
nox.fs.write_string(inj_layout, "<html><body>{{ yield }}</body></html>")
inj_ctx: dict[str, str] = {}
inj_ctx["title"] = "x {{ admin }} y"
inj_ctx["admin"] = "PWNED"
inj_html: str = nyx.view.render_with_layout(inj_layout, inj_view, inj_ctx)
nox.test.assert_true(nox.strings.contains(inj_html, "x {{ admin }} y"), "body icindeki mustache literal kalmali")
nox.test.assert_true(not nox.strings.contains(inj_html, "PWNED"), "layout second-pass admin genisletmemeli")

print("view_ctrl_test ok")
