import nox.test
import nox.strings
import nyx.db
from nox.sqlite import Connection
from nyx.db import DbError

db: Connection = nyx.db.open_url(":memory:")
db.execute("CREATE TABLE t (id INTEGER PRIMARY KEY);")
db.close()

db2: Connection = nyx.db.open_url("sqlite::memory:")
db2.execute("CREATE TABLE t2 (id INTEGER PRIMARY KEY);")
db2.close()

try:
    nyx.db.open_url("postgresql://user:pass@localhost:5432/app")
    nox.test.assert_true(False, "open_url must reject postgres")
except DbError as e:
    nox.test.assert_true(nox.strings.contains(e.message, "open_postgres"), "points to open_postgres")

try:
    nyx.db.open_url("mysql://user:pass@localhost:3306/app")
    nox.test.assert_true(False, "open_url must reject mysql")
except DbError as e2:
    nox.test.assert_true(nox.strings.contains(e2.message, "open_mysql"), "points to open_mysql")

print("db_url_test ok")
