import nox.test
from nox.http import HttpRequest, HttpResponse
from nox.router import Router, Context
import nyx.routes

router: Router = Router()

def items_post(ctx: Context) -> HttpResponse:
    m: str = nyx.routes.effective_method(ctx)
    headers: dict[str, str] = {}
    return HttpResponse(200, "method=" + m, headers)

router.post("/items/:id", items_post)

headers: dict[str, str] = {}
headers["Content-Type"] = "application/x-www-form-urlencoded"

plain_post: HttpRequest = HttpRequest("POST", "/items/1", "title=x", headers)
plain_resp: HttpResponse = router.dispatch(plain_post)
nox.test.assert_eq_int(plain_resp.status, 200, "duz POST 200 doner")
nox.test.assert_eq_str(plain_resp.body, "method=POST", "_method yoksa etkin metod POST")

put_override: HttpRequest = HttpRequest("POST", "/items/1", "_method=PUT&title=y", headers)
put_resp: HttpResponse = router.dispatch(put_override)
nox.test.assert_eq_str(put_resp.body, "method=PUT", "_method=PUT ile etkin metod PUT")

delete_override: HttpRequest = HttpRequest("POST", "/items/1", "_method=delete", headers)
delete_resp: HttpResponse = router.dispatch(delete_override)
nox.test.assert_eq_str(delete_resp.body, "method=DELETE", "_method kucuk harfli 'delete' de calismali")

bogus_override: HttpRequest = HttpRequest("POST", "/items/1", "_method=TELEPORT", headers)
bogus_resp: HttpResponse = router.dispatch(bogus_override)
nox.test.assert_eq_str(bogus_resp.body, "method=POST", "gecersiz _method degeri POST'a duser")

# GET istekler bu POST-only rotayla eslesmez (gercek HTTP metodu router
# seviyesinde ASLA degistirilmez).
get_req: HttpRequest = HttpRequest("GET", "/items/1", "", {})
get_resp: HttpResponse = router.dispatch(get_req)
nox.test.assert_eq_int(get_resp.status, 404, "GET, POST-only rotayla eslesmemeli")

nox.test.assert_eq_str(nyx.routes.path_index("comments"), "/comments", "path_index")
nox.test.assert_eq_str(nyx.routes.path_new("comments"), "/comments/new", "path_new")
nox.test.assert_eq_str(nyx.routes.path_show("comments", 3), "/comments/3", "path_show")
nox.test.assert_eq_str(nyx.routes.path_edit("comments", 3), "/comments/3/edit", "path_edit")
nox.test.assert_eq_str(nyx.routes.path_destroy("comments", 3), "/comments/3/delete", "path_destroy")
nox.test.assert_eq_str(nyx.routes.path_posts(), "/posts", "path_posts compat")

print("routes_test ok")
