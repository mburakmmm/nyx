# MySQL pool under overlap: cold open, 32 and 64 waiters, then a dead
# connection is dropped and the next checkout can query again.
# Skips unless DATABASE_URL is mysql.

import nox.test
import nox.os
import nox.time
import nox.tasks
import nox.mysql
from nox.tasks import TaskGroup
from nox.os import OsError
from nox.db import Row
from nox.mysql import Connection as MysqlConnection, MysqlError
import nyx.db
import nyx.db_pool
from nyx.db_pool import MysqlPool

def database_url() -> str:
    try:
        return nox.os.getenv("DATABASE_URL")
    except OsError:
        return ""

async def checkout(pool: MysqlPool) -> None:
    conn: MysqlConnection = pool.acquire()
    conn.query("SELECT 1")
    nox.time.sleep_ms(20)
    pool.give_back(conn)

async def wave(pool: MysqlPool, n: int) -> None:
    group: TaskGroup[None] = TaskGroup[None]()
    i: int = 0
    while i < n:
        group.add(spawn checkout(pool))
        i = i + 1
    nox.test.assert_true(group.wait_all(30000), "mysql stress wave finished")
    nox.test.assert_true(pool.open_count() <= pool.size, "mysql stress stays within size")
    nox.test.assert_true(pool.open_count() > 0, "mysql stress opened a connection")
    nox.test.assert_eq_int(pool.idle_count(), pool.open_count(), "mysql stress returned every connection")

async def stress(url: str) -> None:
    pool: MysqlPool = nyx.db_pool.open_mysql(url, 8, 20000)
    nox.test.assert_eq_int(pool.open_count(), 0, "cold mysql pool has not connected")
    wave_job: Task[None] = spawn wave(pool, 32)
    await wave_job
    again: Task[None] = spawn wave(pool, 64)
    await again
    held: MysqlConnection = pool.acquire()
    id_rows: list[Row] = held.query("SELECT CONNECTION_ID()")
    killer: MysqlConnection = pool.acquire()
    killer.execute("KILL " + str(id_rows[0].get_int(0)))
    pool.give_back(killer)
    pool.give_back(held)
    fresh: MysqlConnection = pool.acquire()
    fresh.query("SELECT 1")
    pool.give_back(fresh)
    nox.test.assert_true(pool.open_count() >= 1, "a dropped connection was reopened")
    pool.close()
    nox.test.assert_eq_int(pool.open_count(), 0, "mysql stress pool closed")
    print("v276_mysql_pool_stress_test ok")

async def entry() -> None:
    url: str = database_url()
    if nyx.db.dialect_of_url(url) != "mysql":
        print("v276_mysql_pool_stress_test skipped (no mysql DATABASE_URL)")
        return
    job: Task[None] = spawn stress(url)
    await job

root: Task[None] = spawn entry()
await root
