# Two fibers migrate the same sqlite file. The lock row lives in a side
# database so the waiter yields instead of blocking the thread. The INSERT
# is not idempotent: a second run of the file fails the test.

import nox.fs
import nox.os
import nox.test
import nox.path
import nyx.db
import nyx.testing
from nox.sqlite import Connection
from nox.db import Row

dir_path: str = nyx.testing.scratch("nyx_lock_mig")
if nox.fs.exists(dir_path):
    nox.fs.remove_dir_all(dir_path)
nox.fs.create_dir(dir_path)
nox.fs.write_string(
    nox.path.join(dir_path, "001_once.sql"),
    "CREATE TABLE nyx_lock_probe (id INTEGER PRIMARY KEY);\n"
)
db_path: str = nyx.testing.scratch("nyx_lock.sqlite")
if nox.fs.exists(db_path):
    nox.fs.remove_file(db_path)
lock_path: str = db_path + ".nyx-migrate-lock"
if nox.fs.is_file(lock_path):
    nox.fs.remove_file(lock_path)
if nox.fs.is_dir(lock_path):
    nox.fs.remove_dir_all(lock_path)

a: Connection = nyx.db.open(db_path)
b: Connection = nyx.db.open(db_path)

async def mig_a() -> int:
    return nyx.db.migrate(a, dir_path)

async def mig_b() -> int:
    return nyx.db.migrate(b, dir_path)

task_a: Task[int] = spawn mig_a()
task_b: Task[int] = spawn mig_b()
n_a: int = await task_a
n_b: int = await task_b
print("lock " + str(n_a) + " " + str(n_b))
nox.test.assert_eq_int(n_a + n_b, 1, "one fiber applies the migration")
count_rows: list[Row] = a.query("SELECT COUNT(*) FROM nyx_lock_probe")
nox.test.assert_eq_int(count_rows[0].get_int(0), 0, "the table was created once")
version_rows: list[Row] = a.query("SELECT COUNT(*) FROM schema_migrations")
nox.test.assert_eq_int(version_rows[0].get_int(0), 1, "one migration row")
a.close()
b.close()

nox.os.set_var("NYX_MIGRATE_LOCK_LEASE_MS", "300")
nox.os.set_var("NYX_MIGRATE_LOCK_PAUSE_MS", "900")
nox.test.assert_eq_int(nyx.db.lock_lease_ms(), 300, "short lease is visible")
hold_dir: str = nyx.testing.scratch("nyx_lock_hold_mig")
if nox.fs.exists(hold_dir):
    nox.fs.remove_dir_all(hold_dir)
nox.fs.create_dir(hold_dir)
nox.fs.write_string(
    nox.path.join(hold_dir, "001_hold.sql"),
    "CREATE TABLE nyx_lock_hold (id INTEGER PRIMARY KEY);\n"
)
hold_db: str = nyx.testing.scratch("nyx_lock_hold.sqlite")
if nox.fs.exists(hold_db):
    nox.fs.remove_file(hold_db)
hold_lock: str = hold_db + ".nyx-migrate-lock"
if nox.fs.is_file(hold_lock):
    nox.fs.remove_file(hold_lock)
if nox.fs.is_dir(hold_lock):
    nox.fs.remove_dir_all(hold_lock)
hold_a: Connection = nyx.db.open(hold_db)
hold_b: Connection = nyx.db.open(hold_db)

async def hold_mig() -> int:
    return nyx.db.migrate(hold_a, hold_dir)

async def wait_mig() -> int:
    return nyx.db.migrate(hold_b, hold_dir)

held_task: Task[int] = spawn hold_mig()
wait_task: Task[int] = spawn wait_mig()
held_n: int = await held_task
wait_n: int = await wait_task
print("hold " + str(held_n) + " " + str(wait_n))
nox.test.assert_eq_int(held_n + wait_n, 1, "heartbeat keeps the lease through a long pause")
hold_rows: list[Row] = hold_a.query("SELECT COUNT(*) FROM nyx_lock_hold")
nox.test.assert_eq_int(hold_rows[0].get_int(0), 0, "held migration created the table")
hold_a.close()
hold_b.close()
print("v277_migrate_lock_test ok")
