import nox.test
import nox.fs
import nox.strings
import nyx.storage
from nyx.storage import StorageError

root: str = "/tmp/nyx_storage_test"
if nox.fs.exists(root):
    x: int = 0
else:
    nox.fs.create_dir(root)

key: str = nyx.storage.store(root, "avatar.png", "binary-icerik-verisi")
nox.test.assert_true(len(key) > 0, "store bos olmayan key doner")
nox.test.assert_true(nyx.storage.exists(root, key), "store sonrasi dosya var olmali")

content: str = nyx.storage.read(root, key)
nox.test.assert_eq_str(content, "binary-icerik-verisi", "read yazilan icerigi doner")

nox.test.assert_true(nyx.storage.verify_checksum(root, key), "checksum dogrulanmali")

url: str = nyx.storage.url_path(key)
nox.test.assert_eq_str(url, "/storage/" + key, "url_path dogru onek uretmeli")

traversal_key: str = nyx.storage.store(root, "../../etc/passwd", "zararli")
nox.test.assert_true(not nox.strings.contains(traversal_key, ".."), "path traversal denemesi temizlenmeli")
nox.test.assert_true(nox.strings.contains(traversal_key, "passwd"), "sadece dosya adi (basename) korunmali")
nyx.storage.delete(root, traversal_key)

nyx.storage.delete(root, key)
nox.test.assert_true(not nyx.storage.exists(root, key), "delete sonrasi dosya olmamali")

threw: bool = False
try:
    nyx.storage.read(root, key)
except StorageError:
    threw = True
nox.test.assert_true(threw, "silinen anahtari okumak StorageError firlatir")

threw2: bool = False
try:
    nyx.storage.store(root, "", "icerik")
except StorageError:
    threw2 = True
nox.test.assert_true(threw2, "bos dosya adi StorageError firlatir")

# --- path traversal / mutlak yol / backslash korumasi (path_for uzerinden
# read/delete/exists/metadata_json'a yayilir) ---

threw_dotdot: bool = False
try:
    nyx.storage.read(root, "../../etc/passwd")
except StorageError:
    threw_dotdot = True
nox.test.assert_true(threw_dotdot, "read icin '..' iceren anahtar StorageError firlatir")

threw_dotdot_exists: bool = False
try:
    nyx.storage.exists(root, "foo/../../etc/passwd")
except StorageError:
    threw_dotdot_exists = True
nox.test.assert_true(threw_dotdot_exists, "exists icin '..' iceren anahtar StorageError firlatir")

threw_dotdot_delete: bool = False
try:
    nyx.storage.delete(root, "../escape")
except StorageError:
    threw_dotdot_delete = True
nox.test.assert_true(threw_dotdot_delete, "delete icin '..' iceren anahtar StorageError firlatir")

threw_dotdot_meta: bool = False
try:
    nyx.storage.metadata_json(root, "../escape")
except StorageError:
    threw_dotdot_meta = True
nox.test.assert_true(threw_dotdot_meta, "metadata_json icin '..' iceren anahtar StorageError firlatir")

threw_absolute: bool = False
try:
    nyx.storage.read(root, "/etc/passwd")
except StorageError:
    threw_absolute = True
nox.test.assert_true(threw_absolute, "mutlak yol iceren anahtar StorageError firlatir")

threw_backslash: bool = False
try:
    nyx.storage.read(root, "foo\\bar")
except StorageError:
    threw_backslash = True
nox.test.assert_true(threw_backslash, "backslash iceren anahtar StorageError firlatir")

threw_empty_key: bool = False
try:
    nyx.storage.path_for(root, "")
except StorageError:
    threw_empty_key = True
nox.test.assert_true(threw_empty_key, "bos anahtar path_for icin StorageError firlatir")

bad_method: bool = False
try:
    nyx.storage.store_http("GET", "http://127.0.0.1/x", "body", "text/plain")
except StorageError:
    bad_method = True
nox.test.assert_true(bad_method, "GET store_http reddedilir")

import nox.process
from nox.process import Command, Output

link_root: str = "/tmp/nyx_storage_link_root"
outside: str = "/tmp/nyx_storage_link_out"
if not nox.fs.exists(link_root):
    nox.fs.create_dir(link_root)
if not nox.fs.exists(outside):
    nox.fs.create_dir(outside)
nox.fs.write_string(outside + "/secret.txt", "nope")
ln: Command = Command("ln")
ln.arg("-sfn")
ln.arg(outside)
ln.arg(link_root + "/link")
ln_out: Output = ln.run()
nox.test.assert_eq_int(ln_out.status, 0, "symlink fixture")
escaped: bool = False
try:
    nyx.storage.path_for(link_root, "link/secret.txt")
except StorageError:
    escaped = True
nox.test.assert_true(escaped, "symlink out of root is rejected")

print("storage_test ok")
