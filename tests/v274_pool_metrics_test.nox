# Pool counters and gauge text. No database.

import nox.os
import nox.test
import nox.strings
import nyx.metrics

nyx.metrics.reset()
body: str = nyx.metrics.prometheus_text()
nox.test.assert_true(nox.strings.contains(body, "nyx_db_pool_checkouts_total 0"), "checkouts start at 0")
nox.test.assert_true(nox.strings.contains(body, "nyx_db_pool_checkout_wait_ms_total 0"), "wait starts at 0")
nox.test.assert_true(nox.strings.contains(body, "nyx_db_pool_exhausted_total 0"), "exhausted starts at 0")

nyx.metrics.record_db_checkout(12)
nyx.metrics.record_db_checkout(8)
nyx.metrics.inc_db_pool_exhausted()
nox.test.assert_eq_int(nyx.metrics.db_pool_checkouts(), 2, "two checkouts")
nox.test.assert_eq_int(nyx.metrics.db_pool_checkout_wait_ms(), 20, "wait sums")
nox.test.assert_eq_int(nyx.metrics.db_pool_exhausted(), 1, "one exhaustion")

again: str = nyx.metrics.prometheus_text()
nox.test.assert_true(nox.strings.contains(again, "nyx_db_pool_checkouts_total 2"), "checkout counter")
nox.test.assert_true(nox.strings.contains(again, "nyx_db_pool_checkout_wait_ms_total 20"), "wait counter")
nox.test.assert_true(nox.strings.contains(again, "nyx_db_pool_exhausted_total 1"), "exhausted counter")

gauges: str = nyx.metrics.pool_gauge_text(4, 1, 1)
nox.test.assert_true(nox.strings.contains(gauges, "nyx_db_pool_size 4"), "pool size")
nox.test.assert_true(nox.strings.contains(gauges, "nyx_db_pool_open 1"), "pool open")
nox.test.assert_true(nox.strings.contains(gauges, "nyx_db_pool_idle 1"), "pool idle")

nyx.metrics.record_db_checkout(-5)
nox.test.assert_eq_int(nyx.metrics.db_pool_checkout_wait_ms(), 20, "negative wait is zero")
nyx.metrics.reset()
nyx.metrics.record_pool_worker(0, 4, 1, 3)
nyx.metrics.record_pool_worker(1, 4, 2, 2)
series: str = nyx.metrics.pool_series_text()
nox.test.assert_true(nox.strings.contains(series, "nyx_db_pool_open{worker=\"0\"} 1"), "worker 0 open")
nox.test.assert_true(nox.strings.contains(series, "nyx_db_pool_open{worker=\"1\"} 2"), "worker 1 open")
nox.test.assert_true(nox.strings.contains(series, "nyx_db_pool_open 3"), "open sum")
nox.test.assert_true(nox.strings.contains(series, "nyx_db_pool_size 8"), "size sum")
nyx.metrics.reset()
nox.test.assert_eq_int(nyx.metrics.db_pool_checkouts(), 0, "reset checkouts")
nox.test.assert_eq_int(nyx.metrics.db_pool_exhausted(), 0, "reset exhausted")

nyx.metrics.record_pool_worker(0, 4, 1, 3)
nyx.metrics.record_pool_worker(1, 4, 2, 2)
nyx.metrics.stamp_worker(1, 1)
stale: str = nyx.metrics.pool_series_text()
nox.test.assert_true(nox.strings.contains(stale, "nyx_db_pool_open{worker=\"0\"} 1"), "live worker stays")
nox.test.assert_true(nox.strings.contains(stale, "worker=\"1\"") == False, "stale worker is dropped")
nox.test.assert_true(nox.strings.contains(stale, "nyx_db_pool_open 1"), "stale worker is not summed")
reused: int = nyx.metrics.claim_worker()
nox.test.assert_eq_int(reused, 1, "stale slot is reused")

nyx.metrics.reset()
filled: int = 0
while filled < nyx.metrics.worker_slot_count():
    nyx.metrics.record_pool_worker(filled, 1, 0, 0)
    filled = filled + 1
overflow: int = nyx.metrics.claim_worker()
nox.test.assert_eq_int(overflow, -1, "a full generation does not alias the last slot")

before: int = nyx.metrics.generation()
nyx.metrics.record_db_checkout(3)
nyx.metrics.stamp_generation(1)
after: int = nyx.metrics.refresh_generation()
nox.test.assert_true(after != before, "a stale generation is replaced")
nox.test.assert_eq_int(nyx.metrics.db_pool_checkouts(), 0, "a new generation starts at zero")
nox.test.assert_eq_str(nyx.metrics.pool_series_text(), "", "a new generation has no workers")

nox.os.set_var("NYX_METRICS_STALE_MS", "1000")
nox.test.assert_eq_int(nyx.metrics.worker_stale_ms(), 1000, "stale window is configurable")
nyx.metrics.reset()
filled_again: int = 0
while filled_again < nyx.metrics.worker_slot_count():
    nyx.metrics.record_pool_worker(filled_again, 1, 1, 0)
    if filled_again % 2 == 0:
        nyx.metrics.stamp_worker(filled_again, 1)
    filled_again = filled_again + 1
reclaimed: int = 0
again_slot: int = 0
while reclaimed < 32:
    nyx.metrics.release_claim()
    again_slot = nyx.metrics.claim_worker()
    nox.test.assert_true(again_slot >= 0, "a stale worker is claimed again")
    nox.test.assert_eq_int(again_slot % 2, 0, "a live worker is not taken")
    reclaimed = reclaimed + 1
nyx.metrics.release_claim()
blocked: int = nyx.metrics.claim_worker()
nox.test.assert_eq_int(blocked, -1, "live workers stay registered")
nox.os.set_var("NYX_METRICS_STALE_MS", "")
print("v274_pool_metrics_test ok")
