import nox.test
import nyx.runtime

nyx.runtime.begin("req-flash", 0, "en")

nyx.runtime.flash_set("notice", "Kaydedildi")
first_read: str | None = nyx.runtime.flash_get("notice")
nox.test.assert_true(first_read != None, "flash_get ilk okumada mesaji doner")
if first_read != None:
    nox.test.assert_eq_str(first_read, "Kaydedildi", "flash_get dogru mesaji doner")

second_read: str | None = nyx.runtime.flash_get("notice")
nox.test.assert_true(second_read == None, "flash_get ikinci okumada mesaj otomatik temizlenmis olmali (Rails-benzeri)")

nyx.runtime.end()

# --- cycle_session ---

nyx.runtime.begin("req-cycle", 0, "en")
nyx.runtime.load_session("{\"user_id\":\"alice\"}")
nox.test.assert_true(not nyx.runtime.is_session_dirty(), "load_session dirty isaretlemez")
nyx.runtime.cycle_session()
nox.test.assert_true(nyx.runtime.is_session_dirty(), "cycle_session oturumu dirty isaretler")
nox.test.assert_true(nyx.runtime.is_session_rotate(), "cycle_session rotate bayragi")
nyx.runtime.end()

nyx.runtime.begin("req-logout", 0, "en")
nyx.runtime.set_session("{\"user_id\":1}")
nyx.runtime.set_session_sid("old-sid")
nyx.runtime.logout()
nox.test.assert_true(nyx.runtime.should_expire_session_cookie(), "logout expire cookie")
nox.test.assert_eq_str(nyx.runtime.session_json(), "{}", "logout clears payload")
nyx.runtime.end()

print("runtime_test ok")
