import nox.test
import nyx.password

h: str = nyx.password.hash("correct horse battery staple")
nox.test.assert_true(len(h) > 20, "hash length")
nox.test.assert_true(nyx.password.verify(h, "correct horse battery staple"), "verify ok")
nox.test.assert_true(not nyx.password.verify(h, "wrong password"), "verify fail")

print("password_test ok")
