import nox.test
import web.password

h: str = web.password.hash("correct horse battery staple")
nox.test.assert_true(len(h) > 20, "hash length")
nox.test.assert_true(web.password.verify(h, "correct horse battery staple"), "verify ok")
nox.test.assert_true(not web.password.verify(h, "wrong password"), "verify fail")

print("password_test ok")
