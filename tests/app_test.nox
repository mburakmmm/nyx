import nox.test
import nox.fs
import nox.strings
from nox.http import HttpRequest, HttpResponse
from nox.router import Context
import nyx.app
import nyx.config
import nyx.ctrl
from nyx.app import Application, AppError
from nyx.config import Config
from nyx.db import DbError
import nyx.db

dir_path: str = "/tmp/nyx_app_mig_test"
if not nox.fs.exists(dir_path):
    nox.fs.create_dir(dir_path)
nox.fs.write_string(dir_path + "/001_t.sql", "CREATE TABLE IF NOT EXISTS t_app (id INTEGER PRIMARY KEY);")

def setup(application: Application) -> None:
    def home(ctx: Context) -> HttpResponse:
        return nyx.ctrl.text(200, "ok")
    application.router.get("/", home)

cfg: Config = nyx.config.defaults("test")
cfg.secret_key = "nyx-test-secret-change-me-32bytes!"
cfg.db_path = ":memory:"
cfg.migrate_path = dir_path
cfg.csrf_enabled = False
cfg.log_requests = False

application: Application = nyx.app.boot(cfg, setup)
req: HttpRequest = HttpRequest("GET", "/", "", {}, "")
resp: HttpResponse = nyx.app.dispatch(application, req)
nox.test.assert_eq_int(resp.status, 200, "status")
nox.test.assert_eq_str(resp.body, "ok", "body")

# health + ready
h: HttpResponse = nyx.app.dispatch(application, HttpRequest("GET", "/health", "", {}, ""))
nox.test.assert_eq_int(h.status, 200, "health")
r: HttpResponse = nyx.app.dispatch(application, HttpRequest("GET", "/ready", "", {}, ""))
nox.test.assert_eq_int(r.status, 200, "ready")
nox.test.assert_eq_str(application.dialect, "sqlite", "dialect")

nyx.app.shutdown(application)

# auto_migrate=False skips migrate even when migrate dir is missing
cfg2: Config = nyx.config.defaults("test")
cfg2.secret_key = "nyx-test-secret-change-me-32bytes!"
cfg2.db_path = ":memory:"
cfg2.migrate_path = "/tmp/nyx_missing_migrate_dir_xyz"
cfg2.auto_migrate = False
cfg2.csrf_enabled = False
cfg2.log_requests = False
app2: Application = nyx.app.boot(cfg2, setup)
nyx.app.shutdown(app2)
nox.test.assert_true(True, "auto_migrate false boots without migrate dir")

# production placeholder secret rejected
threw_placeholder: bool = False
try:
    cfg3: Config = nyx.config.defaults("production")
    cfg3.secret_key = "change-me-please-this-is-32chars!!"
    cfg3.db_path = ":memory:"
    cfg3.auto_migrate = False
    cfg3.csrf_enabled = False
    cfg3.log_requests = False
    nyx.app.boot(cfg3, setup)
except AppError:
    threw_placeholder = True
nox.test.assert_true(threw_placeholder, "production placeholder secret rejected")

# postgres URL must fail clearly
try:
    nyx.db.open_url("postgres://localhost/db")
    nox.test.assert_true(False, "postgres should raise")
except DbError as e:
    nox.test.assert_true(nox.strings.contains(e.message, "open_postgres"), "postgres hint")

print("app_test ok")
