import nox.test
import nyx.db
import nyx.model
from nox.sqlite import Connection, Statement, Row
from nyx.model import Record, ModelError, Attributes

def _txn_ok(conn: Connection) -> None:
    nyx.model.create(conn, "users", "{\"email\":\"txn-ok@b.c\",\"name\":\"TxnOk\"}")

def _txn_fail(conn: Connection) -> None:
    nyx.model.create(conn, "users", "{\"email\":\"txn-fail@b.c\",\"name\":\"TxnFail\"}")
    raise ModelError("kasitli iptal")

db: Connection = nyx.db.open(":memory:")
db.execute("CREATE TABLE users (id INTEGER PRIMARY KEY AUTOINCREMENT, email TEXT NOT NULL, name TEXT NOT NULL)")

uid: int = nyx.model.create(db, "users", "{\"email\":\"a@b.c\",\"name\":\"Alice\"}")
nox.test.assert_true(uid > 0, "create id")

found: Record | None = nyx.model.find(db, "users", uid)
nox.test.assert_true(found != None, "find")
if found != None:
    nox.test.assert_eq_str(found.get("email"), "a@b.c", "email")
    nox.test.assert_eq_str(found.get("name"), "Alice", "name")

nyx.model.update(db, "users", uid, "{\"name\":\"Alicia\"}")
found2: Record | None = nyx.model.find(db, "users", uid)
if found2 != None:
    nox.test.assert_eq_str(found2.get("name"), "Alicia", "updated name")

rows: list[Record] = nyx.model.where(db, "users", "email", "a@b.c")
nox.test.assert_eq_int(len(rows), 1, "where count")

nyx.model.destroy(db, "users", uid)
gone: Record | None = nyx.model.find(db, "users", uid)
nox.test.assert_true(gone == None, "destroyed")

nyx.model.transaction(db, _txn_ok)
committed: list[Record] = nyx.model.where(db, "users", "email", "txn-ok@b.c")
nox.test.assert_eq_int(len(committed), 1, "basarili transaction commit edilmeli")

threw_txn: bool = False
try:
    nyx.model.transaction(db, _txn_fail)
except ModelError:
    threw_txn = True
nox.test.assert_true(threw_txn, "basarisiz transaction hatayi yeniden firlatmali")
rolled_back: list[Record] = nyx.model.where(db, "users", "email", "txn-fail@b.c")
nox.test.assert_eq_int(len(rolled_back), 0, "basarisiz transaction rollback edilmeli")

id_a: int = nyx.model.create(db, "users", "{\"email\":\"where-sql-a@b.c\",\"name\":\"WA\"}")
id_b: int = nyx.model.create(db, "users", "{\"email\":\"where-sql-b@b.c\",\"name\":\"WB\"}")
binds: list[str] = []
binds.append(str(id_a))
binds.append(str(id_b))
where_sql_rows: list[Record] = nyx.model.where_sql(db, "users", "id = ? OR id = ?", binds)
nox.test.assert_eq_int(len(where_sql_rows), 2, "where_sql iki eslesen satir doner")

threw_bind: bool = False
try:
    empty_binds: list[str] = []
    nyx.model.where_sql(db, "users", "id = ?", empty_binds)
except ModelError:
    threw_bind = True
nox.test.assert_true(threw_bind, "eksik bind sayisi ModelError firlatir")

threw_injection: bool = False
try:
    no_binds: list[str] = []
    nyx.model.where_sql(db, "users", "id = 1; DROP TABLE users;--", no_binds)
except ModelError:
    threw_injection = True
nox.test.assert_true(threw_injection, "supheli karakterler icin where_sql ModelError firlatir")

ordered: list[Record] = nyx.model.order_limit(db, "users", "id", True, 2)
nox.test.assert_eq_int(len(ordered), 2, "order_limit limit kadar satir doner")
nox.test.assert_true(ordered[0].get_int("id") > ordered[1].get_int("id"), "order_limit desc siralamali")

valid_errors: list[str] = nyx.model.validate_required("{\"email\":\"a@b.c\",\"name\":\"A\"}", ["email", "name"])
nox.test.assert_eq_int(len(valid_errors), 0, "tum zorunlu alanlar doluysa hata olmamali")

invalid_errors: list[str] = nyx.model.validate_required("{\"email\":\"\"}", ["email", "name"])
nox.test.assert_eq_int(len(invalid_errors), 2, "bos email + eksik name icin iki hata olmali")

new_id: int = nyx.model.create_valid(db, "users", "{\"email\":\"valid@b.c\",\"name\":\"Valid\"}", ["email", "name"])
nox.test.assert_true(new_id > 0, "create_valid gecerli veriyle kayit olusturur")

threw_create_valid: bool = False
try:
    empty_fields: list[str] = ["email", "name"]
    nyx.model.create_valid(db, "users", "{\"email\":\"\"}", empty_fields)
except ModelError:
    threw_create_valid = True
nox.test.assert_true(threw_create_valid, "create_valid eksik alanlarda ModelError firlatir")

db.execute("CREATE TABLE profiles (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, bio TEXT)")

pid: int = nyx.model.create(db, "profiles", "{\"user_id\":1,\"bio\":null}")
null_check_stmt: Statement = db.prepare("SELECT bio FROM profiles WHERE id = ?")
null_check_stmt.bind_int(0, pid)
null_rows: list[Row] = null_check_stmt.query()
nox.test.assert_eq_int(len(null_rows), 1, "null bio ile profil olusturuldu")
nox.test.assert_true(null_rows[0].is_null(0), "JSON null gercek SQL NULL olarak baglanir (bos string degil)")

nyx.model.update(db, "profiles", pid, "{\"bio\":\"merhaba\"}")
filled_check_stmt: Statement = db.prepare("SELECT bio FROM profiles WHERE id = ?")
filled_check_stmt.bind_int(0, pid)
filled_rows: list[Row] = filled_check_stmt.query()
nox.test.assert_true(not filled_rows[0].is_null(0), "update sonrasi bio artik NULL olmamali")
nox.test.assert_eq_str(filled_rows[0].get_str(0), "merhaba", "update sonrasi bio degeri dogru")

nyx.model.update(db, "profiles", pid, "{\"bio\":null}")
back_to_null_stmt: Statement = db.prepare("SELECT bio FROM profiles WHERE id = ?")
back_to_null_stmt.bind_int(0, pid)
back_to_null_rows: list[Row] = back_to_null_stmt.query()
nox.test.assert_true(back_to_null_rows[0].is_null(0), "update ile bio yeniden NULL yapilabilir")

# --- typed Attributes API ---
attrs: Attributes = nyx.model.attributes()
nyx.model.set_str(attrs, "email", "typed@b.c")
nyx.model.set_str(attrs, "name", "Typed")
tid: int = nyx.model.create_attrs(db, "users", attrs)
typed_row: Record | None = nyx.model.find(db, "users", tid)
nox.test.assert_true(typed_row != None, "create_attrs find")
if typed_row != None:
    nox.test.assert_eq_str(typed_row.get_or("email", ""), "typed@b.c", "create_attrs email")

upd: Attributes = nyx.model.attributes()
nyx.model.set_str(upd, "name", "Typed2")
nyx.model.update_attrs(db, "users", tid, upd)
typed2: Record | None = nyx.model.find(db, "users", tid)
if typed2 != None:
    nox.test.assert_eq_str(typed2.get("name"), "Typed2", "update_attrs name")

# --- nullable Record API ---
prof_attrs: Attributes = nyx.model.attributes()
nyx.model.set_int(prof_attrs, "user_id", tid)
nyx.model.set_null(prof_attrs, "bio")
pid2: int = nyx.model.create_attrs(db, "profiles", prof_attrs)
prof: Record | None = nyx.model.find(db, "profiles", pid2)
nox.test.assert_true(prof != None, "profile find")
if prof != None:
    nox.test.assert_true(prof.is_null("bio"), "is_null bio")
    nox.test.assert_true(nyx.model.get_opt(prof, "bio") == None, "get_opt NULL -> None")
    nox.test.assert_eq_str(prof.get_or("bio", "yok"), "yok", "get_or fallback")
    nox.test.assert_eq_str(prof.get("bio"), "", "get NULL -> empty (compat)")
    nox.test.assert_eq_int(prof.get_int("user_id"), tid, "get_int typed")
    nox.test.assert_true(nyx.model.get_int_opt(prof, "bio") == None, "get_int_opt NULL")
    nox.test.assert_eq_int(prof.get_int_or("bio", -1), -1, "get_int_or fallback")

keys: list[str] = []
keys.append("email")
keys.append("name")
vals: list[str] = []
vals.append("fields@b.c")
vals.append("Fields")
fid: int = nyx.model.create_fields(db, "users", keys, vals)
nox.test.assert_true(fid > 0, "create_fields id")

req_fields: list[str] = []
req_fields.append("email")
req_fields.append("name")
bad: Attributes = nyx.model.attributes()
nyx.model.set_str(bad, "email", "")
bad_errs: list[str] = nyx.model.validate_attrs_required(bad, req_fields)
nox.test.assert_eq_int(len(bad_errs), 2, "validate_attrs_required")

db.close()
print("model_test ok")
