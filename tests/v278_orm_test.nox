# One model surface over the booted application.
# SQLite always runs. Postgres and MySQL run the same CRUD when DATABASE_URL
# selects that dialect.

import nox.os
import nox.test
import nox.uuid
from nox.os import OsError
from nox.http import HttpResponse
from nox.router import Context
import nyx.app
import nyx.config
import nyx.ctrl
import nyx.db
import nyx.model
import nyx.orm
from nyx.app import Application
from nyx.config import Config
from nyx.model import Attributes, Record

def setup(application: Application) -> None:
    def home(ctx: Context) -> HttpResponse:
        return nyx.ctrl.text(200, "ok")
    application.router.get("/", home)

probe_table: str = ""
probe_id: int = 0

def rename(app: Application) -> None:
    changed: Attributes = nyx.model.attributes()
    nyx.model.set_str(changed, "title", "there")
    nyx.orm.update(app, probe_table, probe_id, changed)

def exercise(application: Application, table: str) -> None:
    probe_table = table
    attrs: Attributes = nyx.model.attributes()
    nyx.model.set_str(attrs, "title", "hello")
    probe_id = nyx.orm.create(application, table, attrs)
    found: Record | None = nyx.orm.find(application, table, probe_id)
    nox.test.assert_true(found != None, "orm find")
    opened: list[Record] = nyx.orm.where(application, table, "title", "hello")
    nox.test.assert_eq_int(len(opened), 1, "created row is visible")
    nox.test.assert_eq_str(opened[0].get("title"), "hello", "orm title")
    nyx.orm.transaction(application, rename)
    matched: list[Record] = nyx.orm.where(application, table, "title", "there")
    nox.test.assert_eq_int(len(matched), 1, "orm where")
    everyone: list[Record] = nyx.orm.all_rows(application, table)
    nox.test.assert_eq_int(len(everyone), 1, "orm all")
    nyx.orm.destroy(application, table, probe_id)
    gone: Record | None = nyx.orm.find(application, table, probe_id)
    nox.test.assert_true(gone == None, "orm destroy")

def database_url() -> str:
    try:
        return nox.os.getenv("DATABASE_URL")
    except OsError:
        return ""

def stamp() -> str:
    raw: str = nox.uuid.uuid4()
    out: str = ""
    i: int = 0
    while i < len(raw) and len(out) < 12:
        ch: str = raw[i]
        if ch != "-":
            out = out + ch
        i = i + 1
    return out

cfg: Config = nyx.config.defaults("test")
cfg.secret_key = "nyx-test-secret-change-me-32bytes!"
cfg.csrf_enabled = False
cfg.session_store = "cookie"
cfg.metrics_enabled = False
cfg.log_requests = False
cfg.auto_migrate = False
application: Application = nyx.app.boot(cfg, setup)
application.db.execute("CREATE TABLE posts (id INTEGER PRIMARY KEY, title TEXT NOT NULL)")
exercise(application, "posts")
nyx.app.shutdown(application)

url: str = database_url()
dialect: str = nyx.db.dialect_of_url(url)
if dialect == "postgres" or dialect == "mysql":
    live_cfg: Config = nyx.config.defaults("test")
    live_cfg.secret_key = "nyx-test-secret-change-me-32bytes!"
    live_cfg.csrf_enabled = False
    live_cfg.session_store = "cookie"
    live_cfg.metrics_enabled = False
    live_cfg.log_requests = False
    live_cfg.auto_migrate = False
    live_cfg.db_pool_size = 1
    live_cfg.db_path = url
    live: Application = nyx.app.boot(live_cfg, setup)
    table: str = "nyx_orm_" + stamp()
    if dialect == "postgres":
        nyx.app.pg(live).execute(
            "CREATE TABLE " + table + " (id BIGSERIAL PRIMARY KEY, title TEXT NOT NULL)"
        )
    else:
        nyx.app.mysql(live).execute(
            "CREATE TABLE " + table + " (id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY, title VARCHAR(255) NOT NULL)"
        )
    exercise(live, table)
    if dialect == "postgres":
        nyx.app.pg(live).execute("DROP TABLE IF EXISTS " + table)
    else:
        nyx.app.mysql(live).execute("DROP TABLE IF EXISTS " + table)
    nyx.app.shutdown(live)
    print("v278_orm_test ok (" + dialect + ")")
else:
    print("v278_orm_test ok")
