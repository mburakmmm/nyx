# Uncomment the generated auth snippet and typecheck it.
# The snippet must compile for sqlite, postgres, and mysql branches.

import nox.fs
import nox.os
import nox.process
from nox.os import OsError
import nox.strings
import nox.test
import nyx.cli_gen

def _slashes(path: str) -> str:
    out: str = ""
    i: int = 0
    while i < len(path):
        ch: str = path[i]
        if ch == "/":
            out = out + "\\"
        else:
            out = out + ch
        i = i + 1
    return out

def drop_hash(line: str) -> str:
    if nox.strings.starts_with(line, "# "):
        out: str = ""
        i: int = 2
        while i < len(line):
            out = out + nox.strings.char_from_byte(nox.strings.byte_at(line, i))
            i = i + 1
        return out
    return ""

def is_import_line(line: str) -> bool:
    return nox.strings.starts_with(line, "import ") or nox.strings.starts_with(line, "from ")

root: str = "tests/.auth_compile"
if nox.fs.exists(root):
    nox.fs.remove_dir_all(root)
nyx.cli_gen.generate_auth(root)
snippet: str = nox.fs.read_to_string(root + "/config/auth_routes.nox.snippet")
nox.test.assert_true(nox.strings.contains(snippet, "nox.json.dump_string"), "dump_string")
nox.test.assert_true(not nox.strings.contains(snippet, "encode_string"), "old json name is gone")
nox.test.assert_true(nox.strings.contains(snippet, "nyx.auth_engine_mysql.register"), "mysql register")
nox.test.assert_true(nox.strings.contains(snippet, "nyx.auth_engine_pg.register"), "pg register")
nox.test.assert_true(nox.strings.contains(snippet, "nyx.auth_engine.register"), "sqlite register")

imports: str = ""
body: str = ""
lines: list[str] = nox.strings.split(snippet, "\n")
n: int = 0
while n < len(lines):
    code: str = drop_hash(lines[n])
    if len(code) > 0 and not nox.strings.starts_with(code, "Paste "):
        if is_import_line(code):
            imports = imports + code + "\n"
        else:
            body = body + "    " + code + "\n"
    n = n + 1

program: str = imports
program = program + "import nyx.app\n"
program = program + "import nyx.config\n"
program = program + "import nyx.ctrl\n"
program = program + "from nyx.app import Application\n"
program = program + "from nyx.config import Config\n"
program = program + "from nox.http import HttpResponse\n"
program = program + "from nox.router import Context\n"
program = program + "\n"
program = program + "def setup(application: Application) -> None:\n"
program = program + body
program = program + "\n"
program = program + "cfg: Config = nyx.config.defaults(\"test\")\n"
program = program + "cfg.secret_key = \"nyx-test-secret-change-me-32bytes!\"\n"
program = program + "cfg.db_path = \":memory:\"\n"
program = program + "cfg.migrate_path = \"\"\n"
program = program + "cfg.auto_migrate = False\n"
program = program + "cfg.csrf_enabled = False\n"
program = program + "cfg.log_requests = False\n"
program = program + "application: Application = nyx.app.boot(cfg, setup)\n"
program = program + "nyx.app.shutdown(application)\n"
program = program + "print(\"auth snippet typechecks\")\n"

prog_path: str = nox.os.current_dir() + "/" + root + "/auth_wire.nox"
nox.fs.write_string(root + "/auth_wire.nox", program)
# nox.process starts the child with an empty environment. noxc then
# resolves its cache from an empty HOME and fails with ReadOnlyFileSystem.
# The wrapper puts HOME and PATH back before exec.
# Windows has no /bin/sh. COMSPEC is set there; the wrapper is a .cmd file.
comspec: str = ""
try:
    comspec = nox.os.getenv("COMSPEC")
except OsError:
    comspec = ""
launcher: str = "/bin/sh"
wrapper: str = root + "/run_noxc.sh"
script: str = ""
if len(comspec) > 0:
    profile: str = nox.os.getenv("USERPROFILE")
    # noxc keeps the package cache in $NOX_HOME or $HOME/.nox. The child
    # starts with an empty environment, so it must reuse this process's cache
    # or it tries to fetch the local repo again and fails with FileNotFound.
    parent_home: str = ""
    try:
        parent_home = nox.os.getenv("HOME")
    except OsError:
        parent_home = ""
    nox_home: str = ""
    try:
        nox_home = nox.os.getenv("NOX_HOME")
    except OsError:
        nox_home = ""
    if len(nox_home) == 0:
        nox_home = parent_home + "/.nox"
    if len(parent_home) == 0:
        parent_home = profile
    # The child starts with an empty PATH. noxc links with gcc, which the
    # workflow put on this process's PATH.
    parent_path: str = ""
    try:
        parent_path = nox.os.getenv("PATH")
    except OsError:
        parent_path = ""
    launcher = comspec
    wrapper = _slashes(nox.os.current_dir() + "/" + root + "/run_noxc.cmd")
    script = "@echo off\r\n"
    script = script + "set \"HOME=" + _slashes(parent_home) + "\"\r\n"
    script = script + "set \"USERPROFILE=" + profile + "\"\r\n"
    script = script + "set \"NOX_HOME=" + nox_home + "\"\r\n"
    script = script + "set \"PATH=" + profile + "\\.nox-lang\\bin;" + parent_path + "\"\r\n"
    script = script + "cd /d \"" + _slashes(nox.os.current_dir()) + "\"\r\n"
    script = script + "call \"" + profile + "\\.nox-lang\\bin\\noxc.exe\" test \"" + _slashes(prog_path) + "\"\r\n"
else:
    home: str = nox.os.getenv("HOME")
    script = "#!/bin/sh\n"
    script = script + "export HOME=\"" + home + "\"\n"
    script = script + "export PATH=\"" + home + "/.nox-lang/bin:/usr/bin:/bin\"\n"
    script = script + "cd \"" + nox.os.current_dir() + "\"\n"
    script = script + "exec \"" + home + "/.nox-lang/bin/noxc\" test \"" + prog_path + "\"\n"
nox.fs.write_string(wrapper, script)
cmd: nox.process.Command = nox.process.Command(launcher)
if len(comspec) > 0:
    cmd.arg("/c")
out: nox.process.Output = cmd.arg(wrapper).run()
if len(out.stdout) > 0:
    print(out.stdout)
if len(out.stderr) > 0:
    print(out.stderr)
nox.test.assert_eq_int(out.status, 0, "generated auth snippet typechecks")
nox.fs.remove_dir_all(root)
print("cli_auth_compile_test ok")
