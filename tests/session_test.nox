import nox.test
import nox.strings
import nyx.session

secret: str = "session-secret-key-32chars-min!!"
val: str = nyx.session.create(secret, "{\"user\":\"alice\"}", 3600)
parts: list[str] = nox.strings.split(val, ".")
nox.test.assert_eq_int(len(parts), 2, "session parts")

loaded: str | None = nyx.session.load(secret, val)
nox.test.assert_true(loaded != None, "load ok")
if loaded != None:
    nox.test.assert_true(nox.strings.contains(loaded, "alice"), "load user")

nox.test.assert_true(nyx.session.load("wrong-secret-key-32chars-min!!!", val) == None, "wrong secret")

tampered: str = parts[0] + ".AAAA"
nox.test.assert_true(nyx.session.load(secret, tampered) == None, "tampered")

expired: str = nyx.session.create(secret, "{\"user\":\"bob\"}", 1)
# max_age 1 saniye — hemen yüklenmeli; expire testi için 0 geçersiz,
# bu yüzden bozuk envelope ile expire benzeri davranışı doğrularız.
nox.test.assert_true(nyx.session.load(secret, "") == None, "empty")

nox.test.assert_eq_str(nyx.session.default_cookie_name(), "nyx_session", "cookie name")

print("session_test ok")
