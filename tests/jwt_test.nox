import nox.test
import nox.time
import nox.strings
import web.jwt
from web.jwt import JwtError

secret: str = "test-secret-key-32chars-minimum!!"
now: int = nox.time.now_ms() // 1000
exp: int = now + 3600

token: str = web.jwt.encode(secret, "{\"sub\":\"alice\"}", exp)
parts: list[str] = nox.strings.split(token, ".")
nox.test.assert_eq_int(len(parts), 3, "token parts")

payload: str = web.jwt.decode(secret, token)
nox.test.assert_true(nox.strings.contains(payload, "alice"), "payload sub")
nox.test.assert_true(nox.strings.contains(payload, "exp"), "payload exp")

bad_sig: bool = False
try:
    web.jwt.decode("wrong-secret-key-32chars-minimum!", token)
except JwtError:
    bad_sig = True
nox.test.assert_true(bad_sig, "reject wrong secret")

expired: str = web.jwt.encode(secret, "{\"sub\":\"bob\"}", now - 10)
expired_fail: bool = False
try:
    web.jwt.decode(secret, expired)
except JwtError:
    expired_fail = True
nox.test.assert_true(expired_fail, "reject expired")

tampered: str = parts[0] + "." + parts[1] + ".AAAA"
tamper_fail: bool = False
try:
    web.jwt.decode(secret, tampered)
except JwtError:
    tamper_fail = True
nox.test.assert_true(tamper_fail, "reject tampered")

print("jwt_test ok")
