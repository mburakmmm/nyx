import nox.test
import nox.fs
import nox.strings
import nyx.db
from nyx.db import DbError
from nox.sqlite import Connection
from nox.db import Row
import nyx.testing

dir_path: str = nyx.testing.scratch("nyx_migrate_test")
if nox.fs.exists(dir_path):
    # onceki kosudan kalmis olabilir
    x: int = 0
else:
    nox.fs.create_dir(dir_path)

nox.fs.write_string(dir_path + "/001_a.sql", "CREATE TABLE IF NOT EXISTS t_a (id INTEGER PRIMARY KEY);")
nox.fs.write_string(dir_path + "/002_b.sql", "CREATE TABLE IF NOT EXISTS t_b (id INTEGER PRIMARY KEY);")
nox.fs.write_string(dir_path + "/001_a.down.sql", "DROP TABLE IF EXISTS t_a;")
nox.fs.write_string(dir_path + "/002_b.down.sql", "DROP TABLE IF EXISTS t_b;")
nox.fs.write_string(dir_path + "/001_a.pg.sql", "NOT SQLITE PG;")
nox.fs.write_string(dir_path + "/001_a.pg.down.sql", "DROP TABLE IF EXISTS t_a;")
nox.fs.write_string(dir_path + "/001_a.mysql.sql", "NOT SQLITE MY;")
nox.fs.write_string(dir_path + "/001_a.mysql.down.sql", "DROP TABLE IF EXISTS t_a;")
nox.fs.write_string(dir_path + "/003_c.pg.sql", "NOT SQLITE ONLY PG;")
nox.fs.write_string(dir_path + "/004_d.mysql.sql", "NOT SQLITE ONLY MY;")

names: list[str] = []
names.append("001_a.sql")
names.append("002_b.sql")
names.append("001_a.down.sql")
names.append("001_a.pg.sql")
names.append("001_a.pg.down.sql")
names.append("001_a.mysql.sql")
names.append("001_a.mysql.down.sql")
names.append("003_c.pg.sql")
names.append("004_d.mysql.sql")
sqlite_names: list[str] = nyx.db.select_up_migrations(names, "sqlite")
nox.test.assert_eq_int(len(sqlite_names), 2, "sqlite keeps plain ids and skips dialect-only ids")
pg_names: list[str] = nyx.db.select_up_migrations(names, "postgres")
nox.test.assert_eq_int(len(pg_names), 3, "postgres uses pg twin, plain fallback, and pg-only id")
nox.test.assert_eq_str(pg_names[0], "001_a.pg.sql", "postgres prefers twin over plain")
nox.test.assert_eq_str(pg_names[1], "002_b.sql", "plain id still runs beside another pg file")
nox.test.assert_eq_str(pg_names[2], "003_c.pg.sql", "pg-only id")
my_names: list[str] = nyx.db.select_up_migrations(names, "mysql")
nox.test.assert_eq_int(len(my_names), 3, "mysql uses mysql twin, plain fallback, and mysql-only id")
nox.test.assert_eq_str(my_names[0], "001_a.mysql.sql", "mysql prefers twin over plain")
nox.test.assert_eq_str(my_names[1], "002_b.sql", "plain id still runs beside another mysql file")
nox.test.assert_eq_str(my_names[2], "004_d.mysql.sql", "mysql-only id")
plain_names: list[str] = []
plain_names.append("010_init.sql")
plain_names.append("010_init.down.sql")
plain_pg: list[str] = nyx.db.select_up_migrations(plain_names, "postgres")
nox.test.assert_eq_int(len(plain_pg), 1, "postgres plain dir stays on Ad.sql")
nox.test.assert_eq_str(nyx.db.down_migration_name("010_init.sql"), "010_init.down.sql", "sqlite down")
nox.test.assert_eq_str(nyx.db.down_migration_name("010_init.pg.sql"), "010_init.pg.down.sql", "pg down")
nox.test.assert_eq_str(nyx.db.down_migration_name("010_init.mysql.sql"), "010_init.mysql.down.sql", "mysql down")

db: Connection = nyx.db.open(":memory:")
n1: int = nyx.db.migrate(db, dir_path)
nox.test.assert_eq_int(n1, 2, "first migrate applies 2")
n2: int = nyx.db.migrate(db, dir_path)
nox.test.assert_eq_int(n2, 0, "second migrate noop")

reverted: str = nyx.db.rollback(db, dir_path)
nox.test.assert_eq_str(reverted, "002_b.sql", "rollback en son migration'i geri alir")

check_rows: list[Row] = db.query("SELECT name FROM sqlite_master WHERE type = 'table' AND name = 't_b'")
nox.test.assert_eq_int(len(check_rows), 0, "rollback sonrasi t_b tablosu olmamali")

remaining: list[Row] = db.query("SELECT version FROM schema_migrations")
nox.test.assert_eq_int(len(remaining), 1, "rollback sonrasi tek migration kaydi kalmali")

n3: int = nyx.db.migrate(db, dir_path)
nox.test.assert_eq_int(n3, 1, "rollback sonrasi tekrar migrate 1 uygulamali")

dump_path: str = nyx.testing.scratch("nyx_migrate_test_schema_dump.sql")
nyx.db.schema_dump(db, dump_path)
dump_content: str = nox.fs.read_to_string(dump_path)
nox.test.assert_true(nox.strings.contains(dump_content, "t_a"), "schema_dump t_a tablosunu icermeli")
nox.test.assert_true(nox.strings.contains(dump_content, "t_b"), "schema_dump t_b tablosunu icermeli")
nox.test.assert_true(nox.strings.contains(dump_content, "CREATE TABLE"), "schema_dump CREATE TABLE ifadeleri icermeli")

threw: bool = False
try:
    nyx.db.rollback(db, nyx.testing.scratch("nyx_migrate_test_bos_dizin_yok"))
except DbError:
    threw = True
nox.test.assert_true(threw, "olmayan down dosyasi DbError firlatir")

# --- migration atomiklik (BEGIN IMMEDIATE / COMMIT / ROLLBACK) ---

atomic_dir: str = nyx.testing.scratch("nyx_migrate_atomic_test")
if nox.fs.exists(atomic_dir):
    y: int = 0
else:
    nox.fs.create_dir(atomic_dir)
nox.fs.write_string(atomic_dir + "/001_ok.sql", "CREATE TABLE IF NOT EXISTS t_ok (id INTEGER PRIMARY KEY);")
nox.fs.write_string(atomic_dir + "/002_bad.sql", "CREAT TABLE t_bad (id INTEGER PRIMARY KEY);")

atomic_db: Connection = nyx.db.open(":memory:")
threw_atomic: bool = False
try:
    nyx.db.migrate(atomic_db, atomic_dir)
except DbError:
    threw_atomic = True
nox.test.assert_true(threw_atomic, "gecersiz sozdizimli migration DbError firlatir")

ok_table: list[Row] = atomic_db.query("SELECT name FROM sqlite_master WHERE type = 'table' AND name = 't_ok'")
nox.test.assert_eq_int(len(ok_table), 1, "kendisinden ONCEKI gecerli migration commit edilmis olmali")

applied_versions: list[Row] = atomic_db.query("SELECT version FROM schema_migrations WHERE version = '002_bad.sql'")
nox.test.assert_eq_int(len(applied_versions), 0, "basarisiz migration schema_migrations'a kaydedilmemis olmali")

ok_versions: list[Row] = atomic_db.query("SELECT version FROM schema_migrations WHERE version = '001_ok.sql'")
nox.test.assert_eq_int(len(ok_versions), 1, "basarili migration schema_migrations'a kaydedilmis olmali")

atomic_db.close()

# Eski damga 010_legacy.pg.sql, sqlite'in sececegi 010_legacy.sql ile ayni kimlik.
# Ikizi yeniden calismamali ve ikinci bir satir yazmamali.
ident_dir: str = nyx.testing.scratch("nyx_mig_identity")
if nox.fs.exists(ident_dir):
    nox.fs.remove_dir_all(ident_dir)
nox.fs.create_dir(ident_dir)
plain_sql: str = "CREATE TABLE IF NOT EXISTS t_legacy (id INTEGER PRIMARY KEY);"
nox.fs.write_string(ident_dir + "/010_legacy.sql", plain_sql)
nox.fs.write_string(ident_dir + "/010_legacy.pg.sql", plain_sql)
ident_db: Connection = nyx.db.open(":memory:")
ident_db.execute("CREATE TABLE schema_migrations (version TEXT PRIMARY KEY NOT NULL)")
ident_db.execute("INSERT INTO schema_migrations (version) VALUES ('010_legacy.pg.sql')")
ident_n: int = nyx.db.migrate(ident_db, ident_dir)
nox.test.assert_eq_int(ident_n, 0, "eski lehce damgasi ayni kimligi atlar")
ident_rows: list[Row] = ident_db.query("SELECT version FROM schema_migrations")
nox.test.assert_eq_int(len(ident_rows), 1, "kimlik ikinci satir acmaz")
nox.test.assert_eq_str(ident_rows[0].get_str(0), "010_legacy.pg.sql", "eski damga durur")
legacy_table: list[Row] = ident_db.query("SELECT name FROM sqlite_master WHERE type = 'table' AND name = 't_legacy'")
nox.test.assert_eq_int(len(legacy_table), 0, "atlanan dosya calismaz")
aliases: list[str] = nyx.db.migration_aliases("010_legacy.pg.sql")
nox.test.assert_eq_str(aliases[1], "010_legacy.sql", "duz ad ayni kimlik")
nox.test.assert_eq_str(aliases[2], "010_legacy.pg.sql", "pg ad ayni kimlik")
ident_db.close()

db.close()
print("db_test ok")
