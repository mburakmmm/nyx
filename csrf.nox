# nyx.csrf - HMAC tabanlı CSRF jetonu + protect middleware.
#
# import nyx.csrf
# t: str = nyx.csrf.token(secret)
# ok: bool = nyx.csrf.check(secret, t)
# router.use_before(nyx.csrf.protect(secret))

import nox.crypto
import nox.time
import nox.strings
import nyx.base64
import nyx.params
import nyx.ctrl
import nyx.form
import nyx.runtime
from nyx.base64 import Base64Error
from nox.http import HttpResponse
from nox.router import Context

class CsrfError(Exception):
    pass

def _sign(secret: str, payload: str) -> str:
    return nyx.base64.encode_hex_url(nox.crypto.hmac_sha256(secret, payload))

# Jetonu GEÇERLİ oturuma bağlar (session-bound CSRF token, bkz. OWASP CSRF
# Prevention Cheat Sheet "synchronizer token" deseni) - bu sayede saldirganin
# KENDI oturumunda ürettigi (ama gecerli imzali) bir jeton, KURBANIN
# oturumuna karsi ASLA gecerli olmaz (jeton yalnizca UretildIGI oturumla
# eslesir). Oturum yoksa/bossa ("{}") istek-basina benzersiz 'request_id'
# ile "anon:" onekli bir baglanti kullanilir - YINE DE ayni istek icinde
# uretilen jeton yine ayni istekte dogrulanabilir (login-oncesi formlar).
def _session_binding() -> str:
    sess: str = nyx.runtime.session_json()
    if len(sess) == 0 or sess == "{}":
        return "anon:" + nyx.runtime.request_id()
    return nox.crypto.sha256(sess)

def token(secret: str) -> str:
    return token_ttl(secret, 3600)

def token_ttl(secret: str, ttl_sec: int) -> str:
    if len(secret) == 0:
        raise CsrfError("secret bos")
    if ttl_sec <= 0:
        raise CsrfError("ttl pozitif olmali")
    exp: int = (nox.time.now_ms() // 1000) + ttl_sec
    binding: str = _session_binding()
    payload: str = str(exp) + "|" + binding
    payload_b64: str = nyx.base64.encode_url(payload)
    mac: str = _sign(secret, payload_b64)
    return payload_b64 + "." + mac

def check(secret: str, tok: str) -> bool:
    if len(secret) == 0 or len(tok) == 0:
        return False
    parts: list[str] = nox.strings.split(tok, ".")
    if len(parts) != 2:
        return False
    payload_b64: str = parts[0]
    mac: str = parts[1]
    expected: str = _sign(secret, payload_b64)
    if not nox.crypto.constant_time_eq(mac, expected):
        return False
    try:
        payload: str = nyx.base64.decode_url(payload_b64)
        fields: list[str] = nox.strings.split(payload, "|")
        if len(fields) != 2:
            return False
        exp: int = int(fields[0])
        binding: str = fields[1]
        now: int = nox.time.now_ms() // 1000
        if now >= exp:
            return False
        if not nox.crypto.constant_time_eq(binding, _session_binding()):
            return False
        return True
    except Base64Error:
        return False
    except ValueError:
        return False

def _header_get(headers: dict[str, str], name: str) -> str:
    try:
        return headers[name]
    except KeyError:
        a: int = 0
    try:
        return headers[nox.strings.lower(name)]
    except KeyError:
        b: int = 0
    if nox.strings.lower(name) == "x-csrf-token":
        try:
            return headers["X-CSRF-Token"]
        except KeyError:
            c: int = 0
        try:
            return headers["x-csrf-token"]
        except KeyError:
            d: int = 0
    return ""

def _unsafe_method(method: str) -> bool:
    return method == "POST" or method == "PUT" or method == "PATCH" or method == "DELETE"

def _starts_with_any(path: str, prefixes: list[str]) -> bool:
    i: int = 0
    while i < len(prefixes):
        if nox.strings.starts_with(path, prefixes[i]):
            return True
        i = i + 1
    return False

# State-changing isteklerde '_csrf' form alanı veya 'X-CSRF-Token' zorunlu -
# 'exempt_prefixes'teki oneklerle BASLAYAN yollar (ör. JSON/API istemcileri
# genellikle CSRF cerezine DAYANMADIGINDAN, kendi Bearer/API-key kimlik
# dogrulamalarini kullanir) atlanir.
def protect_except(secret: str, exempt_prefixes: list[str]) -> (Context) -> HttpResponse | None:
    def handler(ctx: Context) -> HttpResponse | None:
        if not _unsafe_method(ctx.request.method):
            return None
        if _starts_with_any(nyx.params.path_only(ctx.request.target), exempt_prefixes):
            return None
        tok: str = _header_get(ctx.request.headers, "X-CSRF-Token")
        if len(tok) == 0:
            params: dict[str, str] = nyx.params.from_request(ctx.request)
            tok = nyx.params.get(params, "_csrf", "")
        if not check(secret, tok):
            return nyx.ctrl.forbidden()
        return None
    return handler

# Guvenli varsayilan: hicbir onek muaf DEGIL. Cookie-session kullanan
# '/api/' rotalari da CSRF ister. Bearer-only JSON API icin acikca
# 'protect_api_exempt' veya 'Config.csrf_api_exempt' / 'NYX_CSRF_API_EXEMPT=1'.
def protect(secret: str) -> (Context) -> HttpResponse | None:
    none_exempt: list[str] = []
    return protect_except(secret, none_exempt)

# Eski davranis: '/api/' altini CSRF'den muaf tut (yalnizca Bearer/API-key
# kimlik dogrulamasina guvenen API'ler icin opt-in).
def protect_api_exempt(secret: str) -> (Context) -> HttpResponse | None:
    exempt: list[str] = ["/api/"]
    return protect_except(secret, exempt)

def field(secret: str) -> str:
    return nyx.form.hidden("_csrf", token(secret))

# CSRF token uretip 'form_with_token' doner (bkz. nyx.form).
def form_with(action: str, method: str, secret: str) -> str:
    return nyx.form.form_with_token(action, method, token(secret))
