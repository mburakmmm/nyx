import nox.test
import nox.strings
from nox.http import HttpRequest, HttpResponse

def _copy_headers(src: dict[str, str]) -> dict[str, str]:
    out: dict[str, str] = {}
    keys: list[str] = src.keys()
    i: int = 0
    while i < len(keys):
        k: str = keys[i]
        out[k] = src[k]
        i = i + 1
    return out

def request(handler: (HttpRequest) -> HttpResponse, method: str, path: str, body: str, headers: dict[str, str]) -> HttpResponse:
    req: HttpRequest = HttpRequest(method, path, body, headers)
    return handler(req)

def get(handler: (HttpRequest) -> HttpResponse, path: str) -> HttpResponse:
    empty: dict[str, str] = {}
    return request(handler, "GET", path, "", empty)

def get_with_headers(handler: (HttpRequest) -> HttpResponse, path: str, headers: dict[str, str]) -> HttpResponse:
    return request(handler, "GET", path, "", headers)

def post(handler: (HttpRequest) -> HttpResponse, path: str, body: str) -> HttpResponse:
    headers: dict[str, str] = {}
    headers["Content-Type"] = "application/x-www-form-urlencoded"
    return request(handler, "POST", path, body, headers)

def post_json(handler: (HttpRequest) -> HttpResponse, path: str, json_body: str) -> HttpResponse:
    headers: dict[str, str] = {}
    headers["Content-Type"] = "application/json"
    return request(handler, "POST", path, json_body, headers)

def post_with_headers(handler: (HttpRequest) -> HttpResponse, path: str, body: str, headers: dict[str, str]) -> HttpResponse:
    return request(handler, "POST", path, body, headers)

def put(handler: (HttpRequest) -> HttpResponse, path: str, body: str) -> HttpResponse:
    headers: dict[str, str] = {}
    headers["Content-Type"] = "application/x-www-form-urlencoded"
    return request(handler, "PUT", path, body, headers)

def patch(handler: (HttpRequest) -> HttpResponse, path: str, body: str) -> HttpResponse:
    headers: dict[str, str] = {}
    headers["Content-Type"] = "application/x-www-form-urlencoded"
    return request(handler, "PATCH", path, body, headers)

def delete(handler: (HttpRequest) -> HttpResponse, path: str) -> HttpResponse:
    empty: dict[str, str] = {}
    return request(handler, "DELETE", path, "", empty)

# with_bearer / with_cookie / with_csrf_token zincirlenebilir — headers.keys()
# ile onceki basliklarin tamamini korur (Nox >= 1.10).
def with_bearer(headers: dict[str, str], token: str) -> dict[str, str]:
    out: dict[str, str] = _copy_headers(headers)
    out["Authorization"] = "Bearer " + token
    return out

def with_cookie(headers: dict[str, str], cookie_header: str) -> dict[str, str]:
    out: dict[str, str] = _copy_headers(headers)
    out["Cookie"] = cookie_header
    return out

def with_csrf_token(headers: dict[str, str], tok: str) -> dict[str, str]:
    out: dict[str, str] = _copy_headers(headers)
    out["X-CSRF-Token"] = tok
    return out

def assert_status(resp: HttpResponse, code: int) -> None:
    nox.test.assert_eq_int(resp.status, code, "http status")

def assert_body_contains(resp: HttpResponse, s: str) -> None:
    nox.test.assert_true(nox.strings.contains(resp.body, s), "body icerir: " + s)

def assert_body_eq(resp: HttpResponse, s: str) -> None:
    nox.test.assert_eq_str(resp.body, s, "http body")

def header(resp: HttpResponse, name: str) -> str | None:
    try:
        return resp.headers[name]
    except KeyError:
        return None

def assert_header_eq(resp: HttpResponse, name: str, value: str) -> None:
    actual: str | None = header(resp, name)
    found: str = ""
    if actual != None:
        found = actual
    nox.test.assert_eq_str(found, value, "http header " + name)

def extract_set_cookie(resp: HttpResponse) -> str | None:
    return header(resp, "Set-Cookie")
