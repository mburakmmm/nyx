# Ağaç kimliği ve tel protokolü. Düğüm kurulumu nyx.ui içindedir.

import nox.strings

def auto_key(index: int) -> str:
    return "n" + str(index)

def node_id(parent_id: str, key: str) -> str:
    if len(parent_id) == 0:
        return key
    return parent_id + "/" + key

def escape_field(text: str) -> str:
    out: str = ""
    i: int = 0
    n: int = nox.strings.byte_len(text)
    while i < n:
        b: int = nox.strings.byte_at(text, i)
        if b == 92:
            out = out + "\\\\"
        else:
            if b == 10:
                out = out + "\\n"
            else:
                if b == 13:
                    out = out + "\\r"
                else:
                    if b == 32:
                        out = out + "\\s"
                    else:
                        out = out + nox.strings.char_from_byte(b)
        i = i + 1
    return out

def unescape_field(text: str) -> str:
    if text == "\\z":
        return ""
    out: str = ""
    i: int = 0
    n: int = len(text)
    while i < n:
        ch: str = text[i:i + 1]
        if ch == "\\":
            if i + 1 >= n:
                return out
            nxt: str = text[i + 1:i + 2]
            if nxt == "n":
                out = out + nox.strings.char_from_byte(10)
            else:
                if nxt == "r":
                    out = out + nox.strings.char_from_byte(13)
                else:
                    if nxt == "s":
                        out = out + " "
                    else:
                        if nxt == "\\":
                            out = out + "\\"
                        else:
                            out = out + nxt
            i = i + 2
        else:
            out = out + ch
            i = i + 1
    return out
