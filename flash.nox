# nyx.flash - oturum JSON içinde tek kullanımlık mesajlar.
#
# import nyx.flash
# s2: str = nyx.flash.set(s, "notice", "Kaydedildi")
# msg: str | None = nyx.flash.get(s2, "notice")
# s3: str = nyx.flash.clear(s2, "notice")

import nox.json

class FlashError(Exception):
    pass

def _drop_last(s: str) -> str:
    n: int = len(s)
    out: str = ""
    i: int = 0
    while i < n - 1:
        out = out + s[i]
        i = i + 1
    return out

def _find(v: JsonValue, name: str) -> JsonValue | None:
    i: int = 0
    n: int = nox.json.object_len(v)
    while i < n:
        if nox.json.object_key(v, i) == name:
            return nox.json.object_value(v, i)
        i = i + 1
    return None

def _object_without(v: JsonValue, skip: str) -> str:
    out: str = "{"
    first: bool = True
    i: int = 0
    n: int = nox.json.object_len(v)
    while i < n:
        key: str = nox.json.object_key(v, i)
        if key != skip:
            if not first:
                out = out + ","
            first = False
            out = out + nox.json.encode_string(key) + ":" + nox.json.encode(nox.json.object_value(v, i))
        i = i + 1
    return out + "}"

def _root(session_json: str) -> JsonValue:
    raw: str = session_json
    if len(raw) == 0:
        raw = "{}"
    v: JsonValue = nox.json.decode(raw)
    if not nox.json.is_object(v):
        raise FlashError("session JSON nesne olmali")
    return v

def _flash_with(key: str, message: str, existing: JsonValue) -> str:
    out: str = "{"
    first: bool = True
    i: int = 0
    n: int = nox.json.object_len(existing)
    while i < n:
        k: str = nox.json.object_key(existing, i)
        if k != key:
            if not first:
                out = out + ","
            first = False
            out = out + nox.json.encode_string(k) + ":" + nox.json.encode(nox.json.object_value(existing, i))
        i = i + 1
    if not first:
        out = out + ","
    return out + nox.json.encode_string(key) + ":" + nox.json.encode_string(message) + "}"

def set(session_json: str, key: str, message: str) -> str:
    root: JsonValue = _root(session_json)
    flash_v: JsonValue | None = _find(root, "flash")
    flash_json: str = ""
    if flash_v == None:
        flash_json = "{" + nox.json.encode_string(key) + ":" + nox.json.encode_string(message) + "}"
    else:
        if nox.json.is_object(flash_v):
            flash_json = _flash_with(key, message, flash_v)
        else:
            flash_json = "{" + nox.json.encode_string(key) + ":" + nox.json.encode_string(message) + "}"
    base: str = _object_without(root, "flash")
    if base == "{}":
        return "{\"flash\":" + flash_json + "}"
    return _drop_last(base) + ",\"flash\":" + flash_json + "}"

def get(session_json: str, key: str) -> str | None:
    root: JsonValue = _root(session_json)
    flash_v: JsonValue | None = _find(root, "flash")
    if flash_v == None:
        return None
    else:
        if not nox.json.is_object(flash_v):
            return None
        msg_v: JsonValue | None = _find(flash_v, key)
        if msg_v == None:
            return None
        else:
            if nox.json.is_string(msg_v):
                return nox.json.as_string(msg_v)
            return None

def clear(session_json: str, key: str) -> str:
    root: JsonValue = _root(session_json)
    flash_v: JsonValue | None = _find(root, "flash")
    if flash_v == None:
        return nox.json.encode(root)
    else:
        if not nox.json.is_object(flash_v):
            return _object_without(root, "flash")
        new_flash: str = _object_without(flash_v, key)
        base: str = _object_without(root, "flash")
        if new_flash == "{}":
            return base
        if base == "{}":
            return "{\"flash\":" + new_flash + "}"
        return _drop_last(base) + ",\"flash\":" + new_flash + "}"
