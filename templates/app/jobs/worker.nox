# jobs/worker.nox - production worker loop.
# Run: ./bin/nyx jobs work   OR   noxc run jobs/worker.nox

from nox.sqlite import Connection
import nyx.config
import nyx.db
import nyx.job
from nyx.config import Config
from nyx.job import JobRegistry

cfg: Config = nyx.config.load()
db: Connection = nyx.db.open(cfg.jobs_db_path)
nyx.job.ensure_schema(db)
registry: JobRegistry = JobRegistry()

# Register handlers here:
# def send_welcome(payload_json: str) -> None:
#     return None
# registry.register("SendWelcomeEmail", send_welcome)

print("nyx jobs worker path=" + cfg.jobs_db_path)
nyx.job.work_forever(db, registry, 1000, 0)
db.close()
