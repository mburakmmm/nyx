# {{APP_NAME}} — nyx application entry
# noxc fetch && NYX_ENV=development noxc run main.nox

import nox.http
from nox.http import HttpRequest, HttpResponse
from nox.router import Router, Context
from nox.sqlite import Connection
import nyx.app
import nyx.config
import nyx.ctrl
import nyx.cors
from nyx.app import Application
from nyx.config import Config
from nyx.cors import CorsConfig

def setup(application: Application) -> None:
    router: Router = application.router
    db: Connection = application.db
    cors: CorsConfig = nyx.cors.default_config()
    router.use_before(nyx.cors.before_handler(cors))
    router.use_after(nyx.cors.after_handler(cors))

    def home(ctx: Context) -> HttpResponse:
        context: dict[str, str] = {}
        context["title"] = "{{APP_NAME}}"
        return nyx.ctrl.render_layout(
            200,
            "app/views/layouts/application.html",
            "app/views/home.html",
            context
        )

    router.get("/", home)

def handle(req: HttpRequest) -> HttpResponse:
    cfg: Config = nyx.config.load()
    if not cfg.is_production() and len(cfg.secret_key) < 16:
        cfg.secret_key = "change-me-{{APP_NAME}}-secret-key-32b!"
    # Production: NYX_SECRET_KEY zorunlu; NYX_AUTO_MIGRATE varsayilan 0 —
    # `nyx db migrate` ile ayri calistirin. Bearer-only /api/ icin
    # NYX_CSRF_API_EXEMPT=1 (cookie-session + /api/ icin KAPALI birakin).
    application: Application = nyx.app.boot(cfg, setup)
    resp: HttpResponse = HttpResponse(500, "", {})
    try:
        resp = nyx.app.dispatch(application, req)
    finally:
        application.db.close()
    return resp

print("{{APP_NAME}} listening on :8080")
nox.http.serve(8080, handle)
