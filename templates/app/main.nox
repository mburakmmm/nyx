# {{APP_NAME}} - nyx application entry
# Requires Nox >= 1.142.3: TaskLocal, peer_addr, Exception.line, M:N --release, nox.smtp, nox.db.Statement.
# Dev:  noxc fetch && NYX_ENV=development noxc run main.nox
# Prod: noxc build --release main.nox && NYX_WORKERS=8 NOX_POOL_WORKERS=8 ./main

import nox.http
from nox.http import HttpRequest, HttpResponse
from nox.router import Router, Context
from nox.sqlite import Connection
import nyx.app
import nyx.config
import nyx.ctrl
import nyx.cors
import nyx.server
from nyx.app import Application
from nyx.config import Config
from nyx.cors import CorsConfig

def setup(application: Application) -> None:
    router: Router = application.router
    db: Connection = application.db
    cors: CorsConfig = nyx.cors.default_config()
    router.use_before(nyx.cors.before_handler(cors))
    router.use_after(nyx.cors.after_handler(cors))

    def home(ctx: Context) -> HttpResponse:
        context: dict[str, str] = {}
        context["title"] = "{{APP_NAME}}"
        return nyx.ctrl.render_layout(
            200,
            "app/views/layouts/application.html",
            "app/views/home.html",
            context
        )

    router.get("/", home)
    # <<NYX_GENERATED_ROUTES>>

cfg: Config = nyx.config.load()
if not cfg.is_production() and len(cfg.secret_key) < 16:
    cfg.secret_key = "change-me-{{APP_NAME}}-secret-key-32b!"
# Production: NYX_SECRET_KEY zorunlu; NYX_AUTO_MIGRATE varsayilan 0.
# HTTPS: NYX_TLS_CERT + NYX_TLS_KEY
# Multicore: NYX_WORKERS>1 (+ --release icin NOX_POOL_WORKERS)
# Bearer-only /api/ icin NYX_CSRF_API_EXEMPT=1.
application: Application = nyx.app.boot(cfg, setup)

def handle(req: HttpRequest) -> HttpResponse:
    return nyx.app.dispatch(application, req)

mode: str = nyx.server.serve_mode(cfg, False)
print("{{APP_NAME}} listening on :" + str(cfg.port) + " mode=" + mode)
try:
    if mode == "multicore_tls":
        nyx.server.require_tls_files(cfg)
        nox.http.serve_multicore_tls(
            cfg.port, handle, nyx.server.workers(cfg), cfg.tls_cert_path, cfg.tls_key_path
        )
    elif mode == "multicore":
        nox.http.serve_multicore(cfg.port, handle, nyx.server.workers(cfg))
    elif mode == "tls":
        nyx.server.require_tls_files(cfg)
        nox.http.serve_tls(cfg.port, handle, cfg.tls_cert_path, cfg.tls_key_path)
    else:
        nox.http.serve(cfg.port, handle)
finally:
    nyx.app.shutdown(application)
