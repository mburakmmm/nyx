# nyx.base64 - RFC 4648 base64 / base64url.
#
# Kodlama ve cozum nox.base64 uzerinden gider (Nox >= 2.1.63, Zig).
# encode_url dolgusuzdur. encode_hex_url, hmac_sha256 hex metnini once ham
# bayta cevirir, sonra encode_url cagirir. JWT, oturum ve CSRF imzalari
# bu yuzden ayni baytta kalir. NUL ve UTF-8 artik kesilmez.
#
# import nyx.base64

import nox.base64
import nox.strings
from nox.base64 import Base64Error as NoxBase64Error

class Base64Error(Exception):
    pass

def encode(data: str) -> str:
    return nox.base64.encode(data)

def encode_url(data: str) -> str:
    return nox.base64.encode_url(data)

def _rethrow(err: NoxBase64Error) -> None:
    raise Base64Error(err.message)

def decode(data: str) -> str:
    try:
        return nox.base64.decode(data)
    except NoxBase64Error as err:
        _rethrow(err)
        return ""

def decode_url(data: str) -> str:
    try:
        return nox.base64.decode(data)
    except NoxBase64Error as err:
        _rethrow(err)
        return ""

def _hex_nibble(b: int) -> int:
    if b >= 48 and b <= 57:
        return b - 48
    if b >= 97 and b <= 102:
        return b - 87
    if b >= 65 and b <= 70:
        return b - 55
    raise Base64Error("gecersiz hex karakteri")

# nox.crypto.hmac_sha256 hex ciktisini dolgusuz base64url yapar.
def encode_hex_url(hex_data: str) -> str:
    n: int = nox.strings.byte_len(hex_data)
    if n % 2 != 0:
        raise Base64Error("hex uzunlugu cift olmali")
    raw: str = ""
    i: int = 0
    while i + 1 < n:
        hi: int = _hex_nibble(nox.strings.byte_at(hex_data, i))
        lo: int = _hex_nibble(nox.strings.byte_at(hex_data, i + 1))
        raw = raw + nox.strings.char_from_byte((hi << 4) | lo)
        i = i + 2
    return nox.base64.encode_url(raw)
