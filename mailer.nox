# nyx.mailer - ActionMailer-benzeri e-posta gonderimi.
#
# import nyx.mailer
#
# mail: Mail = nyx.mailer.new_mail("a@b.c", cfg.mail_from, "Merhaba", "govde metni")
# nyx.mailer.deliver(cfg, mail)
#
# Teslimat yontemleri (Config.mail_delivery):
#   "file" - tmp/mail/ altina bir .eml dosyasi yazar (gelistirme/test icin).
#   "http" - Config.mail_api_url adresine Bearer Config.mail_api_key ile
#            JSON govdeli bir POST yapar (SendGrid/Postmark/Mailgun benzeri
#            HTTP API saglayicilariyla uyumlu).
#   "smtp" - SMTPS (TLS, tipik 465) AUTH LOGIN; NYX_MAIL_SMTP_*.
# Ikisi de GERCEK G/C yapar - mock yoktur.

import nox.fs
import nox.path
import nox.time
import nox.uuid
import nox.http
import nox.json
import nox.strings
from nox.http import HttpResponse, HttpError
from nox.tls import TlsStream
from nyx.config import Config
import nyx.tls
import nyx.base64

class MailerError:
    def __init__(self: MailerError, message: str) -> None:
        self.message = message

class Mail:
    def __init__(self: Mail, to: str, from_addr: str, subject: str, body: str, html_body: str) -> None:
        self.to = to
        self.from_addr = from_addr
        self.subject = subject
        self.body = body
        self.html_body = html_body

def new_mail(to: str, from_addr: str, subject: str, body: str) -> Mail:
    return Mail(to, from_addr, subject, body, "")

def new_html_mail(to: str, from_addr: str, subject: str, body: str, html_body: str) -> Mail:
    return Mail(to, from_addr, subject, body, html_body)

def _validate(mail: Mail) -> None:
    if len(mail.to) == 0:
        raise MailerError("alici (to) bos olamaz")
    if not nox.strings.contains(mail.to, "@"):
        raise MailerError("gecersiz alici adresi: " + mail.to)
    if len(mail.from_addr) == 0:
        raise MailerError("gonderen (from) bos olamaz")
    if len(mail.subject) == 0:
        raise MailerError("konu (subject) bos olamaz")
    _reject_crlf("to", mail.to)
    _reject_crlf("from", mail.from_addr)
    _reject_crlf("subject", mail.subject)

# Header injection: CR/LF baytlarini reddet. Nox >= 1.8.2 `"\r"` kacisini
# dogru cozer; yine de `byte_at` ile ham bayt kontrolu en guvenilir yoldur.
def _contains_cr_or_lf(s: str) -> bool:
    i: int = 0
    n: int = len(s)
    while i < n:
        b: int = nox.strings.byte_at(s, i)
        if b == 13 or b == 10:
            return True
        i = i + 1
    return False

def _reject_crlf(field: str, value: str) -> None:
    if _contains_cr_or_lf(value):
        raise MailerError("header injection: " + field + " contains CR/LF")

def _ensure_dir(path: str) -> None:
    if len(path) == 0 or path == ".":
        return
    if nox.fs.exists(path):
        return
    parent: str = nox.path.dirname(path)
    if parent != path and len(parent) > 0:
        _ensure_dir(parent)
    if not nox.fs.exists(path):
        nox.fs.create_dir(path)

def _boundary() -> str:
    return "==NyxBoundary_" + nox.uuid.uuid4()

# RFC 2822'ye yakin, basit bir .eml govdesi uretir. `html_body` bossa duz
# metin, doluysa `multipart/alternative` uretilir.
def to_eml(mail: Mail) -> str:
    header: str = (
        "From: " + mail.from_addr + "\r\n" +
        "To: " + mail.to + "\r\n" +
        "Subject: " + mail.subject + "\r\n" +
        "MIME-Version: 1.0\r\n"
    )
    if len(mail.html_body) == 0:
        return header + "Content-Type: text/plain; charset=utf-8\r\n\r\n" + mail.body + "\r\n"
    boundary: str = _boundary()
    out: str = header + "Content-Type: multipart/alternative; boundary=\"" + boundary + "\"\r\n\r\n"
    out = out + "--" + boundary + "\r\n"
    out = out + "Content-Type: text/plain; charset=utf-8\r\n\r\n"
    out = out + mail.body + "\r\n\r\n"
    out = out + "--" + boundary + "\r\n"
    out = out + "Content-Type: text/html; charset=utf-8\r\n\r\n"
    out = out + mail.html_body + "\r\n\r\n"
    out = out + "--" + boundary + "--\r\n"
    return out

def _deliver_file(mail: Mail) -> None:
    dir_path: str = "tmp/mail"
    _ensure_dir(dir_path)
    filename: str = str(nox.time.now_ms()) + "_" + nox.uuid.uuid4() + ".eml"
    full: str = nox.path.join(dir_path, filename)
    nox.fs.write_string(full, to_eml(mail))

def _mail_json(cfg: Config, mail: Mail) -> str:
    out: str = "{"
    out = out + "\"to\":" + nox.json.encode_string(mail.to) + ","
    out = out + "\"from\":" + nox.json.encode_string(mail.from_addr) + ","
    out = out + "\"subject\":" + nox.json.encode_string(mail.subject) + ","
    out = out + "\"text\":" + nox.json.encode_string(mail.body)
    if len(mail.html_body) > 0:
        out = out + ",\"html\":" + nox.json.encode_string(mail.html_body)
    out = out + "}"
    return out

def _deliver_http(cfg: Config, mail: Mail) -> None:
    if len(cfg.mail_api_url) == 0:
        raise MailerError("mail_api_url yapilandirilmamis")
    headers: dict[str, str] = {}
    headers["Content-Type"] = "application/json; charset=utf-8"
    if len(cfg.mail_api_key) > 0:
        headers["Authorization"] = "Bearer " + cfg.mail_api_key
    body: str = _mail_json(cfg, mail)
    try:
        resp: HttpResponse = nox.http.post(cfg.mail_api_url, body, headers)
        if resp.status < 200 or resp.status >= 300:
            raise MailerError("mail API hata dondu: " + str(resp.status) + " " + resp.body)
    except HttpError:
        raise MailerError("mail API istegi basarisiz: " + cfg.mail_api_url)

def _smtp_read_line(stream: TlsStream) -> str:
    buf: str = ""
    done: bool = False
    while not done:
        chunk: str = stream.read(1)
        if len(chunk) == 0:
            raise MailerError("SMTP connection closed while reading")
        buf = buf + chunk
        if nox.strings.ends_with(buf, "\n"):
            done = True
    return buf

def _smtp_expect(stream: TlsStream, code_prefix: str) -> str:
    line: str = _smtp_read_line(stream)
    # Multi-line replies: "250-..." then "250 ..."
    while len(line) >= 4 and line[3] == "-":
        line = _smtp_read_line(stream)
    if not nox.strings.starts_with(line, code_prefix):
        raise MailerError("SMTP unexpected reply (want " + code_prefix + "): " + line)
    return line

def _smtp_write(stream: TlsStream, cmd: str) -> None:
    stream.write(cmd + "\r\n")

# SMTPS (implicit TLS, tipik port 465) - AUTH LOGIN + DATA.
# STARTTLS/plain TCP Nox stdlib'de yok; 587 icin TLS-wrap proxy kullanin.
def _deliver_smtp(cfg: Config, mail: Mail) -> None:
    if len(cfg.mail_smtp_host) == 0:
        raise MailerError("mail_smtp_host yapilandirilmamis")
    if cfg.mail_smtp_port <= 0:
        raise MailerError("mail_smtp_port gecersiz")
    stream: TlsStream = nyx.tls.connect(cfg.mail_smtp_host, cfg.mail_smtp_port)
    try:
        _smtp_expect(stream, "220")
        _smtp_write(stream, "EHLO nyx.mailer")
        _smtp_expect(stream, "250")
        if len(cfg.mail_smtp_user) > 0:
            _smtp_write(stream, "AUTH LOGIN")
            _smtp_expect(stream, "334")
            _smtp_write(stream, nyx.base64.encode(cfg.mail_smtp_user))
            _smtp_expect(stream, "334")
            _smtp_write(stream, nyx.base64.encode(cfg.mail_smtp_password))
            _smtp_expect(stream, "235")
        _smtp_write(stream, "MAIL FROM:<" + mail.from_addr + ">")
        _smtp_expect(stream, "250")
        _smtp_write(stream, "RCPT TO:<" + mail.to + ">")
        _smtp_expect(stream, "250")
        _smtp_write(stream, "DATA")
        _smtp_expect(stream, "354")
        eml: str = to_eml(mail)
        # DATA body must not contain lone "." line - escape leading dots.
        escaped: str = ""
        lines: list[str] = nox.strings.split(eml, "\n")
        li: int = 0
        while li < len(lines):
            line: str = lines[li]
            if nox.strings.ends_with(line, "\r"):
                stripped: str = ""
                si: int = 0
                while si < len(line) - 1:
                    stripped = stripped + line[si]
                    si = si + 1
                line = stripped
            if nox.strings.starts_with(line, "."):
                escaped = escaped + "." + line + "\r\n"
            else:
                escaped = escaped + line + "\r\n"
            li = li + 1
        stream.write(escaped + ".\r\n")
        _smtp_expect(stream, "250")
        _smtp_write(stream, "QUIT")
    finally:
        stream.close()

# Yapilandirilmis teslimat yontemine (Config.mail_delivery) gore postayi
# gonderir. `from_addr`/`to` bossa veya konu eksikse MailerError firlatir.
def deliver(cfg: Config, mail: Mail) -> None:
    _validate(mail)
    if cfg.mail_delivery == "file":
        _deliver_file(mail)
        return
    if cfg.mail_delivery == "http":
        _deliver_http(cfg, mail)
        return
    if cfg.mail_delivery == "smtp":
        _deliver_smtp(cfg, mail)
        return
    raise MailerError("desteklenmeyen mail_delivery: " + cfg.mail_delivery)
