# nyx.routes — resources tarzı rota DSL.
#
# import nyx.routes
# nyx.routes.resources(router, "posts", posts_index, posts_show, posts_new, posts_create, posts_edit, posts_update, posts_destroy)
#
# Method override (Rails'in `_method` gizli form alanı deseni, bkz.
# ActionDispatch::Http::URL): HTML `<form>` GERCEKTEN yalnizca GET/POST
# gonderebilir (tarayicilarin KENDI kisitlamasi) — bu yuzden PUT/PATCH/
# DELETE gibi RESTful eylemler icin istemci bir `_method=PUT` gizli alani
# TASIYAN bir POST istegi gonderir. `nox.router.Router.dispatch` isteklerini
# GERCEK HTTP metoduna (`req.method`, DEGISTIRILEMEZ) gore eslestirdiginden
# bu override ROUTER SEVIYESINDE degil, HANDLER SEVIYESINDE cozulur —
# `effective_method(ctx)` `_method` form/query alanindan COZULMUS "etkin"
# metodu doner, POST rotanizin ICINDE bunu okuyup KENDI dallanmanizi
# (branching) yaparsiniz:
#
#   def items_post(ctx: Context) -> HttpResponse:
#       m: str = nyx.routes.effective_method(ctx)
#       if m == "DELETE":
#           return items_destroy(ctx)
#       return items_update(ctx)
#   router.post("/items/:id", items_post)
#
# NOT (gercek bir Nox derleyici kisiti): burada `handler`i BIR PARAMETRE
# olarak alip ICERIDE `def wrapped(ctx): return handler(ctx, ...)` gibi
# ic ice (nested) bir kapanis (closure) ureten genel bir
# `post_with_override(router, pattern, handler)` sarmalayicisi KASITLI
# OLARAK YOK — GERCEKTEN denenip DOGRULANDI: bir ic ice fonksiyon,
# CEVRELEYEN fonksiyonun FONKSIYON TIPINDEKI (ör. `(Context, str) ->
# HttpResponse`) bir parametresini/yerel degiskenini YAKALADIGINDA
# codegen "desteklenmeyen yapı" hatasiyla BASARISIZ olur (list[T]/dict/str
# gibi VERI tipi degerleri YAKALAMAK sorunsuzdur — yalnizca FONKSIYON
# TIPI degerler bu kisita tabidir). Bagli (bound) metodlar da ilk-sinif
# fonksiyon DEGERI olarak KULLANILAMAZ (yalnizca duz `def` isimleri).

from nox.http import HttpResponse
from nox.router import Router, Context
import nox.strings
import nyx.params

def resources(
    router: Router,
    name: str,
    index: (Context) -> HttpResponse,
    show: (Context) -> HttpResponse,
    new_action: (Context) -> HttpResponse,
    create: (Context) -> HttpResponse,
    edit: (Context) -> HttpResponse,
    update: (Context) -> HttpResponse,
    destroy: (Context) -> HttpResponse
) -> None:
    base: str = "/" + name
    router.get(base, index)
    router.get(base + "/new", new_action)
    router.post(base, create)
    router.get(base + "/:id", show)
    router.get(base + "/:id/edit", edit)
    router.post(base + "/:id", update)
    router.post(base + "/:id/delete", destroy)

def api_resources(
    router: Router,
    name: str,
    index: (Context) -> HttpResponse,
    show: (Context) -> HttpResponse,
    create: (Context) -> HttpResponse,
    update: (Context) -> HttpResponse,
    destroy: (Context) -> HttpResponse
) -> None:
    base: str = "/api/" + name
    router.get(base, index)
    router.post(base, create)
    router.get(base + "/:id", show)
    router.put(base + "/:id", update)
    router.delete(base + "/:id", destroy)

def root(router: Router, handler: (Context) -> HttpResponse) -> None:
    router.get("/", handler)

def get(router: Router, pattern: str, handler: (Context) -> HttpResponse) -> None:
    router.get(pattern, handler)

def post(router: Router, pattern: str, handler: (Context) -> HttpResponse) -> None:
    router.post(pattern, handler)

# `ctx.request`teki `_method` form/query alanini (buyuk/kucuk harf
# duyarsiz) okur — "PUT"/"PATCH"/"DELETE"den BIRIYSE onu, aksi halde
# (alan yok/bos/taninmayan bir deger) GERCEK HTTP metodunu ("POST", zaten
# bu fonksiyon yalnizca POST-olarak-kayitli rotalarda kullanilmasi
# amaclandigindan) doner (bkz. modul basi belge notu).
def effective_method(ctx: Context) -> str:
    params: dict[str, str] = nyx.params.from_request(ctx.request)
    override: str = nox.strings.upper(nyx.params.get(params, "_method", ""))
    if override == "PUT" or override == "PATCH" or override == "DELETE":
        return override
    return "POST"

def path_posts() -> str:
    return path_index("posts")

def path_post(id: int) -> str:
    return path_show("posts", id)

def path_new_post() -> str:
    return path_new("posts")

def path_edit_post(id: int) -> str:
    return path_edit("posts", id)

# Generic resource path helpers (preferred over path_post*).
def path_index(resource: str) -> str:
    return "/" + resource

def path_new(resource: str) -> str:
    return "/" + resource + "/new"

def path_show(resource: str, id: int) -> str:
    return "/" + resource + "/" + str(id)

def path_edit(resource: str, id: int) -> str:
    return "/" + resource + "/" + str(id) + "/edit"

def path_destroy(resource: str, id: int) -> str:
    return "/" + resource + "/" + str(id) + "/delete"

def path_for(resource: str, id: int) -> str:
    if id <= 0:
        return path_index(resource)
    return path_show(resource, id)
