#!/usr/bin/env bash
# nyx — Rails-style scaffold, generator, and db CLI
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TEMPLATES="$ROOT/templates"

usage() {
  cat <<EOF
nyx — Nox web framework helper

Usage:
  nyx new <app_name>                         create a new app skeleton
  nyx generate model <Name> [field:type ...] model + migration (+ down)
  nyx generate controller <Name>             controller + views
  nyx generate scaffold <Name> [field:type]  model + controller + views + route snippet
  nyx generate migration <name>              empty up/down migration
  nyx db migrate                             apply pending migrations
  nyx db rollback                            roll back the last migration
  nyx db schema                              dump db/schema.sql
  nyx db seed                                run db/seeds.nox
  nyx jobs work                              run jobs/worker.nox once
  nyx console                                run db/console.nox (no REPL)
  nyx server                                 run noxc run main.nox
  nyx version                                print version
EOF
}

version() {
  if [[ -f "$ROOT/VERSION" ]]; then
    cat "$ROOT/VERSION"
  else
    echo "0.4.0"
  fi
}

snake() {
  echo "$1" | sed -E 's/([a-z0-9])([A-Z])/\1_\2/g' | tr '[:upper:]' '[:lower:]'
}

pluralize() {
  local s
  s="$(snake "$1")"
  if [[ "$s" == *s ]]; then
    echo "${s}es"
  elif [[ "$s" == *y ]]; then
    echo "${s%y}ies"
  else
    echo "${s}s"
  fi
}

sql_type() {
  case "$1" in
    string|text) echo "TEXT" ;;
    integer|int) echo "INTEGER" ;;
    float|real) echo "REAL" ;;
    boolean|bool) echo "INTEGER" ;;
    datetime|timestamp) echo "TEXT" ;;
    *) echo "TEXT" ;;
  esac
}

cmd_new() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "usage: nyx new <app_name>" >&2
    exit 1
  fi
  if [[ -e "$name" ]]; then
    echo "already exists: $name" >&2
    exit 1
  fi
  local app_label
  app_label="$(basename "$name")"
  mkdir -p "$name"
  cp -R "$TEMPLATES/app/." "$name/"
  if [[ "$(uname)" == "Darwin" ]]; then
    find "$name" -type f \( -name '*.nox' -o -name '*.json' -o -name '*.html' -o -name '*.md' -o -name '*.sql' \) -exec sed -i '' "s#{{APP_NAME}}#$app_label#g" {} +
  else
    find "$name" -type f \( -name '*.nox' -o -name '*.json' -o -name '*.html' -o -name '*.md' -o -name '*.sql' \) -exec sed -i "s#{{APP_NAME}}#$app_label#g" {} +
  fi
  echo "created: $name/"
  echo "  cd $name && noxc fetch && NYX_ENV=development noxc run main.nox"
}

write_migration_pair() {
  local table="$1"
  shift
  local ts
  ts="$(date +%Y%m%d%H%M%S)"
  local mig="db/migrate/${ts}_create_${table}.sql"
  local down="db/migrate/${ts}_create_${table}.down.sql"
  local cols=""
  local f
  for f in "$@"; do
    if [[ "$f" == *:* ]]; then
      local fname="${f%%:*}"
      local fty="${f#*:}"
      cols="${cols}
  \"${fname}\" $(sql_type "$fty"),"
    fi
  done
  mkdir -p db/migrate
  cat > "$mig" <<EOF
CREATE TABLE IF NOT EXISTS "$table" (
  id INTEGER PRIMARY KEY AUTOINCREMENT,${cols}
  created_at TEXT NOT NULL DEFAULT (datetime('now')),
  updated_at TEXT NOT NULL DEFAULT (datetime('now'))
);
EOF
  cat > "$down" <<EOF
DROP TABLE IF EXISTS "$table";
EOF
  echo "created: $mig"
  echo "created: $down"
}

cmd_generate_model() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "usage: nyx generate model <Name> [field:type ...]" >&2
    exit 1
  fi
  shift
  local table
  table="$(pluralize "$name")"
  mkdir -p app/models
  local model_file="app/models/$(snake "$name").nox"
  cat > "$model_file" <<EOF
# $name — nyx.model
# nyx.model.find(db, "$table", id)

def table_name() -> str:
    return "$table"
EOF
  write_migration_pair "$table" "$@"
  echo "created: $model_file"
}

cmd_generate_controller() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "usage: nyx generate controller <Name>" >&2
    exit 1
  fi
  local sn
  sn="$(snake "$name")"
  local table
  table="$(pluralize "$name")"
  mkdir -p app/controllers app/views/"$sn"
  local file="app/controllers/${sn}_controller.nox"
  cat > "$file" <<EOF
# ${name}Controller — register handlers inside setup(application) closures
# so they can capture application.db (Router handlers take Context only).
from nox.http import HttpResponse
from nox.router import Context
import nyx.ctrl

def index(ctx: Context) -> HttpResponse:
    context: dict[str, str] = {}
    context["title"] = "$name"
    return nyx.ctrl.render(200, "app/views/$sn/index.html", context)

def show(ctx: Context) -> HttpResponse:
    id: int = int(ctx.param("id"))
    context: dict[str, str] = {}
    context["title"] = "$name " + str(id)
    return nyx.ctrl.render(200, "app/views/$sn/show.html", context)

def new_action(ctx: Context) -> HttpResponse:
    context: dict[str, str] = {}
    context["title"] = "New $name"
    return nyx.ctrl.render(200, "app/views/$sn/new.html", context)

def create(ctx: Context) -> HttpResponse:
    return nyx.ctrl.redirect("/$table")

def edit(ctx: Context) -> HttpResponse:
    id: int = int(ctx.param("id"))
    context: dict[str, str] = {}
    context["title"] = "Edit $name"
    context["id"] = str(id)
    return nyx.ctrl.render(200, "app/views/$sn/edit.html", context)

def update(ctx: Context) -> HttpResponse:
    id: int = int(ctx.param("id"))
    return nyx.ctrl.redirect("/$table/" + str(id))

def destroy(ctx: Context) -> HttpResponse:
    return nyx.ctrl.redirect("/$table")
EOF
  for v in index show new edit; do
    cat > "app/views/$sn/${v}.html" <<EOF
<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>{{ title }}</title></head>
<body><h1>{{ title }}</h1></body></html>
EOF
  done
  echo "created: $file"
  echo "created: app/views/$sn/"
  echo "wire in main.nox: nyx.routes.resources(router, \"$table\", ...)"
}

cmd_generate_migration() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "usage: nyx generate migration <name>" >&2
    exit 1
  fi
  local sn
  sn="$(snake "$name")"
  local ts
  ts="$(date +%Y%m%d%H%M%S)"
  mkdir -p db/migrate
  local mig="db/migrate/${ts}_${sn}.sql"
  local down="db/migrate/${ts}_${sn}.down.sql"
  echo "-- up" > "$mig"
  echo "-- down" > "$down"
  echo "created: $mig"
  echo "created: $down"
}

cmd_generate_scaffold() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "usage: nyx generate scaffold <Name> [field:type ...]" >&2
    exit 1
  fi
  shift
  cmd_generate_model "$name" "$@"
  cmd_generate_controller "$name"
  local table
  table="$(pluralize "$name")"
  local sn
  sn="$(snake "$name")"
  mkdir -p config
  local snippet="config/scaffold_${sn}_routes.nox.snippet"
  cat > "$snippet" <<EOF
# Paste inside setup(application) — handlers close over db (Nox requirement).
# Then delete this file once wired.
#
# import nyx.model
# import nyx.params
# import nyx.routes
# from nyx.model import Record
#
#     def ${sn}_index(ctx: Context) -> HttpResponse:
#         rows: list[Record] = nyx.model.all(db, "$table")
#         context: dict[str, str] = {}
#         context["title"] = "$name"
#         context["count"] = str(len(rows))
#         return nyx.ctrl.render(200, "app/views/$sn/index.html", context)
#
#     def ${sn}_show(ctx: Context) -> HttpResponse:
#         id: int = int(ctx.param("id"))
#         row: Record | None = nyx.model.find(db, "$table", id)
#         if row == None:
#             return nyx.ctrl.text(404, "not found")
#         context: dict[str, str] = {}
#         context["title"] = row.get("id")
#         return nyx.ctrl.render(200, "app/views/$sn/show.html", context)
#
#     def ${sn}_new(ctx: Context) -> HttpResponse:
#         context: dict[str, str] = {}
#         context["title"] = "New $name"
#         return nyx.ctrl.render(200, "app/views/$sn/new.html", context)
#
#     def ${sn}_create(ctx: Context) -> HttpResponse:
#         form: dict[str, str] = nyx.params.from_request(ctx.request)
#         # permitted: dict[str, str] = nyx.params.permit(form, keys)
#         nyx.model.create(db, "$table", form)
#         return nyx.ctrl.redirect("/$table")
#
#     def ${sn}_edit(ctx: Context) -> HttpResponse:
#         id: int = int(ctx.param("id"))
#         context: dict[str, str] = {}
#         context["title"] = "Edit $name"
#         context["id"] = str(id)
#         return nyx.ctrl.render(200, "app/views/$sn/edit.html", context)
#
#     def ${sn}_update(ctx: Context) -> HttpResponse:
#         id: int = int(ctx.param("id"))
#         form: dict[str, str] = nyx.params.from_request(ctx.request)
#         nyx.model.update(db, "$table", id, form)
#         return nyx.ctrl.redirect("/$table/" + str(id))
#
#     def ${sn}_destroy(ctx: Context) -> HttpResponse:
#         id: int = int(ctx.param("id"))
#         nyx.model.destroy(db, "$table", id)
#         return nyx.ctrl.redirect("/$table")
#
#     nyx.routes.resources(router, "$table", ${sn}_index, ${sn}_show, ${sn}_new, ${sn}_create, ${sn}_edit, ${sn}_update, ${sn}_destroy)
EOF
  echo "created: $snippet"
}

cmd_jobs() {
  local what="${1:-}"
  case "$what" in
    work)
      if [[ ! -f jobs/worker.nox ]]; then
        echo "missing jobs/worker.nox" >&2
        echo "Create jobs/worker.nox that registers handlers and calls nyx.job.work / work_forever." >&2
        exit 1
      fi
      noxc run jobs/worker.nox
      ;;
    *)
      echo "usage: nyx jobs work" >&2
      exit 1
      ;;
  esac
}

write_db_runner() {
  local mode="$1"
  local tmp
  tmp="$(mktemp /tmp/nyx_db_XXXX.nox)"
  cat > "$tmp" <<EOF
import nyx.db
import nyx.config
from nyx.config import Config
from nox.sqlite import Connection

cfg: Config = nyx.config.load()
db: Connection = nyx.db.open(cfg.db_path)
EOF
  if [[ "$mode" == "migrate" ]]; then
    cat >> "$tmp" <<EOF
n: int = nyx.db.migrate(db, cfg.migrate_path)
print("applied=" + str(n))
db.close()
EOF
  elif [[ "$mode" == "rollback" ]]; then
    cat >> "$tmp" <<EOF
v: str = nyx.db.rollback(db, cfg.migrate_path)
print("rolled_back=" + v)
db.close()
EOF
  elif [[ "$mode" == "schema" ]]; then
    cat >> "$tmp" <<EOF
nyx.db.schema_dump(db, "db/schema.sql")
print("wrote db/schema.sql")
db.close()
EOF
  fi
  echo "$tmp"
}

cmd_db() {
  local what="${1:-}"
  case "$what" in
    migrate)
      local f
      f="$(write_db_runner migrate)"
      noxc run "$f"
      rm -f "$f"
      ;;
    rollback)
      local f
      f="$(write_db_runner rollback)"
      noxc run "$f"
      rm -f "$f"
      ;;
    schema)
      mkdir -p db
      local f
      f="$(write_db_runner schema)"
      noxc run "$f"
      rm -f "$f"
      ;;
    seed)
      if [[ ! -f db/seeds.nox ]]; then
        echo "missing db/seeds.nox" >&2
        exit 1
      fi
      noxc run db/seeds.nox
      ;;
    *)
      echo "usage: nyx db migrate|rollback|schema|seed" >&2
      exit 1
      ;;
  esac
}

cmd_console() {
  if [[ -f db/console.nox ]]; then
    noxc run db/console.nox
  else
    cat > /tmp/nyx_console.nox <<EOF
import nyx.config
import nyx.db
from nyx.config import Config
from nox.sqlite import Connection

cfg: Config = nyx.config.load()
db: Connection = nyx.db.open(cfg.db_path)
print("nyx console — env=" + cfg.env + " db=" + cfg.db_path)
print("Nox has no REPL; db is open for this run. Put queries in db/console.nox.")
db.close()
EOF
    noxc run /tmp/nyx_console.nox
  fi
}

cmd_server() {
  noxc run main.nox
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    new)
      shift
      cmd_new "$@"
      ;;
    generate|g)
      shift
      local what="${1:-}"
      shift || true
      case "$what" in
        model) cmd_generate_model "$@" ;;
        controller) cmd_generate_controller "$@" ;;
        migration) cmd_generate_migration "$@" ;;
        scaffold) cmd_generate_scaffold "$@" ;;
        *) echo "unknown generate target: $what" >&2; usage; exit 1 ;;
      esac
      ;;
    db)
      shift
      cmd_db "$@"
      ;;
    jobs)
      shift
      cmd_jobs "$@"
      ;;
    console)
      cmd_console
      ;;
    server|s)
      cmd_server
      ;;
    version|-V|--version)
      version
      ;;
    ""|-h|--help|help)
      usage
      ;;
    *)
      echo "unknown command: $cmd" >&2
      usage
      exit 1
      ;;
  esac
}

main "$@"
