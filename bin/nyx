#!/usr/bin/env bash
# nyx — Rails-style scaffold, generator, and db CLI
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TEMPLATES="$ROOT/templates"

usage() {
  cat <<EOF
nyx — Nox web framework helper

Usage:
  nyx new <app_name>                         create a new app skeleton
  nyx generate model <Name> [field:type ...] model + migration (+ down)
  nyx generate controller <Name>             controller + views
  nyx generate scaffold <Name> [field:type]  model + controller + views + route snippet
  nyx generate migration <name>              empty up/down migration (+ .pg.sql twin)
  nyx generate auth                          Devise-core users + routes snippet
  nyx generate mailer <Name>                 mailer template stub
  nyx generate job <Name>                    job handler stub
  nyx generate channel <Name>                cable channel stub
  nyx db migrate                             apply pending migrations
  nyx db rollback                            roll back the last migration
  nyx db schema                              dump db/schema.sql
  nyx db seed                                run db/seeds.nox
  nyx jobs work                              run jobs/worker.nox
  nyx jobs dead                              list dead jobs
  nyx console                                run db/console.nox (no REPL)
  nyx server                                 run noxc run main.nox
  nyx version                                print version
EOF
}

version() {
  if [[ -f "$ROOT/VERSION" ]]; then
    cat "$ROOT/VERSION"
  else
    echo "0.7.0"
  fi
}

snake() {
  echo "$1" | sed -E 's/([a-z0-9])([A-Z])/\1_\2/g' | tr '[:upper:]' '[:lower:]'
}

pluralize() {
  local s
  s="$(snake "$1")"
  if [[ "$s" == *s ]]; then
    echo "${s}es"
  elif [[ "$s" == *y ]]; then
    echo "${s%y}ies"
  else
    echo "${s}s"
  fi
}

sql_type() {
  case "$1" in
    string|text) echo "TEXT" ;;
    integer|int) echo "INTEGER" ;;
    float|real) echo "REAL" ;;
    boolean|bool) echo "INTEGER" ;;
    datetime|timestamp) echo "TEXT" ;;
    *) echo "TEXT" ;;
  esac
}

# Emit commented nyx.model.set_* lines for scaffold create/update from field:type args.
# Pass indent including leading "# " so the whole snippet line stays commented until pasted.
# Values come from `permitted` dict (after nyx.params.permit).
scaffold_attr_sets() {
  local indent="$1"
  shift || true
  local spec field ftype
  for spec in "$@"; do
    field="${spec%%:*}"
    ftype="${spec##*:}"
    if [[ "$spec" != *:* ]]; then
      ftype="string"
    fi
    case "$ftype" in
      integer|int)
        echo "${indent}nyx.model.set_int(attrs, \"$field\", int(nyx.params.get(permitted, \"$field\", \"0\")))"
        ;;
      boolean|bool)
        echo "${indent}nyx.model.set_bool(attrs, \"$field\", nyx.params.get(permitted, \"$field\", \"\") == \"1\" or nyx.params.get(permitted, \"$field\", \"\") == \"true\")"
        ;;
      *)
        echo "${indent}nyx.model.set_str(attrs, \"$field\", nyx.params.get(permitted, \"$field\", \"\"))"
        ;;
    esac
  done
}

cmd_new() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "usage: nyx new <app_name>" >&2
    exit 1
  fi
  if [[ -e "$name" ]]; then
    echo "already exists: $name" >&2
    exit 1
  fi
  local app_label
  app_label="$(basename "$name")"
  mkdir -p "$name"
  cp -R "$TEMPLATES/app/." "$name/"
  if [[ "$(uname)" == "Darwin" ]]; then
    find "$name" -type f \( -name '*.nox' -o -name '*.json' -o -name '*.html' -o -name '*.md' -o -name '*.sql' \) -exec sed -i '' "s#{{APP_NAME}}#$app_label#g" {} +
  else
    find "$name" -type f \( -name '*.nox' -o -name '*.json' -o -name '*.html' -o -name '*.md' -o -name '*.sql' \) -exec sed -i "s#{{APP_NAME}}#$app_label#g" {} +
  fi
  echo "created: $name/"
  echo "  cd $name && noxc fetch && NYX_ENV=development noxc run main.nox"
}

write_migration_pair() {
  local table="$1"
  shift
  local ts
  ts="$(date +%Y%m%d%H%M%S)"
  local mig="db/migrate/${ts}_create_${table}.sql"
  local down="db/migrate/${ts}_create_${table}.down.sql"
  local cols=""
  local f
  for f in "$@"; do
    if [[ "$f" == *:* ]]; then
      local fname="${f%%:*}"
      local fty="${f#*:}"
      cols="${cols}
  \"${fname}\" $(sql_type "$fty"),"
    fi
  done
  mkdir -p db/migrate
  cat > "$mig" <<EOF
CREATE TABLE IF NOT EXISTS "$table" (
  id INTEGER PRIMARY KEY AUTOINCREMENT,${cols}
  created_at TEXT NOT NULL DEFAULT (datetime('now')),
  updated_at TEXT NOT NULL DEFAULT (datetime('now'))
);
EOF
  cat > "$down" <<EOF
DROP TABLE IF EXISTS "$table";
EOF
  echo "created: $mig"
  echo "created: $down"
}

cmd_generate_model() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "usage: nyx generate model <Name> [field:type ...]" >&2
    exit 1
  fi
  shift
  local table
  table="$(pluralize "$name")"
  local sn
  sn="$(snake "$name")"
  mkdir -p app/models
  local model_file="app/models/${sn}.nox"
  local create_params=""
  local create_sets=""
  local save_params="id: int"
  local save_sets=""
  local spec field ftype
  for spec in "$@"; do
    field="${spec%%:*}"
    ftype="${spec##*:}"
    if [[ "$spec" != *:* ]]; then
      ftype="string"
    fi
    case "$ftype" in
      integer|int|boolean|bool)
        if [[ -n "$create_params" ]]; then create_params="${create_params}, "; fi
        create_params="${create_params}${field}: int"
        create_sets="${create_sets}    nyx.model.set_int(attrs, \"${field}\", ${field})"$'\n'
        save_params="${save_params}, ${field}: int"
        save_sets="${save_sets}    nyx.model.set_int(attrs, \"${field}\", ${field})"$'\n'
        ;;
      *)
        if [[ -n "$create_params" ]]; then create_params="${create_params}, "; fi
        create_params="${create_params}${field}: str"
        create_sets="${create_sets}    nyx.model.set_str(attrs, \"${field}\", ${field})"$'\n'
        save_params="${save_params}, ${field}: str"
        save_sets="${save_sets}    nyx.model.set_str(attrs, \"${field}\", ${field})"$'\n'
        ;;
    esac
  done
  if [[ -z "$create_params" ]]; then
    create_params=""
    create_sets="    # add nyx.model.set_* calls"$'\n'
    save_sets="$create_sets"
  fi
  cat > "$model_file" <<EOF
# $name — typed nyx.model helpers (SQLite Application.db)
import nyx.model
from nyx.model import Record, Attributes
from nox.sqlite import Connection

def table_name() -> str:
    return "$table"

def find(db: Connection, id: int) -> Record | None:
    return nyx.model.find(db, table_name(), id)

def all(db: Connection) -> list[Record]:
    return nyx.model.all(db, table_name())

def destroy(db: Connection, id: int) -> None:
    nyx.model.destroy(db, table_name(), id)

def create(db: Connection${create_params:+, $create_params}) -> int:
    attrs: Attributes = nyx.model.attributes()
${create_sets}    return nyx.model.create_attrs(db, table_name(), attrs)

def save(db: Connection, ${save_params}) -> None:
    attrs: Attributes = nyx.model.attributes()
${save_sets}    nyx.model.update_attrs(db, table_name(), id, attrs)
EOF
  write_migration_pair "$table" "$@"
  echo "created: $model_file"
}

cmd_generate_controller() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "usage: nyx generate controller <Name>" >&2
    exit 1
  fi
  local sn
  sn="$(snake "$name")"
  local table
  table="$(pluralize "$name")"
  mkdir -p app/controllers app/views/"$sn" config
  local file="app/controllers/${sn}_controller.nox"
  cat > "$file" <<EOF
# ${name}Controller
#
# Nox kisiti: router handler'lari setup(application) ICINDE closure olmali
# (db/application yakalamak icin). Asagidaki snippet'i main.nox setup()
# icine yapistirin — satir basindaki '#' isaretlerini kaldirin:
#
#   config/${sn}_routes.nox.snippet
#
# Views: app/views/$sn/
EOF
  local snippet="config/${sn}_routes.nox.snippet"
  cat > "$snippet" <<EOF
# Paste inside setup(application) — AppContext + typed attrs + path helpers.
#
# import nyx.ctx
# import nyx.model
# import nyx.routes
# import nyx.params
# from nyx.ctx import AppContext
# from nyx.model import Record, Attributes
#
#     def ${sn}_index(ctx: Context) -> HttpResponse:
#         ac: AppContext = nyx.ctx.wrap(application, ctx)
#         rows: list[Record] = nyx.model.all(ac.db(), "$table")
#         context: dict[str, str] = {}
#         context["title"] = "$name"
#         context["count"] = str(len(rows))
#         return nyx.ctrl.render(200, "app/views/$sn/index.html", context)
#
#     def ${sn}_show(ctx: Context) -> HttpResponse:
#         ac: AppContext = nyx.ctx.wrap(application, ctx)
#         id: int = ac.path_int("id")
#         row: Record | None = nyx.model.find(ac.db(), "$table", id)
#         if row == None:
#             return nyx.ctrl.not_found_for(ctx)
#         context: dict[str, str] = {}
#         context["title"] = row.get_or("id", str(id))
#         return nyx.ctrl.render(200, "app/views/$sn/show.html", context)
#
#     def ${sn}_new(ctx: Context) -> HttpResponse:
#         secret: str = application.config.secret_key
#         context: dict[str, str] = {}
#         context["title"] = "New $name"
#         context["form_start"] = nyx.csrf.form_with(nyx.routes.path_index("$table"), "POST", secret)
#         context["form_end"] = nyx.form.form_end()
#         context["submit"] = nyx.form.submit("Save")
#         return nyx.ctrl.render_unescaped(200, "app/views/$sn/new.html", context)
#
#     def ${sn}_create(ctx: Context) -> HttpResponse:
#         ac: AppContext = nyx.ctx.wrap(application, ctx)
#         raw: dict[str, str] = nyx.params.from_request(ctx.request)
#         keys: list[str] = []
#         # keys.append("field")
#         permitted: dict[str, str] = nyx.params.permit(raw, keys)
#         req_errs: list[str] = nyx.params.missing_required(permitted, keys)
#         if len(req_errs) > 0:
#             return nyx.ctrl.unprocessable_html(req_errs)
#         attrs: Attributes = nyx.model.attributes()
#         nyx.model.set_str(attrs, "field", nyx.params.get(permitted, "field", ""))
#         nyx.model.create_attrs(ac.db(), "$table", attrs)
#         return nyx.ctrl.redirect(nyx.routes.path_index("$table"))
#
#     def ${sn}_edit(ctx: Context) -> HttpResponse:
#         ac: AppContext = nyx.ctx.wrap(application, ctx)
#         id: int = ac.path_int("id")
#         secret: str = application.config.secret_key
#         context: dict[str, str] = {}
#         context["title"] = "Edit $name"
#         context["id"] = str(id)
#         context["form_start"] = nyx.csrf.form_with(nyx.routes.path_show("$table", id), "POST", secret)
#         context["form_end"] = nyx.form.form_end()
#         context["submit"] = nyx.form.submit("Update")
#         return nyx.ctrl.render_unescaped(200, "app/views/$sn/edit.html", context)
#
#     def ${sn}_update(ctx: Context) -> HttpResponse:
#         ac: AppContext = nyx.ctx.wrap(application, ctx)
#         id: int = ac.path_int("id")
#         attrs: Attributes = nyx.model.attributes()
#         nyx.model.set_str(attrs, "field", ac.param("field", ""))
#         nyx.model.update_attrs(ac.db(), "$table", id, attrs)
#         return nyx.ctrl.redirect(nyx.routes.path_show("$table", id))
#
#     def ${sn}_destroy(ctx: Context) -> HttpResponse:
#         ac: AppContext = nyx.ctx.wrap(application, ctx)
#         id: int = ac.path_int("id")
#         nyx.model.destroy(ac.db(), "$table", id)
#         return nyx.ctrl.redirect(nyx.routes.path_index("$table"))
#
#     nyx.routes.resources(application.router, "$table", ${sn}_index, ${sn}_show, ${sn}_new, ${sn}_create, ${sn}_edit, ${sn}_update, ${sn}_destroy)
EOF
  for v in index show new edit; do
    cat > "app/views/$sn/${v}.html" <<EOF
<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>{{ title }}</title></head>
<body><h1>{{ title }}</h1></body></html>
EOF
  done
  echo "created: $file"
  echo "created: $snippet"
  echo "created: app/views/$sn/"
}

cmd_generate_migration() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "usage: nyx generate migration <name>" >&2
    exit 1
  fi
  local sn
  sn="$(snake "$name")"
  local ts
  ts="$(date +%Y%m%d%H%M%S)"
  mkdir -p db/migrate
  local mig="db/migrate/${ts}_${sn}.sql"
  local down="db/migrate/${ts}_${sn}.down.sql"
  local pg="db/migrate/${ts}_${sn}.pg.sql"
  echo "-- up (sqlite)" > "$mig"
  echo "-- down" > "$down"
  echo "-- up (postgres) — applied via migrate_postgres when dialect=postgres" > "$pg"
  echo "created: $mig"
  echo "created: $down"
  echo "created: $pg"
}

cmd_generate_scaffold() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "usage: nyx generate scaffold <Name> [field:type ...]" >&2
    exit 1
  fi
  shift
  local fields=("$@")
  cmd_generate_model "$name" "${fields[@]}"
  cmd_generate_controller "$name"
  local table
  table="$(pluralize "$name")"
  local sn
  sn="$(snake "$name")"
  mkdir -p config
  local create_sets update_sets key_appends
  create_sets="$(scaffold_attr_sets "#         " "${fields[@]}")"
  update_sets="$(scaffold_attr_sets "#         " "${fields[@]}")"
  live_create_sets="$(scaffold_attr_sets "        " "${fields[@]}")"
  live_update_sets="$(scaffold_attr_sets "        " "${fields[@]}")"
  key_appends=""
  live_key_appends=""
  local spec field
  for spec in "${fields[@]}"; do
    field="${spec%%:*}"
    key_appends="${key_appends}#         keys.append(\"${field}\")"$'\n'
    live_key_appends="${live_key_appends}        keys.append(\"${field}\")"$'\n'
  done
  if [[ -z "$create_sets" ]]; then
    create_sets='#         nyx.model.set_str(attrs, "field", ac.param("field", ""))'
    update_sets="$create_sets"
    key_appends='#         keys.append("field")'$'\n'
    live_create_sets='        nyx.model.set_str(attrs, "field", ac.param("field", ""))'
    live_update_sets="$live_create_sets"
    live_key_appends='        keys.append("field")'$'\n'
  fi
  local snippet="config/scaffold_${sn}_routes.nox.snippet"
  cat > "$snippet" <<EOF
# Paste inside setup(application) — AppContext + typed Attributes + path helpers.
# Then delete this file once wired.
#
# import nyx.ctx
# import nyx.csrf
# import nyx.form
# import nyx.model
# import nyx.params
# import nyx.routes
# from nyx.ctx import AppContext
# from nyx.model import Record, Attributes
#
#     def ${sn}_index(ctx: Context) -> HttpResponse:
#         ac: AppContext = nyx.ctx.wrap(application, ctx)
#         rows: list[Record] = nyx.model.all(ac.db(), "$table")
#         context: dict[str, str] = {}
#         context["title"] = "$name"
#         context["count"] = str(len(rows))
#         return nyx.ctrl.render(200, "app/views/$sn/index.html", context)
#
#     def ${sn}_show(ctx: Context) -> HttpResponse:
#         ac: AppContext = nyx.ctx.wrap(application, ctx)
#         id: int = ac.path_int("id")
#         row: Record | None = nyx.model.find(ac.db(), "$table", id)
#         if row == None:
#             return nyx.ctrl.not_found_for(ctx)
#         context: dict[str, str] = {}
#         context["title"] = row.get_or("id", str(id))
#         return nyx.ctrl.render(200, "app/views/$sn/show.html", context)
#
#     def ${sn}_new(ctx: Context) -> HttpResponse:
#         secret: str = application.config.secret_key
#         context: dict[str, str] = {}
#         context["title"] = "New $name"
#         context["form_start"] = nyx.csrf.form_with(nyx.routes.path_index("$table"), "POST", secret)
#         context["form_end"] = nyx.form.form_end()
#         context["submit"] = nyx.form.submit("Save")
#         return nyx.ctrl.render_unescaped(200, "app/views/$sn/new.html", context)
#
#     def ${sn}_create(ctx: Context) -> HttpResponse:
#         ac: AppContext = nyx.ctx.wrap(application, ctx)
#         raw: dict[str, str] = nyx.params.from_request(ctx.request)
#         keys: list[str] = []
${key_appends}#         permitted: dict[str, str] = nyx.params.permit(raw, keys)
#         req_errs: list[str] = nyx.params.missing_required(permitted, keys)
#         if len(req_errs) > 0:
#             return nyx.ctrl.unprocessable_html(req_errs)
#         attrs: Attributes = nyx.model.attributes()
${create_sets}
#         nyx.model.create_attrs(ac.db(), "$table", attrs)
#         return nyx.ctrl.redirect(nyx.routes.path_index("$table"))
#
#     def ${sn}_edit(ctx: Context) -> HttpResponse:
#         ac: AppContext = nyx.ctx.wrap(application, ctx)
#         id: int = ac.path_int("id")
#         secret: str = application.config.secret_key
#         context: dict[str, str] = {}
#         context["title"] = "Edit $name"
#         context["id"] = str(id)
#         context["form_start"] = nyx.csrf.form_with(nyx.routes.path_show("$table", id), "POST", secret)
#         context["form_end"] = nyx.form.form_end()
#         context["submit"] = nyx.form.submit("Update")
#         return nyx.ctrl.render_unescaped(200, "app/views/$sn/edit.html", context)
#
#     def ${sn}_update(ctx: Context) -> HttpResponse:
#         ac: AppContext = nyx.ctx.wrap(application, ctx)
#         id: int = ac.path_int("id")
#         raw: dict[str, str] = nyx.params.from_request(ctx.request)
#         keys: list[str] = []
${key_appends}#         permitted: dict[str, str] = nyx.params.permit(raw, keys)
#         attrs: Attributes = nyx.model.attributes()
${update_sets}
#         nyx.model.update_attrs(ac.db(), "$table", id, attrs)
#         return nyx.ctrl.redirect(nyx.routes.path_show("$table", id))
#
#     def ${sn}_destroy(ctx: Context) -> HttpResponse:
#         ac: AppContext = nyx.ctx.wrap(application, ctx)
#         id: int = ac.path_int("id")
#         nyx.model.destroy(ac.db(), "$table", id)
#         return nyx.ctrl.redirect(nyx.routes.path_index("$table"))
#
#     nyx.routes.resources(application.router, "$table", ${sn}_index, ${sn}_show, ${sn}_new, ${sn}_create, ${sn}_edit, ${sn}_update, ${sn}_destroy)
EOF
  cp "$snippet" "config/${sn}_routes.nox.snippet"
  echo "created: $snippet"
  echo "updated: config/${sn}_routes.nox.snippet"

  if [[ -f main.nox ]] && grep -q '<<NYX_GENERATED_ROUTES>>' main.nox; then
    local live="config/scaffold_${sn}_routes.live.nox"
    cat > "$live" <<LIVE
    def ${sn}_index(ctx: Context) -> HttpResponse:
        ac: AppContext = nyx.ctx.wrap(application, ctx)
        rows: list[Record] = nyx.model.all(ac.db(), "$table")
        context: dict[str, str] = {}
        context["title"] = "$name"
        context["count"] = str(len(rows))
        return nyx.ctrl.render(200, "app/views/$sn/index.html", context)

    def ${sn}_show(ctx: Context) -> HttpResponse:
        ac: AppContext = nyx.ctx.wrap(application, ctx)
        id: int = ac.path_int("id")
        row: Record | None = nyx.model.find(ac.db(), "$table", id)
        if row == None:
            return nyx.ctrl.not_found_for(ctx)
        context: dict[str, str] = {}
        context["title"] = row.get_or("id", str(id))
        return nyx.ctrl.render(200, "app/views/$sn/show.html", context)

    def ${sn}_new(ctx: Context) -> HttpResponse:
        secret: str = application.config.secret_key
        context: dict[str, str] = {}
        context["title"] = "New $name"
        context["form_start"] = nyx.csrf.form_with(nyx.routes.path_index("$table"), "POST", secret)
        context["form_end"] = nyx.form.form_end()
        context["submit"] = nyx.form.submit("Save")
        return nyx.ctrl.render_unescaped(200, "app/views/$sn/new.html", context)

    def ${sn}_create(ctx: Context) -> HttpResponse:
        ac: AppContext = nyx.ctx.wrap(application, ctx)
        raw: dict[str, str] = nyx.params.from_request(ctx.request)
        keys: list[str] = []
${live_key_appends}        permitted: dict[str, str] = nyx.params.permit(raw, keys)
        req_errs: list[str] = nyx.params.missing_required(permitted, keys)
        if len(req_errs) > 0:
            return nyx.ctrl.unprocessable_html(req_errs)
        attrs: Attributes = nyx.model.attributes()
${live_create_sets}
        nyx.model.create_attrs(ac.db(), "$table", attrs)
        return nyx.ctrl.redirect(nyx.routes.path_index("$table"))

    def ${sn}_edit(ctx: Context) -> HttpResponse:
        ac: AppContext = nyx.ctx.wrap(application, ctx)
        id: int = ac.path_int("id")
        secret: str = application.config.secret_key
        context: dict[str, str] = {}
        context["title"] = "Edit $name"
        context["id"] = str(id)
        context["form_start"] = nyx.csrf.form_with(nyx.routes.path_show("$table", id), "POST", secret)
        context["form_end"] = nyx.form.form_end()
        context["submit"] = nyx.form.submit("Update")
        return nyx.ctrl.render_unescaped(200, "app/views/$sn/edit.html", context)

    def ${sn}_update(ctx: Context) -> HttpResponse:
        ac: AppContext = nyx.ctx.wrap(application, ctx)
        id: int = ac.path_int("id")
        raw: dict[str, str] = nyx.params.from_request(ctx.request)
        keys: list[str] = []
${live_key_appends}        permitted: dict[str, str] = nyx.params.permit(raw, keys)
        attrs: Attributes = nyx.model.attributes()
${live_update_sets}
        nyx.model.update_attrs(ac.db(), "$table", id, attrs)
        return nyx.ctrl.redirect(nyx.routes.path_show("$table", id))

    def ${sn}_destroy(ctx: Context) -> HttpResponse:
        ac: AppContext = nyx.ctx.wrap(application, ctx)
        id: int = ac.path_int("id")
        nyx.model.destroy(ac.db(), "$table", id)
        return nyx.ctrl.redirect(nyx.routes.path_index("$table"))

    nyx.routes.resources(application.router, "$table", ${sn}_index, ${sn}_show, ${sn}_new, ${sn}_create, ${sn}_edit, ${sn}_update, ${sn}_destroy)
LIVE
    awk -v livefile="$live" '
      /<<NYX_GENERATED_ROUTES>>/ {
        while ((getline line < livefile) > 0) print line
        close(livefile)
        print
        next
      }
      { print }
    ' main.nox > main.nox.nyxgen && mv main.nox.nyxgen main.nox
    echo "updated: main.nox (<<NYX_GENERATED_ROUTES>>)"
    echo "ensure main.nox imports: nyx.ctx, nyx.csrf, nyx.form, nyx.model, nyx.params, nyx.routes, AppContext, Record, Attributes"
  else
    echo "tip: add '    # <<NYX_GENERATED_ROUTES>>' inside setup() for auto-wire"
  fi
}

cmd_generate_auth() {
  mkdir -p db/migrate app/views/auth config
  local ts
  ts="$(date -u +%Y%m%d%H%M%S)"
  local up="db/migrate/${ts}_create_users.sql"
  local down="db/migrate/${ts}_create_users.down.sql"
  local pg="db/migrate/${ts}_create_users.pg.sql"
  cat > "$up" <<'SQL'
CREATE TABLE IF NOT EXISTS users (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  email TEXT NOT NULL UNIQUE,
  password_digest TEXT NOT NULL,
  failed_attempts INTEGER NOT NULL DEFAULT 0,
  locked_at_ms INTEGER NOT NULL DEFAULT 0,
  reset_token TEXT NOT NULL DEFAULT '',
  reset_sent_at_ms INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS idx_users_reset_token ON users (reset_token);
SQL
  cat > "$down" <<'SQL'
DROP TABLE IF EXISTS users;
SQL
  cat > "$pg" <<'SQL'
CREATE TABLE IF NOT EXISTS users (
  id BIGSERIAL PRIMARY KEY,
  email TEXT NOT NULL UNIQUE,
  password_digest TEXT NOT NULL,
  failed_attempts INTEGER NOT NULL DEFAULT 0,
  locked_at_ms BIGINT NOT NULL DEFAULT 0,
  reset_token TEXT NOT NULL DEFAULT '',
  reset_sent_at_ms BIGINT NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS idx_users_reset_token ON users (reset_token);
SQL
  cat > config/auth_routes.nox.snippet <<'EOF'
# Paste into setup(application):
# import nyx.auth_engine
# import nyx.params
# from nyx.auth_engine import AuthEngineError
#
# if application.dialect == "postgres":
#     import nyx.auth_engine_pg
#     nyx.auth_engine_pg.ensure_schema(nyx.app.pg(application))
# else:
#     nyx.auth_engine.ensure_schema(application.db)
#
# def auth_register(ctx: Context) -> HttpResponse:
#     p: dict[str, str] = nyx.params.from_request(ctx.request)
#     email: str = nyx.params.get(p, "email", "")
#     password: str = nyx.params.get(p, "password", "")
#     if len(email) == 0 or len(password) == 0:
#         return nyx.ctrl.json(422, "{\"error\":\"missing_fields\"}")
#     try:
#         uid: int = 0
#         if application.dialect == "postgres":
#             uid = nyx.auth_engine_pg.register(nyx.app.pg(application), email, password)
#         else:
#             uid = nyx.auth_engine.register(application.db, email, password)
#         nyx.auth_engine.login_session(uid)
#         return nyx.ctrl.redirect("/")
#     except AuthEngineError as e:
#         return nyx.ctrl.json(422, "{\"error\":" + nox.json.encode_string(e.message) + "}")
#
# def auth_login(ctx: Context) -> HttpResponse:
#     p: dict[str, str] = nyx.params.from_request(ctx.request)
#     email: str = nyx.params.get(p, "email", "")
#     password: str = nyx.params.get(p, "password", "")
#     if len(email) == 0 or len(password) == 0:
#         return nyx.ctrl.json(422, "{\"error\":\"missing_fields\"}")
#     try:
#         uid: int = 0
#         if application.dialect == "postgres":
#             uid = nyx.auth_engine_pg.authenticate(nyx.app.pg(application), email, password)
#         else:
#             uid = nyx.auth_engine.authenticate(application.db, email, password)
#         nyx.auth_engine.login_session(uid)
#         return nyx.ctrl.redirect("/")
#     except AuthEngineError as e:
#         return nyx.ctrl.json(401, "{\"error\":" + nox.json.encode_string(e.message) + "}")
#
# def auth_logout(ctx: Context) -> HttpResponse:
#     nyx.auth_engine.logout_session()
#     return nyx.ctrl.redirect("/")
#
# application.router.post("/register", auth_register)
# application.router.post("/login", auth_login)
# application.router.post("/logout", auth_logout)
EOF
  echo "created: $up"
  echo "created: $down"
  echo "created: $pg"
  echo "created: config/auth_routes.nox.snippet"
}

cmd_generate_mailer() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "usage: nyx generate mailer <Name>" >&2
    exit 1
  fi
  local sn
  sn="$(snake "$name")"
  mkdir -p app/mailers app/views/mailers
  cat > "app/mailers/${sn}.nox" <<EOF
# Mailer: $name
# import nyx.mailer
# mail = nyx.mailer.mail_from_template(to, from_addr, subject, "app/views/mailers/${sn}.txt", ctx)
# nyx.mailer.deliver(cfg, mail)
EOF
  cat > "app/views/mailers/${sn}.txt" <<EOF
Hello {{name}},

This is the ${name} mailer body.
EOF
  echo "created: app/mailers/${sn}.nox"
  echo "created: app/views/mailers/${sn}.txt"
}

cmd_generate_job() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "usage: nyx generate job <Name>" >&2
    exit 1
  fi
  local sn
  sn="$(snake "$name")"
  mkdir -p app/jobs
  cat > "app/jobs/${sn}.nox" <<EOF
# Job handler: $name
# Register in jobs/worker.nox:
# def ${sn}_perform(payload_json: str) -> None:
#     return None
# registry.register("$name", ${sn}_perform)
EOF
  echo "created: app/jobs/${sn}.nox"
}

cmd_generate_channel() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "usage: nyx generate channel <Name>" >&2
    exit 1
  fi
  local sn
  sn="$(snake "$name")"
  mkdir -p app/channels
  cat > "app/channels/${sn}.nox" <<EOF
# Cable channel: $name
# ch = nyx.cable.channel_memory(hub, "$sn")
# nyx.cable.channel_broadcast(ch, "ping", "{}")
# WS: nyx.cable.ws_auth_broadcast_loop(ch, conn, application.db, secret, "")
# PG:  nyx.cable.ws_auth_broadcast_loop_pg(ch, conn, nyx.app.pg(application), secret, "")
# Ticket: nyx.cable.issue_ws_ticket(secret, sid, ch.name, 60)
EOF
  echo "created: app/channels/${sn}.nox"
}

cmd_jobs() {
  local what="${1:-}"
  case "$what" in
    work)
      if [[ ! -f jobs/worker.nox ]]; then
        echo "missing jobs/worker.nox" >&2
        exit 1
      fi
      noxc run jobs/worker.nox
      ;;
    dead)
      local tmp
      tmp="$(mktemp /tmp/nyx_jobs_XXXX.nox)"
      cat > "$tmp" <<'EOF'
import nyx.config
import nyx.db
import nyx.job
from nyx.config import Config
from nox.sqlite import Connection
cfg: Config = nyx.config.load()
db: Connection = nyx.db.open(cfg.jobs_db_path)
nyx.job.ensure_schema(db)
print("dead_count=" + str(nyx.job.count_dead(db)))
rows: list[str] = nyx.job.list_dead(db, 50)
i: int = 0
while i < len(rows):
    print(rows[i])
    i = i + 1
db.close()
EOF
      noxc run "$tmp"
      rm -f "$tmp"
      ;;
    *)
      echo "usage: nyx jobs work|dead" >&2
      exit 1
      ;;
  esac
}

write_db_runner() {
  local mode="$1"
  local tmp
  tmp="$(mktemp /tmp/nyx_db_XXXX.nox)"
  cat > "$tmp" <<EOF
import nyx.db
import nyx.config
from nyx.config import Config

cfg: Config = nyx.config.load()
EOF
  if [[ "$mode" == "migrate" ]]; then
    cat >> "$tmp" <<EOF
n: int = nyx.db.migrate_url(cfg.db_path, cfg.migrate_path)
print("applied=" + str(n))
EOF
  elif [[ "$mode" == "rollback" ]]; then
    cat >> "$tmp" <<EOF
v: str = nyx.db.rollback_url(cfg.db_path, cfg.migrate_path)
print("rolled_back=" + v)
EOF
  elif [[ "$mode" == "schema" ]]; then
    cat >> "$tmp" <<EOF
from nox.sqlite import Connection
db: Connection = nyx.db.open(cfg.db_path)
nyx.db.schema_dump(db, "db/schema.sql")
print("wrote db/schema.sql")
db.close()
EOF
  fi
  echo "$tmp"
}

cmd_db() {
  local what="${1:-}"
  case "$what" in
    migrate)
      local f
      f="$(write_db_runner migrate)"
      noxc run "$f"
      rm -f "$f"
      ;;
    rollback)
      local f
      f="$(write_db_runner rollback)"
      noxc run "$f"
      rm -f "$f"
      ;;
    schema)
      mkdir -p db
      local f
      f="$(write_db_runner schema)"
      noxc run "$f"
      rm -f "$f"
      ;;
    seed)
      if [[ ! -f db/seeds.nox ]]; then
        echo "missing db/seeds.nox" >&2
        exit 1
      fi
      noxc run db/seeds.nox
      ;;
    *)
      echo "usage: nyx db migrate|rollback|schema|seed" >&2
      exit 1
      ;;
  esac
}

cmd_console() {
  if [[ -f db/console.nox ]]; then
    noxc run db/console.nox
  else
    cat > /tmp/nyx_console.nox <<EOF
import nyx.config
import nyx.db
from nyx.config import Config
from nox.sqlite import Connection

cfg: Config = nyx.config.load()
db: Connection = nyx.db.open(cfg.db_path)
print("nyx console — env=" + cfg.env + " db=" + cfg.db_path)
print("Nox has no REPL; db is open for this run. Put queries in db/console.nox.")
db.close()
EOF
    noxc run /tmp/nyx_console.nox
  fi
}

cmd_server() {
  noxc run main.nox
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    new)
      shift
      cmd_new "$@"
      ;;
    generate|g)
      shift
      local what="${1:-}"
      shift || true
      case "$what" in
        model) cmd_generate_model "$@" ;;
        controller) cmd_generate_controller "$@" ;;
        migration) cmd_generate_migration "$@" ;;
        scaffold) cmd_generate_scaffold "$@" ;;
        auth) cmd_generate_auth "$@" ;;
        mailer) cmd_generate_mailer "$@" ;;
        job) cmd_generate_job "$@" ;;
        channel) cmd_generate_channel "$@" ;;
        *) echo "unknown generate target: $what" >&2; usage; exit 1 ;;
      esac
      ;;
    db)
      shift
      cmd_db "$@"
      ;;
    jobs)
      shift
      cmd_jobs "$@"
      ;;
    console)
      cmd_console
      ;;
    server|s)
      cmd_server
      ;;
    version|-V|--version)
      version
      ;;
    ""|-h|--help|help)
      usage
      ;;
    *)
      echo "unknown command: $cmd" >&2
      usage
      exit 1
      ;;
  esac
}

main "$@"
