# nyx.db - SQLite açma + migration runner (+ PG/MySQL open).
#
# import nyx.db
#
# db: Connection = nyx.db.open("db/app.sqlite")
# nyx.db.migrate(db, "db/migrate")
#
# # Ham sürücüler (Nox >= 1.13 prepare/bind):
# pg = nyx.db.open_postgres("postgres://user:pass@localhost:5432/app")
# stmt = pg.prepare("SELECT id FROM t WHERE name = $1")
# stmt.bind_str(0, "alice")
# rows = stmt.query()
# my = nyx.db.open_mysql("mysql://user:pass@localhost:3306/app")
#
# Application.db: SQLite Connection (nyx.model / jobs).
# Application.pg: Postgres Connection listesi uzerinden nyx.app.pg()
#   (Nox DbConnection protokolu execute+close paylasir).
# Nox >= 1.76: prepare() her iki surucude ayni nox.db.Statement sinifini dondurur.
# SQL yer tutuculari ayri kalir (? sqlite, $1 postgres). Row okuma surucuye gore.
# PG/MySQL ham: open_postgres / open_mysql.
# Postgres last_insert_rowid yok - INSERT ... RETURNING kullanin.

import nox.sqlite
import nox.postgres
import nox.mysql
import nox.fs
import nox.path
import nox.strings
import nox.url
from nox.sqlite import Connection, SqliteError
from nox.postgres import Connection as PgConnection, PostgresError
from nox.db import Statement
from nox.mysql import Connection as MysqlConnection, MysqlError
from nox.url import URL, UrlError
from nox.db import Row
from nox.db import Row as PgRow

class DbError(Exception):
    pass

def _drop_prefix(s: str, n: int) -> str:
    out: str = ""
    i: int = n
    while i < len(s):
        out = out + s[i]
        i = i + 1
    return out

def _scheme_of(url: str) -> str:
    if nox.strings.contains(url, "://"):
        try:
            u: URL = nox.url.parse(url)
            return u.scheme
        except UrlError:
            return ""
    return ""

# 'path' düz dosya yolu, ':memory:', veya SQLite URL:
#   sqlite:///absolute/path   sqlite://relative/path   sqlite::memory:
# Postgres/MySQL URL'leri bu fonksiyonda HATA verir - 'open_postgres' /
# 'open_mysql' kullanin. 'nyx.app.boot' postgres URL'lerini Application.pg
# olarak acar (dialect-aware); bu fonksiyon yalnizca SQLite Connection doner.
def open(path: str) -> Connection:
    return open_url(path)

def open_url(url: str) -> Connection:
    if url == ":memory:" or url == "sqlite::memory:":
        return nox.sqlite.open(":memory:")
    scheme: str = _scheme_of(url)
    if scheme == "postgres" or scheme == "postgresql":
        raise DbError(
            "postgres/postgresql URLs require nyx.db.open_postgres(...) or " +
            "nyx.app.boot with DATABASE_URL (sets Application.pg / dialect=postgres). " +
            "nyx.db.open stays typed as SQLite Connection for nyx.model."
        )
    if scheme == "mysql":
        raise DbError(
            "mysql URLs require nyx.db.open_mysql(...). " +
            "Application boot does not wire mysql yet; keep Application.db on sqlite."
        )
    path: str = url
    if nox.strings.starts_with(url, "sqlite://"):
        rest: str = _drop_prefix(url, 9)
        if nox.strings.starts_with(rest, "/"):
            if nox.strings.starts_with(rest, "//"):
                path = _drop_prefix(rest, 1)
            else:
                path = rest
        else:
            path = rest
    parent: str = nox.path.dirname(path)
    if len(parent) > 0 and parent != "." and not nox.fs.exists(parent):
        nox.fs.create_dir(parent)
    return nox.sqlite.open(path)

# libpq URI veya keyword-value conninfo. Donus: nox.postgres.Connection.
# Nox >= 1.13: Connection.prepare + bind_* + execute/query (PQexecParams).
def open_postgres(conninfo: str) -> PgConnection:
    try:
        return nox.postgres.open(conninfo)
    except PostgresError as e:
        raise DbError("postgres open failed: " + e.message)

# mysql://[user[:pass]@]host[:port]/db - prepare/bind + last_insert_rowid.
def open_mysql(conn_url: str) -> MysqlConnection:
    try:
        return nox.mysql.open_url(conn_url)
    except MysqlError as e:
        raise DbError("mysql open failed: " + e.message)

# "sqlite" | "postgres" | "mysql" | ""
def dialect_of_url(url: str) -> str:
    scheme: str = _scheme_of(url)
    if scheme == "sqlite" or scheme == "file" or len(scheme) == 0:
        return "sqlite"
    if scheme == "postgres" or scheme == "postgresql":
        return "postgres"
    if scheme == "mysql":
        return "mysql"
    return ""

# INSERT ... RETURNING id - Postgres'te last_insert_rowid yerine.
# 'sql' örn: "INSERT INTO posts (title) VALUES ($1) RETURNING id"
# Prefers prepare/bind via 'postgres_insert_returning_id_bound'.
def postgres_insert_returning_id(conn: PgConnection, sql: str) -> int:
    try:
        rows: list[PgRow] = conn.query(sql)
        if len(rows) == 0:
            raise DbError("postgres INSERT RETURNING returned no rows")
        return rows[0].get_int(0)
    except PostgresError as e:
        raise DbError("postgres insert returning failed: " + e.message)

# Parametreli INSERT ... RETURNING id ($1..$n sirasiyla binds).
def postgres_insert_returning_id_bound(conn: PgConnection, sql: str, binds: list[str], nulls: list[bool]) -> int:
    if len(binds) != len(nulls):
        raise DbError("binds/nulls length mismatch")
    try:
        stmt: Statement = conn.prepare(sql)
        i: int = 0
        while i < len(binds):
            if nulls[i]:
                stmt.bind_null(i)
            else:
                stmt.bind_str(i, binds[i])
            i = i + 1
        rows: list[PgRow] = stmt.query()
        if len(rows) == 0:
            raise DbError("postgres INSERT RETURNING returned no rows")
        return rows[0].get_int(0)
    except PostgresError as e:
        raise DbError("postgres insert returning failed: " + e.message)

def _ends_with_sql(name: str) -> bool:
    return nox.strings.ends_with(name, ".sql")

def _is_up_migration(name: str) -> bool:
    return _ends_with_sql(name) and not nox.strings.ends_with(name, ".down.sql")

def _str_less(a: str, b: str) -> bool:
    i: int = 0
    na: int = len(a)
    nb: int = len(b)
    while i < na and i < nb:
        ba: int = nox.strings.byte_at(a, i)
        bb: int = nox.strings.byte_at(b, i)
        if ba < bb:
            return True
        if ba > bb:
            return False
        i = i + 1
    return na < nb

def _sort_names(names: list[str]) -> list[str]:
    out: list[str] = []
    i: int = 0
    while i < len(names):
        n: str = names[i]
        out.append(n)
        j: int = len(out) - 1
        while j > 0:
            prev: str = out[j - 1]
            cur: str = out[j]
            if _str_less(prev, cur):
                j = 0
            else:
                if _str_less(cur, prev):
                    out[j - 1] = cur
                    out[j] = prev
                    j = j - 1
                else:
                    j = 0
        i = i + 1
    return out

def _ensure_migrations_table(db: Connection) -> None:
    db.execute("CREATE TABLE IF NOT EXISTS schema_migrations (version TEXT PRIMARY KEY NOT NULL)")

def _already_applied(db: Connection, version: str) -> bool:
    stmt: Statement = db.prepare("SELECT 1 FROM schema_migrations WHERE version = ?")
    stmt.bind_str(0, version)
    rows: list[Row] = stmt.query()
    return len(rows) > 0

def _record_applied(db: Connection, version: str) -> None:
    stmt: Statement = db.prepare("INSERT INTO schema_migrations (version) VALUES (?)")
    stmt.bind_str(0, version)
    stmt.execute()

def migrate(db: Connection, dir_path: str) -> int:
    if not nox.fs.exists(dir_path):
        raise DbError("migration dizini yok: " + dir_path)
    if not nox.fs.is_dir(dir_path):
        raise DbError("migration yolu dizin degil: " + dir_path)
    _ensure_migrations_table(db)
    entries: list[str] = nox.fs.read_dir(dir_path)
    sql_files: list[str] = []
    i: int = 0
    while i < len(entries):
        name: str = entries[i]
        if _is_up_migration(name):
            sql_files.append(name)
        i = i + 1
    ordered: list[str] = _sort_names(sql_files)
    applied: int = 0
    j: int = 0
    while j < len(ordered):
        version: str = ordered[j]
        if not _already_applied(db, version):
            full: str = nox.path.join(dir_path, version)
            sql: str = nox.fs.read_to_string(full)
            db.execute("BEGIN IMMEDIATE")
            try:
                db.execute(sql)
                _record_applied(db, version)
            except SqliteError as e:
                db.execute("ROLLBACK")
                raise DbError("migration basarisiz (geri alindi): " + version + ": " + e.message)
            db.execute("COMMIT")
            applied = applied + 1
        j = j + 1
    return applied

def _drop_last_n(s: str, n: int) -> str:
    out: str = ""
    limit: int = len(s) - n
    i: int = 0
    while i < limit:
        out = out + s[i]
        i = i + 1
    return out

def _down_name(version: str) -> str:
    if _ends_with_sql(version):
        return _drop_last_n(version, 4) + ".down.sql"
    return version + ".down.sql"

def rollback(db: Connection, dir_path: str) -> str:
    _ensure_migrations_table(db)
    stmt: Statement = db.prepare("SELECT version FROM schema_migrations ORDER BY rowid DESC LIMIT 1")
    rows: list[Row] = stmt.query()
    if len(rows) == 0:
        raise DbError("geri alinacak migration yok")
    version: str = rows[0].get_str(0)
    down_name: str = _down_name(version)
    down_path: str = nox.path.join(dir_path, down_name)
    if not nox.fs.exists(down_path):
        raise DbError("down migration dosyasi yok: " + down_path)
    sql: str = nox.fs.read_to_string(down_path)
    db.execute("BEGIN IMMEDIATE")
    try:
        db.execute(sql)
        del_stmt: Statement = db.prepare("DELETE FROM schema_migrations WHERE version = ?")
        del_stmt.bind_str(0, version)
        del_stmt.execute()
    except SqliteError as e:
        db.execute("ROLLBACK")
        raise DbError("rollback basarisiz (geri alindi): " + version + ": " + e.message)
    db.execute("COMMIT")
    return version

def schema_dump(db: Connection, path: str) -> None:
    rows: list[Row] = db.query(
        "SELECT sql FROM sqlite_master WHERE type = 'table' AND sql IS NOT NULL ORDER BY name"
    )
    out: str = ""
    i: int = 0
    while i < len(rows):
        out = out + rows[i].get_str(0) + ";\n\n"
        i = i + 1
    nox.fs.write_string(path, out)

def _ensure_migrations_table_pg(conn: PgConnection) -> None:
    conn.execute("CREATE TABLE IF NOT EXISTS schema_migrations (version TEXT PRIMARY KEY NOT NULL)")

def _already_applied_pg(conn: PgConnection, version: str) -> bool:
    stmt: Statement = conn.prepare("SELECT 1 FROM schema_migrations WHERE version = $1")
    stmt.bind_str(0, version)
    rows: list[PgRow] = stmt.query()
    return len(rows) > 0

def _record_applied_pg(conn: PgConnection, version: str) -> None:
    stmt: Statement = conn.prepare("INSERT INTO schema_migrations (version) VALUES ($1)")
    stmt.bind_str(0, version)
    stmt.execute()

# Postgres migration runner - ayni dosya adlandirmasi (*.sql / *.down.sql).
# SQL diyalekti migration dosyasinda postgres uyumlu olmali.
def migrate_postgres(conn: PgConnection, dir_path: str) -> int:
    if not nox.fs.exists(dir_path):
        raise DbError("migration dizini yok: " + dir_path)
    if not nox.fs.is_dir(dir_path):
        raise DbError("migration yolu dizin degil: " + dir_path)
    _ensure_migrations_table_pg(conn)
    entries: list[str] = nox.fs.read_dir(dir_path)
    sql_files: list[str] = []
    i: int = 0
    while i < len(entries):
        name: str = entries[i]
        if _is_up_migration(name):
            sql_files.append(name)
        i = i + 1
    ordered: list[str] = _sort_names(sql_files)
    applied: int = 0
    j: int = 0
    while j < len(ordered):
        version: str = ordered[j]
        if not _already_applied_pg(conn, version):
            full: str = nox.path.join(dir_path, version)
            sql: str = nox.fs.read_to_string(full)
            conn.execute("BEGIN")
            try:
                conn.execute(sql)
                _record_applied_pg(conn, version)
                conn.execute("COMMIT")
            except PostgresError as e:
                conn.execute("ROLLBACK")
                raise DbError("migration basarisiz (geri alindi): " + version + ": " + e.message)
            applied = applied + 1
        j = j + 1
    return applied

def rollback_postgres(conn: PgConnection, dir_path: str) -> str:
    _ensure_migrations_table_pg(conn)
    rows: list[PgRow] = conn.query(
        "SELECT version FROM schema_migrations ORDER BY version DESC LIMIT 1"
    )
    if len(rows) == 0:
        raise DbError("geri alinacak migration yok")
    version: str = rows[0].get_str(0)
    down_name: str = _down_name(version)
    down_path: str = nox.path.join(dir_path, down_name)
    if not nox.fs.exists(down_path):
        raise DbError("down migration dosyasi yok: " + down_path)
    sql: str = nox.fs.read_to_string(down_path)
    conn.execute("BEGIN")
    try:
        conn.execute(sql)
        del_stmt: Statement = conn.prepare("DELETE FROM schema_migrations WHERE version = $1")
        del_stmt.bind_str(0, version)
        del_stmt.execute()
        conn.execute("COMMIT")
    except PostgresError as e:
        conn.execute("ROLLBACK")
        raise DbError("rollback basarisiz (geri alindi): " + version + ": " + e.message)
    return version

# Dialect'e gore migrate - sqlite veya postgres URL.
def migrate_url(url: str, dir_path: str) -> int:
    dialect: str = dialect_of_url(url)
    if dialect == "postgres":
        conn: PgConnection = open_postgres(url)
        try:
            n: int = migrate_postgres(conn, dir_path)
        finally:
            conn.close()
        return n
    if dialect == "mysql":
        raise DbError("migrate_url does not support mysql yet")
    dbc: Connection = open(url)
    try:
        n2: int = migrate(dbc, dir_path)
    finally:
        dbc.close()
    return n2

def rollback_url(url: str, dir_path: str) -> str:
    dialect: str = dialect_of_url(url)
    if dialect == "postgres":
        conn: PgConnection = open_postgres(url)
        try:
            v: str = rollback_postgres(conn, dir_path)
        finally:
            conn.close()
        return v
    if dialect == "mysql":
        raise DbError("rollback_url does not support mysql yet")
    dbc: Connection = open(url)
    try:
        v2: str = rollback(dbc, dir_path)
    finally:
        dbc.close()
    return v2
