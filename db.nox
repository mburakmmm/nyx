# nyx.db - SQLite açma + migration runner (+ PG/MySQL open).
#
# import nyx.db
#
# db: Connection = nyx.db.open("db/app.sqlite")
# nyx.db.migrate(db, "db/migrate")
#
# # Ham sürücüler (Nox >= 1.13 prepare/bind):
# pg = nyx.db.open_postgres("postgres://user:pass@localhost:5432/app")
# stmt = pg.prepare("SELECT id FROM t WHERE name = $1")
# stmt.bind_str(0, "alice")
# rows = stmt.query()
# my = nyx.db.open_mysql("mysql://user:pass@localhost:3306/app")
#
# Application.db: SQLite (nyx.model / jobs).
# Application.pg / Application.mysql: nyx.app.pg() / nyx.app.mysql().
# Yer tutucu: nyx.db.placeholder(dialect, index).
# Postgres last_insert_rowid yok - INSERT ... RETURNING.
# MySQL last_insert_rowid var.

import nox.sqlite
import nox.postgres
import nox.mysql
import nox.fs
import nox.os
import nox.path
import nox.strings
import nox.url
import nox.time
import nox.uuid
from nox.os import OsError
from nox.sqlite import Connection, SqliteError
from nox.fs import FsError, FileMetadata
from nox.postgres import Connection as PgConnection, PostgresError
from nox.db import Statement
from nox.mysql import Connection as MysqlConnection, MysqlError
from nox.url import URL, UrlError
from nox.db import Row
from nox.db import Row as PgRow

class DbError(Exception):
    pass

def _drop_prefix(s: str, n: int) -> str:
    out: str = ""
    i: int = n
    while i < len(s):
        out = out + s[i]
        i = i + 1
    return out

def _scheme_of(url: str) -> str:
    if nox.strings.contains(url, "://"):
        try:
            u: URL = nox.url.parse(url)
            return u.scheme
        except UrlError:
            return ""
    return ""

# 'path' düz dosya yolu, ':memory:', veya SQLite URL:
#   sqlite:///absolute/path   sqlite://relative/path   sqlite::memory:
# Postgres/MySQL URL'leri bu fonksiyonda HATA verir - 'open_postgres' /
# 'open_mysql' kullanin. 'nyx.app.boot' postgres URL'lerini Application.pg
# olarak acar (dialect-aware); bu fonksiyon yalnizca SQLite Connection doner.
def open(path: str) -> Connection:
    return open_url(path)

def open_url(url: str) -> Connection:
    if url == ":memory:" or url == "sqlite::memory:":
        return nox.sqlite.open(":memory:")
    scheme: str = _scheme_of(url)
    if scheme == "postgres" or scheme == "postgresql":
        raise DbError(
            "postgres/postgresql URLs require nyx.db.open_postgres(...) or " +
            "nyx.app.boot with DATABASE_URL (sets Application.pg / dialect=postgres). " +
            "nyx.db.open stays typed as SQLite Connection for nyx.model."
        )
    if scheme == "mysql":
        raise DbError(
            "mysql URLs require nyx.db.open_mysql(...). " +
            "Application boot does not wire mysql yet; keep Application.db on sqlite."
        )
    path: str = url
    if nox.strings.starts_with(url, "sqlite://"):
        rest: str = _drop_prefix(url, 9)
        if nox.strings.starts_with(rest, "/"):
            if nox.strings.starts_with(rest, "//"):
                path = _drop_prefix(rest, 1)
            else:
                path = rest
        else:
            path = rest
    parent: str = nox.path.dirname(path)
    if len(parent) > 0 and parent != "." and not nox.fs.exists(parent):
        nox.fs.create_dir(parent)
    return nox.sqlite.open(path)

# libpq URI veya keyword-value conninfo. Donus: nox.postgres.Connection.
# Nox >= 1.13: Connection.prepare + bind_* + execute/query (PQexecParams).
def open_postgres(conninfo: str) -> PgConnection:
    try:
        return nox.postgres.open(conninfo)
    except PostgresError as e:
        print("postgres open: " + e.message)
        raise DbError("postgres open failed: " + e.message)

# mysql://[user[:pass]@]host[:port]/db - prepare/bind + last_insert_rowid.
def open_mysql(conn_url: str) -> MysqlConnection:
    try:
        return nox.mysql.open_url(conn_url)
    except MysqlError as e:
        print("mysql open: " + e.message)
        raise DbError("mysql open failed: " + e.message)

# sqlite / mysql: "?". postgres: "$1" (index 0-based).
def placeholder(dialect: str, index: int) -> str:
    if index < 0:
        raise DbError("placeholder index must be >= 0")
    if dialect == "sqlite" or dialect == "mysql":
        return "?"
    if dialect == "postgres":
        return "$" + str(index + 1)
    raise DbError("unknown dialect: " + dialect)

# "sqlite" | "postgres" | "mysql" | ""
def dialect_of_url(url: str) -> str:
    scheme: str = _scheme_of(url)
    if scheme == "sqlite" or scheme == "file" or len(scheme) == 0:
        return "sqlite"
    if scheme == "postgres" or scheme == "postgresql":
        return "postgres"
    if scheme == "mysql":
        return "mysql"
    return ""

# INSERT ... RETURNING id - Postgres'te last_insert_rowid yerine.
# 'sql' örn: "INSERT INTO posts (title) VALUES ($1) RETURNING id"
# Prefers prepare/bind via 'postgres_insert_returning_id_bound'.
def postgres_insert_returning_id(conn: PgConnection, sql: str) -> int:
    try:
        rows: list[PgRow] = conn.query(sql)
        if len(rows) == 0:
            raise DbError("postgres INSERT RETURNING returned no rows")
        return rows[0].get_int(0)
    except PostgresError as e:
        raise DbError("postgres insert returning failed: " + e.message)

# Parametreli INSERT ... RETURNING id ($1..$n sirasiyla binds).
def postgres_insert_returning_id_bound(conn: PgConnection, sql: str, binds: list[str], nulls: list[bool]) -> int:
    if len(binds) != len(nulls):
        raise DbError("binds/nulls length mismatch")
    try:
        stmt: Statement = conn.prepare(sql)
        i: int = 0
        while i < len(binds):
            if nulls[i]:
                stmt.bind_null(i)
            else:
                stmt.bind_str(i, binds[i])
            i = i + 1
        rows: list[PgRow] = stmt.query()
        if len(rows) == 0:
            raise DbError("postgres INSERT RETURNING returned no rows")
        return rows[0].get_int(0)
    except PostgresError as e:
        raise DbError("postgres insert returning failed: " + e.message)

def _ends_with_sql(name: str) -> bool:
    return nox.strings.ends_with(name, ".sql")

# Up dosyalari: sqlite `Ad.sql`, postgres `Ad.pg.sql`, mysql `Ad.mysql.sql`.
# Down: `Ad.down.sql`, `Ad.pg.down.sql`, `Ad.mysql.down.sql`.
# Secim kimlik basina: `001_users.sql` ile `002_posts.pg.sql` ayni kimlik degil.
# Kimligin lehce ikizi varsa o dosya; yoksa duz `Ad.sql`. Ikizi olmayan
# duz dosya, dizinde baska bir `.pg.sql` olsa da uygulanir.
def _drop_suffix(s: str, suffix: str) -> str:
    if not nox.strings.ends_with(s, suffix):
        return s
    keep: int = len(s) - len(suffix)
    out: str = ""
    i: int = 0
    while i < keep:
        out = out + nox.strings.char_from_byte(nox.strings.byte_at(s, i))
        i = i + 1
    return out

def _migration_identity(name: str) -> str:
    base: str = _drop_suffix(name, ".sql")
    if nox.strings.ends_with(base, ".mysql"):
        return _drop_suffix(base, ".mysql")
    if nox.strings.ends_with(base, ".pg"):
        return _drop_suffix(base, ".pg")
    return base

def _is_up_candidate(name: str) -> bool:
    if nox.strings.ends_with(name, ".down.sql"):
        return False
    return _ends_with_sql(name)

def _dialect_rank(name: str, dialect: str) -> int:
    pg: bool = nox.strings.ends_with(name, ".pg.sql")
    my: bool = nox.strings.ends_with(name, ".mysql.sql")
    if dialect == "postgres":
        if pg:
            return 2
        if my:
            return 0
        return 1
    if dialect == "mysql":
        if my:
            return 2
        if pg:
            return 0
        return 1
    if pg or my:
        return 0
    return 2

def _identity_seen(seen: list[str], ident: str) -> bool:
    i: int = 0
    while i < len(seen):
        if seen[i] == ident:
            return True
        i = i + 1
    return False

def select_up_migrations(names: list[str], dialect: str) -> list[str]:
    ups: list[str] = []
    i: int = 0
    while i < len(names):
        if _is_up_candidate(names[i]):
            ups.append(names[i])
        i = i + 1
    chosen: list[str] = []
    seen: list[str] = []
    j: int = 0
    while j < len(ups):
        ident: str = _migration_identity(ups[j])
        if not _identity_seen(seen, ident):
            seen.append(ident)
            best: str = ""
            best_rank: int = 0
            k: int = 0
            while k < len(ups):
                if _migration_identity(ups[k]) == ident:
                    rank: int = _dialect_rank(ups[k], dialect)
                    if rank > best_rank:
                        best_rank = rank
                        best = ups[k]
                k = k + 1
            if best_rank > 0:
                chosen.append(best)
        j = j + 1
    return _sort_names(chosen)

def _str_less(a: str, b: str) -> bool:
    i: int = 0
    na: int = len(a)
    nb: int = len(b)
    while i < na and i < nb:
        ba: int = nox.strings.byte_at(a, i)
        bb: int = nox.strings.byte_at(b, i)
        if ba < bb:
            return True
        if ba > bb:
            return False
        i = i + 1
    return na < nb

def _sort_names(names: list[str]) -> list[str]:
    out: list[str] = []
    i: int = 0
    while i < len(names):
        n: str = names[i]
        out.append(n)
        j: int = len(out) - 1
        while j > 0:
            prev: str = out[j - 1]
            cur: str = out[j]
            if _str_less(prev, cur):
                j = 0
            else:
                if _str_less(cur, prev):
                    out[j - 1] = cur
                    out[j] = prev
                    j = j - 1
                else:
                    j = 0
        i = i + 1
    return out

# Satir, calisan dosyanin adini tutar (rollback o adin .down.sql dosyasini arar).
# Uygulanmis sayilma kimlige bakar: 001_users.sql kaydi, sonra eklenen
# 001_users.pg.sql dosyasini yeni migration sanmaz.
def migration_aliases(version: str) -> list[str]:
    ident: str = _migration_identity(version)
    out: list[str] = []
    out.append(ident)
    out.append(ident + ".sql")
    out.append(ident + ".pg.sql")
    out.append(ident + ".mysql.sql")
    return out

def _ensure_migrations_table(db: Connection) -> None:
    db.execute("CREATE TABLE IF NOT EXISTS schema_migrations (version TEXT PRIMARY KEY NOT NULL)")

def _already_applied(db: Connection, version: str) -> bool:
    names: list[str] = migration_aliases(version)
    stmt: Statement = db.prepare(
        "SELECT 1 FROM schema_migrations WHERE version = ? OR version = ? OR version = ? OR version = ?"
    )
    stmt.bind_str(0, names[0])
    stmt.bind_str(1, names[1])
    stmt.bind_str(2, names[2])
    stmt.bind_str(3, names[3])
    rows: list[Row] = stmt.query()
    return len(rows) > 0

def _record_applied(db: Connection, version: str) -> None:
    stmt: Statement = db.prepare("INSERT INTO schema_migrations (version) VALUES (?)")
    stmt.bind_str(0, version)
    stmt.execute()

_LOCK_WAIT_MS: int = 180000
_LOCK_LEASE_DEFAULT_MS: int = 120000

def _env_ms(name: str, default: int, floor: int) -> int:
    raw: str = ""
    try:
        raw = nox.os.getenv(name)
    except OsError:
        return default
    if len(raw) == 0:
        return default
    n: int = 0
    i: int = 0
    while i < len(raw):
        b: int = nox.strings.byte_at(raw, i)
        if b < 48 or b > 57:
            return default
        n = n * 10 + (b - 48)
        i = i + 1
    if n < floor:
        return floor
    return n

def lock_lease_ms() -> int:
    return _env_ms("NYX_MIGRATE_LOCK_LEASE_MS", _LOCK_LEASE_DEFAULT_MS, 200)

def _lock_pause_ms() -> int:
    return _env_ms("NYX_MIGRATE_LOCK_PAUSE_MS", 0, 0)

def _lock_heartbeat_ms() -> int:
    lease: int = lock_lease_ms()
    if lease <= 150:
        return 50
    if lease <= 1000:
        return 100
    if lease <= 10000:
        return 1000
    return 5000

def _sqlite_db_file(db: Connection) -> str:
    try:
        rows: list[Row] = db.query("PRAGMA database_list")
        if len(rows) > 0:
            return rows[0].get_str(2)
    except SqliteError:
        return ""
    return ""

def _sqlite_busy(db: Connection) -> None:
    try:
        db.query("PRAGMA busy_timeout = 30000")
    except SqliteError:
        return

# PRAGMA bir okuma islemi birakirsa diger baglantinin BEGIN IMMEDIATE
# cagrisi tek OS ipligini kilitler. Migration kendi islemini acmadan once birakilir.
def _sqlite_release_read(db: Connection) -> None:
    try:
        db.execute("ROLLBACK")
    except SqliteError:
        return

# SQLite kilidi ayri bir veritabaninda tutulmaz. Ikinci baglanti uzerindeki
# UPDATE, tek OS ipligini sqlite icinde bekletip fiberi kilitler.
# mkdir atomiktir: dizini olusturan instance kilidi alir, bekleyen uyur.
def _lock_dir(db: Connection) -> str:
    path: str = _sqlite_db_file(db)
    if len(path) == 0:
        return ""
    return path + ".nyx-migrate-lock"

def _parse_u64(text: str) -> int:
    n: int = 0
    i: int = 0
    while i < len(text):
        b: int = nox.strings.byte_at(text, i)
        if b < 48 or b > 57:
            return n
        n = n * 10 + (b - 48)
        i = i + 1
    return n

def _owner_token(text: str) -> str:
    i: int = 0
    while i < len(text):
        if nox.strings.byte_at(text, i) == 10:
            return text[0:i]
        i = i + 1
    return ""

def _owner_until(text: str) -> int:
    i: int = 0
    while i < len(text):
        if nox.strings.byte_at(text, i) == 10:
            return _parse_u64(text[i + 1:len(text)])
        i = i + 1
    return 0

def _read_owner(dir_path: str) -> str:
    owner_path: str = dir_path + "/owner"
    if not nox.fs.is_file(owner_path):
        return ""
    try:
        return nox.fs.read_to_string(owner_path)
    except FsError:
        return ""

def _break_stale_lock(dir_path: str, now: int) -> None:
    if not nox.fs.is_dir(dir_path):
        return
    text: str = _read_owner(dir_path)
    stale: bool = False
    if len(text) == 0:
        try:
            meta: FileMetadata = nox.fs.metadata(dir_path)
            stale = (now - meta.modified_ms) > lock_lease_ms()
        except FsError:
            stale = False
    else:
        stale = _owner_until(text) < now
    if not stale:
        return
    again: str = _read_owner(dir_path)
    if again != text:
        return
    trash: str = dir_path + ".stale." + nox.uuid.uuid4()
    try:
        nox.fs.rename(dir_path, trash)
    except FsError:
        return
    try:
        nox.fs.remove_dir_all(trash)
    except FsError:
        return

def _try_create_lock(dir_path: str, token: str, now: int) -> bool:
    try:
        nox.fs.create_dir(dir_path)
    except FsError:
        return False
    try:
        nox.fs.write_string_atomic(dir_path + "/owner", token + "\n" + str(now + lock_lease_ms()))
    except FsError:
        return False
    written: str = _read_owner(dir_path)
    if _owner_token(written) != token:
        return False
    return True

def _acquire_sqlite(db: Connection) -> str:
    dir_path: str = _lock_dir(db)
    if len(dir_path) == 0:
        return ""
    _sqlite_release_read(db)
    if nox.fs.is_file(dir_path):
        nox.fs.remove_file(dir_path)
    token: str = nox.uuid.uuid4()
    started: int = nox.time.now_ms()
    while True:
        now: int = nox.time.now_ms()
        _break_stale_lock(dir_path, now)
        if _try_create_lock(dir_path, token, now):
            return token
        if now - started > _LOCK_WAIT_MS:
            raise DbError("migration kilidi alinamadi")
        nox.time.sleep_ms(20)
    return ""

def _release_sqlite(db: Connection, token: str) -> None:
    if len(token) == 0:
        return
    dir_path: str = _lock_dir(db)
    if len(dir_path) == 0:
        return
    if _owner_token(_read_owner(dir_path)) != token:
        return
    trash: str = dir_path + ".done." + token
    try:
        nox.fs.rename(dir_path, trash)
    except FsError:
        return
    try:
        nox.fs.remove_dir_all(trash)
    except FsError:
        return

def _refresh_sqlite(db: Connection, token: str) -> bool:
    if len(token) == 0:
        return True
    dir_path: str = _lock_dir(db)
    if len(dir_path) == 0:
        return True
    if _owner_token(_read_owner(dir_path)) != token:
        return False
    now: int = nox.time.now_ms()
    try:
        nox.fs.write_string_atomic(dir_path + "/owner", token + "\n" + str(now + lock_lease_ms()))
    except FsError as e:
        print("sqlite lock: " + e.message)
        return False
    return _owner_token(_read_owner(dir_path)) == token

def _sqlite_still_owned(db: Connection, token: str) -> bool:
    if len(token) == 0:
        return True
    dir_path: str = _lock_dir(db)
    if len(dir_path) == 0:
        return True
    text: str = _read_owner(dir_path)
    if _owner_token(text) != token:
        return False
    return _owner_until(text) >= nox.time.now_ms()

class _LockBeat:
    stop: bool
    lost: bool
    done: bool
    live: bool

    def __init__(self: _LockBeat) -> None:
        self.stop = True
        self.lost = False
        self.done = True
        self.live = False

_sqlite_beat: _LockBeat = _LockBeat()

# Kalp atisi dosyayi yeniler. Uzun sqlite deyimi OS ipligini birakmaz;
# o pencerede lease duserse sonraki dosyada sahiplik kontrolu durur.
async def _beat_sqlite(db: Connection, token: str, beat: _LockBeat) -> None:
    try:
        waited: int = 0
        while not beat.stop:
            nox.time.sleep_ms(50)
            if beat.stop:
                break
            waited = waited + 50
            if waited >= _lock_heartbeat_ms():
                waited = 0
                if not _refresh_sqlite(db, token):
                    beat.lost = True
                    break
    finally:
        beat.done = True

def _start_sqlite_beat(db: Connection, token: str) -> None:
    if len(token) == 0:
        return
    _stop_sqlite_beat()
    _sqlite_beat.stop = False
    _sqlite_beat.lost = False
    _sqlite_beat.done = False
    _sqlite_beat.live = True
    spawn _beat_sqlite(db, token, _sqlite_beat)

def _stop_sqlite_beat() -> None:
    if not _sqlite_beat.live:
        return
    _sqlite_beat.stop = True
    spins: int = 0
    while not _sqlite_beat.done and spins < 15000:
        nox.time.sleep_ms(1)
        spins = spins + 1
    _sqlite_beat.live = False

def _pause_for_lock() -> None:
    pause: int = _lock_pause_ms()
    if pause > 0:
        nox.time.sleep_ms(pause)

def _guard_sqlite(db: Connection, token: str) -> None:
    _pause_for_lock()
    if len(token) == 0:
        return
    if _sqlite_beat.lost or not _sqlite_still_owned(db, token):
        raise DbError("migration kilidi kaybedildi")

# Oturum kilidi lease kullanmaz. Uzun sorgu surerken sunucu kilidi tutar.
# Baglanti dusunce kilit birakilir. Satir INSERT yarisi yoktur.
# Tek bigint anahtar. pg_advisory_lock_held(int, int) Postgres 16'da yok.
# Sahiplik pg_locks satirindan okunur: classid yuksek yari, objid alcak yari, objsubid 1.
def _pg_held_sql() -> str:
    return "SELECT CASE WHEN EXISTS (SELECT 1 FROM pg_locks WHERE locktype = 'advisory' AND database = (SELECT oid FROM pg_database WHERE datname = current_database()) AND classid = 0 AND objid = 831194108 AND objsubid = 1 AND pid = pg_backend_pid() AND granted) THEN 1 ELSE 0 END"

def _pg_lock_flag(conn: PgConnection, sql: str) -> bool:
    rows: list[PgRow] = []
    try:
        rows = conn.query(sql)
    except PostgresError as e:
        print("pg lock: " + e.message)
        raise DbError("migration kilidi sorgusu basarisiz: " + e.message)
    if len(rows) == 0:
        return False
    return rows[0].get_int(0) == 1

def _acquire_pg(conn: PgConnection) -> None:
    started: int = nox.time.now_ms()
    try_sql: str = "SELECT CASE WHEN pg_try_advisory_lock(831194108::bigint) THEN 1 ELSE 0 END"
    while True:
        now: int = nox.time.now_ms()
        if _pg_lock_flag(conn, try_sql):
            return
        if now - started > _LOCK_WAIT_MS:
            raise DbError("migration kilidi alinamadi")
        nox.time.sleep_ms(20)

def _release_pg(conn: PgConnection) -> None:
    try:
        conn.query("SELECT pg_advisory_unlock(831194108::bigint)")
    except PostgresError:
        return

def _guard_pg(conn: PgConnection) -> None:
    _pause_for_lock()
    held: bool = _pg_lock_flag(conn, _pg_held_sql())
    if not held:
        raise DbError("migration kilidi kaybedildi")

def _fnv_name(text: str) -> str:
    h: int = 2166136261
    i: int = 0
    while i < len(text):
        h = (h * 131 + nox.strings.byte_at(text, i)) % 1000000007
        i = i + 1
    return "nyx_" + str(h)

def _mysql_lock_name(conn: MysqlConnection) -> str:
    rows: list[Row] = conn.query("SELECT DATABASE()")
    dbn: str = ""
    if len(rows) > 0:
        dbn = rows[0].get_str(0)
    return _fnv_name(dbn)

def _mysql_flag(conn: MysqlConnection, sql: str, name: str) -> bool:
    stmt: Statement = conn.prepare(sql)
    stmt.bind_str(0, name)
    rows: list[Row] = stmt.query()
    if len(rows) == 0:
        return False
    return rows[0].get_int(0) == 1

def _acquire_mysql(conn: MysqlConnection) -> str:
    name: str = _mysql_lock_name(conn)
    started: int = nox.time.now_ms()
    while True:
        now: int = nox.time.now_ms()
        if _mysql_flag(conn, "SELECT CASE WHEN GET_LOCK(?, 0) = 1 THEN 1 ELSE 0 END", name):
            return name
        if now - started > _LOCK_WAIT_MS:
            raise DbError("migration kilidi alinamadi")
        nox.time.sleep_ms(20)
    return ""

def _release_mysql(conn: MysqlConnection, name: str) -> None:
    if len(name) == 0:
        return
    try:
        stmt: Statement = conn.prepare("SELECT RELEASE_LOCK(?)")
        stmt.bind_str(0, name)
        stmt.query()
    except MysqlError:
        return

def _guard_mysql(conn: MysqlConnection, name: str) -> None:
    _pause_for_lock()
    if len(name) == 0:
        return
    held: bool = _mysql_flag(
        conn,
        "SELECT CASE WHEN IS_USED_LOCK(?) = CONNECTION_ID() THEN 1 ELSE 0 END",
        name
    )
    if not held:
        raise DbError("migration kilidi kaybedildi")

def migrate(db: Connection, dir_path: str) -> int:
    if not nox.fs.exists(dir_path):
        raise DbError("migration dizini yok: " + dir_path)
    if not nox.fs.is_dir(dir_path):
        raise DbError("migration yolu dizin degil: " + dir_path)
    _sqlite_busy(db)
    token: str = _acquire_sqlite(db)
    _start_sqlite_beat(db, token)
    applied: int = 0
    try:
        _ensure_migrations_table(db)
        entries: list[str] = nox.fs.read_dir(dir_path)
        ordered: list[str] = select_up_migrations(entries, "sqlite")
        j: int = 0
        while j < len(ordered):
            _guard_sqlite(db, token)
            version: str = ordered[j]
            if not _already_applied(db, version):
                full: str = nox.path.join(dir_path, version)
                sql: str = nox.fs.read_to_string(full)
                db.execute("BEGIN IMMEDIATE")
                try:
                    db.execute(sql)
                    _record_applied(db, version)
                except SqliteError as e:
                    db.execute("ROLLBACK")
                    raise DbError("migration basarisiz (geri alindi): " + version + ": " + e.message)
                db.execute("COMMIT")
                applied = applied + 1
            j = j + 1
    finally:
        _stop_sqlite_beat()
        _release_sqlite(db, token)
    return applied

def _drop_last_n(s: str, n: int) -> str:
    out: str = ""
    limit: int = len(s) - n
    i: int = 0
    while i < limit:
        out = out + s[i]
        i = i + 1
    return out

def down_migration_name(version: str) -> str:
    if _ends_with_sql(version):
        return _drop_last_n(version, 4) + ".down.sql"
    return version + ".down.sql"

def rollback(db: Connection, dir_path: str) -> str:
    _sqlite_busy(db)
    token: str = _acquire_sqlite(db)
    _start_sqlite_beat(db, token)
    version: str = ""
    try:
        _ensure_migrations_table(db)
        _guard_sqlite(db, token)
        stmt: Statement = db.prepare("SELECT version FROM schema_migrations ORDER BY rowid DESC LIMIT 1")
        rows: list[Row] = stmt.query()
        if len(rows) == 0:
            raise DbError("geri alinacak migration yok")
        version = rows[0].get_str(0)
        down_name: str = down_migration_name(version)
        down_path: str = nox.path.join(dir_path, down_name)
        if not nox.fs.exists(down_path):
            raise DbError("down migration dosyasi yok: " + down_path)
        sql: str = nox.fs.read_to_string(down_path)
        db.execute("BEGIN IMMEDIATE")
        try:
            db.execute(sql)
            del_stmt: Statement = db.prepare("DELETE FROM schema_migrations WHERE version = ?")
            del_stmt.bind_str(0, version)
            del_stmt.execute()
        except SqliteError as e:
            db.execute("ROLLBACK")
            raise DbError("rollback basarisiz (geri alindi): " + version + ": " + e.message)
        db.execute("COMMIT")
    finally:
        _stop_sqlite_beat()
        _release_sqlite(db, token)
    return version

def schema_dump(db: Connection, path: str) -> None:
    rows: list[Row] = db.query(
        "SELECT sql FROM sqlite_master WHERE type = 'table' AND sql IS NOT NULL ORDER BY name"
    )
    out: str = ""
    i: int = 0
    while i < len(rows):
        out = out + rows[i].get_str(0) + ";\n\n"
        i = i + 1
    nox.fs.write_string(path, out)

def _ensure_migrations_table_pg(conn: PgConnection) -> None:
    conn.execute("CREATE TABLE IF NOT EXISTS schema_migrations (version TEXT PRIMARY KEY NOT NULL)")

def _already_applied_pg(conn: PgConnection, version: str) -> bool:
    names: list[str] = migration_aliases(version)
    stmt: Statement = conn.prepare(
        "SELECT 1 FROM schema_migrations WHERE version = $1 OR version = $2 OR version = $3 OR version = $4"
    )
    stmt.bind_str(0, names[0])
    stmt.bind_str(1, names[1])
    stmt.bind_str(2, names[2])
    stmt.bind_str(3, names[3])
    rows: list[PgRow] = stmt.query()
    return len(rows) > 0

def _record_applied_pg(conn: PgConnection, version: str) -> None:
    stmt: Statement = conn.prepare("INSERT INTO schema_migrations (version) VALUES ($1)")
    stmt.bind_str(0, version)
    stmt.execute()

# Postgres: kimligin `*.pg.sql` ikizi varsa o, yoksa duz `*.sql`.
def migrate_postgres(conn: PgConnection, dir_path: str) -> int:
    if not nox.fs.exists(dir_path):
        raise DbError("migration dizini yok: " + dir_path)
    if not nox.fs.is_dir(dir_path):
        raise DbError("migration yolu dizin degil: " + dir_path)
    _acquire_pg(conn)
    applied: int = 0
    try:
        _ensure_migrations_table_pg(conn)
        entries: list[str] = nox.fs.read_dir(dir_path)
        ordered: list[str] = select_up_migrations(entries, "postgres")
        j: int = 0
        while j < len(ordered):
            _guard_pg(conn)
            version: str = ordered[j]
            if not _already_applied_pg(conn, version):
                full: str = nox.path.join(dir_path, version)
                sql: str = nox.fs.read_to_string(full)
                conn.execute("BEGIN")
                try:
                    conn.execute(sql)
                    _record_applied_pg(conn, version)
                    conn.execute("COMMIT")
                except PostgresError as e:
                    conn.execute("ROLLBACK")
                    raise DbError("migration basarisiz (geri alindi): " + version + ": " + e.message)
                applied = applied + 1
            j = j + 1
    finally:
        _release_pg(conn)
    return applied

def rollback_postgres(conn: PgConnection, dir_path: str) -> str:
    _acquire_pg(conn)
    version: str = ""
    try:
        _ensure_migrations_table_pg(conn)
        _guard_pg(conn)
        rows: list[PgRow] = conn.query(
            "SELECT version FROM schema_migrations ORDER BY version DESC LIMIT 1"
        )
        if len(rows) == 0:
            raise DbError("geri alinacak migration yok")
        version = rows[0].get_str(0)
        down_name: str = down_migration_name(version)
        down_path: str = nox.path.join(dir_path, down_name)
        if not nox.fs.exists(down_path):
            raise DbError("down migration dosyasi yok: " + down_path)
        sql: str = nox.fs.read_to_string(down_path)
        conn.execute("BEGIN")
        try:
            conn.execute(sql)
            del_stmt: Statement = conn.prepare("DELETE FROM schema_migrations WHERE version = $1")
            del_stmt.bind_str(0, version)
            del_stmt.execute()
            conn.execute("COMMIT")
        except PostgresError as e:
            conn.execute("ROLLBACK")
            raise DbError("rollback basarisiz (geri alindi): " + version + ": " + e.message)
    finally:
        _release_pg(conn)
    return version

def _ensure_migrations_table_mysql(conn: MysqlConnection) -> None:
    conn.execute(
        "CREATE TABLE IF NOT EXISTS schema_migrations (version VARCHAR(255) PRIMARY KEY NOT NULL)"
    )

def _already_applied_mysql(conn: MysqlConnection, version: str) -> bool:
    names: list[str] = migration_aliases(version)
    stmt: Statement = conn.prepare(
        "SELECT 1 FROM schema_migrations WHERE version = ? OR version = ? OR version = ? OR version = ?"
    )
    stmt.bind_str(0, names[0])
    stmt.bind_str(1, names[1])
    stmt.bind_str(2, names[2])
    stmt.bind_str(3, names[3])
    rows: list[Row] = stmt.query()
    return len(rows) > 0

def _record_applied_mysql(conn: MysqlConnection, version: str) -> None:
    stmt: Statement = conn.prepare("INSERT INTO schema_migrations (version) VALUES (?)")
    stmt.bind_str(0, version)
    stmt.execute()

# MySQL: kimligin `*.mysql.sql` ikizi varsa o, yoksa duz `*.sql`.
# execute tek deyim calistirir; bir dosyada birden fazla deyim varsa ayri dosyaya bolun.
# DDL (CREATE/ALTER/DROP) MySQL'de acik islemi örtülü commit eder. ROLLBACK
# o tabloyu silmez. Basarisiz bir migration dosyasi semayi yarim birakabilir;
# yeniden kosum IF NOT EXISTS / IF EXISTS ile guvenli olmalidir.
def migrate_mysql(conn: MysqlConnection, dir_path: str) -> int:
    if not nox.fs.exists(dir_path):
        raise DbError("migration dizini yok: " + dir_path)
    if not nox.fs.is_dir(dir_path):
        raise DbError("migration yolu dizin degil: " + dir_path)
    token: str = _acquire_mysql(conn)
    applied: int = 0
    try:
        _ensure_migrations_table_mysql(conn)
        entries: list[str] = nox.fs.read_dir(dir_path)
        ordered: list[str] = select_up_migrations(entries, "mysql")
        j: int = 0
        while j < len(ordered):
            _guard_mysql(conn, token)
            version: str = ordered[j]
            if not _already_applied_mysql(conn, version):
                full: str = nox.path.join(dir_path, version)
                sql: str = nox.fs.read_to_string(full)
                conn.execute("START TRANSACTION")
                try:
                    conn.execute(sql)
                    _record_applied_mysql(conn, version)
                    conn.execute("COMMIT")
                except MysqlError as e:
                    conn.execute("ROLLBACK")
                    raise DbError(
                        "migration basarisiz: " + version + ": " + e.message +
                        " (MySQL DDL geri alinmaz; yarim sema kalmis olabilir)"
                    )
                applied = applied + 1
            j = j + 1
    finally:
        _release_mysql(conn, token)
    return applied

def rollback_mysql(conn: MysqlConnection, dir_path: str) -> str:
    token: str = _acquire_mysql(conn)
    version: str = ""
    try:
        _ensure_migrations_table_mysql(conn)
        _guard_mysql(conn, token)
        rows: list[Row] = conn.query(
            "SELECT version FROM schema_migrations ORDER BY version DESC LIMIT 1"
        )
        if len(rows) == 0:
            raise DbError("geri alinacak migration yok")
        version = rows[0].get_str(0)
        down_name: str = down_migration_name(version)
        down_path: str = nox.path.join(dir_path, down_name)
        if not nox.fs.exists(down_path):
            raise DbError("down migration dosyasi yok: " + down_path)
        sql: str = nox.fs.read_to_string(down_path)
        conn.execute("START TRANSACTION")
        try:
            conn.execute(sql)
            del_stmt: Statement = conn.prepare("DELETE FROM schema_migrations WHERE version = ?")
            del_stmt.bind_str(0, version)
            del_stmt.execute()
            conn.execute("COMMIT")
        except MysqlError as e:
            conn.execute("ROLLBACK")
            raise DbError(
                "rollback basarisiz: " + version + ": " + e.message +
                " (MySQL DDL geri alinmaz; yarim sema kalmis olabilir)"
            )
    finally:
        _release_mysql(conn, token)
    return version

# Dialect'e gore migrate - sqlite, postgres veya mysql URL.
def migrate_url(url: str, dir_path: str) -> int:
    dialect: str = dialect_of_url(url)
    if dialect == "postgres":
        conn: PgConnection = open_postgres(url)
        try:
            n: int = migrate_postgres(conn, dir_path)
        finally:
            conn.close()
        return n
    if dialect == "mysql":
        my: MysqlConnection = open_mysql(url)
        try:
            n_my: int = migrate_mysql(my, dir_path)
        finally:
            my.close()
        return n_my
    dbc: Connection = open(url)
    try:
        n2: int = migrate(dbc, dir_path)
    finally:
        dbc.close()
    return n2

def rollback_url(url: str, dir_path: str) -> str:
    dialect: str = dialect_of_url(url)
    if dialect == "postgres":
        conn: PgConnection = open_postgres(url)
        try:
            v: str = rollback_postgres(conn, dir_path)
        finally:
            conn.close()
        return v
    if dialect == "mysql":
        my: MysqlConnection = open_mysql(url)
        try:
            v_my: str = rollback_mysql(my, dir_path)
        finally:
            my.close()
        return v_my
    dbc: Connection = open(url)
    try:
        v2: str = rollback(dbc, dir_path)
    finally:
        dbc.close()
    return v2
