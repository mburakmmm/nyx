# nyx.db — SQLite açma + migration runner (+ ham PG/MySQL open).
#
# import nyx.db
#
# db: Connection = nyx.db.open("db/app.sqlite")
# nyx.db.migrate(db, "db/migrate")
#
# # Ham sürücüler (Nox >= 1.11) — nyx.model/job/Application.db DEĞİL:
# pg = nyx.db.open_postgres("postgres://user:pass@localhost:5432/app")
# my = nyx.db.open_mysql("mysql://user:pass@localhost:3306/app")
#
# PG/MySQL v1: parametreli sorgu (prepare/bind) YOK — SQL enjeksiyonuna dikkat.

import nox.sqlite
import nox.postgres
import nox.mysql
import nox.fs
import nox.path
import nox.strings
import nox.url
from nox.sqlite import Connection, Statement, Row, SqliteError
from nox.postgres import Connection as PgConnection, PostgresError
from nox.mysql import Connection as MysqlConnection, MysqlError
from nox.url import URL, UrlError

class DbError:
    def __init__(self: DbError, message: str) -> None:
        self.message = message

def _drop_prefix(s: str, n: int) -> str:
    out: str = ""
    i: int = n
    while i < len(s):
        out = out + s[i]
        i = i + 1
    return out

def _scheme_of(url: str) -> str:
    if nox.strings.contains(url, "://"):
        try:
            u: URL = nox.url.parse(url)
            return u.scheme
        except UrlError:
            return ""
    return ""

# `path` düz dosya yolu, `:memory:`, veya SQLite URL:
#   sqlite:///absolute/path   sqlite://relative/path   sqlite::memory:
# Postgres/MySQL URL'leri bu fonksiyonda HATA verir — `open_postgres` /
# `open_mysql` kullanın (Application.db tipi SQLite Connection).
def open(path: str) -> Connection:
    return open_url(path)

def open_url(url: str) -> Connection:
    if url == ":memory:" or url == "sqlite::memory:":
        return nox.sqlite.open(":memory:")
    scheme: str = _scheme_of(url)
    if scheme == "postgres" or scheme == "postgresql":
        raise DbError(
            "postgres/postgresql URLs require nyx.db.open_postgres(...). " +
            "nyx.model / Application.db stay SQLite until parameterized queries exist. " +
            "Use NYX_DB_PATH or sqlite:///path/to.db for the app ORM."
        )
    if scheme == "mysql":
        raise DbError(
            "mysql URLs require nyx.db.open_mysql(...). " +
            "nyx.model / Application.db stay SQLite. Use sqlite:///path/to.db for the app ORM."
        )
    path: str = url
    if nox.strings.starts_with(url, "sqlite://"):
        rest: str = _drop_prefix(url, 9)
        if nox.strings.starts_with(rest, "/"):
            if nox.strings.starts_with(rest, "//"):
                path = _drop_prefix(rest, 1)
            else:
                path = rest
        else:
            path = rest
    parent: str = nox.path.dirname(path)
    if len(parent) > 0 and parent != "." and not nox.fs.exists(parent):
        nox.fs.create_dir(parent)
    return nox.sqlite.open(path)

# libpq URI veya keyword-value conninfo. Donus: nox.postgres.Connection.
# Parametreli sorgu YOK — degerleri kendiniz kacisin / birlestirin.
def open_postgres(conninfo: str) -> PgConnection:
    try:
        return nox.postgres.open(conninfo)
    except PostgresError as e:
        raise DbError("postgres open failed: " + e.message)

# mysql://[user[:pass]@]host[:port]/db
def open_mysql(conn_url: str) -> MysqlConnection:
    try:
        return nox.mysql.open_url(conn_url)
    except MysqlError as e:
        raise DbError("mysql open failed: " + e.message)

def _ends_with_sql(name: str) -> bool:
    return nox.strings.ends_with(name, ".sql")

def _is_up_migration(name: str) -> bool:
    return _ends_with_sql(name) and not nox.strings.ends_with(name, ".down.sql")

def _str_less(a: str, b: str) -> bool:
    i: int = 0
    na: int = len(a)
    nb: int = len(b)
    while i < na and i < nb:
        ba: int = nox.strings.byte_at(a, i)
        bb: int = nox.strings.byte_at(b, i)
        if ba < bb:
            return True
        if ba > bb:
            return False
        i = i + 1
    return na < nb

def _sort_names(names: list[str]) -> list[str]:
    out: list[str] = []
    i: int = 0
    while i < len(names):
        n: str = names[i]
        out.append(n)
        j: int = len(out) - 1
        while j > 0:
            prev: str = out[j - 1]
            cur: str = out[j]
            if _str_less(prev, cur):
                j = 0
            else:
                if _str_less(cur, prev):
                    out[j - 1] = cur
                    out[j] = prev
                    j = j - 1
                else:
                    j = 0
        i = i + 1
    return out

def _ensure_migrations_table(db: Connection) -> None:
    db.execute("CREATE TABLE IF NOT EXISTS schema_migrations (version TEXT PRIMARY KEY NOT NULL)")

def _already_applied(db: Connection, version: str) -> bool:
    stmt: Statement = db.prepare("SELECT 1 FROM schema_migrations WHERE version = ?")
    stmt.bind_str(0, version)
    rows: list[Row] = stmt.query()
    return len(rows) > 0

def _record_applied(db: Connection, version: str) -> None:
    stmt: Statement = db.prepare("INSERT INTO schema_migrations (version) VALUES (?)")
    stmt.bind_str(0, version)
    stmt.execute()

def migrate(db: Connection, dir_path: str) -> int:
    if not nox.fs.exists(dir_path):
        raise DbError("migration dizini yok: " + dir_path)
    if not nox.fs.is_dir(dir_path):
        raise DbError("migration yolu dizin degil: " + dir_path)
    _ensure_migrations_table(db)
    entries: list[str] = nox.fs.read_dir(dir_path)
    sql_files: list[str] = []
    i: int = 0
    while i < len(entries):
        name: str = entries[i]
        if _is_up_migration(name):
            sql_files.append(name)
        i = i + 1
    ordered: list[str] = _sort_names(sql_files)
    applied: int = 0
    j: int = 0
    while j < len(ordered):
        version: str = ordered[j]
        if not _already_applied(db, version):
            full: str = nox.path.join(dir_path, version)
            sql: str = nox.fs.read_to_string(full)
            db.execute("BEGIN IMMEDIATE")
            try:
                db.execute(sql)
                _record_applied(db, version)
            except SqliteError as e:
                db.execute("ROLLBACK")
                raise DbError("migration basarisiz (geri alindi): " + version + ": " + e.message)
            db.execute("COMMIT")
            applied = applied + 1
        j = j + 1
    return applied

def _drop_last_n(s: str, n: int) -> str:
    out: str = ""
    limit: int = len(s) - n
    i: int = 0
    while i < limit:
        out = out + s[i]
        i = i + 1
    return out

def _down_name(version: str) -> str:
    if _ends_with_sql(version):
        return _drop_last_n(version, 4) + ".down.sql"
    return version + ".down.sql"

def rollback(db: Connection, dir_path: str) -> str:
    _ensure_migrations_table(db)
    stmt: Statement = db.prepare("SELECT version FROM schema_migrations ORDER BY rowid DESC LIMIT 1")
    rows: list[Row] = stmt.query()
    if len(rows) == 0:
        raise DbError("geri alinacak migration yok")
    version: str = rows[0].get_str(0)
    down_name: str = _down_name(version)
    down_path: str = nox.path.join(dir_path, down_name)
    if not nox.fs.exists(down_path):
        raise DbError("down migration dosyasi yok: " + down_path)
    sql: str = nox.fs.read_to_string(down_path)
    db.execute("BEGIN IMMEDIATE")
    try:
        db.execute(sql)
        del_stmt: Statement = db.prepare("DELETE FROM schema_migrations WHERE version = ?")
        del_stmt.bind_str(0, version)
        del_stmt.execute()
    except SqliteError as e:
        db.execute("ROLLBACK")
        raise DbError("rollback basarisiz (geri alindi): " + version + ": " + e.message)
    db.execute("COMMIT")
    return version

def schema_dump(db: Connection, path: str) -> None:
    rows: list[Row] = db.query(
        "SELECT sql FROM sqlite_master WHERE type = 'table' AND sql IS NOT NULL ORDER BY name"
    )
    out: str = ""
    i: int = 0
    while i < len(rows):
        out = out + rows[i].get_str(0) + ";\n\n"
        i = i + 1
    nox.fs.write_string(path, out)
