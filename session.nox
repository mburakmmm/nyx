# web.session — HMAC-imzalı cookie oturumu.
#
# Cookie değeri: base64url(envelope) + "." + base64url(hmac_hex)
# envelope: {"exp":<unix>,"d":<data_json-as-embedded-json>}
#
# import web.session

import nox.crypto
import nox.json
import nox.time
import nox.strings
import web.base64
from nox.json import JsonError
from web.base64 import Base64Error

class SessionError:
    def __init__(self: SessionError, message: str) -> None:
        self.message = message

def default_cookie_name() -> str:
    return "nox_session"

def _now_unix() -> int:
    return nox.time.now_ms() // 1000

def _sign(secret: str, payload_b64: str) -> str:
    mac_hex: str = nox.crypto.hmac_sha256(secret, payload_b64)
    return web.base64.encode_hex_url(mac_hex)

def create(secret: str, data_json: str, max_age_sec: int) -> str:
    if len(secret) == 0:
        raise SessionError("secret bos olamaz")
    if max_age_sec <= 0:
        raise SessionError("max_age_sec pozitif olmali")
    # data_json gömülü JSON olmalı (nesne/dizi/string literal metni).
    body: JsonValue = nox.json.decode(data_json)
    exp: int = _now_unix() + max_age_sec
    envelope: str = "{\"exp\":" + str(exp) + ",\"d\":" + nox.json.encode(body) + "}"
    payload_b64: str = web.base64.encode_url(envelope)
    sig: str = _sign(secret, payload_b64)
    return payload_b64 + "." + sig

def load(secret: str, cookie_value: str) -> str | None:
    if len(secret) == 0:
        return None
    if len(cookie_value) == 0:
        return None
    parts: list[str] = nox.strings.split(cookie_value, ".")
    if len(parts) != 2:
        return None
    payload_b64: str = parts[0]
    sig: str = parts[1]
    expected: str = _sign(secret, payload_b64)
    if not nox.crypto.constant_time_eq(sig, expected):
        return None
    try:
        envelope_json: str = web.base64.decode_url(payload_b64)
        env: JsonValue = nox.json.decode(envelope_json)
        if not nox.json.is_object(env):
            return None
        exp_v: JsonValue | None = None
        data_v: JsonValue | None = None
        i: int = 0
        n: int = nox.json.object_len(env)
        while i < n:
            key: str = nox.json.object_key(env, i)
            if key == "exp":
                exp_v = nox.json.object_value(env, i)
            if key == "d":
                data_v = nox.json.object_value(env, i)
            i = i + 1
        if exp_v == None or data_v == None:
            return None
        if not nox.json.is_number(exp_v):
            return None
        exp_i: int = int(nox.json.as_number(exp_v))
        if _now_unix() >= exp_i:
            return None
        return nox.json.encode(data_v)
    except JsonError:
        return None
    except Base64Error:
        return None
