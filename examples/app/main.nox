# Örnek: login + JWT korumalı /me + CORS
#
#   cd examples/app && noxc run main.nox
#
# Demo kullanıcı: alice / secret123
# `nox.http.serve` handle'ı derleme-zamanı üst düzey fonksiyon adı olmalı.

import nox.http
import nox.validate
import nox.time
import nox.json
from nox.http import HttpRequest, HttpResponse
from nox.router import Router, Context
from nox.validate import Schema
import nyx.jwt
import nyx.password
import nyx.auth
import nyx.cors
import nyx.response
from nyx.cors import CorsConfig

# Önceden üretilmiş: nyx.password.hash("secret123")
def demo_password_hash() -> str:
    return "$argon2id$v=19$m=19456,t=2,p=1$u0TfSRMYacNa94sSvfb+x0Vc9+nGeUT24pSb+IbjEkc$33scSHjeCCcdvgqAr8e/aRA4xnLcIFbhVjgqxTFpMI4"

def demo_secret() -> str:
    return "example-app-secret-key-32chars!!"

def build_router() -> Router:
    secret: str = demo_secret()
    password_hash: str = demo_password_hash()
    router: Router = Router()
    cfg: CorsConfig = CorsConfig("http://localhost:3000", "GET,POST,OPTIONS", "Authorization,Content-Type", True)
    router.use_before(nyx.cors.before_handler(cfg))
    router.use_before(nyx.auth.require_bearer_unless(secret, "/login"))
    router.use_after(nyx.cors.after_handler(cfg))

    def login(ctx: Context) -> HttpResponse:
        schema: Schema = Schema()
        schema.require("username", "string")
        schema.require("password", "string")
        errors: list[str] = nox.validate.validate_json_str(ctx.request.body, schema)
        if len(errors) > 0:
            return nyx.response.json(400, "{\"error\":\"validation\"}")
        body: JsonValue = nox.json.parse(ctx.request.body)
        user: str = ""
        password: str = ""
        i: int = 0
        while i < nox.json.object_len(body):
            k: str = nox.json.object_key(body, i)
            v: JsonValue = nox.json.object_value(body, i)
            if k == "username" and nox.json.is_string(v):
                user = nox.json.as_string(v)
            if k == "password" and nox.json.is_string(v):
                password = nox.json.as_string(v)
            i = i + 1
        if user != "alice" or not nyx.password.verify(password_hash, password):
            return nyx.response.json(401, "{\"error\":\"invalid_credentials\"}")
        exp: int = (nox.time.now_ms() // 1000) + 3600
        token: str = nyx.jwt.encode(secret, "{\"sub\":\"" + user + "\"}", exp)
        return nyx.response.json(200, "{\"token\":\"" + token + "\"}")

    def me(ctx: Context) -> HttpResponse:
        auth: str = ctx.request.headers["Authorization"]
        token: str = ""
        j: int = 7
        while j < len(auth):
            token = token + auth[j]
            j = j + 1
        payload: str = nyx.jwt.decode(secret, token)
        return nyx.response.json(200, payload)

    router.post("/login", login)
    router.get("/me", me)
    return router

def handle(req: HttpRequest) -> HttpResponse:
    router: Router = build_router()
    return router.dispatch(req)

print("listening on :8080  POST /login  GET /me")
nox.http.serve(8080, handle)
