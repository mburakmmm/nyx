# Nyx blog example — boot-once + typed attrs + AppContext
# Requires Nox >= 1.10
# cd examples/blog && noxc fetch && NYX_ENV=development noxc run main.nox

import nox.http
from nox.http import HttpRequest, HttpResponse
from nox.router import Router, Context
from nox.sqlite import Connection
import nyx.app
import nyx.config
import nyx.model
import nyx.ctrl
import nyx.form
import nyx.csrf
import nyx.view
import nyx.ctx
from nyx.app import Application
from nyx.config import Config
from nyx.model import Record, Attributes
from nyx.ctx import AppContext

def setup(application: Application) -> None:
    router: Router = application.router
    secret: str = application.config.secret_key

    def index(ctx: Context) -> HttpResponse:
        ac: AppContext = nyx.ctx.wrap(application, ctx)
        rows: list[Record] = nyx.model.all(ac.db(), "posts")
        fields: list[str] = []
        fields.append("title")
        fields.append("body")
        posts_html: str = nyx.view.render_records("app/views/posts/_item.html", rows, fields)
        if len(rows) == 0:
            posts_html = "<li>No posts yet.</li>"
        context: dict[str, str] = {}
        context["title"] = "Nyx Blog"
        context["notice"] = ""
        context["posts_html"] = posts_html
        context["csrf_field"] = nyx.csrf.field(secret)
        context["title_field"] = nyx.form.text("title", "")
        context["body_field"] = nyx.form.textarea("body", "")
        context["submit"] = nyx.form.submit("Save")
        return nyx.ctrl.html(200, nyx.view.render_unescaped("app/views/posts.html", context))

    def create(ctx: Context) -> HttpResponse:
        ac: AppContext = nyx.ctx.wrap(application, ctx)
        title: str = ac.param("title", "")
        body: str = ac.param("body", "")
        if len(title) == 0:
            return nyx.ctrl.redirect("/")
        attrs: Attributes = nyx.model.attributes()
        nyx.model.set_str(attrs, "title", title)
        nyx.model.set_str(attrs, "body", body)
        nyx.model.create_attrs(ac.db(), "posts", attrs)
        return nyx.ctrl.redirect("/")

    router.get("/", index)
    router.post("/posts", create)

cfg: Config = nyx.config.load()
cfg.secret_key = "blog-example-secret-key-32chars!!!"
cfg.db_path = "db/app.sqlite"
cfg.migrate_path = "db/migrate"
cfg.csrf_enabled = True
cfg.log_requests = True
application: Application = nyx.app.boot(cfg, setup)

def handle(req: HttpRequest) -> HttpResponse:
    return nyx.app.dispatch(application, req)

print("nyx blog on :8080")
nox.http.serve(8080, handle)
