# nyx.form - HTML form alanı yardımcıları (kaçışlı).
#
# str donen API uyumluluk icin durur (render_unescaped context).
# Tercih edilen: *_safe -> SafeHtml + nyx.html.put(context, key, frag).

import nox.template
import nox.strings
import nyx.html
from nyx.html import SafeHtml

def _esc(s: str) -> str:
    return nox.template.escape_html(s)

def text(name: str, value: str) -> str:
    return "<input type=\"text\" name=\"" + _esc(name) + "\" value=\"" + _esc(value) + "\">"

def text_safe(name: str, value: str) -> SafeHtml:
    return nyx.html.safe(text(name, value))

def password(name: str) -> str:
    return "<input type=\"password\" name=\"" + _esc(name) + "\">"

def password_safe(name: str) -> SafeHtml:
    return nyx.html.safe(password(name))

def hidden(name: str, value: str) -> str:
    return "<input type=\"hidden\" name=\"" + _esc(name) + "\" value=\"" + _esc(value) + "\">"

def hidden_safe(name: str, value: str) -> SafeHtml:
    return nyx.html.safe(hidden(name, value))

def textarea(name: str, value: str) -> str:
    return "<textarea name=\"" + _esc(name) + "\">" + _esc(value) + "</textarea>"

def textarea_safe(name: str, value: str) -> SafeHtml:
    return nyx.html.safe(textarea(name, value))

def checkbox(name: str, value: str, checked: bool) -> str:
    out: str = "<input type=\"checkbox\" name=\"" + _esc(name) + "\" value=\"" + _esc(value) + "\""
    if checked:
        out = out + " checked"
    return out + ">"

def checkbox_safe(name: str, value: str, checked: bool) -> SafeHtml:
    return nyx.html.safe(checkbox(name, value, checked))

# 'options' her eleman 'value' veya 'value|label'. 'selected' eslesen value.
def select(name: str, options: list[str], selected: str) -> str:
    out: str = "<select name=\"" + _esc(name) + "\">"
    i: int = 0
    while i < len(options):
        raw: str = options[i]
        value: str = raw
        label: str = raw
        pipe: int = nox.strings.index_of(raw, "|")
        if pipe >= 0:
            value = ""
            label = ""
            j: int = 0
            while j < pipe:
                value = value + raw[j]
                j = j + 1
            j = pipe + 1
            while j < len(raw):
                label = label + raw[j]
                j = j + 1
        out = out + "<option value=\"" + _esc(value) + "\""
        if value == selected:
            out = out + " selected"
        out = out + ">" + _esc(label) + "</option>"
        i = i + 1
    return out + "</select>"

def select_safe(name: str, options: list[str], selected: str) -> SafeHtml:
    return nyx.html.safe(select(name, options, selected))

# Rails '_method' gizli alani (HTML form yalnizca GET/POST gonderebilir).
def method_override(method: str) -> str:
    return hidden("_method", nox.strings.upper(method))

def method_override_safe(method: str) -> SafeHtml:
    return nyx.html.safe(method_override(method))

def submit(label: str) -> str:
    return "<button type=\"submit\">" + _esc(label) + "</button>"

def submit_safe(label: str) -> SafeHtml:
    return nyx.html.safe(submit(label))

def form_start(action: str, method: str) -> str:
    return "<form action=\"" + _esc(action) + "\" method=\"" + _esc(method) + "\">"

def form_start_safe(action: str, method: str) -> SafeHtml:
    return nyx.html.safe(form_start(action, method))

def form_end() -> str:
    return "</form>"

def form_end_safe() -> SafeHtml:
    return nyx.html.safe(form_end())

# Acilis '<form>' + CSRF hidden. GET icin CSRF eklenmez.
# PUT/PATCH/DELETE icin method=post + '_method' override.
def form_with_token(action: str, method: str, csrf_token: str) -> str:
    m: str = nox.strings.upper(method)
    if m == "GET":
        return form_start(action, "get")
    out: str = form_start(action, "post")
    if len(csrf_token) > 0:
        out = out + hidden("_csrf", csrf_token)
    if m != "POST":
        out = out + method_override(m)
    return out

def form_with_token_safe(action: str, method: str, csrf_token: str) -> SafeHtml:
    return nyx.html.safe(form_with_token(action, method, csrf_token))
