# nyx.config - ortam (development/test/production) + uygulama ayarları.
#
# import nyx.config
# cfg: Config = nyx.config.load()
# cfg: Config = nyx.config.from_env()

import nox.os
from nox.os import OsError

class ConfigError(Exception):
    pass

class Config:
    def __init__(
        self: Config,
        env: str,
        secret_key: str,
        db_path: str,
        migrate_path: str,
        host: str,
        port: int,
        session_cookie: str,
        session_max_age: int,
        csrf_enabled: bool,
        secure_cookies: bool,
        log_requests: bool,
        locale: str,
        locales_path: str,
        cache_path: str,
        storage_path: str,
        mail_delivery: str,
        mail_from: str,
        mail_api_url: str,
        mail_api_key: str,
        mail_smtp_host: str,
        mail_smtp_port: int,
        mail_smtp_user: str,
        mail_smtp_password: str,
        mail_smtp_starttls: bool,
        jobs_db_path: str,
        cable_store_path: str,
        csp: str,
        auto_migrate: bool,
        csrf_api_exempt: bool,
        tls_cert_path: str,
        tls_key_path: str,
        session_store: str,
        secret_key_previous: str,
        rate_limit_enabled: bool,
        rate_limit_max: int,
        rate_limit_window_ms: int,
        metrics_enabled: bool,
        storage_max_bytes: int,
        log_json: bool,
        trusted_proxies: str,
        rate_limit_auth_max: int,
        trust_x_forwarded_for: bool,
        rate_limit_store: str,
        workers: int,
        session_enabled: bool,
        security_headers: bool,
        request_id: bool,
        request_headers: bool
    ) -> None:
        self.env = env
        self.secret_key = secret_key
        self.db_path = db_path
        self.migrate_path = migrate_path
        self.host = host
        self.port = port
        self.session_cookie = session_cookie
        self.session_max_age = session_max_age
        self.csrf_enabled = csrf_enabled
        self.secure_cookies = secure_cookies
        self.log_requests = log_requests
        self.locale = locale
        self.locales_path = locales_path
        self.cache_path = cache_path
        self.storage_path = storage_path
        self.mail_delivery = mail_delivery
        self.mail_from = mail_from
        self.mail_api_url = mail_api_url
        self.mail_api_key = mail_api_key
        self.mail_smtp_host = mail_smtp_host
        self.mail_smtp_port = mail_smtp_port
        self.mail_smtp_user = mail_smtp_user
        self.mail_smtp_password = mail_smtp_password
        # False: aninda TLS (SMTPS, tipik 465). True: duz TCP sonra STARTTLS (tipik 587).
        self.mail_smtp_starttls = mail_smtp_starttls
        self.jobs_db_path = jobs_db_path
        self.cable_store_path = cable_store_path
        self.csp = csp
        self.auto_migrate = auto_migrate
        self.csrf_api_exempt = csrf_api_exempt
        self.tls_cert_path = tls_cert_path
        self.tls_key_path = tls_key_path
        # "db" (default) | "cookie" (legacy signed blob)
        self.session_store = session_store
        self.secret_key_previous = secret_key_previous
        self.rate_limit_enabled = rate_limit_enabled
        self.rate_limit_max = rate_limit_max
        self.rate_limit_window_ms = rate_limit_window_ms
        self.metrics_enabled = metrics_enabled
        self.storage_max_bytes = storage_max_bytes
        self.log_json = log_json
        # Legacy name: non-empty still enables XFF trust (see trust_x_forwarded_for).
        self.trusted_proxies = trusted_proxies
        self.rate_limit_auth_max = rate_limit_auth_max
        # When true, first X-Forwarded-For hop is the client key.
        # Non-empty trusted_proxies is an IP allowlist: XFF is used only if
        # HttpRequest.peer_addr's IP is in that list (Nox >= 1.127).
        self.trust_x_forwarded_for = trust_x_forwarded_for
        # "memory" | "db" (jobs_db) — workers>1 ise boot db'ye zorlar
        self.rate_limit_store = rate_limit_store
        # 1 = nox.http.serve*; >1 = serve_multicore* (Nox >= 1.22; --release M:N 1.28+)
        self.workers = workers
        # False: session middleware yok (API/bench). CSRF aciksa session zorlanır.
        self.session_enabled = session_enabled
        # False: security headers after-middleware yok (fair bench).
        self.security_headers = security_headers
        # False: uuid request-id + X-Request-Id yok.
        self.request_id = request_id
        # False: serve handler req.headers okumaz (Nox iterateHeaders skip).
        self.request_headers = request_headers

    def is_development(self: Config) -> bool:
        return self.env == "development"

    def is_test(self: Config) -> bool:
        return self.env == "test"

    def is_production(self: Config) -> bool:
        return self.env == "production"

def _env_or(name: str, default: str) -> str:
    try:
        return nox.os.getenv(name)
    except OsError:
        return default

def _env_int(name: str, default: int) -> int:
    raw: str = _env_or(name, "")
    if len(raw) == 0:
        return default
    return int(raw)

def _env_bool(name: str, default: bool) -> bool:
    raw: str = _env_or(name, "")
    if len(raw) == 0:
        return default
    if raw == "1" or raw == "true" or raw == "TRUE" or raw == "yes" or raw == "on":
        return True
    if raw == "0" or raw == "false" or raw == "FALSE" or raw == "no" or raw == "off":
        return False
    return default

def _validate_env(env: str) -> None:
    if env != "development" and env != "test" and env != "production":
        raise ConfigError("invalid NYX_ENV: " + env + " (development|test|production)")

def defaults(env: str) -> Config:
    _validate_env(env)
    secret: str = "nyx-dev-secret-change-me-32bytes!!"
    secure: bool = False
    csrf: bool = True
    log_req: bool = True
    db: str = "db/app.sqlite"
    auto_mig: bool = True
    jobs_path: str = "db/jobs.sqlite"
    rate_on: bool = True
    metrics_on: bool = True
    log_json_on: bool = True
    if env == "test":
        secret = "nyx-test-secret-change-me-32bytes!"
        db = ":memory:"
        log_req = False
        jobs_path = ":memory:"
        rate_on = False
        metrics_on = False
        log_json_on = False
    if env == "production":
        secret = ""
        secure = True
        log_req = True
        # Production'da migrate'i CLI ile ayri calistirin.
        auto_mig = False
    return Config(
        env,
        secret,
        db,
        "db/migrate",
        "0.0.0.0",
        8080,
        "nyx_session",
        86400 * 7,
        csrf,
        secure,
        log_req,
        "en",
        "config/locales",
        "tmp/cache.sqlite",
        "storage",
        "file",
        "noreply@example.com",
        "",
        "",
        "",
        465,
        "",
        "",
        False,
        jobs_path,
        "",
        "",
        auto_mig,
        False,
        "",
        "",
        "db",
        "",
        rate_on,
        120,
        60000,
        metrics_on,
        10485760,
        log_json_on,
        "",
        20,
        False,
        "memory",
        1,
        True,
        True,
        True,
        True
    )

def from_env() -> Config:
    env: str = _env_or("NYX_ENV", "development")
    cfg: Config = defaults(env)
    secret: str = _env_or("NYX_SECRET_KEY", cfg.secret_key)
    if cfg.is_production() and len(secret) < 32:
        raise ConfigError("production requires NYX_SECRET_KEY with at least 32 characters")
    cfg.secret_key = secret
    # DATABASE_URL wins over NYX_DB_PATH when set (sqlite:///... or path)
    db_url: str = _env_or("DATABASE_URL", "")
    if len(db_url) > 0:
        cfg.db_path = db_url
    else:
        cfg.db_path = _env_or("NYX_DB_PATH", cfg.db_path)
    cfg.migrate_path = _env_or("NYX_MIGRATE_PATH", cfg.migrate_path)
    cfg.host = _env_or("NYX_HOST", cfg.host)
    cfg.port = _env_int("NYX_PORT", cfg.port)
    cfg.session_cookie = _env_or("NYX_SESSION_COOKIE", cfg.session_cookie)
    cfg.session_max_age = _env_int("NYX_SESSION_MAX_AGE", cfg.session_max_age)
    cfg.csrf_enabled = _env_bool("NYX_CSRF", cfg.csrf_enabled)
    cfg.secure_cookies = _env_bool("NYX_SECURE_COOKIES", cfg.secure_cookies)
    cfg.log_requests = _env_bool("NYX_LOG_REQUESTS", cfg.log_requests)
    cfg.locale = _env_or("NYX_LOCALE", cfg.locale)
    cfg.locales_path = _env_or("NYX_LOCALES_PATH", cfg.locales_path)
    cfg.cache_path = _env_or("NYX_CACHE_PATH", cfg.cache_path)
    cfg.storage_path = _env_or("NYX_STORAGE_PATH", cfg.storage_path)
    cfg.mail_delivery = _env_or("NYX_MAIL_DELIVERY", cfg.mail_delivery)
    cfg.mail_from = _env_or("NYX_MAIL_FROM", cfg.mail_from)
    cfg.mail_api_url = _env_or("NYX_MAIL_API_URL", cfg.mail_api_url)
    cfg.mail_api_key = _env_or("NYX_MAIL_API_KEY", cfg.mail_api_key)
    cfg.mail_smtp_host = _env_or("NYX_MAIL_SMTP_HOST", cfg.mail_smtp_host)
    cfg.mail_smtp_port = _env_int("NYX_MAIL_SMTP_PORT", cfg.mail_smtp_port)
    cfg.mail_smtp_user = _env_or("NYX_MAIL_SMTP_USER", cfg.mail_smtp_user)
    cfg.mail_smtp_password = _env_or("NYX_MAIL_SMTP_PASSWORD", cfg.mail_smtp_password)
    # 1: duz TCP + STARTTLS. 0 veya bos: aninda TLS (bugunku 465 davranisi).
    cfg.mail_smtp_starttls = _env_bool("NYX_MAIL_SMTP_STARTTLS", cfg.mail_smtp_starttls)
    cfg.jobs_db_path = _env_or("NYX_JOBS_DB_PATH", cfg.jobs_db_path)
    cfg.cable_store_path = _env_or("NYX_CABLE_STORE_PATH", cfg.cable_store_path)
    cfg.csp = _env_or("NYX_CSP", cfg.csp)
    cfg.auto_migrate = _env_bool("NYX_AUTO_MIGRATE", cfg.auto_migrate)
    cfg.csrf_api_exempt = _env_bool("NYX_CSRF_API_EXEMPT", cfg.csrf_api_exempt)
    cfg.tls_cert_path = _env_or("NYX_TLS_CERT", cfg.tls_cert_path)
    cfg.tls_key_path = _env_or("NYX_TLS_KEY", cfg.tls_key_path)
    cfg.session_store = _env_or("NYX_SESSION_STORE", cfg.session_store)
    cfg.secret_key_previous = _env_or("NYX_SECRET_KEY_PREVIOUS", cfg.secret_key_previous)
    cfg.rate_limit_enabled = _env_bool("NYX_RATE_LIMIT", cfg.rate_limit_enabled)
    cfg.rate_limit_max = _env_int("NYX_RATE_LIMIT_MAX", cfg.rate_limit_max)
    cfg.rate_limit_window_ms = _env_int("NYX_RATE_LIMIT_WINDOW_MS", cfg.rate_limit_window_ms)
    cfg.metrics_enabled = _env_bool("NYX_METRICS", cfg.metrics_enabled)
    cfg.storage_max_bytes = _env_int("NYX_STORAGE_MAX_BYTES", cfg.storage_max_bytes)
    cfg.log_json = _env_bool("NYX_LOG_JSON", cfg.log_json)
    cfg.trusted_proxies = _env_or("NYX_TRUSTED_PROXIES", cfg.trusted_proxies)
    cfg.rate_limit_auth_max = _env_int("NYX_RATE_LIMIT_AUTH_MAX", cfg.rate_limit_auth_max)
    # Prefer honest flag; legacy NYX_TRUSTED_PROXIES non-empty still enables trust.
    trust_xff: bool = _env_bool("NYX_TRUST_X_FORWARDED_FOR", False)
    if len(cfg.trusted_proxies) > 0:
        trust_xff = True
    cfg.trust_x_forwarded_for = trust_xff
    store: str = _env_or("NYX_RATE_LIMIT_STORE", cfg.rate_limit_store)
    if store != "memory" and store != "db":
        raise ConfigError("NYX_RATE_LIMIT_STORE must be memory|db")
    cfg.rate_limit_store = store
    # NYX_WORKERS wins; NOX_POOL_WORKERS is the Nox runtime knob for --release pool size.
    w: int = _env_int("NYX_WORKERS", cfg.workers)
    if w < 1:
        w = 1
    cfg.workers = w
    # Multicore + in-memory rate limit is racy under M:N; prefer jobs_db store.
    if cfg.workers > 1 and cfg.rate_limit_store == "memory":
        if len(_env_or("NYX_RATE_LIMIT_STORE", "")) == 0:
            cfg.rate_limit_store = "db"
    cfg.session_enabled = _env_bool("NYX_SESSION", cfg.session_enabled)
    cfg.security_headers = _env_bool("NYX_SECURITY_HEADERS", cfg.security_headers)
    cfg.request_id = _env_bool("NYX_REQUEST_ID", cfg.request_id)
    cfg.request_headers = _env_bool("NYX_REQUEST_HEADERS", cfg.request_headers)
    # CSRF requires a session bag; force session middleware on.
    if cfg.csrf_enabled and not cfg.session_enabled:
        cfg.session_enabled = True
    return cfg

def load() -> Config:
    return from_env()
