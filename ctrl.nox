# nyx.ctrl — controller yanıt kısayolları (nox.http tarzı sadelik).
#
# import nyx.ctrl
# return nyx.ctrl.redirect("/posts")
# return nyx.ctrl.html(200, body)
# return nyx.ctrl.render(200, "app/views/x.html", ctx)
# return nyx.ctrl.redirect_back(ctx, "/")

import nox.strings
import nox.json
import nox.template
from nox.http import HttpResponse
from nox.router import Context
import nyx.response
import nyx.view

def redirect(location: str) -> HttpResponse:
    return nyx.response.redirect(location, 302)

# Acik yonlendirme (open redirect) korumasi: yalnizca `/` ile baslayan,
# `//` (sema-goreli/protocol-relative — tarayici bunu farkli bir HOST'a
# yonlendirir) ile BASLAMAYAN ve `://` (mutlak URL, farkli bir origin'e
# isaret edebilir) ICERMEYEN goreli yollara izin verilir. `redirect_back`/
# `redirect_back_to` kullanici-kontrollu `Referer` basligina KOR KOR
# guvenmez — guvenli degilse `fallback`e doner.
def _is_safe_relative_redirect(target: str) -> bool:
    if len(target) == 0:
        return False
    if not nox.strings.starts_with(target, "/"):
        return False
    if nox.strings.starts_with(target, "//"):
        return False
    if nox.strings.contains(target, "://"):
        return False
    return True

def _header_get(headers: dict[str, str], name: str) -> str | None:
    try:
        return headers[name]
    except KeyError:
        a: int = 0
    lower: str = nox.strings.lower(name)
    try:
        return headers[lower]
    except KeyError:
        b: int = 0
    if lower == "referer":
        try:
            return headers["Referer"]
        except KeyError:
            c: int = 0
    return None

# Istegin `Referer` basligina (varsa) yonlendirir, yoksa `fallback`e.
# `Referer` GUVENILMEYEN bir istemci girdisidir — acik yonlendirmeyi
# ONLEMEK icin yalnizca `_is_safe_relative_redirect` KABUL ETTIGI goreli
# yollara izin verilir (bkz. yukarisi).
def redirect_back(ctx: Context, fallback: str) -> HttpResponse:
    referer: str | None = _header_get(ctx.request.headers, "Referer")
    if referer != None:
        if _is_safe_relative_redirect(referer):
            return redirect(referer)
    return redirect(fallback)

# `Context` olmadan, dogrudan bir `Referer` metniyle cagirmak isteyenler
# icin (ör. baska bir middleware'den gelen deger). Ayni acik yonlendirme
# korumasina tabidir.
def redirect_back_to(referer: str, fallback: str) -> HttpResponse:
    if _is_safe_relative_redirect(referer):
        return redirect(referer)
    return redirect(fallback)

def html(status: int, body: str) -> HttpResponse:
    headers: dict[str, str] = {}
    headers["Content-Type"] = "text/html; charset=utf-8"
    return HttpResponse(status, body, headers)

def json(status: int, body: str) -> HttpResponse:
    return nyx.response.json(status, body)

def text(status: int, body: str) -> HttpResponse:
    return nyx.response.text(status, body)

def render(status: int, path: str, context: dict[str, str]) -> HttpResponse:
    body: str = nyx.view.render(path, context)
    return html(status, body)

def render_unescaped(status: int, path: str, context: dict[str, str]) -> HttpResponse:
    body: str = nyx.view.render_unescaped(path, context)
    return html(status, body)

# Layout icinde `{{ yield }}` konumuna `view`in render edilmis govdesini
# yerlestirip tek bir HTML yaniti doner (bkz. nyx.view.render_with_layout).
def render_layout(status: int, layout: str, view: str, context: dict[str, str]) -> HttpResponse:
    body: str = nyx.view.render_with_layout(layout, view, context)
    return html(status, body)

def not_found() -> HttpResponse:
    return html(404, "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>Not Found</title></head><body><h1>Not Found</h1></body></html>")

def not_found_json() -> HttpResponse:
    return json(404, "{\"error\":\"not_found\"}")

def forbidden() -> HttpResponse:
    return html(403, "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>Forbidden</title></head><body><h1>Forbidden</h1></body></html>")

def forbidden_json() -> HttpResponse:
    return json(403, "{\"error\":\"forbidden\"}")

def server_error() -> HttpResponse:
    return html(500, "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>Error</title></head><body><h1>Internal Server Error</h1></body></html>")

def server_error_json() -> HttpResponse:
    return json(500, "{\"error\":\"internal_server_error\"}")

def unprocessable() -> HttpResponse:
    return html(422, "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>Unprocessable</title></head><body><h1>Unprocessable Entity</h1></body></html>")

# Form re-render icin kacisli HTML hata listesi.
def errors_html(errors: list[str]) -> str:
    if len(errors) == 0:
        return ""
    out: str = "<ul class=\"errors\">"
    i: int = 0
    while i < len(errors):
        out = out + "<li>" + nox.template.escape_html(errors[i]) + "</li>"
        i = i + 1
    return out + "</ul>"

def unprocessable_html(errors: list[str]) -> HttpResponse:
    body: str = "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>Unprocessable</title></head><body><h1>Unprocessable Entity</h1>" + errors_html(errors) + "</body></html>"
    return html(422, body)

# `nyx.model.validate_required` gibi fonksiyonlardan gelen hata mesaji
# listesini `{"errors":[...]}` JSON govdeli 422 yaniti olarak doner
# (JSON API controller'lari icin).
def unprocessable_json(errors: list[str]) -> HttpResponse:
    body: str = "{\"errors\":["
    i: int = 0
    while i < len(errors):
        if i > 0:
            body = body + ","
        body = body + nox.json.encode_string(errors[i])
        i = i + 1
    body = body + "]}"
    return json(422, body)

# Accept: application/json ise JSON, aksi halde HTML hata sayfasi.
def not_found_for(ctx: Context) -> HttpResponse:
    if _wants_json(ctx):
        return not_found_json()
    return not_found()

def server_error_for(ctx: Context) -> HttpResponse:
    if _wants_json(ctx):
        return server_error_json()
    return server_error()

def _wants_json(ctx: Context) -> bool:
    accept: str | None = _header_get(ctx.request.headers, "Accept")
    if accept == None:
        return False
    else:
        return nox.strings.contains(accept, "application/json")
