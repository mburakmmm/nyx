# nyx.jwt - HS256 JWT (RFC 7519 alt kümesi).
#
# import nyx.jwt
#
# İmza: nox.crypto.hmac_sha256 (hex) -> nyx.base64.encode_hex_url.
# Alias ZORUNLU: nyx

import nox.crypto
import nox.json
import nox.time
import nox.strings
import nyx.base64

class JwtError(Exception):
    pass

def _header_json() -> str:
    return "{\"alg\":\"HS256\",\"typ\":\"JWT\"}"

def _now_unix() -> int:
    return nox.time.now_ms() // 1000

def _find_object_field(v: JsonValue, name: str) -> JsonValue | None:
    i: int = 0
    n: int = nox.json.object_len(v)
    while i < n:
        if nox.json.object_key(v, i) == name:
            return nox.json.object_value(v, i)
        i = i + 1
    return None

def _with_exp(payload_json: str, exp_unix: int) -> str:
    v: JsonValue = nox.json.decode(payload_json)
    if not nox.json.is_object(v):
        raise JwtError("payload bir JSON nesnesi olmali")
    out: str = "{\"exp\":" + str(exp_unix)
    i: int = 0
    n: int = nox.json.object_len(v)
    while i < n:
        key: str = nox.json.object_key(v, i)
        if key != "exp":
            out = out + "," + nox.json.encode_string(key) + ":" + nox.json.encode(nox.json.object_value(v, i))
        i = i + 1
    return out + "}"

def _sign(secret: str, signing_input: str) -> str:
    mac_hex: str = nox.crypto.hmac_sha256(secret, signing_input)
    return nyx.base64.encode_hex_url(mac_hex)

def encode(secret: str, payload_json: str, exp_unix: int) -> str:
    if len(secret) == 0:
        raise JwtError("secret bos olamaz")
    if exp_unix <= _now_unix():
        raise JwtError("exp_unix simdiki zamandan ileride olmali")
    payload: str = _with_exp(payload_json, exp_unix)
    h_b64: str = nyx.base64.encode_url(_header_json())
    p_b64: str = nyx.base64.encode_url(payload)
    signing_input: str = h_b64 + "." + p_b64
    sig: str = _sign(secret, signing_input)
    return signing_input + "." + sig

def _split_token(token: str) -> list[str]:
    parts: list[str] = nox.strings.split(token, ".")
    if len(parts) != 3:
        raise JwtError("token uc parca olmali")
    return parts

def _check_time_claims(payload: JsonValue) -> None:
    now: int = _now_unix()
    exp_v: JsonValue | None = _find_object_field(payload, "exp")
    if exp_v == None:
        raise JwtError("exp eksik")
    else:
        if not nox.json.is_number(exp_v):
            raise JwtError("exp sayi olmali")
        else:
            exp_i: int = int(nox.json.as_number(exp_v))
            if now >= exp_i:
                raise JwtError("token suresi dolmus")
    nbf_v: JsonValue | None = _find_object_field(payload, "nbf")
    if nbf_v != None:
        if not nox.json.is_number(nbf_v):
            raise JwtError("nbf sayi olmali")
        else:
            nbf_i: int = int(nox.json.as_number(nbf_v))
            if now < nbf_i:
                raise JwtError("token henuz gecerli degil (nbf)")
    iat_v: JsonValue | None = _find_object_field(payload, "iat")
    if iat_v != None:
        if not nox.json.is_number(iat_v):
            raise JwtError("iat sayi olmali")
        else:
            iat_i: int = int(nox.json.as_number(iat_v))
            if iat_i > now + 60:
                raise JwtError("iat gelecekte")

def decode(secret: str, token: str) -> str:
    if len(secret) == 0:
        raise JwtError("secret bos olamaz")
    parts: list[str] = _split_token(token)
    h_b64: str = parts[0]
    p_b64: str = parts[1]
    sig: str = parts[2]
    signing_input: str = h_b64 + "." + p_b64
    expected: str = _sign(secret, signing_input)
    if not nox.crypto.constant_time_eq(sig, expected):
        raise JwtError("gecersiz imza")
    header_json: str = nyx.base64.decode_url(h_b64)
    header: JsonValue = nox.json.decode(header_json)
    alg_v: JsonValue | None = _find_object_field(header, "alg")
    if alg_v == None:
        raise JwtError("alg eksik")
    else:
        if not nox.json.is_string(alg_v):
            raise JwtError("alg eksik")
        else:
            if nox.json.as_string(alg_v) != "HS256":
                raise JwtError("yalnizca HS256 desteklenir")
    payload_json: str = nyx.base64.decode_url(p_b64)
    payload: JsonValue = nox.json.decode(payload_json)
    if not nox.json.is_object(payload):
        raise JwtError("payload nesne olmali")
    _check_time_claims(payload)
    return payload_json
