# C2 FAIL (import → SIGSEGV on noxc 1.17.0)
# Root shape: package module + function-type param returning dict[str,str]
# + pass that result INLINE into another same-module function.
#
#   use_ctx(to_context(rows[i]))     ← crashes on import
#   ctx = to_context(rows[i])
#   use_ctx(ctx)                     ← OK (see c2_local.nox)

class Row:
    def __init__(self: Row, title: str) -> None:
        self.title = title

def use_ctx(context: dict[str, str]) -> str:
    return context["title"]

def map_inline(rows: list[Row], to_context: (Row) -> dict[str, str]) -> str:
    out: str = ""
    i: int = 0
    while i < len(rows):
        out = out + use_ctx(to_context(rows[i]))
        i = i + 1
    return out
