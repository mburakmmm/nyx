# nyx.server - Nox >= 1.22 serve matrisi yardimcilari.
#
# 'nox.http.serve*' handler/ws_handle parametreleri DERLEME ZAMANI bare
# fonksiyon adi olmalidir; bu modul serve'i sarmalamaz, yalnizca mod/secim
# ve TLS dosya dogrulamasi saglar.
#
# Ornek (duz HTTP):
#   nox.http.serve(cfg.port, handle)
#
# Ornek (HTTPS - OpenSSL libssl gerekir; macOS'ta Homebrew openssl):
#   nyx.server.require_tls_files(cfg)
#   nox.http.serve_tls(cfg.port, handle, cfg.tls_cert_path, cfg.tls_key_path)
#
# Ornek (HTTP + WebSocket Upgrade):
#   def ws_handle(conn: WebSocketServerConn) -> None:
#       nyx.cable.ws_echo(conn)
#   nox.http.serve_ws(cfg.port, handle, ws_handle)
#
# Ornek (HTTPS + WS):
#   nox.http.serve_ws_tls(cfg.port, handle, ws_handle, cfg.tls_cert_path, cfg.tls_key_path)

import nox.fs
from nyx.config import Config

class ServerError(Exception):
    def __init__(self: ServerError, message: str) -> None:
        self.message = message

def has_tls(cfg: Config) -> bool:
    if len(cfg.tls_cert_path) == 0:
        return False
    if len(cfg.tls_key_path) == 0:
        return False
    return True

# "plain" | "tls" | "ws" | "ws_tls"
def serve_mode(cfg: Config, want_ws: bool) -> str:
    tls: bool = has_tls(cfg)
    if tls:
        if want_ws:
            return "ws_tls"
        return "tls"
    if want_ws:
        return "ws"
    return "plain"

def require_tls_files(cfg: Config) -> None:
    if len(cfg.tls_cert_path) == 0:
        raise ServerError("set NYX_TLS_CERT and NYX_TLS_KEY for serve_tls / serve_ws_tls")
    if len(cfg.tls_key_path) == 0:
        raise ServerError("set NYX_TLS_CERT and NYX_TLS_KEY for serve_tls / serve_ws_tls")
    if not nox.fs.exists(cfg.tls_cert_path):
        raise ServerError("TLS cert missing: " + cfg.tls_cert_path)
    if not nox.fs.exists(cfg.tls_key_path):
        raise ServerError("TLS key missing: " + cfg.tls_key_path)
