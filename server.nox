# nyx.server - Nox >= 1.22 serve matrisi; Nox >= 1.28/1.29 multicore + --release.
#
# 'nox.http.serve*' handler/ws_handle parametreleri DERLEME ZAMANI bare
# fonksiyon adi olmalidir. Nox >= 2.1.20: serve_multicore* ayrica
# parametresiz bir UST DUZEY fabrika kabul eder; fabrika her worker'da
# bir kez calisir ve (HttpRequest) -> HttpResponse closure'i doner.
# Ana runtime'da kurulmus bir closure degeri hâlâ reddedilir.
# Bu modul serve'i sarmalamaz — mod secimi, worker sayisi ve TLS dogrulamasi saglar.
#
# Production (onerilen):
#   noxc build --release main.nox
#   NYX_WORKERS=8 NOX_POOL_WORKERS=8 ./main   # veya env ile
#   nox.http.serve_multicore(port, handle, cfg.workers)
#
# QBE (bayraksiz build): serve_multicore hâlâ bagimsiz worker modeli.
# LLVM --release: paylasilan M:N havuz + work-stealing (1.29+).

import nox.fs
import nox.http
from nyx.config import Config

class ServerError(Exception):
    pass

def has_tls(cfg: Config) -> bool:
    if len(cfg.tls_cert_path) == 0:
        return False
    if len(cfg.tls_key_path) == 0:
        return False
    return True

def workers(cfg: Config) -> int:
    # 1 = tek worker serve*; >1 = serve_multicore*
    if cfg.workers < 1:
        return 1
    return cfg.workers

def use_multicore(cfg: Config) -> bool:
    return workers(cfg) > 1

def use_ipv6(cfg: Config) -> bool:
    return cfg.ipv6

# Nox >= 2.1.32: 0 IPv4, 1 dual-stack, 2 IPv6-only. Windows ignores ip_family.
def ip_family(cfg: Config) -> int:
    if not cfg.ipv6:
        return 0
    if cfg.ipv6_only:
        return 2
    return 1

def listen_fd(cfg: Config) -> int:
    if cfg.ipv6:
        return nox.http.listen_v6(cfg.port, cfg.ipv6_only)
    return nox.http.listen(cfg.port)

# Nox 1.29.2+: False → serve handler must not read req.headers (iterateHeaders skip).
def materialize_request_headers(cfg: Config) -> bool:
    return cfg.request_headers

# "plain" | "tls" | "ws" | "ws_tls" | "multicore" | "multicore_tls" |
# "multicore_ws" | "multicore_ws_tls"
def serve_mode(cfg: Config, want_ws: bool) -> str:
    tls: bool = has_tls(cfg)
    mc: bool = use_multicore(cfg)
    if mc:
        if tls:
            if want_ws:
                return "multicore_ws_tls"
            return "multicore_tls"
        if want_ws:
            return "multicore_ws"
        return "multicore"
    if tls:
        if want_ws:
            return "ws_tls"
        return "tls"
    if want_ws:
        return "ws"
    return "plain"

# Nox 2.0.118–2.0.127: call once before serve*. 0 keeps a stdlib default.
# SIGTERM/SIGINT already drains serve*; the entry finally block then
# calls nyx.app.shutdown.
def apply(cfg: Config) -> None:
    nox.http.configure(
        cfg.max_body_bytes,
        cfg.max_header_bytes,
        cfg.read_timeout_ms,
        cfg.max_connections,
        cfg.drain_timeout_ms,
        ip_family(cfg)
    )
    nox.http.set_http2(cfg.http2)
    nox.http.client_pool(cfg.http_pool_idle, cfg.http_pool_idle_ms)

def require_tls_files(cfg: Config) -> None:
    if len(cfg.tls_cert_path) == 0:
        raise ServerError("set NYX_TLS_CERT and NYX_TLS_KEY for serve_tls / serve_ws_tls")
    if len(cfg.tls_key_path) == 0:
        raise ServerError("set NYX_TLS_CERT and NYX_TLS_KEY for serve_tls / serve_ws_tls")
    if not nox.fs.exists(cfg.tls_cert_path):
        raise ServerError("TLS cert missing: " + cfg.tls_cert_path)
    if not nox.fs.exists(cfg.tls_key_path):
        raise ServerError("TLS key missing: " + cfg.tls_key_path)

# Uygulama entry'sinde switch icin yardimci aciklama (bare serve cagrisi
# entry dosyasinda kalmalidir). Ornek:
