# nyx.params — query string + application/x-www-form-urlencoded.
#
# import nyx.params
# q: dict[str, str] = nyx.params.query(req.target)
# f: dict[str, str] = nyx.params.form(req.body)
# all: dict[str, str] = nyx.params.from_request(req)

import nox.strings
from nox.http import HttpRequest

class ParamsError:
    def __init__(self: ParamsError, message: str) -> None:
        self.message = message

def _substr(s: str, start: int, end: int) -> str:
    out: str = ""
    i: int = start
    while i < end:
        out = out + s[i]
        i = i + 1
    return out

def _hex_val(c: int) -> int:
    if c >= 48 and c <= 57:
        return c - 48
    if c >= 65 and c <= 70:
        return c - 55
    if c >= 97 and c <= 102:
        return c - 87
    return -1

def _ascii_char(b: int) -> str:
    if b == 9:
        return "\t"
    if b == 10:
        return "\n"
    if b == 13:
        return "\r"
    if b < 32 or b > 126:
        raise ParamsError("desteklenmeyen ASCII bayt: " + str(b))
    table: str = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    return table[b - 32]

def _read_pct(s: str, i: int) -> int:
    if i + 2 >= len(s):
        return -1
    if s[i] != "%":
        return -1
    h1: int = _hex_val(nox.strings.byte_at(s, i + 1))
    h2: int = _hex_val(nox.strings.byte_at(s, i + 2))
    if h1 < 0 or h2 < 0:
        return -1
    return h1 * 16 + h2

def _utf8_2(b1: int, b2: int) -> str:
    cp: int = ((b1 % 32) * 64) + (b2 % 64)
    if cp == 192:
        return "À"
    if cp == 193:
        return "Á"
    if cp == 194:
        return "Â"
    if cp == 195:
        return "Ã"
    if cp == 196:
        return "Ä"
    if cp == 199:
        return "Ç"
    if cp == 200:
        return "È"
    if cp == 201:
        return "É"
    if cp == 202:
        return "Ê"
    if cp == 204:
        return "Ì"
    if cp == 205:
        return "Í"
    if cp == 206:
        return "Î"
    if cp == 208:
        return "Ð"
    if cp == 209:
        return "Ñ"
    if cp == 210:
        return "Ò"
    if cp == 211:
        return "Ó"
    if cp == 212:
        return "Ô"
    if cp == 213:
        return "Õ"
    if cp == 214:
        return "Ö"
    if cp == 217:
        return "Ù"
    if cp == 218:
        return "Ú"
    if cp == 219:
        return "Û"
    if cp == 220:
        return "Ü"
    if cp == 223:
        return "ß"
    if cp == 224:
        return "à"
    if cp == 225:
        return "á"
    if cp == 226:
        return "â"
    if cp == 227:
        return "ã"
    if cp == 228:
        return "ä"
    if cp == 231:
        return "ç"
    if cp == 232:
        return "è"
    if cp == 233:
        return "é"
    if cp == 234:
        return "ê"
    if cp == 236:
        return "ì"
    if cp == 237:
        return "í"
    if cp == 238:
        return "î"
    if cp == 241:
        return "ñ"
    if cp == 242:
        return "ò"
    if cp == 243:
        return "ó"
    if cp == 244:
        return "ô"
    if cp == 245:
        return "õ"
    if cp == 246:
        return "ö"
    if cp == 249:
        return "ù"
    if cp == 250:
        return "ú"
    if cp == 251:
        return "û"
    if cp == 252:
        return "ü"
    if cp == 253:
        return "ý"
    if cp == 255:
        return "ÿ"
    # Latin Extended-A (Türkçe): ğ Ğ ı İ ş Ş
    if cp == 286:
        return "Ğ"
    if cp == 287:
        return "ğ"
    if cp == 304:
        return "İ"
    if cp == 305:
        return "ı"
    if cp == 350:
        return "Ş"
    if cp == 351:
        return "ş"
    raise ParamsError("desteklenmeyen unicode codepoint: " + str(cp))

def decode(s: str) -> str:
    out: str = ""
    i: int = 0
    n: int = len(s)
    while i < n:
        ch: str = s[i]
        if ch == "+":
            out = out + " "
            i = i + 1
        else:
            if ch == "%":
                b: int = _read_pct(s, i)
                if b < 0:
                    out = out + ch
                    i = i + 1
                else:
                    if b < 128:
                        out = out + _ascii_char(b)
                        i = i + 3
                    else:
                        if b >= 192 and b < 224:
                            b2: int = _read_pct(s, i + 3)
                            if b2 < 0:
                                raise ParamsError("eksik utf-8 devam bayti")
                            out = out + _utf8_2(b, b2)
                            i = i + 6
                        else:
                            if b >= 224 and b < 240:
                                b2b: int = _read_pct(s, i + 3)
                                b3: int = _read_pct(s, i + 6)
                                if b2b < 0 or b3 < 0:
                                    raise ParamsError("eksik utf-8 devam bayti")
                                cp: int = ((b % 16) * 4096) + ((b2b % 64) * 64) + (b3 % 64)
                                if cp == 286:
                                    out = out + "Ğ"
                                else:
                                    if cp == 287:
                                        out = out + "ğ"
                                    else:
                                        if cp == 304:
                                            out = out + "İ"
                                        else:
                                            if cp == 305:
                                                out = out + "ı"
                                            else:
                                                if cp == 350:
                                                    out = out + "Ş"
                                                else:
                                                    if cp == 351:
                                                        out = out + "ş"
                                                    else:
                                                        raise ParamsError("desteklenmeyen 3-bayt unicode: " + str(cp))
                                i = i + 9
                            else:
                                raise ParamsError("desteklenmeyen percent-encoding bayti: " + str(b))
            else:
                out = out + ch
                i = i + 1
    return out

def parse_qs_flat(raw: str) -> list[str]:
    flat: list[str] = []
    if len(raw) == 0:
        return flat
    parts: list[str] = nox.strings.split(raw, "&")
    i: int = 0
    while i < len(parts):
        p: str = parts[i]
        if len(p) > 0:
            eq: int = nox.strings.index_of(p, "=")
            if eq < 0:
                flat.append(decode(p))
                flat.append("")
            else:
                flat.append(decode(_substr(p, 0, eq)))
                flat.append(decode(_substr(p, eq + 1, len(p))))
        i = i + 1
    return flat

def flat_to_dict(flat: list[str]) -> dict[str, str]:
    result: dict[str, str] = {}
    i: int = 0
    while i + 1 < len(flat):
        result[flat[i]] = flat[i + 1]
        i = i + 2
    return result

def parse_qs(raw: str) -> dict[str, str]:
    return flat_to_dict(parse_qs_flat(raw))

def query_string(target: str) -> str:
    q: int = nox.strings.index_of(target, "?")
    if q < 0:
        return ""
    return _substr(target, q + 1, len(target))

def path_only(target: str) -> str:
    q: int = nox.strings.index_of(target, "?")
    if q < 0:
        return target
    return _substr(target, 0, q)

def query(target: str) -> dict[str, str]:
    return parse_qs(query_string(target))

def form(body: str) -> dict[str, str]:
    return parse_qs(body)

def get(params: dict[str, str], key: str, default: str) -> str:
    try:
        return params[key]
    except KeyError:
        return default

def _header_ci(headers: dict[str, str], name: str) -> str:
    try:
        return headers[name]
    except KeyError:
        a: int = 0
    lower: str = nox.strings.lower(name)
    try:
        return headers[lower]
    except KeyError:
        b: int = 0
    if lower == "content-type":
        try:
            return headers["Content-Type"]
        except KeyError:
            c: int = 0
    return ""

def from_request(req: HttpRequest) -> dict[str, str]:
    flat: list[str] = parse_qs_flat(query_string(req.target))
    method: str = req.method
    if method == "POST" or method == "PUT" or method == "PATCH":
        if len(req.body) > 0:
            ct: str = _header_ci(req.headers, "Content-Type")
            trimmed: str = nox.strings.trim(req.body)
            is_json: bool = nox.strings.starts_with(trimmed, "{") or nox.strings.starts_with(trimmed, "[")
            is_form: bool = nox.strings.contains(ct, "application/x-www-form-urlencoded")
            if is_form or (not is_json and (len(ct) == 0 or is_form)):
                if not is_json:
                    body_flat: list[str] = parse_qs_flat(req.body)
                    j: int = 0
                    while j < len(body_flat):
                        flat.append(body_flat[j])
                        j = j + 1
    return flat_to_dict(flat)
