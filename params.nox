# nyx.params - query string + application/x-www-form-urlencoded.
#
# import nyx.params
# q: dict[str, str] = nyx.params.query(req.target)
# f: dict[str, str] = nyx.params.form(req.body)
# all: dict[str, str] = nyx.params.from_request(req)
#
# Nox >= 1.11: percent/query decode 'nox.url' uzerinden (form '+' = bosluk).

import nox.strings
import nox.url
from nox.http import HttpRequest
from nox.url import UrlError
import nyx.runtime

class ParamsError(Exception):
    def __init__(self: ParamsError, message: str) -> None:
        self.message = message

def _substr(s: str, start: int, end: int) -> str:
    out: str = ""
    i: int = start
    while i < end:
        out = out + s[i]
        i = i + 1
    return out

# application/x-www-form-urlencoded: '+' bosluk; sonra nox.url.percent_decode.
def decode(s: str) -> str:
    normalized: str = nox.strings.replace(s, "+", "%20")
    try:
        return nox.url.percent_decode(normalized)
    except UrlError as e:
        raise ParamsError(e.message)

def _form_query_decode(raw: str) -> dict[str, str]:
    normalized: str = nox.strings.replace(raw, "+", "%20")
    try:
        return nox.url.query_decode(normalized)
    except UrlError as e:
        raise ParamsError(e.message)

# Uyumluluk: anahtar/deger ciftleri duz liste (query sonra body birlestirme).
def parse_qs_flat(raw: str) -> list[str]:
    flat: list[str] = []
    d: dict[str, str] = _form_query_decode(raw)
    keys: list[str] = d.keys()
    i: int = 0
    while i < len(keys):
        k: str = keys[i]
        flat.append(k)
        flat.append(d[k])
        i = i + 1
    return flat

def flat_to_dict(flat: list[str]) -> dict[str, str]:
    result: dict[str, str] = {}
    i: int = 0
    while i + 1 < len(flat):
        result[flat[i]] = flat[i + 1]
        i = i + 2
    return result

def parse_qs(raw: str) -> dict[str, str]:
    return _form_query_decode(raw)

# Request target'lari semasiz ('/path?q=1') - nox.url.parse kullanilmaz.
def query_string(target: str) -> str:
    q: int = nox.strings.index_of(target, "?")
    if q < 0:
        return ""
    return _substr(target, q + 1, len(target))

def path_only(target: str) -> str:
    q: int = nox.strings.index_of(target, "?")
    if q < 0:
        return target
    return _substr(target, 0, q)

def query(target: str) -> dict[str, str]:
    return parse_qs(query_string(target))

def form(body: str) -> dict[str, str]:
    return parse_qs(body)

def get(params: dict[str, str], key: str, default: str) -> str:
    try:
        return params[key]
    except KeyError:
        return default

def permit(params: dict[str, str], keys: list[str]) -> dict[str, str]:
    out: dict[str, str] = {}
    i: int = 0
    while i < len(keys):
        k: str = keys[i]
        try:
            out[k] = params[k]
        except KeyError:
            skip: int = 0
        i = i + 1
    return out

def missing_required(params: dict[str, str], keys: list[str]) -> list[str]:
    errors: list[str] = []
    i: int = 0
    while i < len(keys):
        k: str = keys[i]
        try:
            v: str = params[k]
            if len(v) == 0:
                errors.append("required param empty: " + k)
        except KeyError:
            errors.append("required param missing: " + k)
        i = i + 1
    return errors

def require_keys(params: dict[str, str], keys: list[str]) -> dict[str, str]:
    errs: list[str] = missing_required(params, keys)
    if len(errs) > 0:
        empty: dict[str, str] = {}
        return empty
    return permit(params, keys)

def validate_max_length(params: dict[str, str], key: str, max_len: int) -> list[str]:
    errors: list[str] = []
    try:
        v: str = params[key]
        if len(v) > max_len:
            errors.append(key + " too long (max " + str(max_len) + ")")
    except KeyError:
        a: int = 0
    return errors

def validate_min_length(params: dict[str, str], key: str, min_len: int) -> list[str]:
    errors: list[str] = []
    try:
        v: str = params[key]
        if len(v) < min_len:
            errors.append(key + " too short (min " + str(min_len) + ")")
    except KeyError:
        errors.append("required param missing: " + key)
    return errors

def looks_like_email(value: str) -> bool:
    if len(value) < 3:
        return False
    if nox.strings.contains(value, " "):
        return False
    at: int = nox.strings.index_of(value, "@")
    if at <= 0:
        return False
    if at >= len(value) - 1:
        return False
    if nox.strings.contains(_substr(value, at + 1, len(value)), "@"):
        return False
    return True

def validate_email(params: dict[str, str], key: str) -> list[str]:
    errors: list[str] = []
    try:
        v: str = params[key]
        if len(v) == 0:
            errors.append("required param empty: " + key)
        elif not looks_like_email(v):
            errors.append(key + " invalid email")
    except KeyError:
        errors.append("required param missing: " + key)
    return errors

def _header_ci(headers: dict[str, str], name: str) -> str:
    try:
        return headers[name]
    except KeyError:
        a: int = 0
    lower: str = nox.strings.lower(name)
    try:
        return headers[lower]
    except KeyError:
        b: int = 0
    if lower == "content-type":
        try:
            return headers["Content-Type"]
        except KeyError:
            c: int = 0
    return ""

def from_request(req: HttpRequest) -> dict[str, str]:
    target: str = req.target
    full: str = nyx.runtime.request_target()
    if len(full) > 0:
        target = full
    flat: list[str] = parse_qs_flat(query_string(target))
    method: str = req.method
    if method == "POST" or method == "PUT" or method == "PATCH":
        if len(req.body) > 0:
            ct: str = _header_ci(req.headers, "Content-Type")
            if nox.strings.contains(ct, "multipart/form-data"):
                return flat_to_dict(flat)
            trimmed: str = nox.strings.trim(req.body)
            is_json: bool = nox.strings.starts_with(trimmed, "{") or nox.strings.starts_with(trimmed, "[")
            is_form: bool = nox.strings.contains(ct, "application/x-www-form-urlencoded")
            if is_form or (not is_json and len(ct) == 0):
                if not is_json:
                    body_flat: list[str] = parse_qs_flat(req.body)
                    j: int = 0
                    while j < len(body_flat):
                        flat.append(body_flat[j])
                        j = j + 1
    return flat_to_dict(flat)
