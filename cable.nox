# nyx.cable - gercek-zamanli yayin (SSE / long-poll / WebSocket).
#
# - SSE + long-poll: her ortamda calisir
# - Cross-worker: open_store (SQLite)
# - WebSocket sunucu (Nox >= 1.22): `nox.http.serve_ws*` + ws_echo /
#   ws_broadcast_loop (WebSocketServerConn)
#
# OMUR: Hub, boot-once Application ile ayni worker sureci boyunca yasayabilir.
# `serve_multicore` worker'lari ARASI hub paylasilmaz; store veya dis kuyruk kullanin.
#
# import nyx.cable
#
# hub: Hub = Hub()
# since: str = nyx.cable.subscribe(hub, "room:1")
# nyx.cable.broadcast(hub, "room:1", "message", "{\"text\":\"selam\"}")
# return nyx.cable.sse_response_for(hub, "room:1", int(since))
# Cross-worker: store = nyx.cable.open_store("tmp/cable.sqlite")

import nox.json
import nox.time
import nox.fs
import nox.path
import nox.sqlite
from nox.http import HttpResponse
from nox.sqlite import Connection as SqliteConnection, Statement as SqliteStatement, Row as SqliteRow
from nox.websocket import WebSocketServerConn

class CableError:
    def __init__(self: CableError, message: str) -> None:
        self.message = message

class Message:
    id: int
    event: str
    data_json: str
    ts_ms: int

    def __init__(self: Message, id: int, event: str, data_json: str, ts_ms: int) -> None:
        self.id = id
        self.event = event
        self.data_json = data_json
        self.ts_ms = ts_ms

class ChannelBuf:
    name: str
    messages: list[Message]
    next_id: int

    def __init__(self: ChannelBuf, name: str) -> None:
        self.name = name
        self.messages = []
        self.next_id = 1

def default_capacity() -> int:
    return 200

class Hub:
    channels: list[ChannelBuf]
    capacity: int

    def __init__(self: Hub) -> None:
        self.channels = []
        self.capacity = default_capacity()

def _find_channel_idx(hub: Hub, name: str) -> int:
    i: int = 0
    channels: list[ChannelBuf] = hub.channels
    while i < len(channels):
        if channels[i].name == name:
            return i
        i = i + 1
    return -1

def _get_or_create(hub: Hub, name: str) -> int:
    idx: int = _find_channel_idx(hub, name)
    if idx >= 0:
        return idx
    buf: ChannelBuf = ChannelBuf(name)
    channels: list[ChannelBuf] = hub.channels
    channels.append(buf)
    hub.channels = channels
    return len(channels) - 1

# `channel`i (yoksa OLUSTURARAK) kaydeder ve o ANKI son mesaj kimligini
# metin olarak doner - cagiran taraf bunu ilk `stream_poll`/`sse_response_for`
# cagrisinda `since_id` olarak kullanip yalnizca ABONELIKTEN SONRAKI
# olaylari alir.
def subscribe(hub: Hub, channel: str) -> str:
    idx: int = _get_or_create(hub, channel)
    buf: ChannelBuf = hub.channels[idx]
    return str(buf.next_id - 1)

def _cap(msgs: list[Message], capacity: int) -> list[Message]:
    if len(msgs) <= capacity:
        return msgs
    out: list[Message] = []
    start: int = len(msgs) - capacity
    i: int = start
    while i < len(msgs):
        out.append(msgs[i])
        i = i + 1
    return out

# `channel`e yeni bir olay yayinlar, atanan mesaj kimligini (id) doner.
def broadcast(hub: Hub, channel: str, event: str, data_json: str) -> int:
    idx: int = _get_or_create(hub, channel)
    buf: ChannelBuf = hub.channels[idx]
    id: int = buf.next_id
    buf.next_id = id + 1
    msgs: list[Message] = buf.messages
    msgs.append(Message(id, event, data_json, nox.time.now_ms()))
    buf.messages = _cap(msgs, hub.capacity)
    channels: list[ChannelBuf] = hub.channels
    channels[idx] = buf
    hub.channels = channels
    return id

def last_event_id(hub: Hub, channel: str) -> int:
    idx: int = _find_channel_idx(hub, channel)
    if idx < 0:
        return 0
    return hub.channels[idx].next_id - 1

def _messages_since(hub: Hub, channel: str, since_id: int) -> list[Message]:
    idx: int = _find_channel_idx(hub, channel)
    if idx < 0:
        return []
    buf: ChannelBuf = hub.channels[idx]
    out: list[Message] = []
    msgs: list[Message] = buf.messages
    i: int = 0
    while i < len(msgs):
        if msgs[i].id > since_id:
            out.append(msgs[i])
        i = i + 1
    return out

def _sse_format(events: list[Message]) -> str:
    out: str = ""
    i: int = 0
    while i < len(events):
        e: Message = events[i]
        out = out + "id: " + str(e.id) + "\n"
        out = out + "event: " + e.event + "\n"
        out = out + "data: " + e.data_json + "\n\n"
        i = i + 1
    return out

# Verilen olay listesini `text/event-stream` govdeli bir HTTP yanitina
# cevirir. Uzun-omurlu, kalici bir baglanti DEGILDIR - istemci tarayicisi
# EventSource API'siyle bu ucu periyodik olarak yeniden acabilir (tarayici
# `Last-Event-ID` basligini otomatik gonderir).
def sse_response(events: list[Message]) -> HttpResponse:
    headers: dict[str, str] = {}
    headers["Content-Type"] = "text/event-stream; charset=utf-8"
    headers["Cache-Control"] = "no-cache"
    headers["Connection"] = "keep-alive"
    headers["X-Accel-Buffering"] = "no"
    return HttpResponse(200, _sse_format(events), headers)

def sse_response_for(hub: Hub, channel: str, since_id: int) -> HttpResponse:
    return sse_response(_messages_since(hub, channel, since_id))

def _message_json(m: Message) -> str:
    return (
        "{\"id\":" + str(m.id) +
        ",\"event\":" + nox.json.encode_string(m.event) +
        ",\"data\":" + m.data_json +
        ",\"ts_ms\":" + str(m.ts_ms) + "}"
    )

# Long-poll fallback: `since_id`den SONRAKI olaylari duz bir JSON govdesi
# olarak doner - istemci bu govdedeki en yuksek `id`yi bir SONRAKI
# `stream_poll` cagrisinda `since_id` olarak kullanir.
def stream_poll(hub: Hub, channel: str, since_id: int) -> str:
    events: list[Message] = _messages_since(hub, channel, since_id)
    out: str = "{\"channel\":" + nox.json.encode_string(channel) + ",\"events\":["
    i: int = 0
    while i < len(events):
        if i > 0:
            out = out + ","
        out = out + _message_json(events[i])
        i = i + 1
    out = out + "]}"
    return out

def stream_poll_response(hub: Hub, channel: str, since_id: int) -> HttpResponse:
    headers: dict[str, str] = {}
    headers["Content-Type"] = "application/json; charset=utf-8"
    return HttpResponse(200, stream_poll(hub, channel, since_id), headers)

# --- Cross-worker SQLite store (serve_multicore / multi-process) ---

class Store:
    def __init__(self: Store, db: SqliteConnection, capacity: int) -> None:
        self.db = db
        self.capacity = capacity

def open_store(path: str) -> Store:
    parent: str = nox.path.dirname(path)
    if len(parent) > 0 and parent != "." and not nox.fs.exists(parent):
        nox.fs.create_dir(parent)
    db: SqliteConnection = nox.sqlite.open(path)
    db.execute(
        "CREATE TABLE IF NOT EXISTS cable_messages (" +
        "id INTEGER PRIMARY KEY AUTOINCREMENT, " +
        "channel TEXT NOT NULL, " +
        "event TEXT NOT NULL, " +
        "data_json TEXT NOT NULL, " +
        "ts_ms INTEGER NOT NULL)"
    )
    db.execute("CREATE INDEX IF NOT EXISTS idx_cable_channel_id ON cable_messages (channel, id)")
    return Store(db, default_capacity())

def close_store(store: Store) -> None:
    store.db.close()

def store_subscribe(store: Store, channel: str) -> str:
    stmt: SqliteStatement = store.db.prepare(
        "SELECT COALESCE(MAX(id), 0) FROM cable_messages WHERE channel = ?"
    )
    stmt.bind_str(0, channel)
    rows: list[SqliteRow] = stmt.query()
    if len(rows) == 0:
        return "0"
    return str(rows[0].get_int(0))

def store_broadcast(store: Store, channel: str, event: str, data_json: str) -> int:
    now: int = nox.time.now_ms()
    stmt: SqliteStatement = store.db.prepare(
        "INSERT INTO cable_messages (channel, event, data_json, ts_ms) VALUES (?, ?, ?, ?)"
    )
    stmt.bind_str(0, channel)
    stmt.bind_str(1, event)
    stmt.bind_str(2, data_json)
    stmt.bind_int(3, now)
    stmt.execute()
    id: int = store.db.last_insert_rowid()
    # Cap per channel
    cnt_stmt: SqliteStatement = store.db.prepare(
        "SELECT COUNT(*) FROM cable_messages WHERE channel = ?"
    )
    cnt_stmt.bind_str(0, channel)
    cnt_rows: list[SqliteRow] = cnt_stmt.query()
    if len(cnt_rows) > 0 and cnt_rows[0].get_int(0) > store.capacity:
        overflow: int = cnt_rows[0].get_int(0) - store.capacity
        del_stmt: SqliteStatement = store.db.prepare(
            "DELETE FROM cable_messages WHERE id IN (" +
            "SELECT id FROM cable_messages WHERE channel = ? ORDER BY id ASC LIMIT ?" +
            ")"
        )
        del_stmt.bind_str(0, channel)
        del_stmt.bind_int(1, overflow)
        del_stmt.execute()
    return id

def _store_messages_since(store: Store, channel: str, since_id: int) -> list[Message]:
    stmt: SqliteStatement = store.db.prepare(
        "SELECT id, event, data_json, ts_ms FROM cable_messages " +
        "WHERE channel = ? AND id > ? ORDER BY id ASC"
    )
    stmt.bind_str(0, channel)
    stmt.bind_int(1, since_id)
    rows: list[SqliteRow] = stmt.query()
    out: list[Message] = []
    i: int = 0
    while i < len(rows):
        r: SqliteRow = rows[i]
        out.append(Message(r.get_int(0), r.get_str(1), r.get_str(2), r.get_int(3)))
        i = i + 1
    return out

def store_sse_response_for(store: Store, channel: str, since_id: int) -> HttpResponse:
    return sse_response(_store_messages_since(store, channel, since_id))

def store_stream_poll(store: Store, channel: str, since_id: int) -> str:
    events: list[Message] = _store_messages_since(store, channel, since_id)
    out: str = "{\"channel\":" + nox.json.encode_string(channel) + ",\"events\":["
    i: int = 0
    while i < len(events):
        if i > 0:
            out = out + ","
        out = out + _message_json(events[i])
        i = i + 1
    out = out + "]}"
    return out

# Channel - ActionCable-benzeri yayin sozlesmesi.
# backend: "hub" | "store"
# SSE/long-poll: channel_sse_response
# WebSocket (Nox >= 1.22 serve_ws*): ws_echo / ws_broadcast_loop
class Channel:
    def __init__(self: Channel, name: str, backend: str, hub: Hub, store: Store) -> None:
        self.name = name
        self.backend = backend
        self.hub = hub
        self.store = store

def channel_memory(hub: Hub, name: str) -> Channel:
    # store placeholder unused when backend=hub
    dummy: Store = Store(nox.sqlite.open(":memory:"), default_capacity())
    return Channel(name, "hub", hub, dummy)

def channel_store(store: Store, name: str) -> Channel:
    dummy_hub: Hub = Hub()
    return Channel(name, "store", dummy_hub, store)

def channel_broadcast(ch: Channel, event: str, data_json: str) -> int:
    if ch.backend == "store":
        return store_broadcast(ch.store, ch.name, event, data_json)
    return broadcast(ch.hub, ch.name, event, data_json)

def channel_subscribe(ch: Channel) -> str:
    if ch.backend == "store":
        return store_subscribe(ch.store, ch.name)
    return subscribe(ch.hub, ch.name)

def channel_sse_response(ch: Channel, since_id: int) -> HttpResponse:
    if ch.backend == "store":
        return store_sse_response_for(ch.store, ch.name, since_id)
    return sse_response_for(ch.hub, ch.name, since_id)

# Sunucu WS: her gelen metin frame'ini aynen geri gonder (smoke / ping).
def ws_echo(conn: WebSocketServerConn) -> None:
    while conn.is_open():
        msg: str = conn.recv()
        if len(msg) == 0:
            return
        conn.send_text(msg)

# Sunucu WS: her gelen metin frame'ini kanala yayinla ve onay JSON'u gonder.
# Gelen govde dogrudan data_json olarak kullanilir; event sabit "message".
def ws_broadcast_loop(ch: Channel, conn: WebSocketServerConn) -> None:
    while conn.is_open():
        msg: str = conn.recv()
        if len(msg) == 0:
            return
        mid: int = channel_broadcast(ch, "message", msg)
        conn.send_text("{\"ok\":true,\"id\":" + str(mid) + "}")
