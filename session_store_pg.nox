# nyx.session_store_pg - server-side sessions on PostgreSQL.
#
# Used when application.dialect == "postgres" and NYX_SESSION_STORE=db.
# Cookie envelope helpers stay on nyx.session_store (signing is dialect-agnostic).

import nox.time
import nox.uuid
import nox.json
from nox.postgres import Connection as PgConnection, Statement as PgStatement, PostgresError
from nox.db import Row
from nyx.session_store import SessionStoreError

def ensure_schema(db: PgConnection) -> None:
    db.execute(
        "CREATE TABLE IF NOT EXISTS nyx_sessions (" +
        "id TEXT PRIMARY KEY NOT NULL, " +
        "data TEXT NOT NULL, " +
        "user_id BIGINT NOT NULL DEFAULT 0, " +
        "expires_at_ms BIGINT NOT NULL, " +
        "created_at_ms BIGINT NOT NULL, " +
        "updated_at_ms BIGINT NOT NULL" +
        ")"
    )
    db.execute(
        "CREATE INDEX IF NOT EXISTS idx_nyx_sessions_user ON nyx_sessions (user_id)"
    )
    db.execute(
        "CREATE INDEX IF NOT EXISTS idx_nyx_sessions_exp ON nyx_sessions (expires_at_ms)"
    )

def _now_ms() -> int:
    return nox.time.now_ms()

def create_sid(db: PgConnection, data_json: str, max_age_sec: int, user_id: int) -> str:
    if max_age_sec <= 0:
        raise SessionStoreError("max_age_sec must be positive")
    nox.json.decode(data_json)
    sid: str = nox.uuid.uuid4()
    now: int = _now_ms()
    exp: int = now + (max_age_sec * 1000)
    stmt: PgStatement = db.prepare(
        "INSERT INTO nyx_sessions (id, data, user_id, expires_at_ms, created_at_ms, updated_at_ms) " +
        "VALUES ($1, $2, $3, $4, $5, $6)"
    )
    stmt.bind_str(0, sid)
    stmt.bind_str(1, data_json)
    stmt.bind_int(2, user_id)
    stmt.bind_int(3, exp)
    stmt.bind_int(4, now)
    stmt.bind_int(5, now)
    try:
        stmt.execute()
    except PostgresError as e:
        raise SessionStoreError("postgres create_sid failed: " + e.message)
    return sid

def load_sid(db: PgConnection, sid: str) -> str | None:
    if len(sid) == 0:
        return None
    stmt: PgStatement = db.prepare(
        "SELECT data, expires_at_ms FROM nyx_sessions WHERE id = $1"
    )
    stmt.bind_str(0, sid)
    rows: list[Row] = stmt.query()
    if len(rows) == 0:
        return None
    exp: int = rows[0].get_int(1)
    if exp < _now_ms():
        destroy_sid(db, sid)
        return None
    return rows[0].get_str(0)

def save_sid(db: PgConnection, sid: str, data_json: str, max_age_sec: int, user_id: int) -> None:
    nox.json.decode(data_json)
    now: int = _now_ms()
    exp: int = now + (max_age_sec * 1000)
    stmt: PgStatement = db.prepare(
        "UPDATE nyx_sessions SET data = $1, user_id = $2, expires_at_ms = $3, updated_at_ms = $4 WHERE id = $5"
    )
    stmt.bind_str(0, data_json)
    stmt.bind_int(1, user_id)
    stmt.bind_int(2, exp)
    stmt.bind_int(3, now)
    stmt.bind_str(4, sid)
    try:
        stmt.execute()
    except PostgresError as e:
        raise SessionStoreError("postgres save_sid failed: " + e.message)

def destroy_sid(db: PgConnection, sid: str) -> None:
    if len(sid) == 0:
        return
    stmt: PgStatement = db.prepare("DELETE FROM nyx_sessions WHERE id = $1")
    stmt.bind_str(0, sid)
    stmt.execute()

def destroy_all_for_user(db: PgConnection, user_id: int) -> int:
    stmt: PgStatement = db.prepare("DELETE FROM nyx_sessions WHERE user_id = $1")
    stmt.bind_int(0, user_id)
    return stmt.execute()

def purge_expired(db: PgConnection) -> int:
    stmt: PgStatement = db.prepare("DELETE FROM nyx_sessions WHERE expires_at_ms < $1")
    stmt.bind_int(0, _now_ms())
    return stmt.execute()
