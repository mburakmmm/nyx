# nyx.auth - Router 'use_before' kimlik doğrulama ara katmanları.
#
# import nyx.auth

from nox.http import HttpResponse
from nox.router import Context
import nox.strings
import nox.json
import nyx.jwt
import nyx.session
import nyx.cookie
import nyx.response
import nyx.runtime
from nyx.jwt import JwtError
from nyx.cookie import CookieError
from nox.json import JsonError

def _header_get(headers: dict[str, str], name: str) -> str | None:
    # HTTP başlıkları büyük/küçük harf duyarsız - yaygın biçimleri dene.
    try:
        return headers[name]
    except KeyError:
        x: int = 0
    lower: str = nox.strings.lower(name)
    try:
        return headers[lower]
    except KeyError:
        y: int = 0
    # Title-Case (Authorization)
    if name == "Authorization" or lower == "authorization":
        try:
            return headers["Authorization"]
        except KeyError:
            z: int = 0
        try:
            return headers["authorization"]
        except KeyError:
            w: int = 0
    if name == "Cookie" or lower == "cookie":
        try:
            return headers["Cookie"]
        except KeyError:
            a: int = 0
        try:
            return headers["cookie"]
        except KeyError:
            b: int = 0
    return None

# 'msg' her zaman bu modulun SABIT dizeleri OLSA da ("missing_authorization"
# gibi, kullanici girdisi ICERMEZ), 'nox.json.encode_string' KULLANMAK
# gelecekte BASKA bir cagiran DEGISKEN/kullanici-kontrollu bir mesaj
# GECIRIRSE (ör. hata ayrintisi) bozuk/enjekte edilebilir JSON URETILMESINI
# BASTAN ONLER - elle '"\"" + msg + "\""' birlestirmesi TIRNAK/backslash
# icerebilecek bir 'msg' icin GECERSIZ JSON uretirdi.
def _unauthorized(msg: str) -> HttpResponse:
    return nyx.response.json(401, "{\"error\":" + nox.json.encode_string(msg) + "}")

def _drop_prefix(s: str, n: int) -> str:
    out: str = ""
    i: int = n
    while i < len(s):
        out = out + s[i]
        i = i + 1
    return out

def _request_path(target: str) -> str:
    q: int = nox.strings.index_of(target, "?")
    if q < 0:
        return target
    out: str = ""
    i: int = 0
    while i < q:
        out = out + target[i]
        i = i + 1
    return out

def path_is_exempt(target: str, exempt_path: str) -> bool:
    return _request_path(target) == exempt_path

def path_is_exempt_any(target: str, exempt_paths: list[str]) -> bool:
    path: str = _request_path(target)
    i: int = 0
    while i < len(exempt_paths):
        if path == exempt_paths[i]:
            return True
        i = i + 1
    return False

# 'json_str' (bir JSON nesnesi) icinde 'field' adinda bir metin alani ararsa
# onu, yoksa (veya metin degilse/JSON gecersizse) bos string doner.
def _json_field_str(json_str: str, field: str) -> str:
    try:
        v: JsonValue = nox.json.decode(json_str)
        if not nox.json.is_object(v):
            return ""
        i: int = 0
        n: int = nox.json.object_len(v)
        while i < n:
            if nox.json.object_key(v, i) == field:
                fv: JsonValue = nox.json.object_value(v, i)
                if nox.json.is_string(fv):
                    return nox.json.as_string(fv)
                return ""
            i = i + 1
        return ""
    except JsonError:
        return ""

# Tüm eşleşen rotalarda Bearer JWT zorunlu kılar.
def require_bearer(secret: str) -> (Context) -> HttpResponse | None:
    def handler(ctx: Context) -> HttpResponse | None:
        auth: str | None = _header_get(ctx.request.headers, "Authorization")
        if auth == None:
            return _unauthorized("missing_authorization")
        else:
            if not nox.strings.starts_with(auth, "Bearer "):
                return _unauthorized("invalid_authorization")
            token: str = _drop_prefix(auth, 7)
            try:
                payload: str = nyx.jwt.decode(secret, token)
                if len(payload) == 0:
                    return _unauthorized("empty_payload")
                sub: str = _json_field_str(payload, "sub")
                nyx.runtime.set_user(sub, payload)
                return None
            except JwtError:
                return _unauthorized("invalid_token")
    return handler

# 'exempt_paths' listesindeki yollar (query haric exact match) disinda
# Bearer JWT zorunlu. Ornek: ["/login", "/health"].
def require_bearer_unless_paths(secret: str, exempt_paths: list[str]) -> (Context) -> HttpResponse | None:
    def handler(ctx: Context) -> HttpResponse | None:
        if path_is_exempt_any(ctx.request.target, exempt_paths):
            return None
        inner: (Context) -> HttpResponse | None = require_bearer(secret)
        return inner(ctx)
    return handler

# Tek yol muafiyeti - exact path match (query string yok sayilir).
# Prefix match YOKTUR ('/login' '/login/extra'yi muaf tutmaz).
def require_bearer_unless(secret: str, exempt_path: str) -> (Context) -> HttpResponse | None:
    paths: list[str] = []
    paths.append(exempt_path)
    return require_bearer_unless_paths(secret, paths)

# NOT: Oturum (cookie) verisinde 'user_id' alani ZORUNLUDUR - imzasi
# GECERLI ama 'user_id'si eksik/bos bir oturum "kimlik dogrulanmis DEGIL"
# olarak SAYILIR (401 doner). Bu, HMAC imzasi gecerli olsa bile icerigi
# YANLIS/eksik olusturulmus (ör. login akisinda 'user_id' unutulmus) bir
# oturumun 'nyx.runtime.signed_in()'in True donmesine yol ACMASINI ONLER.
def require_session(secret: str, cookie_name: str) -> (Context) -> HttpResponse | None:
    def handler(ctx: Context) -> HttpResponse | None:
        raw: str | None = _header_get(ctx.request.headers, "Cookie")
        if raw == None:
            return _unauthorized("missing_cookie")
        else:
            try:
                cookies: dict[str, str] = nyx.cookie.parse(raw)
                val: str = cookies[cookie_name]
                data: str | None = nyx.session.load(secret, val)
                if data != None:
                    uid: str = _json_field_str(data, "user_id")
                    if len(uid) > 0:
                        nyx.runtime.set_user(uid, data)
                        return None
                    return _unauthorized("missing_user_id")
                return _unauthorized("invalid_session")
            except KeyError:
                return _unauthorized("missing_session_cookie")
            except CookieError:
                return _unauthorized("bad_cookie")
    return handler

# Router zincirine 'require_bearer'/'require_session'DEN SONRA eklenir:
# onlar 'nyx.runtime.set_user'i CAGIRDIYSA burada 'signed_in()' True olur.
# Dogrudan kullanildiginda (onceki bir kimlik dogrulama katmani OLMADAN)
# her zaman 401 doner (hicbir kullanici ATANMAMIS olur).
def require_user() -> (Context) -> HttpResponse | None:
    def handler(ctx: Context) -> HttpResponse | None:
        if not nyx.runtime.signed_in():
            return _unauthorized("unauthenticated")
        return None
    return handler
